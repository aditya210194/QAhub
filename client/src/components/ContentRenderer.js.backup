                                    <span className="phase-number bg-success text-white rounded-circle d-inline-flex align-items-center justify-content-center me-3" style={{width: '30px', height: '30px'}}>
                                        {phaseIndex + 1}
                                    </span>
                                    <h6 className="text-success mb-0">{phase.phase}</h6>
                                </div>
                            </div>

                            <div className="row">
                                <div className="col-md-6">
                                    <div className="activities-section mb-3">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-tasks me-1"></i>
                                            Key Activities
                                        </small>
                                        <div className="activities-list">
                                            {phase.activities.map((activity, activityIndex) => (
                                                <div key={activityIndex} className="activity-item small bg-success bg-opacity-10 p-2 rounded mb-1">
                                                    • {activity}
                                                </div>
                                            ))}
                                        </div>
                                    </div>
                                </div>
                                <div className="col-md-6">
                                    <div className="evaluation-section">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-check-circle me-1"></i>
                                            Evaluation Criteria
                                        </small>
                                        <div className="evaluation-list">
                                            {phase['evaluation-criteria'].map((criterion, criterionIndex) => (
                                                <div key={criterionIndex} className="criterion-item small text-warning mb-1">
                                                    ✓ {criterion}
                                                </div>
                                            ))}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    );
};

// Practice Applications Component
const PracticeApplicationsBlock = ({ block, index }) => {
    const [copied, setCopied] = useState(false);

