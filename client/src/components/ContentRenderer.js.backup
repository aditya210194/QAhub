// Defect Triage Component
const DefectTriageBlock = ({ block, index }) => {
    const [copied, setCopied] = useState(false);

    const handleCopy = () => {
        let textToCopy = `${block.title}\n\n`;
        block.process.forEach(step => {
            textToCopy += `${step.step}\n`;
            textToCopy += `Activities: ${step.activities.join(', ')}\n`;
            textToCopy += `Participants: ${step.participants}\n\n`;
        });
        navigator.clipboard.writeText(textToCopy);
        setCopied(true);
        setTimeout(() => setCopied(false), 2000);
    };

    return (
        <div className="defect-triage-block card my-4">
            <div className="card-header bg-info bg-opacity-10 border-info">
                <div className="d-flex justify-content-between align-items-center">
                    <div className="d-flex align-items-center">
                        <i className="fas fa-clipboard-list text-info me-2"></i>
                        <h5 className="card-title mb-0 text-dark">{block.title}</h5>
                    </div>
                    <button className="btn btn-sm btn-outline-secondary" onClick={handleCopy}>
                        <i className={`fas ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                        {copied ? ' Copied!' : ' Copy'}
                    </button>
                </div>
            </div>

            <div className="card-body">
                <div className="triage-process">
                    {block.process.map((step, stepIndex) => (
                        <div key={stepIndex} className="step-item mb-4 p-3 border rounded">
                            <div className="step-header mb-3">
                                <div className="d-flex align-items-center mb-2">
                                    <span className="step-number bg-info text-white rounded-circle d-inline-flex align-items-center justify-content-center me-3" style={{width: '30px', height: '30px'}}>
                                        {stepIndex + 1}
                                    </span>
                                    <h6 className="text-info mb-0">{step.step}</h6>
                                </div>
                                <div className="participants text-muted small">
                                    <i className="fas fa-users me-1"></i>
                                    Participants: {step.participants}
                                </div>
