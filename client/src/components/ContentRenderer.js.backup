// TestRail Implementation Component
const TestRailImplementationBlock = ({ block, index }) => {
    const [copied, setCopied] = useState(false);

    const handleCopy = () => {
        let textToCopy = `${block.title}\n\n`;
        block.structure.forEach(structure => {
            textToCopy += `${structure.component}\n`;
            textToCopy += `Configuration: ${structure.configuration}\n`;
            if (structure.hierarchy) {
                textToCopy += `Hierarchy: ${structure.hierarchy.join(' → ')}\n`;
            }
            if (structure.sections) {
                textToCopy += `Sections: ${structure.sections.join(', ')}\n`;
            }
            if (structure.states) {
                textToCopy += `States: ${structure.states.join(', ')}\n`;
            }
            if (structure.integration) {
                textToCopy += `Integration: ${structure.integration}\n`;
            }
            textToCopy += '\n';
        });
        navigator.clipboard.writeText(textToCopy);
        setCopied(true);
        setTimeout(() => setCopied(false), 2000);
    };

    return (
        <div className="testrail-implementation-block card my-4">
            <div className="card-header bg-primary bg-opacity-10 border-primary">
                <div className="d-flex justify-content-between align-items-center">
                    <div className="d-flex align-items-center">
                        <i className="fas fa-database text-primary me-2"></i>
                        <h5 className="card-title mb-0 text-dark">{block.title}</h5>
                    </div>
                    <button className="btn btn-sm btn-outline-secondary" onClick={handleCopy}>
                        <i className={`fas ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                        {copied ? ' Copied!' : ' Copy'}
                    </button>
                </div>
            </div>

            <div className="card-body">
                <div className="testrail-structure">
                    {block.structure.map((structure, structureIndex) => (
                        <div key={structureIndex} className="structure-item mb-4 p-3 border rounded">
                            <div className="structure-header mb-3">
                                <h6 className="text-primary mb-2">
                                    <i className="fas fa-cube me-2"></i>
                                    {structure.component}
                                </h6>
                                <div className="configuration text-muted small mb-3">
                                    <i className="fas fa-cog me-1"></i>
                                    Configuration: {structure.configuration}
                                </div>
                            </div>

                            <div className="structure-details">
                                {structure.hierarchy && (
                                    <div className="hierarchy-section mb-3">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-sitemap me-1"></i>
                                            Hierarchy
                                        </small>
                                        <div className="hierarchy-list">
                                            {structure.hierarchy.map((level, levelIndex) => (
                                                <div key={levelIndex} className="level-item small bg-primary bg-opacity-10 p-2 rounded mb-1">
                                                    {levelIndex + 1}. {level}
                                                </div>
                                            ))}
                                        </div>
                                    </div>
                                )}

                                {structure.sections && (
                                    <div className="sections-section mb-3">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-list me-1"></i>
                                            Sections
                                        </small>
                                        <div className="sections-list">
                                            {structure.sections.map((section, sectionIndex) => (
                                                <div key={sectionIndex} className="section-item small text-success mb-1">
                                                    ✓ {section}
                                                </div>
                                            ))}
                                        </div>
                                    </div>
                                )}

                                {structure.states && (
                                    <div className="states-section mb-3">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-tasks me-1"></i>
                                            Workflow States
                                        </small>
                                        <div className="states-list">
                                            {structure.states.map((state, stateIndex) => (
                                                <span key={stateIndex} className="badge bg-secondary me-1 mb-1">
                                                    {state}
                                                </span>
                                            ))}
                                        </div>
                                    </div>
                                )}

                                {structure.integration && (
                                    <div className="integration-section">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-plug me-1"></i>
                                            Integration
                                        </small>
                                        <div className="integration-text small text-info">
                                            {structure.integration}
                                        </div>
                                    </div>
                                )}
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    );
};

// Test Execution Process Component
const TestExecutionProcessBlock = ({ block, index }) => {
    const [copied, setCopied] = useState(false);

    const handleCopy = () => {
        let textToCopy = `${block.title}\n\n`;
        block.process.forEach(phase => {
            textToCopy += `${phase.phase}\n`;
            textToCopy += `Approach: ${phase.approach}\n`;
            if (phase.configuration) {
                textToCopy += `Configuration: ${phase.configuration}\n`;
            }
            if (phase.process) {
                textToCopy += `Process: ${phase.process.join(', ')}\n`;
            }
            if (phase.metrics) {
                textToCopy += `Metrics: ${phase.metrics.join(', ')}\n`;
            }
            textToCopy += `Best Practice: ${phase['best-practice']}\n\n`;
        });
        navigator.clipboard.writeText(textToCopy);
        setCopied(true);
        setTimeout(() => setCopied(false), 2000);
    };

    return (
        <div className="test-execution-process-block card my-4">
            <div className="card-header bg-success bg-opacity-10 border-success">
                <div className="d-flex justify-content-between align-items-center">
                    <div className="d-flex align-items-center">
                        <i className="fas fa-play-circle text-success me-2"></i>
                        <h5 className="card-title mb-0 text-dark">{block.title}</h5>
                    </div>
                    <button className="btn btn-sm btn-outline-secondary" onClick={handleCopy}>
                        <i className={`fas ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                        {copied ? ' Copied!' : ' Copy'}
                    </button>
                </div>
            </div>

            <div className="card-body">
                <div className="execution-phases">
                    {block.process.map((phase, phaseIndex) => (
                        <div key={phaseIndex} className="phase-item mb-4 p-3 border rounded">
                            <div className="phase-header mb-3">
                                <div className="d-flex align-items-center mb-2">
                                    <span className="phase-number bg-success text-white rounded-circle d-inline-flex align-items-center justify-content-center me-3" style={{width: '30px', height: '30px'}}>
                                        {phaseIndex + 1}
                                    </span>
                                    <div>
                                        <h6 className="text-success mb-0">{phase.phase}</h6>
                                        <small className="text-muted">Approach: {phase.approach}</small>
                                    </div>
                                </div>
                            </div>

                            <div className="phase-details">
                                {phase.configuration && (
                                    <div className="configuration-section mb-3">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-cog me-1"></i>
                                            Configuration
                                        </small>
                                        <div className="configuration-text small bg-success bg-opacity-10 p-2 rounded">
                                            {phase.configuration}
                                        </div>
                                    </div>
                                )}

                                {phase.process && (
                                    <div className="process-section mb-3">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-list-ol me-1"></i>
                                            Process Steps
                                        </small>
                                        <div className="process-list">
                                            {phase.process.map((step, stepIndex) => (
                                                <div key={stepIndex} className="step-item small bg-light p-2 rounded mb-1">
                                                    {stepIndex + 1}. {step}
                                                </div>
                                            ))}
                                        </div>
                                    </div>
                                )}

                                {phase.metrics && (
                                    <div className="metrics-section mb-3">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-chart-bar me-1"></i>
                                            Metrics Tracked
                                        </small>
                                        <div className="metrics-list">
                                            {phase.metrics.map((metric, metricIndex) => (
                                                <span key={metricIndex} className="badge bg-info me-1 mb-1">
                                                    {metric}
                                                </span>
                                            ))}
                                        </div>
                                    </div>
                                )}

                                <div className="best-practice-section">
                                    <small className="text-muted d-block mb-2">
                                        <i className="fas fa-star me-1"></i>
                                        Best Practice
                                    </small>
                                    <div className="best-practice-text small text-warning">
                                        {phase['best-practice']}
                                    </div>
                                </div>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    );
};

