const ReportingFrameworkBlock = ({ block, index }) => {
    const [expanded, setExpanded] = useState(false);
    const [copied, setCopied] = useState(false);

    const handleCopy = () => {
        let textToCopy = "Reporting Framework\n\n";
        block.reports.forEach(report => {
            textToCopy += `${report.report} (${report.frequency})\n`;
            textToCopy += `Audience: ${report.audience}\n`;
            textToCopy += "Content:\n";
            report.content.forEach(item => {
                textToCopy += `• ${item}\n`;
            });
            textToCopy += "\n";
        });
        navigator.clipboard.writeText(textToCopy);
        setCopied(true);
        setTimeout(() => setCopied(false), 2000);
    };

    const toggleExpand = () => {
        setExpanded(!expanded);
    };

    const getFrequencyColor = (frequency) => {
        const frequencyMap = {
            'Daily': 'primary',
            'Weekly': 'info',
            'As needed': 'warning'
        };
        return frequencyMap[frequency] || 'secondary';
    };

    return (
        <div className="reporting-framework-block card my-4">
            <div className="card-header bg-success bg-opacity-10 border-success">
                <div className="d-flex justify-content-between align-items-center">
