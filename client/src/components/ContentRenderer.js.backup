                            <i className={`fas ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                            {copied ? ' Copied!' : ' Copy'}
                        </button>
                    </div>
                </div>

                <div className="card-body">
                    <div className="mitigation-cheatsheet">
                        {block.mitigations.map((mitigation, mitigationIndex) => (
                            <div key={mitigationIndex} className="mitigation-item mb-3 p-3 border rounded">
                                <div className="row">
                                    <div className="col-md-4">
                                        <div className="issue-section">
                                            <h6 className="text-dark mb-2">
                                                <i className="fas fa-exclamation-circle me-2"></i>
                                                {mitigation.issue}
                                            </h6>
                                        </div>
                                    </div>
                                    <div className="col-md-8">
                                        <div className="action-section">
                                            <small className="text-muted d-block mb-1">
                                                <i className="fas fa-play-circle me-1"></i>
                                                Remediation Action
                                            </small>
                                            <div className="action-text small bg-success bg-opacity-10 p-2 rounded text-success">
                                                {mitigation.action}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        ))}
                    </div>

                    {/* Quick Implementation Guide */}
                    <div className="implementation-guide mt-4 p-3 bg-light rounded">
                        <h6 className="text-success mb-3">
                            <i className="fas fa-bolt me-2"></i>
                            Quick Implementation Priority
                        </h6>
                        <div className="priority-list">
                            <div className="priority-item high mb-2 p-2 bg-danger bg-opacity-10 rounded">
                                <strong>HIGH PRIORITY:</strong> HSTS, CSP, Certificate Validation
                            </div>
                            <div className="priority-item medium mb-2 p-2 bg-warning bg-opacity-10 rounded">
                                <strong>MEDIUM PRIORITY:</strong> X-Frame-Options, X-Content-Type-Options, Referrer-Policy
                            </div>
                            <div className="priority-item low p-2 bg-info bg-opacity-10 rounded">
                                <strong>LOW PRIORITY:</strong> Header Removal, Feature-Policy, Additional Headers
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        );
    };

