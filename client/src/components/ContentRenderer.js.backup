const UseCasesGridBlock = ({ block, index }) => {
    const [copied, setCopied] = useState(false);

    const handleCopy = () => {
        let textToCopy = "Visual Testing Use Cases\n\n";
        block.categories.forEach(category => {
            textToCopy += `${category.category}\n`;
            textToCopy += `Problem: ${category.problem}\n`;
            textToCopy += `AI Solution: ${category['ai-solution']}\n`;
            textToCopy += "Key Features:\n";
            category['key-features'].forEach(feature => {
                textToCopy += `• ${feature}\n`;
            });
            textToCopy += "Tools:\n";
            category.tools.forEach(tool => {
                textToCopy += `• ${tool}\n`;
            });
            textToCopy += `Accuracy: ${category.accuracy}\n\n`;
        });
        navigator.clipboard.writeText(textToCopy);
        setCopied(true);
        setTimeout(() => setCopied(false), 2000);
    };

    return (
        <div className="use-cases-grid-block card my-4">
            <div className="card-header bg-primary bg-opacity-10 border-primary">
                <div className="d-flex justify-content-between align-items-center">
                    <div className="d-flex align-items-center">
                        <i className="fas fa-th-large text-primary me-2"></i>
                        <h5 className="card-title mb-0 text-dark">Visual Testing Use Cases</h5>
                    </div>
                    <button className="btn btn-sm btn-outline-secondary" onClick={handleCopy}>
                        <i className={`fas ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                        {copied ? ' Copied!' : ' Copy'}
                    </button>
                </div>
            </div>

            <div className="card-body">
                <div className="use-cases-grid">
                    {block.categories.map((category, catIndex) => (
                        <div key={catIndex} className="use-case-item mb-4 p-3 border rounded">
                            <div className="use-case-header mb-3">
