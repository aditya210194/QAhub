                {/* Progress Visualization */}
                <div className="progress-summary mt-4 p-3 bg-light rounded">
                    <h6 className="d-flex align-items-center text-success mb-3">
                        <i className="fas fa-tachometer-alt me-2"></i>
                        Expected Performance Improvement
                    </h6>
                    <div className="progress-bars">
                        {[
                            { label: "Test Creation", value: 75, color: "success" },
                            { label: "Test Maintenance", value: 80, color: "info" },
                            { label: "Defect Detection", value: 40, color: "warning" },
                            { label: "Execution Time", value: 50, color: "primary" }
                        ].map((item, idx) => (
                            <div key={idx} className="progress-item mb-3">
                                <div className="d-flex justify-content-between mb-1">
                                    <small className="text-muted">{item.label}</small>
                                    <small className="text-muted">{item.value}% improvement</small>
                                </div>
                                <div className="progress" style={{ height: '8px' }}>
                                    <div
                                        className={`progress-bar bg-${item.color}`}
                                        style={{ width: `${item.value}%` }}
                                    ></div>
                                </div>
                            </div>
                        ))}
                    </div>
                </div>
            </div>
        </div>
    );
};
