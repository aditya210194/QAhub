const ImplementationPhasesBlock = ({ block, index }) => {
    const [expanded, setExpanded] = useState(false);
    const [copied, setCopied] = useState(false);

    const handleCopy = () => {
        let textToCopy = "Implementation Phases\n\n";
        block.phases.forEach(phase => {
            textToCopy += `${phase.phase} (${phase.duration})\n`;
            textToCopy += "Activities:\n";
            phase.activities.forEach(activity => {
                textToCopy += `• ${activity}\n`;
            });
            textToCopy += "Success Criteria:\n";
            phase['success-criteria'].forEach(criteria => {
                textToCopy += `✓ ${criteria}\n`;
            });
            textToCopy += "\n";
        });
        navigator.clipboard.writeText(textToCopy);
        setCopied(true);
        setTimeout(() => setCopied(false), 2000);
    };

    const toggleExpand = () => {
        setExpanded(!expanded);
    };

    return (
        <div className="implementation-phases-block card my-4">
            <div className="card-header bg-warning bg-opacity-10 border-warning">
                <div className="d-flex justify-content-between align-items-center">
