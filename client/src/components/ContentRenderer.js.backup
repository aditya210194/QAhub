// Tools Categories Component
const ToolsCategoriesBlock = ({ block, index }) => {
    const [copied, setCopied] = useState(false);

    const handleCopy = () => {
        let textToCopy = "Penetration Testing Tools Categories\n\n";
        block.categories.forEach(category => {
            textToCopy += `${category.category}\n`;
            textToCopy += `Purpose: ${category.purpose}\n\n`;
            category.tools.forEach(tool => {
                textToCopy += `  ${tool.name} (${tool.type})\n`;
                textToCopy += `  Capabilities: ${tool.capabilities.join(', ')}\n`;
                textToCopy += `  Usage: ${tool.usage}\n\n`;
            });
        });
        navigator.clipboard.writeText(textToCopy);
        setCopied(true);
        setTimeout(() => setCopied(false), 2000);
    };

    return (
        <div className="tools-categories-block card my-4">
            <div className="card-header bg-danger bg-opacity-10 border-danger">
                <div className="d-flex justify-content-between align-items-center">
                    <div className="d-flex align-items-center">
                        <i className="fas fa-toolbox text-danger me-2"></i>
                        <h5 className="card-title mb-0 text-dark">Penetration Testing Tools</h5>
                    </div>
                    <button className="btn btn-sm btn-outline-secondary" onClick={handleCopy}>
                        <i className={`fas ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                        {copied ? ' Copied!' : ' Copy'}
                    </button>
                </div>
            </div>

            <div className="card-body">
                <div className="tools-categories">
                    {block.categories.map((category, categoryIndex) => (
                        <div key={categoryIndex} className="category-item mb-4 p-3 border rounded">
                            <div className="category-header mb-3">
                                <h6 className="text-danger mb-2">
                                    <i className="fas fa-folder me-2"></i>
                                    {category.category}
                                </h6>
                                <div className="category-purpose text-muted small mb-3">
                                    <i className="fas fa-bullseye me-1"></i>
                                    {category.purpose}
                                </div>
                            </div>

                            <div className="tools-list">
                                {category.tools.map((tool, toolIndex) => (
                                    <div key={toolIndex} className="tool-item mb-3 p-3 bg-light rounded">
                                        <div className="tool-header d-flex justify-content-between align-items-start mb-2">
                                            <div>
                                                <h6 className="text-dark mb-1">{tool.name}</h6>
                                                <small className="text-muted">{tool.type}</small>
                                            </div>
                                            <span className="badge bg-danger">{toolIndex + 1}</span>
                                        </div>

                                        <div className="row">
                                            <div className="col-md-6">
                                                <div className="capabilities-section mb-2">
                                                    <small className="text-muted d-block mb-1">
                                                        <i className="fas fa-star me-1"></i>
                                                        Capabilities
                                                    </small>
                                                    <div className="capabilities-list">
                                                        {tool.capabilities.map((capability, capIndex) => (
                                                            <span key={capIndex} className="badge bg-secondary me-1 mb-1">
                                                                {capability}
                                                            </span>
                                                        ))}
                                                    </div>
                                                </div>
                                            </div>
                                            <div className="col-md-6">
                                                <div className="usage-section">
                                                    <small className="text-muted d-block mb-1">
                                                        <i className="fas fa-terminal me-1"></i>
                                                        Usage Example
                                                    </small>
                                                    <div className="usage-code small bg-dark text-light p-2 rounded font-monospace">
                                                        {tool.usage}
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                ))}
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    );
};

