            category.tools.forEach(tool => {
                textToCopy += `• ${tool.name}\n`;
                textToCopy += `  Capabilities: ${tool.capabilities.join(', ')}\n`;
                textToCopy += `  Best for: ${tool['best-for']}\n`;
                textToCopy += `  Pricing: ${tool['pricing-tier']}\n`;
