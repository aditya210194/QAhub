// Defensive Strategies Component
const DefensiveStrategiesBlock = ({ block, index }) => {
    const [copied, setCopied] = useState(false);

    const handleCopy = () => {
        let textToCopy = "Defensive Strategies for Session Protection\n\n";
        block.categories.forEach(category => {
            textToCopy += `${category.category}\n\n`;
            category.measures.forEach(measure => {
                textToCopy += `  ${measure.measure}\n`;
                textToCopy += `  Description: ${measure.description}\n`;
                textToCopy += `  Implementation: ${measure.implementation}\n`;
                textToCopy += `  Effectiveness: ${measure.effectiveness}\n\n`;
            });
        });
        navigator.clipboard.writeText(textToCopy);
        setCopied(true);
        setTimeout(() => setCopied(false), 2000);
    };

    return (
        <div className="defensive-strategies-block card my-4">
            <div className="card-header bg-info bg-opacity-10 border-info">
                <div className="d-flex justify-content-between align-items-center">
                    <div className="d-flex align-items-center">
                        <i className="fas fa-shield-alt text-info me-2"></i>
                        <h5 className="card-title mb-0 text-dark">Defensive Strategies</h5>
                    </div>
                    <button className="btn btn-sm btn-outline-secondary" onClick={handleCopy}>
                        <i className={`fas ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                        {copied ? ' Copied!' : ' Copy'}
                    </button>
                </div>
            </div>

            <div className="card-body">
                <div className="defensive-categories">
                    {block.categories.map((category, categoryIndex) => (
                        <div key={categoryIndex} className="category-item mb-4 p-3 border rounded">
                            <div className="category-header mb-3">
                                <h6 className="text-info mb-2">
                                    <i className="fas fa-lock me-2"></i>
                                    {category.category}
                                </h6>
                            </div>

                            <div className="defensive-measures">
                                {category.measures.map((measure, measureIndex) => (
                                    <div key={measureIndex} className="measure-item mb-3 p-3 bg-light rounded">
                                        <div className="measure-header mb-2">
                                            <div className="d-flex justify-content-between align-items-start">
                                                <h6 className="text-dark mb-1">
                                                    <i className="fas fa-check-circle me-2"></i>
                                                    {measure.measure}
                                                </h6>
                                                <span className={`badge ${
                                                    measure.effectiveness === 'High' ? 'bg-success' :
                                                        measure.effectiveness === 'Medium' ? 'bg-warning' : 'bg-info'
                                                }`}>
                                                    {measure.effectiveness}
                                                </span>
                                            </div>
                                            <div className="measure-description text-muted small mb-2">
                                                {measure.description}
                                            </div>
                                        </div>

                                        <div className="row">
                                            <div className="col-md-8">
                                                <div className="implementation-section mb-2">
                                                    <small className="text-muted d-block mb-1">
                                                        <i className="fas fa-code me-1"></i>
                                                        Implementation
                                                    </small>
                                                    <div className="implementation-code small bg-info bg-opacity-10 p-2 rounded font-monospace">
                                                        {measure.implementation}
                                                    </div>
                                                </div>
                                            </div>
                                            <div className="col-md-4">
                                                <div className="effectiveness-section">
                                                    <small className="text-muted d-block mb-1">
                                                        <i className="fas fa-chart-line me-1"></i>
                                                        Effectiveness
                                                    </small>
                                                    <div className="effectiveness-badge">
                                                        <span className={`badge ${
                                                            measure.effectiveness === 'High' ? 'bg-success' :
                                                                measure.effectiveness === 'Medium' ? 'bg-warning' : 'bg-info'
                                                        }`}>
                                                            {measure.effectiveness}
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                ))}
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    );
};

