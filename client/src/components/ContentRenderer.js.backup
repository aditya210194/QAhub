                                    <div className="status-indicator">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-tasks me-1"></i>
                                            Status
                                        </small>
                                        <span className="badge bg-secondary">{state.state}</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    ))}
