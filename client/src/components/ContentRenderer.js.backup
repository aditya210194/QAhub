                                            <i className="fas fa-footsteps me-1"></i>
                                            Attack Steps
                                        </small>
                                        <div className="steps-list">
                                            {technique.steps.map((step, stepIndex) => (
                                                <div key={stepIndex} className="step-item small bg-danger bg-opacity-10 p-2 rounded mb-1">
                                                    {stepIndex + 1}. {step}
                                                </div>
                                            ))}
                                        </div>
                                    </div>
                                </div>
                                <div className="col-md-4">
                                    <div className="mitigation-section mb-3">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-shield-alt me-1"></i>
                                            Mitigation
                                        </small>
                                        <div className="mitigation-text small bg-success bg-opacity-10 p-2 rounded text-success">
                                            {technique.mitigation}
                                        </div>
                                    </div>
                                </div>
                                <div className="col-md-3">
                                    <div className="tools-section">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-tools me-1"></i>
                                            Tools
                                        </small>
                                        <div className="tools-list">
                                            {technique.tools.map((tool, toolIndex) => (
                                                <span key={toolIndex} className="badge bg-secondary me-1 mb-1">
                                                    {tool}
                                                </span>
                                            ))}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    );
};

// Advanced Techniques Component
const AdvancedTechniquesBlock = ({ block, index }) => {
    const [copied, setCopied] = useState(false);

    const handleCopy = () => {
        let textToCopy = `${block.title}\n\n`;
        block.techniques.forEach(technique => {
            textToCopy += `${technique.technique}\n`;
            textToCopy += `Description: ${technique.description}\n`;
            textToCopy += `Method: ${technique.method}\n`;
            textToCopy += `Tools: ${technique.tools.join(', ')}\n`;
            textToCopy += `Complexity: ${technique.complexity}\n\n`;
        });
        navigator.clipboard.writeText(textToCopy);
        setCopied(true);
        setTimeout(() => setCopied(false), 2000);
    };

    return (
        <div className="advanced-techniques-block card my-4">
            <div className="card-header bg-warning bg-opacity-10 border-warning">
                <div className="d-flex justify-content-between align-items-center">
                    <div className="d-flex align-items-center">
                        <i className="fas fa-rocket text-warning me-2"></i>
                        <h5 className="card-title mb-0 text-dark">{block.title}</h5>
                    </div>
                    <button className="btn btn-sm btn-outline-secondary" onClick={handleCopy}>
                        <i className={`fas ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                        {copied ? ' Copied!' : ' Copy'}
                    </button>
                </div>
            </div>

            <div className="card-body">
                <div className="advanced-techniques-grid">
                    {block.techniques.map((technique, techniqueIndex) => (
                        <div key={techniqueIndex} className="technique-item mb-4 p-3 border rounded">
                            <div className="technique-header mb-3">
                                <div className="d-flex justify-content-between align-items-start">
                                    <h6 className="text-warning mb-0">
                                        <i className="fas fa-cogs me-2"></i>
                                        {technique.technique}
                                    </h6>
                                    <span className={`badge ${
                                        technique.complexity === 'High' ? 'bg-danger' :
                                            technique.complexity === 'Medium-High' ? 'bg-warning' : 'bg-info'
                                    }`}>
                                        {technique.complexity}
                                    </span>
                                </div>
                                <div className="technique-description text-muted small mt-2">
                                    <i className="fas fa-info-circle me-1"></i>
                                    {technique.description}
                                </div>
                            </div>

                            <div className="row">
                                <div className="col-md-6">
                                    <div className="method-section mb-3">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-code me-1"></i>
                                            Attack Method
                                        </small>
                                        <div className="method-text small bg-warning bg-opacity-10 p-2 rounded">
                                            {technique.method}
                                        </div>
                                    </div>
                                </div>
                                <div className="col-md-6">
                                    <div className="tools-section">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-toolbox me-1"></i>
                                            Required Tools
                                        </small>
                                        <div className="tools-list">
                                            {technique.tools.map((tool, toolIndex) => (
                                                <span key={toolIndex} className="badge bg-secondary me-1 mb-1">
                                                    {tool}
                                                </span>
                                            ))}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    );
};
// Sprint Context Component
const SprintContextBlock = ({ block, index }) => {
    const [copied, setCopied] = useState(false);

    const handleCopy = () => {
        let textToCopy = `${block.title}\n\n`;
        Object.entries(block.details).forEach(([key, value]) => {
            if (Array.isArray(value)) {
                textToCopy += `${key}: ${value.join(', ')}\n`;
            } else {
                textToCopy += `${key}: ${value}\n`;
            }
        });
        navigator.clipboard.writeText(textToCopy);
        setCopied(true);
        setTimeout(() => setCopied(false), 2000);
    };

    return (
        <div className="sprint-context-block card my-4">
            <div className="card-header bg-primary bg-opacity-10 border-primary">
                <div className="d-flex justify-content-between align-items-center">
                    <div className="d-flex align-items-center">
                        <i className="fas fa-calendar-alt text-primary me-2"></i>
                        <h5 className="card-title mb-0 text-dark">{block.title}</h5>
                    </div>
                    <button className="btn btn-sm btn-outline-secondary" onClick={handleCopy}>
                        <i className={`fas ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                        {copied ? ' Copied!' : ' Copy'}
                    </button>
                </div>
            </div>

            <div className="card-body">
                <div className="sprint-details-grid">
                    {Object.entries(block.details).map(([key, value], detailIndex) => (
                        <div key={detailIndex} className="detail-item mb-3 p-3 border rounded">
                            <div className="detail-header mb-2">
                                <h6 className="text-primary mb-1">
                                    <i className="fas fa-info-circle me-2"></i>
                                    {key}
                                </h6>
                            </div>
                            <div className="detail-content">
                                {Array.isArray(value) ? (
                                    <div className="value-list">
                                        {value.map((item, itemIndex) => (
                                            <div key={itemIndex} className="value-item small bg-primary bg-opacity-10 p-2 rounded mb-1">
                                                • {item}
                                            </div>
                                        ))}
                                    </div>
                                ) : (
                                    <div className="value-text small bg-light p-2 rounded">
                                        {value}
                                    </div>
                                )}
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    );
};

