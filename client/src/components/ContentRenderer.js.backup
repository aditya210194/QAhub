const FeatureCategoriesBlock = ({ block, index }) => {
    const [expanded, setExpanded] = useState(false);
    const [copied, setCopied] = useState(false);

    const handleCopy = () => {
        let textToCopy = "Feature Categories for Test Prediction\n\n";
        block.categories.forEach(category => {
            textToCopy += `${category.category} (Importance: ${category.importance})\n`;
            textToCopy += "Features:\n";
            category.features.forEach(feature => {
                textToCopy += `• ${feature}\n`;
            });
            textToCopy += "Data Sources:\n";
            category['data-sources'].forEach(source => {
                textToCopy += `• ${source}\n`;
            });
            textToCopy += "\n";
        });
        navigator.clipboard.writeText(textToCopy);
        setCopied(true);
        setTimeout(() => setCopied(false), 2000);
    };

    const toggleExpand = () => {
        setExpanded(!expanded);
    };

    const getImportanceColor = (importance) => {
        const importanceMap = {
            'High': 'danger',
            'Medium-High': 'warning',
            'Medium': 'info',
            'Low': 'success'
        };
        return importanceMap[importance] || 'secondary';
    };

    return (
        <div className="feature-categories-block card my-4">
            <div className="card-header bg-success bg-opacity-10 border-success">
                <div className="d-flex justify-content-between align-items-center">
                    <div className="d-flex align-items-center">
                        <i className="fas fa-puzzle-piece text-success me-2"></i>
                        <h5 className="card-title mb-0 text-dark">Feature Categories for Test Prediction</h5>
                    </div>
                    <div className="feature-actions">
                        <button className="btn btn-sm btn-outline-secondary me-2" onClick={handleCopy}>
                            <i className={`fas ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                            {copied ? ' Copied!' : ' Copy'}
                        </button>
                        <button className="btn btn-sm btn-outline-primary" onClick={toggleExpand}>
                            <i className={`fas fa-${expanded ? 'minus' : 'plus'}`}></i>
                            {expanded ? ' Less' : ' More'}
                        </button>
                    </div>
                </div>
            </div>

            <div className="card-body">
                <div className="feature-categories">
                    {block.categories.map((category, catIndex) => (
                        <div key={catIndex} className="category-item mb-4 p-3 border rounded">
                            <div className="category-header d-flex justify-content-between align-items-center mb-3">
                                <h6 className="text-success mb-0">
                                    <i className="fas fa-folder me-2"></i>
                                    {category.category}
                                </h6>
                                <span className={`badge bg-${getImportanceColor(category.importance)}`}>
                                    {category.importance}
                                </span>
                            </div>

                            <div className="row">
                                <div className="col-md-6">
                                    <div className="features-section mb-3">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-list-ul me-1"></i>
                                            Key Features
                                        </small>
                                        <div className="features-list">
                                            {category.features.slice(0, expanded ? category.features.length : 3).map((feature, featureIndex) => (
                                                <div key={featureIndex} className="feature-item small text-muted mb-1">
                                                    • {feature}
                                                </div>
                                            ))}
                                            {!expanded && category.features.length > 3 && (
                                                <div className="more-items small text-primary">
                                                    +{category.features.length - 3} more features...
                                                </div>
                                            )}
                                        </div>
                                    </div>
                                </div>
                                <div className="col-md-6">
                                    <div className="sources-section">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-database me-1"></i>
                                            Data Sources
                                        </small>
                                        <div className="sources-list">
                                            {category['data-sources'].map((source, sourceIndex) => (
                                                <div key={sourceIndex} className="source-item small text-success mb-1">
                                                    ✓ {source}
                                                </div>
                                            ))}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    );
};
const AlgorithmSelectionGuideBlock = ({ block, index }) => {
    const [copied, setCopied] = useState(false);

    const handleCopy = () => {
        let textToCopy = `${block.title}\n\n`;
        block.criteria.forEach(criterion => {
            textToCopy += `${criterion.criterion}:\n`;
            textToCopy += `Small Data: ${criterion['small-data'].join(', ')}\n`;
            textToCopy += `Large Data: ${criterion['large-data'].join(', ')}\n`;
            textToCopy += `Very Large Data: ${criterion['very-large-data'].join(', ')}\n\n`;
        });
        navigator.clipboard.writeText(textToCopy);
        setCopied(true);
        setTimeout(() => setCopied(false), 2000);
    };

    return (
        <div className="algorithm-selection-guide-block card my-4">
            <div className="card-header bg-info bg-opacity-10 border-info">
                <div className="d-flex justify-content-between align-items-center">
                    <div className="d-flex align-items-center">
                        <i className="fas fa-road text-info me-2"></i>
                        <h5 className="card-title mb-0 text-dark">{block.title}</h5>
                    </div>
                    <button className="btn btn-sm btn-outline-secondary" onClick={handleCopy}>
                        <i className={`fas ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                        {copied ? ' Copied!' : ' Copy'}
                    </button>
                </div>
            </div>

            <div className="card-body">
                <div className="selection-criteria">
                    {block.criteria.map((criterion, critIndex) => (
                        <div key={critIndex} className="criterion-item mb-4 p-3 border rounded">
                            <h6 className="text-info mb-3">
                                <i className="fas fa-filter me-2"></i>
                                {criterion.criterion}
                            </h6>

                            <div className="row">
                                <div className="col-md-4">
                                    <div className="data-size-section mb-3">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-database me-1"></i>
                                            Small Data
                                        </small>
                                        <div className="algorithms-list">
                                            {criterion['small-data'].map((algo, algoIndex) => (
                                                <span key={algoIndex} className="badge bg-light text-dark border me-1 mb-1">
                                                    {algo}
                                                </span>
                                            ))}
                                        </div>
                                    </div>
                                </div>
                                <div className="col-md-4">
                                    <div className="data-size-section mb-3">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-database me-1"></i>
                                            Large Data
                                        </small>
                                        <div className="algorithms-list">
                                            {criterion['large-data'].map((algo, algoIndex) => (
                                                <span key={algoIndex} className="badge bg-info text-dark me-1 mb-1">
                                                    {algo}
                                                </span>
                                            ))}
                                        </div>
                                    </div>
                                </div>
                                <div className="col-md-4">
                                    <div className="data-size-section">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-database me-1"></i>
                                            Very Large Data
                                        </small>
                                        <div className="algorithms-list">
                                            {criterion['very-large-data'].map((algo, algoIndex) => (
                                                <span key={algoIndex} className="badge bg-primary text-white me-1 mb-1">
                                                    {algo}
                                                </span>
                                            ))}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    );
};

const MLAlgorithmsBlock = ({ block, index }) => {
