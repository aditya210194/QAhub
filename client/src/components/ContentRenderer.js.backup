                        <h5 className="card-title mb-0 text-dark">Penetration Testing Methodologies</h5>
                    </div>
                    <button className="btn btn-sm btn-outline-secondary" onClick={handleCopy}>
                        <i className={`fas ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                        {copied ? ' Copied!' : ' Copy'}
                    </button>
                </div>
            </div>

            <div className="card-body">
                <div className="frameworks-grid">
                    {block.frameworks.map((framework, frameworkIndex) => (
                        <div key={frameworkIndex} className="framework-item mb-4 p-3 border rounded">
                            <div className="framework-header mb-3">
                                <h6 className="text-success mb-2">
                                    <i className="fas fa-project-diagram me-2"></i>
                                    {framework.framework}
                                </h6>
                                <div className="framework-focus text-muted small mb-3">
                                    <i className="fas fa-bullseye me-1"></i>
                                    Focus: {framework.focus}
