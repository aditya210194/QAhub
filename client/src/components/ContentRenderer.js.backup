const ArchitectureComponentsBlock = ({ block, index }) => {
    const [expanded, setExpanded] = useState(false);
    const [copied, setCopied] = useState(false);

    const handleCopy = () => {
        let textToCopy = "ML Architecture Components\n\n";
        block.components.forEach(component => {
            textToCopy += `${component.component}\n`;
            textToCopy += `Purpose: ${component.purpose}\n`;
            textToCopy += "Technologies:\n";
            component.technologies.forEach(tech => {
                textToCopy += `• ${tech}\n`;
            });
            textToCopy += "Tools:\n";
            component.tools.forEach(tool => {
                textToCopy += `• ${tool}\n`;
            });
            textToCopy += "\n";
        });
        navigator.clipboard.writeText(textToCopy);
        setCopied(true);
        setTimeout(() => setCopied(false), 2000);
    };

    const toggleExpand = () => {
        setExpanded(!expanded);
    };

    return (
        <div className="architecture-components-block card my-4">
            <div className="card-header bg-primary bg-opacity-10 border-primary">
                <div className="d-flex justify-content-between align-items-center">
                    <div className="d-flex align-items-center">
                        <i className="fas fa-sitemap text-primary me-2"></i>
                        <h5 className="card-title mb-0 text-dark">ML Architecture Components</h5>
                    </div>
                    <div className="architecture-actions">
                        <button className="btn btn-sm btn-outline-secondary me-2" onClick={handleCopy}>
                            <i className={`fas ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                            {copied ? ' Copied!' : ' Copy'}
                        </button>
                        <button className="btn btn-sm btn-outline-primary" onClick={toggleExpand}>
                            <i className={`fas fa-${expanded ? 'minus' : 'plus'}`}></i>
                            {expanded ? ' Less' : ' More'}
                        </button>
                    </div>
                </div>
            </div>

            <div className="card-body">
                <div className="architecture-components">
                    {block.components.map((component, compIndex) => (
                        <div key={compIndex} className="component-item mb-4 p-3 border rounded">
                            <div className="component-header mb-3">
                                <h6 className="text-primary mb-2">
                                    <i className="fas fa-cube me-2"></i>
                                    {component.component}
                                </h6>
                                <div className="component-purpose text-muted small mb-3">
                                    <i className="fas fa-bullseye me-1"></i>
                                    {component.purpose}
                                </div>
                            </div>

                            <div className="row">
                                <div className="col-md-6">
                                    <div className="technologies-section mb-3">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-microchip me-1"></i>
                                            Technologies
                                        </small>
                                        <div className="technologies-list">
                                            {component.technologies.map((tech, techIndex) => (
                                                <span key={techIndex} className="badge bg-info text-dark me-1 mb-1">
                                                    {tech}
                                                </span>
                                            ))}
                                        </div>
                                    </div>
                                </div>
                                <div className="col-md-6">
                                    <div className="tools-section">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-tools me-1"></i>
                                            Tools
                                        </small>
                                        <div className="tools-list">
                                            {component.tools.map((tool, toolIndex) => (
                                                <span key={toolIndex} className="badge bg-light text-dark border me-1 mb-1">
                                                    {tool}
                                                </span>
                                            ))}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    ))}
                </div>

                {/* Architecture Flow Visualization */}
                <div className="architecture-flow mt-4 p-3 bg-light rounded">
                    <h6 className="d-flex align-items-center text-primary mb-3">
                        <i className="fas fa-project-diagram me-2"></i>
                        Architecture Flow
                    </h6>
                    <div className="flow-steps text-center">
                        <div className="row">
                            {block.components.map((component, compIndex) => (
                                <div key={compIndex} className="col-md-2 mb-3">
                                    <div className="flow-step">
                                        <div className="step-circle bg-primary text-white rounded-circle mx-auto mb-2 d-flex align-items-center justify-content-center" style={{width: '50px', height: '50px'}}>
                                            <i className="fas fa-cube"></i>
                                        </div>
                                        <div className="step-name small fw-bold">{component.component}</div>
                                        <div className="step-number small text-muted">Step {compIndex + 1}</div>
                                    </div>
                                    {compIndex < block.components.length - 1 && (
                                        <div className="flow-arrow d-none d-md-block">
                                            <i className="fas fa-arrow-right text-muted fa-lg"></i>
                                        </div>
                                    )}
                                </div>
                            ))}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    );
};
const RiskMitigationBlock = ({ block, index }) => {
    const [copied, setCopied] = useState(false);

    const handleCopy = () => {
        let textToCopy = `${block.title}\n\n`;
        block.risks.forEach(risk => {
            textToCopy += `${risk.risk}\n`;
            textToCopy += `Probability: ${risk.probability}, Impact: ${risk.impact}\n`;
            textToCopy += `Mitigation: ${risk.mitigation}\n\n`;
        });
        navigator.clipboard.writeText(textToCopy);
        setCopied(true);
        setTimeout(() => setCopied(false), 2000);
    };

    const getRiskColor = (probability, impact) => {
        if (probability === 'High' && impact === 'High') return 'danger';
        if (probability === 'High' || impact === 'High') return 'warning';
        return 'info';
    };

    return (
        <div className="risk-mitigation-block card my-4">
            <div className="card-header bg-warning bg-opacity-10 border-warning">
                <div className="d-flex justify-content-between align-items-center">
                    <div className="d-flex align-items-center">
                        <i className="fas fa-shield-alt text-warning me-2"></i>
                        <h5 className="card-title mb-0 text-dark">{block.title}</h5>
                    </div>
                    <button className="btn btn-sm btn-outline-secondary" onClick={handleCopy}>
                        <i className={`fas ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                        {copied ? ' Copied!' : ' Copy'}
                    </button>
                </div>
            </div>

            <div className="card-body">
                <div className="table-responsive">
                    <table className="table table-bordered table-hover">
                        <thead className="table-light">
                        <tr>
                            <th>Risk</th>
                            <th className="text-center">Probability</th>
                            <th className="text-center">Impact</th>
                            <th>Mitigation Strategy</th>
                        </tr>
                        </thead>
                        <tbody>
                        {block.risks.map((risk, riskIndex) => (
                            <tr key={riskIndex}>
                                <td><strong>{risk.risk}</strong></td>
                                <td className="text-center">
                                        <span className={`badge bg-${risk.probability === 'High' ? 'danger' : risk.probability === 'Medium' ? 'warning' : 'info'}`}>
                                            {risk.probability}
                                        </span>
                                </td>
                                <td className="text-center">
                                        <span className={`badge bg-${risk.impact === 'High' ? 'danger' : risk.impact === 'Medium' ? 'warning' : 'info'}`}>
                                            {risk.impact}
                                        </span>
                                </td>
                                <td>{risk.mitigation}</td>
                            </tr>
                        ))}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    );
};
