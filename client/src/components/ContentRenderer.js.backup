        let textToCopy = `${block.title}\n\n`;
        block.configurations.forEach(config => {
            textToCopy += `${config.tool}\n`;
            textToCopy += `Configuration: ${config.configuration.join(', ')}\n`;
            textToCopy += `Benefits: ${config.benefits}\n\n`;
        });
        navigator.clipboard.writeText(textToCopy);
        setCopied(true);
        setTimeout(() => setCopied(false), 2000);
    };

    return (
        <div className="tool-configuration-block card my-4">
            <div className="card-header bg-info bg-opacity-10 border-info">
                <div className="d-flex justify-content-between align-items-center">
                    <div className="d-flex align-items-center">
                        <i className="fas fa-cogs text-info me-2"></i>
                        <h5 className="card-title mb-0 text-dark">{block.title}</h5>
                    </div>
                    <button className="btn btn-sm btn-outline-secondary" onClick={handleCopy}>
                        <i className={`fas ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                        {copied ? ' Copied!' : ' Copy'}
                    </button>
                </div>
            </div>

            <div className="card-body">
                <div className="tool-configurations">
                    {block.configurations.map((config, configIndex) => (
                        <div key={configIndex} className="config-item mb-4 p-3 border rounded">
                            <div className="config-header mb-3">
                                <h6 className="text-info mb-2">
                                    <i className="fas fa-toolbox me-2"></i>
                                    {config.tool}
                                </h6>
                            </div>

                            <div className="row">
                                <div className="col-md-7">
                                    <div className="configuration-section mb-3">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-wrench me-1"></i>
                                            Configuration Steps
                                        </small>
                                        <div className="configuration-list">
                                            {config.configuration.map((step, stepIndex) => (
                                                <div key={stepIndex} className="step-item small bg-info bg-opacity-10 p-2 rounded mb-1">
                                                    {stepIndex + 1}. {step}
                                                </div>
                                            ))}
                                        </div>
                                    </div>
                                </div>
                                <div className="col-md-5">
                                    <div className="benefits-section">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-gift me-1"></i>
                                            Benefits
                                        </small>
                                        <div className="benefits-text small bg-success bg-opacity-10 p-2 rounded text-success">
                                            {config.benefits}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    );
};

// Vulnerability Categories Component
const VulnerabilityCategoriesBlock = ({ block, index }) => {
    const [copied, setCopied] = useState(false);

    const handleCopy = () => {
        let textToCopy = "API Security Vulnerability Categories\n\n";
        block.categories.forEach(category => {
            textToCopy += `${category.category}\n\n`;
            category.vulnerabilities.forEach(vuln => {
                textToCopy += `  ${vuln.vulnerability}\n`;
                textToCopy += `  Description: ${vuln.description}\n`;
                textToCopy += `  Testing Technique: ${vuln['testing-technique'].join(', ')}\n`;
                textToCopy += `  Tools: ${vuln.tools.join(', ')}\n`;
                textToCopy += `  Severity: ${vuln.severity}\n\n`;
            });
        });
        navigator.clipboard.writeText(textToCopy);
        setCopied(true);
        setTimeout(() => setCopied(false), 2000);
    };

    return (
        <div className="vulnerability-categories-block card my-4">
            <div className="card-header bg-warning bg-opacity-10 border-warning">
                <div className="d-flex justify-content-between align-items-center">
                    <div className="d-flex align-items-center">
                        <i className="fas fa-bug text-warning me-2"></i>
                        <h5 className="card-title mb-0 text-dark">API Security Vulnerabilities</h5>
                    </div>
                    <button className="btn btn-sm btn-outline-secondary" onClick={handleCopy}>
                        <i className={`fas ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                        {copied ? ' Copied!' : ' Copy'}
                    </button>
                </div>
            </div>

            <div className="card-body">
                <div className="vulnerability-categories">
                    {block.categories.map((category, categoryIndex) => (
                        <div key={categoryIndex} className="category-item mb-4 p-3 border rounded">
                            <div className="category-header mb-3">
                                <h6 className="text-warning mb-2">
                                    <i className="fas fa-shield-alt me-2"></i>
                                    {category.category}
                                </h6>
                            </div>

                            <div className="vulnerabilities-list">
                                {category.vulnerabilities.map((vuln, vulnIndex) => (
