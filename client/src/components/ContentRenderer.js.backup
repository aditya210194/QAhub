                    </h6>
                    <div className="cycle-steps text-center">
                        <div className="row">
                            <div className="col-md-3 mb-3">
                                <div className="cycle-step p-2">
                                    <div className="step-icon bg-primary text-white rounded-circle mx-auto mb-2 d-flex align-items-center justify-content-center" style={{width: '50px', height: '50px'}}>
                                        <i className="fas fa-chart-line"></i>
                                    </div>
                                    <small className="text-muted">Measure & Analyze</small>
                                </div>
                            </div>
                            <div className="col-md-3 mb-3">
                                <div className="cycle-step p-2">
                                    <div className="step-icon bg-success text-white rounded-circle mx-auto mb-2 d-flex align-items-center justify-content-center" style={{width: '50px', height: '50px'}}>
                                        <i className="fas fa-lightbulb"></i>
                                    </div>
                                    <small className="text-muted">Identify Improvements</small>
                                </div>
                            </div>
                            <div className="col-md-3 mb-3">
                                <div className="cycle-step p-2">
                                    <div className="step-icon bg-info text-white rounded-circle mx-auto mb-2 d-flex align-items-center justify-content-center" style={{width: '50px', height: '50px'}}>
                                        <i className="fas fa-cogs"></i>
                                    </div>
                                    <small className="text-muted">Implement Changes</small>
                                </div>
                            </div>
                            <div className="col-md-3 mb-3">
                                <div className="cycle-step p-2">
                                    <div className="step-icon bg-warning text-white rounded-circle mx-auto mb-2 d-flex align-items-center justify-content-center" style={{width: '50px', height: '50px'}}>
                                        <i className="fas fa-sync-alt"></i>
