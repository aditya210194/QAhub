                                            </small>
                                            <div className="features-list">
                                                {category['key-features'].map((feature, featureIndex) => (
                                                    <div key={featureIndex} className="feature-item small text-muted mb-1">
                                                        • {feature}
                                                    </div>
                                                ))}
