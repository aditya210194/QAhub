                    return <RootCauseAnalysisBlock key={blockKey} block={block} index={index} />;
                case 'design-principles':
                    return <DesignPrinciplesBlock key={blockKey} block={block} index={index} />;
                case 'test-design-techniques':
                    return <TestDesignTechniquesBlock key={blockKey} block={block} index={index} />;
                case 'continuous-improvement':
                    return <ContinuousImprovementBlock key={blockKey} block={block} index={index} />;
                case 'advanced-topics':
                    return <AdvancedTopicsBlock key={blockKey} block={block} index={index} />;
                case 'future-trends':
                    return <FutureTrendsBlock key={blockKey} block={block} index={index} />;
                case 'best-practices':
                    return <BestPracticesBlock key={blockKey} block={block} index={index} />;
                case 'phase-analysis':
                    return <PhaseAnalysisBlock key={blockKey} block={block} index={index} />;
                case 'cost-analysis':
                    return <CostAnalysisBlock key={blockKey} block={block} index={index} />;
                case 'tool-integration':
                    return <ToolIntegrationBlock key={blockKey} block={block} index={index} />;
                case 'implementation-example':
                    return <ImplementationExampleBlock key={blockKey} block={block} index={index} />;
                case 'implementation-roadmap':
                    return <ImplementationRoadmapBlock key={blockKey} block={block} index={index} />;
                case 'measurement-guidelines':
                    return <MeasurementGuidelinesBlock key={blockKey} block={block} index={index} />;
                case 'dashboard':
                    return <DashboardBlock key={blockKey} block={block} index={index} />;
                case 'tool-categories':
                    return <ToolCategoriesBlock key={blockKey} block={block} index={index} />;
                case 'integration-scenario':
                    return <IntegrationScenarioBlock key={blockKey} block={block} index={index} />;
                case 'implementation-phases':
                    return <ImplementationPhasesBlock key={blockKey} block={block} index={index} />;
                case 'roles-responsibilities':
                    return <RolesResponsibilitiesBlock key={blockKey} block={block} index={index} />;
                case 'trends':
                    return <TrendsBlock key={blockKey} block={block} index={index} />;
                case 'next-generation':
                    return <NextGenerationBlock key={blockKey} block={block} index={index} />;
                case 'strategy':
                    return <StrategyBlock key={blockKey} block={block} index={index} />;

                case 'categorization':
                    return <CategorizationBlock key={blockKey} block={block} index={index} />;

                case 'formula':
                    return <FormulaBlock key={blockKey} block={block} index={index} />;

                case 'analogy':
                    return <AnalogyBlock key={blockKey} block={block} index={index} />;

                case 'definition':
                    return <DefinitionBlock key={blockKey} block={block} index={index} />;

                case 'quiz':
                    return <InteractiveQuiz key={blockKey} block={block} index={index} />;
                case 'quiz':
                    return <InteractiveQuiz1 key={blockKey} block={block} index={index} />;

                case 'interactive-calculator':
                    return <InteractiveCalculator key={blockKey} block={block} index={index} />;
                case 'interactive-quiz':
                    return <InteractiveQuiz key={blockKey} block={block} index={index} />;

                case 'section':
                    return (
                        <section key={index} className="mb-5">
                            {block.title && <h2 className="mb-4">{block.title}</h2>}
                            <ContentRenderer
                                content={block.content}
                                baseUrl={baseUrl}
                                imageWrapperClass={imageWrapperClass}
                                imageClass={imageClass}
                                maxImageHeight={maxImageHeight}
                                fallbackImage={fallbackImage}
                            />
                        </section>
                    );
                    case 'flowchart': {
                        const { title, content } = block;

                        return (
                            <div className="simple-flowchart">
                                <h4>{title}</h4>
                                <div className="flowchart-diagram">
                                    <div className="flow-step start">
                                        <div className="step-icon">▶</div>
                                        <div className="step-text">{content.start}</div>
                                    </div>

                                    {content.decisions.map((decision, idx) => (
                                        <React.Fragment key={idx}>
                                            <div className="connector">↓</div>
                                            <div className="flow-step decision">
                                                <div className="step-icon">?</div>
                                                <div className="step-text">{decision.question}</div>
                                            </div>

                                            <div className="options-grid">
                                                {decision.options.map((option, optIdx) => (
                                                    <div key={optIdx} className="option">
                                                        <div className="option-answer">{option.answer}</div>
                                                        <div className="option-action">{option.action}</div>
                                                        <div className="option-next">→ {option.next}</div>
                                                    </div>
                                                ))}
                                            </div>
                                        </React.Fragment>
                                    ))}

                                    <div className="connector">↓</div>
                                    <div className="flow-step end">
                                        <div className="step-icon">✓</div>
                                        <div className="step-text">{content.end}</div>
                                    </div>
                                </div>
                            </div>
                        );
                    }


                case 'text':
                    return (
                        <div key={index} className="text-block mb-4">
                            <ReactMarkdown components={markdownComponents}>
                                {block.value}
                            </ReactMarkdown>
                            {block.subpoints && (
                                <ul className="subpoints mt-3 ps-4">
                                    {block.subpoints.map((point, i) => (
                                        <li key={i}>
                                            <ReactMarkdown components={markdownComponents}>
                                                {point}
                                            </ReactMarkdown>
                                        </li>
                                    ))}
                                </ul>
                            )}
                            {block.example && (
                                <div className="example-block bg-light p-3 rounded mt-3">
                                    <strong>{block.example.title}: </strong>
                                    <ReactMarkdown components={markdownComponents}>
                                        {block.example.content}
                                    </ReactMarkdown>
                                </div>
                            )}
                        </div>
                    );
                case 'example':
                    return (
                        <div key={index} className="example-block card border-0 shadow-sm my-4">
                            <div className="card-header bg-danger bg-opacity-10 d-flex align-items-center">
                                <i className="fas fa-exclamation-triangle text-danger me-2"></i>
                                <h5 className="mb-0 text-danger">{block.title || 'Real-World Example'}</h5>
                            </div>
                            <div className="card-body">
                                <div className="row g-3">
                                    {/* Scenario */}
                                    <div className="col-md-4">
                                        <div className="p-3 h-100 border-start border-3 border-danger">
                                            <h6 className="d-flex align-items-center text-danger">
                                                <i className="fas fa-fire me-2"></i>Scenario
                                            </h6>
                                            <ReactMarkdown components={markdownComponents}>
                                                {block.scenario}
                                            </ReactMarkdown>
                                        </div>
                                    </div>

                                    {/* Outcome */}
                                    <div className="col-md-4">
                                        <div className="p-3 h-100 border-start border-3 border-warning">
                                            <h6 className="d-flex align-items-center text-warning-dark">
                                                <i className="fas fa-dollar-sign me-2"></i>Outcome
                                            </h6>
                                            <ReactMarkdown components={markdownComponents}>
                                                {block.outcome}
                                            </ReactMarkdown>
                                        </div>
                                    </div>

                                    {/* Prevention */}
                                    <div className="col-md-4">
                                        <div className="p-3 h-100 border-start border-3 border-success">
                                            <h6 className="d-flex align-items-center text-success">
                                                <i className="fas fa-shield-alt me-2"></i>Prevention
                                            </h6>
                                            <ReactMarkdown components={markdownComponents}>
                                                {block.prevention}
                                            </ReactMarkdown>
                                        </div>
                                    </div>
                                </div>

                                {/* Optional Details */}
                                {block.details && (
                                    <div className="mt-3 p-3 bg-light rounded">
                                        <h6 className="d-flex align-items-center">
                                            <i className="fas fa-info-circle me-2"></i>Technical Details
                                        </h6>
                                        <ReactMarkdown components={markdownComponents}>
                                            {block.details}
                                        </ReactMarkdown>
                                    </div>
                                )}
                            </div>
                        </div>
                    );

                case 'image':
                    return (
                        <ImageRenderer
                            key={index}
                            src={block.image}
                            alt={block.caption}
                            title={block.caption}
                        />
                    );

                case 'table':
                    return (
                        <div key={index} className="table-responsive my-4">
                            {block.title && <h5 className="mb-3">{block.title}</h5>}
                            <table className="table table-bordered">
                                {block.columns && (
                                    <thead>
                                    <tr>
                                        {block.columns.map((col, i) => (
                                            <th key={i}>{col}</th>
                                        ))}
                                    </tr>
                                    </thead>
                                )}
                                <tbody>
                                {block.rows.map((row, i) => (
                                    <tr key={i}>
                                        {row.map((cell, j) => (
                                            <td key={j}>
                                                <ReactMarkdown components={markdownComponents}>
                                                    {cell}
                                                </ReactMarkdown>
                                            </td>
                                        ))}
                                    </tr>
                                ))}
                                </tbody>
                            </table>
                            {block.footer && (
                                <div className="text-muted small mt-2">{block.footer}</div>
                            )}
                        </div>
                    );

               case 'chart':
                 const chartData = (() => {
                   // 🔹 If multiple datasets already provided
                   if (block.data?.datasets) {
                     return {
                       labels: block.data.labels || [],
                       datasets: block.data.datasets.map(ds => ({
                         label: ds.label,
                         data: ds.values || ds.data,   // supports both values & bubble data
                         backgroundColor: ds.color || ds.backgroundColor,
                         borderColor: ds.color || ds.borderColor,
                         borderRadius: 6,
                         tension: 0.4
                       }))
                     };
                   }

                   // 🔹 If single dataset (old structure)
                   if (block.data?.values) {
                     return {
                       labels: block.data.labels || [],
                       datasets: [{
                         label: block.title,
                         data: block.data.values,
                         backgroundColor: block.data.colors,
                         borderColor: block.data.colors,
                         borderRadius: 6,
                         tension: 0.4
                       }]
                     };
                   }

                   // 🔹 Fallback (prevents crash)
                   return { labels: [], datasets: [] };
                 })();

                 return (
                   <div key={index} className="chart-wrapper my-5">
                     <div className="chart-card shadow-sm">

                       {block.title && (
                         <div className="chart-header">
                           <h5 className="chart-title mb-0">
                             {block.title}
                           </h5>
                         </div>
                       )}

                       <div className="chart-body">
                         <ChartRenderer
                           chartType={block.chartType}
                           data={chartData}
                         />
                       </div>

                       {block.caption && (
                         <div className="chart-footer">
                           {block.caption}
                         </div>
                       )}
                     </div>
                   </div>
                 );



                case 'markdown':
                    return (
                        <ReactMarkdown key={index} components={markdownComponents}>
                            {block.data}
                        </ReactMarkdown>
                    );

                case 'definition-list':
                    return (
                        <div key={index} className="definition-list">
                            {block.title && <h4>{block.title}</h4>}
                            <dl>
                                {block.items.map((item, i) => (
                                    <React.Fragment key={i}>
                                        <dt>{item.term}</dt>
                                        <dd>{item.definition}</dd>
                                    </React.Fragment>
                                ))}
                            </dl>
                        </div>
                    );

                case 'list':
                    return (
                        <ul key={index} className="ps-3" style={block.style}>
                            {block.items?.map((item, i) => (
                                <li key={i}>{item}</li>
                            ))}
                        </ul>
                    )



                case 'code': {
                    // Determine language from file extension if not specified
                    const detectLanguage = (code) => {
                        if (block.language) return block.language;

                        const firstLine = (code || '').split('\n')[0];
                        const extensionMatches = firstLine.match(/\.([a-z0-9]+)$/i);
                        if (extensionMatches) {
                            return extensionMatches[1].toLowerCase();
                        }
                        return 'text';
                    };

                    // Check if content is test case format
                    const isTestCase = (content) => {
                        return content.includes('Test Case ID:') ||
                            content.includes('Steps:') ||
                            content.includes('Expected:');
                    };

                    const codeContent = block.code || block.value || '';
                    const language = detectLanguage(codeContent);
                    const shouldHighlight = !isTestCase(codeContent) && language !== 'text';

                    return (
                        <div key={index} className={`advanced-code-block ${block.variant || 'default'}`}>
                            {/* Header with language tab and actions */}
                            <div className="code-header">
                                <div className="language-tab">
                                    <span className="language-name">{language}</span>
                                    {block.filename && (
                                        <span className="filename">{block.filename}</span>
                                    )}
                                </div>
                                <div className="code-actions">
                                    {block.copyable && (
                                        <button
                                            className="copy-button"
                                            onClick={() => navigator.clipboard.writeText(codeContent)}
                                        >
                                            <i className="fas fa-copy"></i>
                                        </button>
                                    )}
                                </div>
                            </div>

                            {/* Content area */}
                            <div className="code-content-container">
                                {shouldHighlight ? (
                                    <SyntaxHighlighter
                                        language={language}
                                        style={atomDark}
                                        showLineNumbers={block.showLineNumbers !== false}
                                        wrapLines={true}
                                        lineProps={{ style: { wordBreak: 'break-all', whiteSpace: 'pre-wrap' } }}
                                    >
                                        {codeContent}
                                    </SyntaxHighlighter>
                                ) : (
                                    <pre className="plain-code">
                                        {codeContent.split('\n').map((line, i) => (
                                            <div key={i} className="code-line">
                                                {block.showLineNumbers !== false && (
                                                    <span className="line-number">{i + 1}</span>
                                                )}
                                                <span className="line-content">{line}</span>
                                            </div>
                                        ))}
                                    </pre>
                                )}
                            </div>

                            {/* Footer with metadata */}
                            {(block.caption || block.metadata) && (
                                <div className="code-footer">
                                    {block.caption && <div className="code-caption">{block.caption}</div>}
                                    {block.metadata && (
                                        <div className="code-metadata">
                                            {Object.entries(block.metadata).map(([key, value]) => (
                                                <span key={key} className="meta-item">
                                                    <strong>{key}:</strong> {value}
                                                </span>
                                            ))}
                                        </div>
                                    )}
                                </div>
                            )}
                        </div>
                    );
                }
                case 'code-example':
                    return (
                        <div>
                            <h3>{block.title}</h3>
                            {block.examples?.map((ex, i) => (
                                <div key={i}>
                                    <h4>{ex.title} ({ex.language})</h4>
                                    <pre>{ex.code}</pre>
                                    <p>{ex.explanation}</p>
                                </div>
                            ))}
                        </div>
                    );


                case 'mermaid':
                    try {
                        return (
                            <div key={index} className="my-4">
                                <Mermaid chart={block.code} />
                            </div>
                        );
                    } catch (error) {
                        return (
                            <div key={index} className="my-4 p-3 border rounded bg-light">
                                <pre>{block.fallback || block.code}</pre>
                            </div>
                        );
                    }

                case 'diagram':
                    return (
                        <div key={index} className="diagram-container my-4 p-3 border rounded">
                            {block.title && <h5 className="mb-3">{block.title}</h5>}
                            {block.image && (
                                <figure className="text-center">
                                    <img
                                        src={block.image}
                                        alt={block.caption || block.title}
                                        className="img-fluid"
                                    />
                                    {block.caption && <figcaption className="mt-2 text-muted">{block.caption}</figcaption>}
                                </figure>
                            )}
                            {block.layers && (
                                <div className="mt-3">
                                    <h6>Process Layers:</h6>
                                    <ul className="list-group">
                                        {block.layers.map((layer, i) => (
                                            <li key={i} className="list-group-item">
                                                <strong>{layer.phase}:</strong> {layer.activity}
                                            </li>
                                        ))}
                                    </ul>
                                </div>
                            )}
                        </div>
                    );
                    case 'diagram visual':
                        return (
                            <div key={index} className="diagram-container my-4 p-4 border rounded bg-light">
                                {block.title && <h5 className="mb-3 text-primary fw-bold">{block.title}</h5>}

                                {block.content && Array.isArray(block.content) && (
                                    <div className="ascii-diagram mt-3 mb-4 p-3 bg-dark text-light rounded">
                                        <pre className="mb-0 font-monospace" style={{
                                            fontSize: '12px',
                                            lineHeight: '1.2',
                                            overflowX: 'auto',
                                            whiteSpace: 'pre-wrap',
                                            wordWrap: 'break-word'
                                        }}>
                                            {block.content.map((line, i) => (
                                                <div key={i} className="diagram-line">{line}</div>
                                            ))}
                                        </pre>
                                    </div>
                                )}

                                {block.image && !block.content && (
                                    <figure className="text-center">
                                        <img
                                            src={block.image}
                                            alt={block.caption || block.title}
                                            className="img-fluid border rounded shadow-sm"
                                            style={{ maxHeight: '400px' }}
                                        />
                                        {block.caption && <figcaption className="mt-2 text-muted">{block.caption}</figcaption>}
                                    </figure>
                                )}

                                {block.description && (
                                    <div className="mt-3 p-3 bg-info bg-opacity-10 rounded border-start border-primary border-4">
                                        <p className="mb-0"><strong>Architecture Insight:</strong> {block.description}</p>
                                    </div>
                                )}

                                {block.layers && (
                                    <div className="mt-4">
                                        <h6 className="text-secondary mb-3">Layer Breakdown:</h6>
                                        <div className="row">
                                            {block.layers.map((layer, i) => (
                                                <div key={i} className="col-md-6 mb-3">
                                                    <div className="layer-card p-3 border rounded h-100">
                                                        <div className="layer-header d-flex align-items-center mb-2">
                                                            <span className="layer-badge badge bg-secondary me-2">{i + 1}</span>
                                                            <strong className="layer-name">{layer.name || layer.phase}:</strong>
                                                        </div>
                                                        <div className="layer-details">
                                                            <p className="mb-1"><small className="text-muted">Responsibility:</small></p>
                                                            <p className="mb-2">{layer.responsibility || layer.activity}</p>
                                                            {layer.components && (
                                                                <>
                                                                    <p className="mb-1"><small className="text-muted">Components:</small></p>
                                                                    <p className="mb-0 text-muted">{layer.components}</p>
                                                                </>
                                                            )}
                                                        </div>
                                                    </div>
                                                </div>
                                            ))}
                                        </div>
                                    </div>
                                )}
                            </div>
                        );

                case 'comparison-grid':
                    return (
                        <div key={index} className="comparison-grid my-4">
                            {block.title && <h5 className="mb-3">{block.title}</h5>}
                            <div className="table-responsive">
                                <table className="table table-bordered table-hover">
                                    {block.columns && (
                                        <thead className="table-light">
                                        <tr>
                                            {block.columns.map((col, i) => (
                                                <th key={i}>{col}</th>
                                            ))}
                                        </tr>
                                        </thead>
                                    )}
                                    <tbody>
                                    {block.rows.map((row, i) => (
                                        <tr key={i}>
                                            {row.map((cell, j) => (
                                                <td key={j}>
                                                    <ReactMarkdown components={markdownComponents}>
                                                        {cell}
                                                    </ReactMarkdown>
                                                </td>
                                            ))}
                                        </tr>
                                    ))}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    );

                case 'infographic':
                    return (
                        <div key={index} className="infographic-container my-4">
                            {block.title && <h5 className="mb-3">{block.title}</h5>}
                            {block.image && (
                                <figure className="text-center">
                                    <img
                                        src={block.image}
                                        alt={block.title}
                                        className="img-fluid rounded"
                                    />
                                </figure>
                            )}
                            {block.levels && (
                                <div className="mt-3">
                                    <h6>Breakdown:</h6>
                                    <div className="progress mb-3" style={{ height: '30px' }}>
                                        {block.levels.map((level, i) => (
                                            <div
                                                key={i}
                                                className="progress-bar"
                                                role="progressbar"
                                                style={{
                                                    width: `${level.percentage}%`,
                                                    backgroundColor: level.color
                                                }}
                                                aria-valuenow={level.percentage}
                                                aria-valuemin="0"
                                                aria-valuemax="100"
                                            >
                                                {level.type} ({level.percentage}%)
                                            </div>
                                        ))}
                                    </div>
                                    {block.bestPractice && (
                                        <div className="alert alert-info mt-2">
                                            <strong>Best Practice:</strong> {block.bestPractice}
                                        </div>
                                    )}
                                </div>
                            )}
                        </div>
                    );

                case 'myth-busters':
                    return (
                        <div key={index} className="myth-busters my-4">
                            {block.title && <h5 className="mb-3">{block.title}</h5>}
                            <div className="row">
                                {block.items.map((item, i) => (
                                    <div key={i} className="col-md-6 mb-3">
                                        <div className="card h-100">
                                            <div className="card-header bg-danger text-white">
                                                <strong>Myth:</strong> {item.myth}
                                            </div>
                                            <div className="card-body bg-light">
                                                <strong>Reality:</strong> {item.reality}
                                            </div>
                                        </div>
                                    </div>
                                ))}
                            </div>
                        </div>
                    );

                case 'step-by-step':
                    return (
                        <div key={index} className="step-by-step my-4">
                            {block.title && <h5 className="mb-3">{block.title}</h5>}
                            <div className="list-group">
                                {block.steps.map((step, i) => (
                                    <div key={i} className="list-group-item">
                                        <div className="d-flex align-items-start">
                                            <span className="badge bg-primary me-3 mt-1">{step.step}</span>
                                            <div>
                                                <h6 className="mb-1">{step.action}</h6>
                                                {step.tip && (
                                                    <small className="text-muted">
                                                        <i className="bi bi-lightbulb"></i> {step.tip}
                                                    </small>
                                                )}
                                            </div>
                                        </div>
                                    </div>
                                ))}
                            </div>
                        </div>
                    );

                case 'resources':
                    return (
                        <div key={index} className="resources my-4">
                            {block.title && <h5 className="mb-3">{block.title}</h5>}
                            <div className="row">
                                {block.items.map((item, i) => (
                                    <div key={i} className="col-md-6 mb-3">
                                        <div className="card h-100">
                                            <div className="card-body">
                                                <h6 className="card-title">
                                                    {item.type === 'book' && <i className="bi bi-book me-2"></i>}
                                                    {item.type === 'tool' && <i className="bi bi-tools me-2"></i>}
                                                    {item.title}
                                                </h6>
                                                {item.author && <p className="card-text text-muted">by {item.author}</p>}
                                                {item.link && (
                                                    <a href={item.link} target="_blank" rel="noopener noreferrer" className="btn btn-sm btn-outline-primary">
                                                        Visit Resource
                                                    </a>
                                                )}
                                            </div>
                                        </div>
                                    </div>
                                ))}
                            </div>
                        </div>
                    );

                case 'chapter':
                    return (
                        <div key={index} className="chapter my-5">
                            <h2 className="chapter-title border-bottom pb-2 mb-4">
                                {block.chapterNumber && (
                                    <span className="chapter-number me-2">
                                        Chapter {block.chapterNumber}:
                                    </span>
                                )}
                                {block.title}
                            </h2>
                            <div className="chapter-content">
                                <ContentRenderer content={block.content} />
                            </div>
                            {block.summary && (
                                <div className="chapter-summary alert alert-light mt-4">
                                    <h5>Chapter Summary</h5>
                                    <ReactMarkdown components={markdownComponents}>
                                        {block.summary}
                                    </ReactMarkdown>
                                </div>
                            )}
                        </div>
                    );

                case 'appendix':
                    return (
                        <div key={index} className="appendix my-5">
                            <h2 className="appendix-title border-bottom pb-2 mb-4">
                                <span className="appendix-label me-2">
                                    Appendix {block.appendixLetter || 'A'}:
                                </span>
                                {block.title}
                            </h2>
                            <div className="appendix-content">
                                <ContentRenderer content={block.content} />
                            </div>
                            {block.reference && (
                                <div className="appendix-reference small text-muted mt-3">
                                    {block.reference}
                                </div>
                            )}
                        </div>
                    );
                case 'sub-section':
                    return (
                        <div key={index} className={`sub-section-block ${block.variant || 'default'}`}>
                            <h2 className="sub-section-title">{block.title}</h2>

                            {block.content.map((contentBlock, idx) => {
                                switch (contentBlock.type) {
                                    case 'text':
                                        return (
                                            <div key={idx} className="sub-section-text">
                                                {contentBlock.content || contentBlock.value ? (
                                                    <ReactMarkdown components={markdownComponents}>
                                                        {contentBlock.content || contentBlock.value}
                                                    </ReactMarkdown>
                                                ) : null}
                                            </div>
                                        );

                                    case 'key-points':
                                        return (
                                            <div key={idx} className="key-points-section">
                                                {contentBlock.title && (
                                                    <h3 className="key-points-title">
                                                        {contentBlock.icon && <i className={`key-points-icon ${contentBlock.icon}`}></i>}
                                                        {contentBlock.title}
                                                    </h3>
                                                )}

                                                <div className="key-points-grid">
                                                    {contentBlock.items?.map((item, itemIndex) => (
                                                        <div key={itemIndex} className={`key-point-card ${item.type || 'info'}`}>
                                                            <div className="key-point-header">
                                                                {item.icon && (
                                                                    <div className="key-point-icon">
                                                                        <i className={item.icon}></i>
                                                                    </div>
                                                                )}
                                                                <h4 className="key-point-title">{item.title}</h4>
                                                            </div>
                                                            <div className="key-point-content">
                                                                <p className="key-point-description">{item.description}</p>
                                                                {item.details && (
                                                                    <div className="key-point-details">
                                                                        <ReactMarkdown components={markdownComponents}>
                                                                            {item.details}
                                                                        </ReactMarkdown>
                                                                    </div>
                                                                )}
                                                                {item.stats && (
                                                                    <div className="key-point-stats">
                                                                        {Object.entries(item.stats).map(([key, value]) => (
                                                                            <div key={key} className="stat-item">
                                                                                <span className="stat-value">{value}</span>
                                                                                <span className="stat-label">{key}</span>
                                                                            </div>
                                                                        ))}
                                                                    </div>
                                                                )}
                                                            </div>
                                                        </div>
                                                    ))}
                                                </div>
                                            </div>
                                        );

                                    case 'example':
                                        return (
                                            <div key={idx} className={`example-block ${contentBlock.layout || 'default'}`}>
                                                <div className="example-header">
                                                    {contentBlock.icon && <i className={`example-icon ${contentBlock.icon}`}></i>}
                                                    <span className="example-title">
                                        {contentBlock.title || 'Example'}
                                                        {contentBlock.type === 'do' && (
                                                            <span className="example-type-badge badge bg-success">Do</span>
                                                        )}
                                                        {contentBlock.type === 'dont' && (
                                                            <span className="example-type-badge badge bg-danger">Don't</span>
                                                        )}
                                    </span>
                                                </div>

                                                <div className="example-content">
                                                    {/* Simple text content */}
                                                    {contentBlock.content && (
                                                        <ReactMarkdown components={markdownComponents}>
                                                            {contentBlock.content}
                                                        </ReactMarkdown>
                                                    )}

                                                    {/* Scenario-based content */}
                                                    {contentBlock.scenario && (
                                                        <div className="example-scenario">
                                                            {contentBlock.scenario && (
                                                                <div className="scenario-item">
                                                                    <strong>Scenario:</strong> {contentBlock.scenario}
                                                                </div>
                                                            )}
                                                            {contentBlock.problem && (
                                                                <div className="scenario-item">
                                                                    <strong>Problem:</strong> {contentBlock.problem}
                                                                </div>
                                                            )}
                                                            {contentBlock.solution && (
                                                                <div className="scenario-item">
                                                                    <strong>Solution:</strong> {contentBlock.solution}
                                                                </div>
                                                            )}
                                                            {contentBlock.prevention && (
                                                                <div className="scenario-item">
                                                                    <strong>Prevention:</strong> {contentBlock.prevention}
                                                                </div>
                                                            )}
                                                            {contentBlock.details && (
                                                                <div className="scenario-details">
                                                                    <ReactMarkdown components={markdownComponents}>
                                                                        {contentBlock.details}
                                                                    </ReactMarkdown>
                                                                </div>
                                                            )}
                                                        </div>
                                                    )}

                                                    {/* Code content */}
                                                    {contentBlock.code && (
                                                        <div className="example-code">
                                                            <SyntaxHighlighter
                                                                language={contentBlock.language || 'javascript'}
                                                                style={atomDark}
                                                                showLineNumbers={contentBlock.showLineNumbers}
                                                            >
                                                                {contentBlock.code}
                                                            </SyntaxHighlighter>
                                                        </div>
                                                    )}

                                                    {/* Note */}
                                                    {contentBlock.note && (
                                                        <div className="example-note">
                                                            <i className="fas fa-lightbulb"></i> {contentBlock.note}
                                                        </div>
                                                    )}
                                                </div>
                                            </div>
                                        );



                                    case 'best-practices':
                                        return (
                                            <div key={idx} className="best-practices-section">
                                                <h3 className="best-practices-title">{contentBlock.title}</h3>
                                                <div className="best-practices-grid">
                                                    {Array.isArray(contentBlock?.items) &&
                                                      contentBlock.items.map((item, itemIndex) => (
                                                        <div key={itemIndex} className="best-practice-card">
                                                          <h4 className="practice-title">{item.practice}</h4>
                                                          <p className="practice-benefit">{item.benefit}</p>
                                                          <p className="practice-implementation">{item.implementation}</p>
                                                        </div>
                                                      ))
                                                    }
                                                </div>
                                            </div>
                                        );




                                    case 'strategy-grid':
                                        return (
                                            <div key={idx} className="strategy-grid-section">
                                                <h3 className="strategy-grid-title">{contentBlock.title}</h3>
                                                <div className="strategy-grid-wrapper">
                                                    <table className="strategy-grid">
                                                        <thead>
                                                        <tr>
                                                            {contentBlock.columns?.map((col, colIndex) => (
                                                                <th key={colIndex}>{col}</th>
                                                            ))}
                                                        </tr>
                                                        </thead>
                                                        <tbody>
                                                        {contentBlock.rows?.map((row, rowIndex) => (
                                                            <tr key={rowIndex}>
                                                                {row.map((cell, cellIndex) => (
                                                                    <td key={cellIndex}>{cell}</td>
                                                                ))}
                                                            </tr>
                                                        ))}
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>
                                        );



                                        case 'formula':
                                            return (
                                                <div key={idx} className="formula-section">
                                                    <h3 className="formula-title">{contentBlock.title}</h3>
                                                    <div className="formula-content">
                                                        {contentBlock.content.split('\n\n').map((formulaGroup, groupIndex) => {
                                                            // Parse bold headers and formula content
                                                            const lines = formulaGroup.split('\n');
                                                            const formulaHeader = lines[0].replace(/\*\*/g, '');
                                                            const formulaLines = lines.slice(1);

                                                            return (
                                                                <div key={groupIndex} className="formula-group">
                                                                    <div className="formula-header">
                                                                        <h4 className="formula-name">{formulaHeader}</h4>
                                                                    </div>
                                                                    <div className="formula-details">
                                                                        {formulaLines.map((line, lineIndex) => {
                                                                            if (line.includes('Example:')) {
                                                                                return (
                                                                                    <div key={lineIndex} className="formula-example">
                                                                                        <span className="example-label">Example:</span>
                                                                                        <span className="example-value">{line.replace('Example: ', '')}</span>
                                                                                    </div>
                                                                                );
                                                                            } else if (line.includes('Where:')) {
                                                                                return (
                                                                                    <div key={lineIndex} className="formula-conditions">
                                                                                        <span className="conditions-label">Where:</span>
                                                                                        <ul className="conditions-list">
                                                                                            {line.replace('Where:', '').split('\n').slice(1).map((condition, condIndex) => (
                                                                                                <li key={condIndex} className="condition-item">
                                                                                                    {condition.trim()}
                                                                                                </li>
                                                                                            ))}
                                                                                        </ul>
                                                                                    </div>
                                                                                );
                                                                            } else if (line.trim()) {
                                                                                return (
                                                                                    <div key={lineIndex} className="formula-equation">
                                                                                        <code className="equation-code">{line}</code>
                                                                                    </div>
                                                                                );
                                                                            }
                                                                            return null;
                                                                        })}
                                                                    </div>
                                                                </div>
                                                            );
                                                        })}
                                                    </div>
                                                </div>
                                            );

                                    case 'visualization':
                                        return (
                                            <div key={idx} className="visualization-section">
                                                <h3 className="visualization-title">{contentBlock.title}</h3>
                                                <div className="visualization-content">
                                    <pre className="visualization-pre">
                                        {contentBlock.content}
                                    </pre>
                                                </div>
                                            </div>
                                        );

                                    case 'process':
                                        return (
                                            <div key={idx} className="process-section">
                                                <h3 className="process-title">{contentBlock.title}</h3>
                                                <div className="process-steps">
                                                    {contentBlock.steps?.map((step, stepIndex) => (
                                                        <div key={stepIndex} className="process-step">
                                                            <div className="process-step-number">{stepIndex + 1}</div>
                                                            <div className="process-step-content">
                                                                <h4>{step.step}</h4>
                                                                <p>{step.details}</p>
                                                            </div>
                                                        </div>
                                                    ))}
                                                </div>
                                            </div>
                                        );

                                    case 'metrics':
                                        return (
                                            <div key={idx} className="metrics-section">
                                                <h3 className="metrics-title">{contentBlock.title}</h3>
                                                <div className="metrics-grid">
                                                    {contentBlock.items?.map((item, itemIndex) => (
                                                        <div key={itemIndex} className="metric-card">
                                                            <div className="metric-header">
                                                                <h4>{item.metric}</h4>
                                                            </div>
                                                            <div className="metric-content">
                                                                <div className="metric-target">
                                                                    <strong>Target:</strong> {item.target}
                                                                </div>
                                                                <div className="metric-measurement">
                                                                    <strong>Measurement:</strong> {item.measurement}
                                                                </div>
                                                            </div>
                                                        </div>
                                                    ))}
                                                </div>
                                            </div>
                                        );

                                    case 'pattern-grid':
                                        return (
                                            <div key={idx} className="pattern-grid-section">
                                                <h3 className="pattern-grid-title">{contentBlock.title}</h3>
                                                <div className="pattern-grid-wrapper">
                                                    <table className="pattern-grid">
                                                        <thead>
                                                        <tr>
                                                            {contentBlock.columns?.map((col, colIndex) => (
                                                                <th key={colIndex}>{col}</th>
                                                            ))}
                                                        </tr>
                                                        </thead>
                                                        <tbody>
                                                        {contentBlock.rows?.map((row, rowIndex) => (
                                                            <tr key={rowIndex}>
                                                                {row.map((cell, cellIndex) => (
                                                                    <td key={cellIndex}>{cell}</td>
                                                                ))}
                                                            </tr>
                                                        ))}
                                                        </tbody>
                                                    </table>
                                                </div>
                                            </div>
                                        );



                                    case 'integration-example':
                                        return (
                                            <div key={idx} className="integration-example-section">
                                                <h3 className="integration-example-title">{contentBlock.title}</h3>
                                                <div className="integration-example-content">
                                                    {contentBlock.content && (
                                                        <ReactMarkdown components={markdownComponents}>
                                                            {contentBlock.content}
                                                        </ReactMarkdown>
                                                    )}
                                                    {contentBlock.diagram && (
                                                        <div className="integration-diagram">
                                                            <pre>{contentBlock.diagram}</pre>
                                                        </div>
                                                    )}
                                                </div>
                                            </div>
                                        );

                                    case 'best-practices-summary':
                                        return (
                                            <div key={idx} className="best-practices-summary-section">
                                                <h3 className="best-practices-summary-title">{contentBlock.title}</h3>
                                                <div className="best-practices-summary-grid">
                                                    {contentBlock.items?.map((item, itemIndex) => (
                                                        <div key={itemIndex} className="best-practice-summary-card">
                                                            <h4 className="practice-title">{item.practice}</h4>
                                                            <div className="practice-rationale">
                                                                <strong>Rationale:</strong> {item.rationale}
                                                            </div>
                                                            <div className="practice-implementation">
                                                                <strong>Implementation:</strong> {item.implementation}
                                                            </div>
                                                        </div>
                                                    ))}
                                                </div>
                                            </div>
                                        );

                                    case 'action-plan':
                                        return (
                                            <div key={idx} className="action-plan-section">
                                                <h3 className="action-plan-title">{contentBlock.title}</h3>
                                                <div className="action-plan-weeks">
                                                    {contentBlock.weeks?.map((week, weekIndex) => (
                                                        <div key={weekIndex} className="action-plan-week">
                                                            <h4 className="week-title">{week.week}</h4>
                                                            <ul className="week-tasks">
                                                                {week.tasks?.map((task, taskIndex) => (
                                                                    <li key={taskIndex}>{task}</li>
                                                                ))}
                                                            </ul>
                                                        </div>
                                                    ))}
                                                </div>
                                            </div>
                                        );




               case 'narrative-section':
                    return (
                        <section key={index} className="narrative-section mb-5">
                            {block.title && <h2 className="narrative-title mb-4">{block.title}</h2>}
                            <div className="narrative-content">
                                {block.narrative?.map((item, idx) => {
                                    switch (item.type) {
                                        case 'paragraph':
                                            return (
                                                <div key={idx} className="narrative-paragraph mb-3">
                                                    <p>{item.content}</p>
                                                    {item.subpoints && (
                                                        <ul className="subpoints mt-2 ps-4">
                                                            {item.subpoints.map((point, i) => (
                                                                <li key={i}>{point}</li>
                                                            ))}
                                                        </ul>
                                                    )}
                                                </div>
                                            );

                                        case 'visual':
                                            if (item.contentType === 'image') {
                                                return (
                                                    <figure key={idx} className="narrative-visual text-center my-4">
                                                        <img
                                                            src={item.src}
                                                            alt={item.caption || ''}
                                                            className="img-fluid rounded"
                                                            style={{ maxHeight: '400px' }}
                                                        />
                                                        {item.caption && (
                                                            <figcaption className="mt-2 text-muted">
                                                                {item.caption}
                                                            </figcaption>
                                                        )}
                                                    </figure>
                                                );
                                            }
                                            return null;

                                        default:
                                            return null;
                                    }
                                })}
                            </div>
                        </section>
                    );
                    case 'exercise':
                                                            return (
                                                                <div key={idx} className="exercise-section">
                                                                    <h3 className="exercise-title">{contentBlock.title}</h3>
                                                                    <div className="exercise-content">
                                                                        {contentBlock.content?.map((exerciseBlock, exerciseIdx) => {
                                                                            switch (exerciseBlock.type) {
                                                                                case 'objective':
                                                                                    return (
                                                                                        <div key={exerciseIdx} className="exercise-objective">
                                                                                            <h4>Objective</h4>
                                                                                            <p>{exerciseBlock.content}</p>
                                                                                        </div>
                                                                                    );
                                                                                case 'requirements':
                                                                                    return (
                                                                                        <div key={exerciseIdx} className="exercise-requirements">
                                                                                            <h4>Requirements</h4>
                                                                                            <ul>
                                                                                                {exerciseBlock.items?.map((item, reqIdx) => (
                                                                                                    <li key={reqIdx}>{item}</li>
                                                                                                ))}
                                                                                            </ul>
                                                                                        </div>
                                                                                    );
                                                                                case 'deliverables':
                                                                                    return (
                                                                                        <div key={exerciseIdx} className="exercise-deliverables">
                                                                                            <h4>Deliverables</h4>
                                                                                            <ul>
                                                                                                {exerciseBlock.items?.map((item, delIdx) => (
                                                                                                    <li key={delIdx}>{item}</li>
                                                                                                ))}
                                                                                            </ul>
                                                                                        </div>
                                                                                    );
                                                                                case 'success-criteria':
                                                                                    return (
                                                                                        <div key={exerciseIdx} className="exercise-success-criteria">
                                                                                            <h4>Success Criteria</h4>
                                                                                            <ul>
                                                                                                {exerciseBlock.items?.map((item, critIdx) => (
                                                                                                    <li key={critIdx}>{item}</li>
                                                                                                ))}
                                                                                            </ul>
                                                                                        </div>
                                                                                    );
                                                                                default:
                                                                                    return null;
                                                                            }
                                                                        })}
                                                                    </div>
                                                                </div>
                                                            );

                                                        default:
                                                            console.warn(`Unhandled content type: ${contentBlock.type}`);
                                                            return null;
                                                    }
                                                })}
                                            </div>
                                        );


                case 'concept-explainer':
                    return (
                        <div key={index} className="concept-explainer card my-4">
                            <div className="card-body">
                                <h3 className="card-title">{block.title}</h3>
                                <div className="concept-level mb-3">
                                    <span className="badge bg-primary">Level: {block.difficulty}</span>
                                </div>
                                <ReactMarkdown components={markdownComponents}>
                                    {block.explanation}
                                </ReactMarkdown>
                                {block.analogy && (
                                    <div className="concept-analogy alert alert-light mt-3">
                                        <strong>Analogy: </strong>{block.analogy}
                                    </div>
                                )}
                            </div>
                        </div>
                    );
                    case 'exercise':
                        return (
                            <div key={index} className="exercise-container card my-4">
                                {/* Header */}
                                <div className="card-header bg-light">
                                    <h4 className="mb-0">
                                        <i className="fas fa-pencil-alt me-2 text-primary"></i>
                                        {block.title}
                                    </h4>
                                </div>

                                <div className="card-body">
                                    {/* Instructions */}
                                    <div className="mb-4">
                                        <h5 className="d-flex align-items-center">
                                            <i className="fas fa-info-circle text-info me-2"></i>
                                            Instructions
                                        </h5>
                                        <div className="p-3 bg-light rounded">
                                            <p className="mb-0">{block.instructions}</p>
                                        </div>
                                    </div>

                                    {/* Scenarios */}
                                    <div className="mb-4">
                                        <h5 className="d-flex align-items-center">
                                            <i className="fas fa-list-ol text-success me-2"></i>
                                            Scenarios to Practice
                                        </h5>
                                        <div className="p-3 border rounded">
                                            <ReactMarkdown>{block.startingPoint}</ReactMarkdown>
                                        </div>
                                    </div>

                                    {/* Task Input Areas */}
                                    <div className="mb-4">
                                        <h5 className="d-flex align-items-center mb-3">
                                            <i className="fas fa-tasks text-warning me-2"></i>
                                            Your Responses
                                        </h5>

                                        {/* Create input areas for each scenario */}
                                        {(() => {
                                            // Extract scenario numbers from startingPoint
                                            const scenarios = block.startingPoint.match(/\d+\.\s+\*\*.*?\*\*:.*/g) || [];
                                            return scenarios.map((scenario, idx) => {
                                                const match = scenario.match(/\d+\.\s+\*\*(.*?)\*\*:\s*(.*)/);
                                                if (!match) return null;

                                                const [, scenarioName, description] = match;
                                                return (
                                                    <div key={idx} className="mb-3">
                                                        <div className="mb-2">
                                                            <strong>Scenario {idx + 1}: {scenarioName}</strong>
                                                            <div className="text-muted small">{description}</div>
                                                        </div>
                                                        <textarea
                                                            className="form-control"
                                                            rows="2"
                                                            placeholder={`Write your response to "${scenarioName}"...`}
                                                        ></textarea>
                                                    </div>
                                                );
                                            });
                                        })()}
                                    </div>

                                    {/* Expected Output */}
                                    <div className="alert alert-light">
                                        <h6 className="d-flex align-items-center">
                                            <i className="fas fa-check-circle text-success me-2"></i>
                                            Success Criteria
                                        </h6>
                                        <p className="mb-0">{block.expectedOutput}</p>
                                    </div>

                                    {/* Action Buttons */}
                                    <div className="d-flex gap-2 mt-4">
                                        <button className="btn btn-primary">
                                            <i className="fas fa-check me-2"></i>
                                            Submit Practice
                                        </button>
                                        <button className="btn btn-outline-secondary">
                                            <i className="fas fa-eye me-2"></i>
                                            View Example Answers
                                        </button>
                                        <button className="btn btn-outline-secondary">
                                            <i className="fas fa-redo me-2"></i>
                                            Clear All
                                        </button>
                                    </div>
                                </div>
                            </div>
                        );

                case 'cheat-sheet':
                    return (
                        <div key={index} className="cheat-sheet card border-warning my-4">
                            <div className="card-header bg-warning bg-opacity-10">
                                <h3 className="card-title">{block.title}</h3>
                            </div>
                            <div className="card-body">
                                <ul className="list-group list-group-flush">
                                    {block.items.map((item, i) => (
                                        <li key={i} className="list-group-item d-flex justify-content-between align-items-start">
                                            <div className="ms-2 me-auto">
                                                <div className="fw-bold">{item.term}</div>
                                                {item.description}
                                            </div>
                                            {item.example && (
                                                <span className="badge bg-primary rounded-pill">Ex</span>
                                            )}
                                        </li>
                                    ))}
                                </ul>
                            </div>
                        </div>
                    );

                case 'case-study':
                    return (
                        <div key={index} className="case-study card my-4">
                            <div className="card-body">
                                {block.title && <h3 className="card-title">{block.title}</h3>}

                                {/* Handle metrics if present */}
                                {block.metrics && (
                                    <div className="case-study-meta mb-3">
                                        {typeof block.metrics === 'object' ? (
                                            Object.entries(block.metrics).map(([key, value]) => (
                                                <span key={key} className="badge bg-secondary me-2">
                                                    {key}: {value}
                                                </span>
                                            ))
                                        ) : (
                                            <span className="badge bg-secondary">{block.metrics}</span>
                                        )}
                                    </div>
                                )}

                                {/* Handle examples array if present */}
                                {block.examples && Array.isArray(block.examples) && (
                                    <div className="case-study-examples">
                                        {block.examples.map((example, i) => (
                                            <div key={i} className="example-item mb-3">
                                                <h5>{example.name}</h5>
                                                {example.description && <p>{example.description}</p>}
                                                {example.lesson && (
                                                    <div className="alert alert-light">
                                                        <strong>Lesson:</strong> {example.lesson}
                                                    </div>
                                                )}
                                            </div>
                                        ))}
                                    </div>
                                )}

                                {/* Handle single example object if present */}
                                {block.example && typeof block.example === 'object' && (
                                    <div className="case-study-example mb-3">
                                        <h5>{block.example.name || block.example.title}</h5>
                                        {block.example.description && <p>{block.example.description}</p>}
                                        {block.example.lesson && (
                                            <div className="alert alert-light">
                                                <strong>Lesson:</strong> {block.example.lesson}
                                            </div>
                                        )}
                                    </div>
                                )}

                                {/* Handle phases array if present */}
                                {block.phases && Array.isArray(block.phases) && (
                                    <div className="case-study-phases mt-3">
                                        <h5>Implementation Phases</h5>
                                        <ul className="list-group">
                                            {block.phases.map((phase, i) => (
                                                <li key={i} className="list-group-item">
                                                    <strong>{phase.name || phase.phase}:</strong> {phase.activity || phase.description}
                                                </li>
                                            ))}
                                        </ul>
                                    </div>
                                )}

                                {/* Handle analysis array if present */}
                                {block.analysis && Array.isArray(block.analysis) && (
                                    <div className="case-study-analysis mt-3">
                                        <h5>Analysis</h5>
                                        <ul>
                                            {block.analysis.map((item, i) => (
                                                <li key={i}>
                                                    <strong>{item.failure || item.issue}:</strong> {item.stlcSolution || item.solution}
                                                </li>
                                            ))}
                                        </ul>
                                    </div>
                                )}

                                {/* Handle lessons array if present */}
                                {block.lessons && Array.isArray(block.lessons) && (
                                    <div className="case-study-lessons alert alert-light mt-3">
                                        <h5>Key Lessons</h5>
                                        <ul>
                                            {block.lessons.map((lesson, i) => (
                                                <li key={i}>{lesson}</li>
                                            ))}
                                        </ul>
                                    </div>
                                )}

                                {/* Handle scenario/decisions format */}
                                {block.scenario && (
                                    <div className="case-study-scenario mt-3">
                                        <h5>Scenario</h5>
                                        <p>{block.scenario}</p>
                                        {block.decisions && Array.isArray(block.decisions) && (
                                            <div className="case-study-decisions mt-2">
                                                <h6>Key Decisions:</h6>
                                                <ul className="list-group">
                                                    {block.decisions.map((decision, i) => (
                                                        <li key={i} className="list-group-item">
                                                            <strong>{decision.aspect}:</strong> {decision.detail}
                                                        </li>
                                                    ))}
                                                </ul>
                                            </div>
                                        )}
                                    </div>
                                )}
                            </div>
                        </div>
                    );

                case 'video-tutorial':
                    return (
                        <div key={index} className="video-tutorial card my-4">
                            <div className="ratio ratio-16x9">
                                <iframe
                                    src={block.embedUrl}
                                    title={block.title}
                                    allowFullScreen
                                ></iframe>
                            </div>
                            <div className="card-body">
                                <h3 className="card-title">{block.title}</h3>
                                <div className="video-meta mb-2">
                                    <span className="text-muted me-3">Duration: {block.duration}</span>
                                    <span className="text-muted">Skill Level: {block.level}</span>
                                </div>
                                <ReactMarkdown components={markdownComponents}>
                                    {block.description}
                                </ReactMarkdown>
                            </div>
                        </div>
                    );

                case 'decision-tree':
                    return (
                        <div key={index} className="decision-tree card my-4">
                            <div className="card-body">
                                <h3 className="card-title">{block.title}</h3>
                                <div className="decision-tree-container">
                                    {block.nodes.map((node, i) => (
                                        <div key={i} className={`decision-node ${node.isRoot ? 'root-node' : ''}`}>
                                            <div className="node-question p-3 bg-light rounded">
                                                {node.question}
                                            </div>
                                            <div className="node-options mt-2">
                                                {node.options.map((option, j) => (
                                                    <div key={j} className="node-option ps-4 my-2">
                                                        → {option.answer} {option.result &&
                                                        <span className="badge bg-success ms-2">Result</span>}
                                                    </div>
                                                ))}
                                            </div>
                                        </div>
                                    ))}
                                </div>
                            </div>
                        </div>
                    );
                    case 'metrics-dashboard':
                        return (
                            <div key={index} className="metrics-dashboard-container my-4">
                                {block.title && (
                                    <h4 className="mb-4">{block.title}</h4>
                                )}

                                <div className="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                                    {(block.content || []).map((metric, i) => (
                                        <div key={i} className="col">
                                            <div className="card h-100 shadow-sm border-0">
                                                <div className="card-body d-flex flex-column">

                                                    {metric.name && (
                                                        <h5 className="card-title mb-2">
                                                            {metric.name}
                                                        </h5>
                                                    )}

                                                    {metric.description && (
                                                        <p className="text-muted mb-2">
                                                            {metric.description}
                                                        </p>
                                                    )}

                                                    {metric.target && (
                                                        <div className="mb-2">
                                                            <span className="badge bg-primary">
                                                                Target: {metric.target}
                                                            </span>
                                                        </div>
                                                    )}

                                                    {metric.insight && (
                                                        <p className="small text-muted mt-auto mb-0">
                                                            💡 {metric.insight}
                                                        </p>
                                                    )}

                                                </div>
                                            </div>
                                        </div>
                                    ))}
                                </div>
                            </div>
                        );

                    case 'qa-list':
                        return (
                            <div key={index} className="qa-list-container my-4">
                                {block.title && (
                                    <h4 className="mb-4">{block.title}</h4>
                                )}

                                <div className="accordion" id={`qaAccordion-${index}`}>
                                    {(block.questions || []).map((qa, i) => {
                                        const collapseId = `qa-${index}-${i}`;

                                        return (
                                            <div key={i} className="accordion-item border-0 shadow-sm mb-3 rounded">
                                                <h2 className="accordion-header">
                                                    <button
                                                        className="accordion-button collapsed fw-semibold"
                                                        type="button"
                                                        data-bs-toggle="collapse"
                                                        data-bs-target={`#${collapseId}`}
                                                    >
                                                        {qa.question}
                                                    </button>
                                                </h2>

                                                <div
                                                    id={collapseId}
                                                    className="accordion-collapse collapse"
                                                    data-bs-parent={`#qaAccordion-${index}`}
                                                >
                                                    <div className="accordion-body text-muted">
                                                        {qa.answer}
                                                    </div>
                                                </div>
                                            </div>
                                        );
                                    })}
                                </div>
                            </div>
                        );


                case 'interactive-lab':
                    return (
                        <div key={index} className="interactive-lab card my-4">
                            <div className="card-body">
                                <h3 className="card-title">{block.title}</h3>
                                <div className="lab-description mb-3">
                                    <ReactMarkdown components={markdownComponents}>
                                        {block.description}
                                    </ReactMarkdown>
                                </div>
                                <div className="lab-environment p-3 bg-light rounded">
                                    <h5>Environment Setup</h5>
                                    <pre><code>{block.environmentSetup}</code></pre>
                                </div>
                                <div className="lab-actions mt-3">
                                    <button className="btn btn-primary me-2">Run Code</button>
                                    <button className="btn btn-outline-secondary">Reset</button>
                                </div>
                            </div>
                        </div>
                    );

                case 'qa':
                    return (
                        <div key={index} className="qa card my-4">
                            <div className="card-body">
                                <h3 className="card-title">{block.title}</h3>
                                <div className="accordion" id={`qaAccordion-${index}`}>
                                    {block.questions.map((q, i) => (
                                        <div key={i} className="accordion-item">
                                            <h4 className="accordion-header">
                                                <button
                                                    className="accordion-button collapsed"
                                                    type="button"
                                                    data-bs-toggle="collapse"
                                                    data-bs-target={`#qaCollapse-${index}-${i}`}
                                                >
                                                    {q.question}
                                                </button>
                                            </h4>
                                            <div
                                                id={`qaCollapse-${index}-${i}`}
                                                className="accordion-collapse collapse"
                                                data-bs-parent={`#qaAccordion-${index}`}
                                            >
                                                <div className="accordion-body">
                                                    <ReactMarkdown components={markdownComponents}>
                                                        {q.answer}
                                                    </ReactMarkdown>
                                                </div>
                                            </div>
                                        </div>
                                    ))}
                                </div>
                            </div>
                        </div>
                    );

                case 'project':
                    return (
                        <div key={index} className="project card my-4">
                            <div className="card-body">
                                <h3 className="card-title">{block.title}</h3>
                                <div className="project-meta mb-3">
                                    <span className="badge bg-primary me-2">Tech: {block.technology}</span>
                                    <span className="badge bg-secondary">Duration: {block.duration}</span>
                                </div>
                                <h5>Objectives</h5>
                                <ul>
                                    {block.objectives.map((obj, i) => (
                                        <li key={i}>{obj}</li>
                                    ))}
                                </ul>
                                <h5>Steps</h5>
                                <ol>
                                    {block.steps.map((step, i) => (
                                        <li key={i}>
                                            <strong>{step.title}: </strong>
                                            {step.description}
                                        </li>
                                    ))}
                                </ol>
                            </div>
                        </div>
                    );

                case 'expert-discussion':
                    return (
                        <div key={index} className="expert-discussion card my-4">
                            <div className="card-body">
                                <h3 className="card-title">{block.title}</h3>
                                <div className="participants mb-3">
                                    {block.participants.map((p, i) => (
                                        <span key={i} className="badge bg-info me-2">{p}</span>
                                    ))}
                                </div>
                                <div className="discussion-content">
                                    {block.transcript.map((item, i) => (
                                        <div key={i} className={`message ${item.role === 'expert' ? 'expert-message' : 'moderator-message'}`}>
                                            <strong>{item.speaker}: </strong>
                                            {item.content}
                                        </div>
                                    ))}
                                </div>
                                <div className="key-takeaways mt-3">
                                    <h5>Key Takeaways</h5>
                                    <ul>
                                        {block.keyTakeaways.map((takeaway, i) => (
                                            <li key={i}>{takeaway}</li>
                                        ))}
                                    </ul>
                                </div>
                            </div>
                        </div>
                    );

                case 'quote':
                    return (
                        <blockquote key={index} className="quote-block my-4 p-3 bg-light border-start border-5 border-primary">
                            <div className="quote-content">
                                <i className="fas fa-quote-left me-2 text-muted"></i>
                                <ReactMarkdown components={markdownComponents}>
                                    {block.text}
                                </ReactMarkdown>
                            </div>
                            {block.source && (
                                <footer className="quote-footer mt-2 text-end text-muted">
                                    — {block.source}
                                    {block.context && (
                                        <span className="quote-context small d-block">{block.context}</span>
                                    )}
                                </footer>
                            )}
                        </blockquote>
                    );

                case 'heading':
                    return (
                        <div
                            key={index}
                            className={`heading-wrapper ${block.divider ? 'with-divider' : ''}`}
                            style={{ textAlign: block.align || 'left' }}
                        >
                            {block.level === 1 && (
                                <h1 className="heading-1 my-4">
                                    {block.icon && <i className={`me-2 ${block.icon}`}></i>}
                                    {block.text}
                                    {block.badge && (
                                        <span className="heading-badge ms-2 badge bg-primary">
                                            {block.badge}
                                        </span>
                                    )}
                                </h1>
                            )}
                            {block.level === 2 && (
                                <h2 className="heading-2 my-3">
                                    {block.icon && <i className={`me-2 ${block.icon}`}></i>}
                                    {block.text}
                                    {block.subtext && (
                                        <small className="heading-subtext ms-2 text-muted">
                                            {block.subtext}
                                        </small>
                                    )}
                                </h2>
                            )}
                            {block.level === 3 && (
                                <h3 className="heading-3 my-2">
                                    {block.text}
                                    {block.tooltip && (
                                        <sup>
                                            <i
                                                className="fas fa-info-circle ms-1 text-info"
                                                data-bs-toggle="tooltip"
                                                title={block.tooltip}
                                            ></i>
                                        </sup>
                                    )}
                                </h3>
                            )}
                        </div>
                    );

                case 'example':
                    return (
                        <div key={index} className={`example-block ${block.variant || 'default'}`}>
                            <div className="example-header">
                                {block.icon && <i className={`example-icon ${block.icon}`}></i>}
                                <span className="example-title">
                                    {block.title || (block.type === 'do' ? 'Best Practice' : 'Example')}
                                    {block.language && (
                                        <span className="example-language badge rounded-pill">
                                            {block.language}
                                        </span>
                                    )}
                                </span>
                            </div>

                            <div className="example-content">
                                {block.code ? (
                                    <SyntaxHighlighter
                                        language={block.language || 'javascript'}
                                        style={atomDark}
                                        showLineNumbers={block.showLineNumbers}
                                    >
                                        {block.code}
                                    </SyntaxHighlighter>
                                ) : (
                                    <ReactMarkdown components={markdownComponents}>
                                        {block.content}
                                    </ReactMarkdown>
                                )}
                            </div>

                            {block.description && (
                                <div className="example-description">
                                    <ReactMarkdown components={markdownComponents}>
                                        {block.description}
                                    </ReactMarkdown>
                                </div>
                            )}

                            {block.note && (
                                <div className="example-note">
                                    <i className="fas fa-lightbulb"></i> {block.note}
                                </div>
                            )}
                        </div>
                    );
                case 'key-points':
                    return (
                        <div key={index} className="key-points-section">
                            {block.title && (
                                <h3 className="key-points-title">
                                    {block.icon && <i className={`key-points-icon ${block.icon}`}></i>}
                                    {block.title}
                                </h3>
                            )}

                            <div className="key-points-grid">
                                {block.items?.map((item, itemIndex) => (
                                    <div
                                        key={itemIndex}
                                        className={`key-point-card ${item.type || 'info'}`}
                                        data-priority={item.priority || 'medium'}
                                    >
                                        <div className="key-point-header">
                                            {item.icon && (
                                                <div className="key-point-icon">
                                                    <i className={item.icon}></i>
                                                </div>
                                            )}
                                            {!item.icon && (
                                                <div className="key-point-bullet">
                                                    <span>{itemIndex + 1}</span>
                                                </div>
                                            )}
                                            <h4 className="key-point-title">
                                                {item.title}
                                                {item.badge && (
                                                    <span className="key-point-badge">
                                        {item.badge}
                                    </span>
                                                )}
                                            </h4>
                                        </div>

                                        <div className="key-point-content">
                                            <p className="key-point-description">{item.description}</p>

                                            {item.details && (
                                                <div className="key-point-details">
                                                    <ReactMarkdown components={markdownComponents}>
                                                        {item.details}
                                                    </ReactMarkdown>
                                                </div>
                                            )}

                                            {item.example && (
                                                <div className="key-point-example">
                                                    <strong>Example:</strong> {item.example}
                                                </div>
                                            )}

                                            {item.code && (
                                                <div className="key-point-code">
                                                    <SyntaxHighlighter
                                                        language={item.language || 'javascript'}
                                                        style={atomDark}
                                                        lineProps={{style: {wordBreak: 'break-all', whiteSpace: 'pre-wrap'}}}
                                                        wrapLines={true}
                                                    >
                                                        {item.code}
                                                    </SyntaxHighlighter>
                                                </div>
                                            )}

                                            {item.stats && (
                                                <div className="key-point-stats">
                                                    {Object.entries(item.stats).map(([key, value]) => (
                                                        <div key={key} className="stat-item">
                                                            <span className="stat-value">{value}</span>
                                                            <span className="stat-label">{key}</span>
                                                        </div>
                                                    ))}
                                                </div>
                                            )}
                                        </div>

                                        {item.actions && (
                                            <div className="key-point-actions">
                                                {item.actions.map((action, actionIndex) => (
                                                    <button
                                                        key={actionIndex}
                                                        className={`btn btn-sm ${action.variant || 'outline-primary'}`}
                                                        onClick={() => action.onClick && action.onClick(item)}
                                                    >
                                                        {action.icon && <i className={`me-2 ${action.icon}`}></i>}
                                                        {action.label}
                                                    </button>
                                                ))}
                                            </div>
                                        )}

                                        {item.tags && (
                                            <div className="key-point-tags">
                                                {item.tags.map((tag, tagIndex) => (
                                                    <span key={tagIndex} className="badge bg-secondary me-1">
                                        {tag}
                                    </span>
                                                ))}
                                            </div>
                                        )}
                                    </div>
                                ))}
                            </div>

                            {block.footer && (
                                <div className="key-points-footer">
                                    <ReactMarkdown components={markdownComponents}>
                                        {block.footer}
                                    </ReactMarkdown>
                                </div>
                            )}
                        </div>
                    );

                case 'subsection':
                    return (
                        <div key={index} className={`subsection ${block.collapsible ? 'collapsible' : ''}`}>
                            <div
                                className="subsection-header d-flex justify-content-between align-items-center"
                                onClick={block.collapsible ? () => toggleCollapse(index) : undefined}
                            >
                                <h3 className="subsection-title">
                                    {block.icon && <i className={`${block.icon} me-2`}></i>}
                                    {block.title}
                                    {block.status && (
                                        <span className={`status-badge ms-2 badge ${getStatusBadgeClass(block.status)}`}>
                                            {block.status}
                                        </span>
                                    )}
                                </h3>
                                {block.collapsible && (
                                    <i className={`fas ${isCollapsed(index) ? 'fa-chevron-down' : 'fa-chevron-up'}`}></i>
                                )}
                            </div>

                            {(!block.collapsible || !isCollapsed(index)) && (
                                <div className="subsection-content">
                                    <ContentRenderer content={block.content} />
                                    {block.footer && (
                                        <div className="subsection-footer">
                                            <ReactMarkdown components={markdownComponents}>
                                                {block.footer}
                                            </ReactMarkdown>
                                        </div>
                                    )}
                                </div>
                            )}
                        </div>
                    );

                case 'sectioned-list':
                    return (
                        <div key={index} className={`sectioned-list ${block.variant || 'default'}`}>
                            {block.title && (
                                <h3 className="sectioned-list-title">
                                    {block.icon && <i className={`${block.icon} me-2`}></i>}
                                    {block.title}
                                </h3>
                            )}

                            <div className="list-container">
                                {block.sections.map((section, sectionIndex) => (
                                    <div
                                        key={sectionIndex}
                                        className="list-section"
                                        data-section-depth={section.depth || 0}
                                    >
                                        {section.title && (
                                            <h4 className="section-title">
                                                {section.icon && <i className={`${section.icon} me-2`}></i>}
                                                {section.title}
                                            </h4>
                                        )}

                                        <div className="section-content">
                                            <ul className="section-items">
                                                {section.items.map((item, itemIndex) => (
                                                    <li key={itemIndex} className="list-item">
                                                        {typeof item === 'string' ? (
                                                            <div className="item-content">{item}</div>
                                                        ) : (
                                                            <>
                                                                {item.title && <strong className="item-title">{item.title}</strong>}
                                                                {item.content && <div className="item-content">{item.content}</div>}
                                                            </>
                                                        )}
                                                    </li>
                                                ))}
                                            </ul>
                                        </div>
                                    </div>
                                ))}
                            </div>
                        </div>
                    );

                case 'timeline':
                    return (
                        <div key={index} className="timeline-container my-5">
                            {block.title && <h3 className="mb-4 text-center font-weight-bold text-primary">{block.title}</h3>}
                            <div className="timeline">
                                {block.events.map((event, i) => (
                                    <div key={i} className="timeline-event position-relative">
                                        {/* Timeline connector line */}
                                        <div className="timeline-connector"></div>

                                        {/* Date bubble */}
                                        <div className="timeline-date bg-primary text-white rounded-pill shadow-sm">
                                            {event.date || event.year}
                                        </div>

                                        {/* Content card with hover effects */}
                                        <div className="timeline-content card border-0 shadow-sm transition-all">
                                            <div className="card-body p-4">
                                                <div className="d-flex justify-content-between align-items-start">
                                                    <h5 className="card-title mb-3 font-weight-bold text-dark">
                                                        {event.title || event.event}
                                                    </h5>
                                                    {event.icon && <span className="timeline-icon ml-2">{event.icon}</span>}
                                                </div>

                                                {/* Collapsible description */}
                                                <div className="card-text text-muted">
                                                    {event.description || event.detail}
                                                </div>

                                                {/* Optional links */}
                                                <div className="mt-3 d-flex flex-wrap gap-2">
                                                    {event.link && (
                                                        <a
                                                            href={event.link}
                                                            target="_blank"
                                                            rel="noopener noreferrer"
                                                            className="btn btn-sm btn-outline-primary"
                                                        >
                                                            Learn More
                                                        </a>
                                                    )}
                                                    {event.links?.map((link, idx) => (
                                                        <a
                                                            key={idx}
                                                            href={link.url}
                                                            target="_blank"
                                                            rel="noopener noreferrer"
                                                            className="btn btn-sm btn-outline-secondary"
                                                        >
                                                            {link.label}
                                                        </a>
                                                    ))}
                                                </div>

                                                {/* Optional image */}
                                                {event.image && (
                                                    <div className="mt-3">
                                                        <img
                                                            src={event.image}
                                                            alt={event.title}
                                                            className="img-fluid rounded"
                                                            style={{ maxHeight: '200px' }}
                                                        />
                                                    </div>
                                                )}
                                            </div>
                                        </div>
                                    </div>
                                ))}
                            </div>
                        </div>
                    );
                   case 'steps':
                           return (
                               <div key={index} className="steps-section mb-5">
                                   <h3 className="steps-title mb-4" style={{
                                       color: theme === 'dark' ? '#f8f9fa' : '#2c3e50',
                                       borderBottom: `2px solid ${theme === 'dark' ? '#495057' : '#dee2e6'}`,
                                       paddingBottom: '0.5rem'
                                   }}>
                                       {block.title}
                                   </h3>

                                   <div className="steps-container">
                                       {block.steps?.map((step, stepIndex) => (
                                           <div key={stepIndex} className="step-item card mb-3" style={{
                                               backgroundColor: theme === 'dark' ? '#343a40' : 'white',
                                               borderColor: theme === 'dark' ? '#495057' : '#dee2e6',
                                               transition: 'transform 0.2s ease, box-shadow 0.2s ease'
                                           }}>
                                               <div className="card-body">
                                                   <div className="step-header d-flex align-items-start mb-2">
                                                       <div className="step-number me-3" style={{
                                                           backgroundColor: theme === 'dark' ? '#0d6efd' : '#007bff',
                                                           color: 'white',
                                                           width: '36px',
                                                           height: '36px',
                                                           borderRadius: '50%',
                                                           display: 'flex',
                                                           alignItems: 'center',
                                                           justifyContent: 'center',
                                                           fontWeight: 'bold',
                                                           fontSize: '1.1rem',
                                                           flexShrink: 0
                                                       }}>
                                                           {step.step}
                                                       </div>
                                                       <h4 className="step-title card-title mb-0" style={{
                                                           color: theme === 'dark' ? '#f8f9fa' : '#2c3e50',
                                                           fontSize: '1.2rem'
                                                       }}>
                                                           {step.title}
                                                       </h4>
                                                   </div>

                                                   <div className="step-content ps-5">
                                                       <p className="step-description card-text mb-2" style={{
                                                           color: theme === 'dark' ? '#dee2e6' : '#495057'
                                                       }}>
                                                           {step.description}
                                                       </p>

                                                       {step.details && (
                                                           <div className="step-details mt-3 p-3" style={{
                                                               backgroundColor: theme === 'dark' ? '#212529' : '#f8f9fa',
                                                               borderRadius: '6px',
                                                               borderLeft: `3px solid ${theme === 'dark' ? '#6c757d' : '#adb5bd'}`
                                                           }}>
                                                               <p className="mb-0" style={{
                                                                   color: theme === 'dark' ? '#adb5bd' : '#6c757d',
                                                                   fontSize: '0.95rem'
                                                               }}>
                                                                   <strong>Details: </strong>{step.details}
                                                               </p>
                                                           </div>
                                                       )}
                                                   </div>
                                               </div>
                                           </div>
                                       ))}
                                   </div>
                               </div>
                           );

              case 'flashcards':
                    return (
                        <div key={index} className="flashcards-container my-4">
                            {block.title && <h4 className="mb-4">{block.title}</h4>}
                            <div className="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                                {block.cards.map((card, i) => {
                                    const cardId = `card-${index}-${i}`;
                                    const isFlipped = flashcardStates[cardId];
                                    return (
                                        <div key={i} className="col">
                                            <div
                                                className={`flashcard card h-100 ${isFlipped ? 'flipped' : ''}`}
                                                onClick={() => interactive && toggleFlashcard(cardId)}
                                            >
                                                <div className="card-front card-body d-flex flex-column">
                                                    <h5 className="card-title">{card.frontTitle || 'Question'}</h5>
                                                    <div className="card-content mt-auto">
                                                        {renderContent(card.front)}
                                                    </div>
                                                    {interactive && (
                                                        <div className="card-hint text-muted small mt-2">
                                                            Click to reveal answer
                                                        </div>
                                                    )}
                                                </div>
                                                <div className="card-back card-body d-flex flex-column">
                                                    <h5 className="card-title">{card.backTitle || 'Answer'}</h5>
                                                    <div className="card-content">
                                                        {renderContent(card.back)}
                                                    </div>
                                                    {interactive && (
                                                        <div className="card-hint text-muted small mt-2">
                                                            Click to show question
                                                        </div>
                                                    )}
                                                </div>
                                            </div>
                                        </div>
                                    );
                                })}
                            </div>
                        </div>
                    );
                    case 'tools-list':
                        return (
                            <div key={index} className="tools-list-container my-4">
                                {block.title && <h4 className="mb-4">{block.title}</h4>}

                                <div className="row row-cols-1 row-cols-md-2 row-cols-lg-2 g-4">
                                    {block.tools?.map((tool, i) => (
                                        <div key={i} className="col">
                                            <div className="card h-100 shadow-sm border-0">
                                                <div className="card-body d-flex flex-column">
                                                    <h5 className="card-title mb-2">
                                                        {tool.name}
                                                    </h5>

                                                    <p className="card-text text-muted mb-0">
                                                        {tool.purpose}
                                                    </p>
                                                </div>
                                            </div>
                                        </div>
                                    ))}
                                </div>
                            </div>
                        );
case 'anti-pattern':
    return (
        <div key={index} className="anti-pattern-container my-4">
            <div className="card border-warning shadow-sm">
                <div className="card-body">

                    {block.title && (
                        <h4 className="card-title text-warning mb-3">
                            {block.title}
                        </h4>
                    )}

                    {block.description && (
                        <p className="mb-3">
                            {block.description}
                        </p>
                    )}

                    {block.symptoms?.length > 0 && (
                        <div className="mb-3">
                            <h6 className="fw-bold mb-2">Symptoms</h6>
                            <ul className="mb-0">
                                {block.symptoms.map((symptom, i) => (
                                    <li key={i}>{symptom}</li>
                                ))}
                            </ul>
                        </div>
                    )}

                    {block.consequences && (
                        <div className="mb-3">
                            <h6 className="fw-bold mb-1 text-danger">
                                Consequences
                            </h6>
                            <p className="mb-0">{block.consequences}</p>
                        </div>
                    )}

                    {block.solution && (
                        <div className="mt-3">
                            <h6 className="fw-bold mb-1 text-success">
                                Recommended Solution
                            </h6>
                            <p className="mb-0">{block.solution}</p>
                        </div>
                    )}

                </div>
            </div>
        </div>
    );



                case 'cards':
                    return (
                        <div key={index} className="content-cards-container my-4">
                            {block.title && <h4 className="cards-title mb-4 text-center">{block.title}</h4>}

                            <div className="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4">
                                {(block.cards || block.items)?.map((card, cardIndex) => (
                                    <div key={cardIndex} className="col">
                                        <div className="content-card card h-100 border-0 shadow-sm">

                                            {/* Card Header */}
                                            <div className="card-header bg-transparent border-bottom-0 text-center">
                                                {card.icon && (
                                                    <div className="card-icon mb-3">
                                                        <i className={`${card.icon} fa-2x text-primary`}></i>
                                                    </div>
                                                )}
                                                {card.title && (
                                                    <h5 className="card-title mb-2">{card.title}</h5>
                                                )}
                                                {card.description && (
                                                    <p className="card-subtitle text-muted mb-0">{card.description}</p>
                                                )}
                                            </div>

                                            {/* Card Body */}
                                            <div className="card-body">
                                                {/* Details */}
                                                {card.details && (
                                                    <div className="card-details">
                                                        <ReactMarkdown components={markdownComponents}>
                                                            {card.details}
                                                        </ReactMarkdown>
                                                    </div>
                                                )}

                                                {/* Additional content types can be added here */}
                                                {card.stats && (
                                                    <div className="card-stats mt-3">
                                                        <div className="row text-center">
                                                            {card.stats.map((stat, statIndex) => (
                                                                <div key={statIndex} className="col-4">
                                                                    <div className="stat-value text-primary fw-bold">{stat.value}</div>
                                                                    <div className="stat-label small text-muted">{stat.label}</div>
                                                                </div>
                                                            ))}
                                                        </div>
                                                    </div>
                                                )}

                                                {card.items && (
                                                    <ul className="card-list list-unstyled mt-3">
                                                        {card.items.map((item, itemIndex) => (
                                                            <li key={itemIndex} className="card-list-item d-flex align-items-start mb-2">
                                                                <i className="fas fa-check-circle text-success me-2 mt-1"></i>
                                                                <span>{item}</span>
                                                            </li>
                                                        ))}
                                                    </ul>
                                                )}
                                            </div>

                                            {/* Card Footer */}
                                            {(card.actions || card.footer) && (
                                                <div className="card-footer bg-transparent border-top-0">
                                                    {card.actions && (
                                                        <div className="card-actions">
                                                            {card.actions.map((action, actionIndex) => (
                                                                <a
                                                                    key={actionIndex}
                                                                    href={action.url}
                                                                    target="_blank"
                                                                    rel="noopener noreferrer"
                                                                    className={`btn btn-sm me-2 ${
                                                                        action.primary ? 'btn-primary' : 'btn-outline-primary'
                                                                    }`}
                                                                >
                                                                    {action.icon && <i className={`${action.icon} me-1`}></i>}
                                                                    {action.label}
                                                                </a>
                                                            ))}
                                                        </div>
                                                    )}

                                                    {card.footer && (
                                                        <div className="card-footer-text small text-muted mt-2">
                                                            {card.footer}
                                                        </div>
                                                    )}
                                                </div>
                                            )}
                                        </div>
                                    </div>
                                ))}
                            </div>

                            {/* Cards Container Footer */}
                            {block.footer && (
                                <div className="cards-footer text-center mt-4 small text-muted">
                                    {block.footer}
                                </div>
                            )}
                        </div>
                    );

                    case 'statistic':
                        return (
                            <div key={index} className="my-4">
                                <div className="d-flex align-items-baseline">
                                    <span className="display-5 fw-bold">{block.value}</span>
                                    {block.unit && <span className="fs-4 ms-1">{block.unit}</span>}
                                </div>
                                <div className="h5">{block.label}</div>
                                {block.trend && (
                                    <div className={`badge ${block.trend.direction === 'up' ? 'bg-success' : 'bg-danger'}`}>
                                        {block.trend.value}
                                        {block.trend.unit}
                                    </div>
                                )}
                                {block.source && <div className="text-muted small mt-2">{block.source}</div>}
                            </div>
                        );
                        case 'trend-cards':
                            return (
                                <div key={index} className="trend-cards-container my-5">
                                    <div className="row g-4">
                                        {block.trends.map((trend, i) => (
                                            <div key={i} className="col-md-4">
                                                <div className="trend-card card h-100 border-0 shadow-sm">
                                                    <div className="card-body p-4">
                                                        {/* Header with icon and name */}
                                                        <div className="d-flex align-items-center mb-3">
                                                            <div className="trend-icon me-3">
                                                                <i className={`${trend.icon} fa-2x text-primary`}></i>
                                                            </div>
                                                            <h3 className="trend-name h5 mb-0">
                                                                {trend.name}
                                                            </h3>
                                                        </div>

                                                        {/* Impact */}
                                                        <div className="trend-impact mb-3">
                                                            <div className="text-muted small mb-1">Impact</div>
                                                            <p className="mb-0">{trend.impact}</p>
                                                        </div>

                                                        {/* Example */}
                                                        <div className="trend-example mb-3">
                                                            <div className="text-muted small mb-1">Example</div>
                                                            <p className="mb-0">{trend.example}</p>
                                                        </div>

                                                        {/* Adoption */}
                                                        {trend.adoption && (
                                                            <div className="trend-adoption">
                                                                <div className="text-muted small mb-1">Adoption</div>
                                                                <p className="mb-0 small">{trend.adoption}</p>
                                                            </div>
                                                        )}
                                                    </div>
                                                </div>
                                            </div>
                                        ))}
                                    </div>
                                </div>
                            );
                            case 'tip-box':
                                return (
                                    <div key={index} className="tip-box card border-success my-4">
                                        <div className="card-header bg-success bg-opacity-10 border-success">
                                            <div className="d-flex align-items-center">
                                                <i className="fas fa-lightbulb text-success me-2"></i>
                                                <h4 className="mb-0">{block.title || "Tips"}</h4>
                                            </div>
                                        </div>
                                        <div className="card-body">
                                            <ul className="list-unstyled mb-0">
                                                {block.tips.map((tip, i) => (
                                                    <li key={i} className="mb-3 pb-3 border-bottom">
                                                        <div className="d-flex align-items-start">
                                                            <div className="tip-icon me-3 mt-1">
                                                                <i className={`${tip.icon} text-success`}></i>
                                                            </div>
                                                            <div className="tip-text">
                                                                {tip.text}
                                                            </div>
                                                        </div>
                                                    </li>
                                                ))}
                                            </ul>
                                        </div>
                                    </div>
                                );

            case 'tabs':
                const tabBlockId = `tabs-${index}`;
                const activeTab = activeTabs[tabBlockId] || 0;

                // Define the handler - don't rely on external onTabChange
                const handleTabClick = (blockId, tabIndex) => {
                    // Check if setActiveTabs exists (from parent or useState)
                    if (setActiveTabs && typeof setActiveTabs === 'function') {
                        setActiveTabs(prev => ({
                            ...prev,
                            [blockId]: tabIndex
                        }));
                    }
                };

                return (
                    <div key={index} className="tabs-container card my-4">
                        <div className="card-header p-0 border-bottom-0">
                            <ul className="nav nav-tabs card-header-tabs m-0">
                                {block.tabs.map((tab, i) => (
                                    <li key={i} className="nav-item">
                                        <button
                                            className={`nav-link ${activeTab === i ? 'active' : ''}`}
                                            onClick={() => handleTabClick(tabBlockId, i)}
                                            type="button"
                                        >
                                            {tab.icon && <i className={`${tab.icon} me-2`}></i>}
                                            {tab.title}
                                        </button>
                                    </li>
                                ))}
                            </ul>
                        </div>
                        <div className="card-body">
                            {block.tabs.map((tab, i) => (
                                <div
                                    key={i}
                                    style={{ display: activeTab === i ? 'block' : 'none' }}
                                >
                                    {renderContent(tab.content)}
                                </div>
                            ))}
                        </div>
                    </div>
                );
                case 'metric':
                    const trendColor = block.trend === 'up' ? 'text-danger' :
                                      block.trend === 'down' ? 'text-success' : 'text-muted';
                    const trendIcon = block.trend === 'up' ? 'fa-arrow-up' :
                                     block.trend === 'down' ? 'fa-arrow-down' : 'fa-minus';

                    return (
                        <div key={index} className="metric-single card border-0 shadow-sm my-3">
                            <div className="card-body p-4">
                                <div className="row align-items-center">
                                    {/* Left: Icon and title */}
                                    <div className="col-md-8">
                                        <div className="d-flex align-items-start">
                                            {block.icon && (
                                                <div className="metric-icon me-3">
                                                    <i className={`${block.icon} fa-2x ${trendColor}`}></i>
                                                </div>
                                            )}
                                            <div>
                                                <h5 className="metric-title h5 mb-2">{block.title}</h5>
                                                {block.description && (
                                                    <p className="metric-description text-muted small mb-0">
                                                        {block.description}
                                                    </p>
                                                )}
                                            </div>
                                        </div>
                                    </div>

                                    {/* Right: Value and trend */}
                                    <div className="col-md-4 text-md-end mt-3 mt-md-0">
                                        <div className="metric-value-container">
                                            <div className="metric-value display-5 fw-bold mb-1">
                                                {block.value}
                                            </div>
                                            <div className="metric-trend d-flex align-items-center justify-content-md-end">
                                                <i className={`fas ${trendIcon} me-1 ${trendColor}`}></i>
                                                {block.source && (
                                                    <span className="metric-source text-muted small">
                                                        {block.source}
                                                    </span>
                                                )}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    );
                    case 'template':
                        return (
                            <div key={index} className="template-container card border-info my-4">
                                <div className="card-header bg-info bg-opacity-10 border-info">
                                    <div className="d-flex justify-content-between align-items-center">
                                        <div>
                                            <h4 className="mb-0">
                                                <i className="fas fa-file-alt me-2"></i>
                                                {block.title}
                                            </h4>
                                            {block.description && (
                                                <p className="mb-0 small text-muted">{block.description}</p>
                                            )}
                                        </div>
                                        {block.version && (
                                            <span className="badge bg-info">{block.version}</span>
                                        )}
                                    </div>
                                </div>
                                <div className="card-body">
                                    {block.content && (
                                        <div className="template-content">
                                            <ReactMarkdown components={markdownComponents}>
                                                {block.content}
                                            </ReactMarkdown>
                                        </div>
                                    )}
                                </div>
                                {block.lastUpdated && (
                                    <div className="card-footer bg-transparent border-info">
                                        <div className="text-muted small">
                                            <i className="fas fa-calendar-alt me-1"></i>
                                            Last updated: {block.lastUpdated}
                                        </div>
                                    </div>
                                )}
                            </div>
                        );
                        case 'metrics-grid':
                            return (
                                <div key={index} className="metrics-grid-container my-5">
                                    {block.title && (
                                        <h3 className="text-center mb-4">{block.title}</h3>
                                    )}

                                    <div className="table-responsive">
                                        <table className="table table-bordered table-striped">
                                            <thead className="table-dark">
                                                <tr>
                                                    {block.columns.map((column, i) => (
                                                        <th key={i} scope="col">{column}</th>
                                                    ))}
                                                </tr>
                                            </thead>
                                            <tbody>
                                                {block.rows.map((row, i) => (
                                                    <tr key={i}>
                                                        {row.map((cell, j) => (
                                                            <td key={j} className={j === 0 ? 'fw-bold' : ''}>
                                                                {cell}
                                                            </td>
                                                        ))}
                                                    </tr>
                                                ))}
                                            </tbody>
                                        </table>
                                    </div>
                                </div>
                            );
                            case 'definition-box':
                                return (
                                    <div key={index} className="definition-box my-5">
                                        {block.title && (
                                            <h3 className="mb-3">{block.title}</h3>
                                        )}

                                        <div className="definition-content p-4 bg-light border rounded">
                                            {block.definition.split('\n\n').map((paragraph, i) => {
                                                // Convert **bold** to <strong>
                                                const html = paragraph
                                                    .replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>')
                                                    .replace(/\*(Case:.*?)\*/g, '<em class="text-muted d-block mt-2">$1</em>')
                                                    .replace(/\*(?!Case)(.*?)\*/g, '<em>$1</em>');

                                                return (
                                                    <div
                                                        key={i}
                                                        className="mb-3"
                                                        dangerouslySetInnerHTML={{ __html: html }}
                                                    />
                                                );
                                            })}
                                        </div>
                                    </div>
                                );
                                case 'technique-cards':
                                    return (
                                        <div key={index} className="technique-cards my-5">
                                            {block.title && (
                                                <h3 className="mb-4">{block.title}</h3>
                                            )}

                                            <div className="row">
                                                {/* FIX 1: Check if techniques exists before mapping */}
                                                {block.techniques && block.techniques.length > 0 ? (
                                                    block.techniques.map((technique, i) => {
                                                        // FIX 2: Safely extract all properties with defaults
                                                        const techniqueName = technique.name || 'Unnamed Technique';
                                                        const techniqueDescription = technique.description || '';
                                                        const techniqueSteps = technique.steps || [];
                                                        const techniqueTags = technique.tags || [];
                                                        const techniqueReference = technique.reference || null;

                                                        return (
                                                            <div key={i} className="col-md-6 mb-4">
                                                                <div className="card h-100 border shadow-sm">
                                                                    <div className="card-body">
                                                                        <h5 className="card-title text-primary">{techniqueName}</h5>

                                                                        {techniqueDescription && (
                                                                            <p className="card-text text-muted mb-3">{techniqueDescription}</p>
                                                                        )}

                                                                        {/* FIX 3: Check if steps exists and has items */}
                                                                        {techniqueSteps.length > 0 && (
                                                                            <div className="mb-3">
                                                                                <h6 className="text-secondary mb-2">Steps:</h6>
                                                                                <ul className="list-unstyled">
                                                                                    {techniqueSteps.map((step, stepIndex) => (
                                                                                        <li key={stepIndex} className="mb-1">
                                                                                            <small>{step || 'Step'}</small>
                                                                                        </li>
                                                                                    ))}
                                                                                </ul>
                                                                            </div>
                                                                        )}

                                                                        <div className="d-flex justify-content-between align-items-end mt-3">
                                                                            {/* FIX 4: Check if tags exists and has items */}
                                                                            {techniqueTags.length > 0 && (
                                                                                <div>
                                                                                    {techniqueTags.map((tag, tagIndex) => (
                                                                                        <span
                                                                                            key={tagIndex}
                                                                                            className="badge bg-light text-dark me-1"
                                                                                            style={{ fontSize: '0.7rem' }}
                                                                                        >
                                                                                            {tag || 'Tag'}
                                                                                        </span>
                                                                                    ))}
                                                                                </div>
                                                                            )}

                                                                            {/* FIX 5: Check reference exists and has text */}
                                                                            {techniqueReference && techniqueReference.text && (
                                                                                <a
                                                                                    href={techniqueReference.url || '#'}
                                                                                    className="btn btn-sm btn-outline-primary"
                                                                                >
                                                                                    {techniqueReference.text}
                                                                                </a>
                                                                            )}
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        );
                                                    })
                                                ) : (
                                                    // FIX 6: Add fallback for empty techniques
                                                    <div className="col-12">
                                                        <div className="alert alert-warning">
                                                            No techniques available for this section.
                                                        </div>
                                                    </div>
                                                )}
                                            </div>
                                        </div>
                                    );
                                    case 'project-context':
                                        return (
                                            <div key={index} className="project-context-block card my-4 shadow-sm">
                                                <div className="card-header bg-primary bg-opacity-10 border-primary">
                                                    <div className="d-flex align-items-center">
                                                        <i className="fas fa-project-diagram text-primary me-2"></i>
                                                        <h5 className="card-title mb-0 text-dark">{block.title}</h5>
                                                    </div>
                                                </div>

                                                <div className="card-body">
                                                    <div className="row g-4">
                                                        {Object.entries(block.details).map(([key, value], i) => (
                                                            <div key={i} className="col-md-6">
                                                                <div className="context-item p-3 border rounded h-100 bg-light bg-opacity-50">
                                                                    <div className="context-label text-muted small mb-1">
                                                                        {key}
                                                                    </div>
                                                                    <div className="context-value fw-semibold text-dark">
                                                                        {value}
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        ))}
                                                    </div>
                                                </div>
                                            </div>
                                        );

                case 'process-steps':
                    return (
                        <div key={index} className="process-steps-container my-5">
                            {block.title && (
                                <h3 className="text-center mb-4">{block.title}</h3>
                            )}

                            <div className="steps-timeline">
                                {block.steps.map((step, i) => (
                                    <div key={i} className="step-item position-relative mb-4">
                                        {/* Step number circle */}
                                        <div className="step-number position-absolute start-0 translate-middle bg-primary text-white rounded-circle d-flex align-items-center justify-content-center"
                                             style={{width: '40px', height: '40px', top: '0'}}>
                                            {i + 1}
                                        </div>

                                        {/* Step content */}
                                        <div className="step-content ms-5 ps-4">
                                            <div className="card border-0 shadow-sm">
                                                <div className="card-body">
                                                    <p className="mb-0">{step}</p>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                ))}
                            </div>
                        </div>
                    );

                case 'callout':
                    return (
                        <div key={index} className={`callout callout-${block.variant || 'info'} my-4`}>
                            <div className="callout-header d-flex align-items-center">
                                {block.icon && <i className={`${block.icon} me-2`}></i>}
                                <h5 className="callout-title mb-0">{block.title}</h5>
                            </div>
                            <div className="callout-content">
                                {renderContent(block.content)}
                                {block.link && (
                                    <a
                                        href={block.link.url}
                                        target="_blank"
                                        rel="noopener noreferrer"
                                        className="callout-link"
                                    >
                                        {block.link.text || 'Learn more'} <i className="fas fa-arrow-right ms-1"></i>
                                    </a>
                                )}
                            </div>
                        </div>
                    );

                case 'interactive-diagram':
                    return (
                        <div key={index} className="interactive-diagram my-4">
                            {block.title && <h4 className="mb-3">{block.title}</h4>}

                            <div className="diagram-container position-relative" style={{ minHeight: '500px' }}>
                                <img
                                    src={block.image}
                                    alt={block.title}
                                    className="img-fluid"
                                    style={{ opacity: 0.2, position: 'absolute', top: 0, left: 0 }}
                                />

                                {/* Render nodes */}
                                {block.nodes.map((node, i) => (
                                    <div
                                        key={node.id}
                                        className="diagram-node position-absolute text-center p-2 rounded shadow-sm bg-white"
                                        style={{
                                            top: `${node.y}px`,
                                            left: `${node.x}px`,
                                            transform: 'translate(-50%, -50%)',
                                            cursor: 'pointer',
                                            border: '1px solid #ccc',
                                            zIndex: 2
                                        }}
                                        onClick={() => console.log(`Node clicked: ${node.label}`)}
                                    >
                                        {node.label}
                                    </div>
                                ))}

                                {/* Render connections */}
                                <svg
                                    className="diagram-lines position-absolute"
                                    style={{ top: 0, left: 0, width: '100%', height: '100%', zIndex: 1 }}
                                >
                                    {block.connections.map((conn, i) => {
                                        const [fromId, toId] = conn.split(' → ');
                                        const fromNode = block.nodes.find(n => n.id === fromId);
                                        const toNode = block.nodes.find(n => n.id === toId);

                                        if (!fromNode || !toNode) return null;

                                        return (
                                            <line
                                                key={i}
                                                x1={fromNode.x}
                                                y1={fromNode.y}
                                                x2={toNode.x}
                                                y2={toNode.y}
                                                stroke="#007bff"
                                                strokeWidth="2"
                                                markerEnd="url(#arrowhead)"
                                            />
                                        );
                                    })}

                                    {/* Arrowhead marker */}
                                    <defs>
                                        <marker
                                            id="arrowhead"
                                            markerWidth="10"
                                            markerHeight="7"
                                            refX="10"
                                            refY="3.5"
                                            orient="auto"
                                        >
                                            <polygon points="0 0, 10 3.5, 0 7" fill="#007bff" />
                                        </marker>
                                    </defs>
                                </svg>
                            </div>

                            {block.caption && <p className="mt-3 text-muted">{block.caption}</p>}
                        </div>
                    );

                case 'coverage-chart':
                    return (
                        <div key={index} className="coverage-chart my-4">
                            {block.title && <h5 className="mb-3">{block.title}</h5>}
                            <div className="chart-container bg-light p-3 rounded">
                                <div className="coverage-bars">
                                    {block.metrics?.map((metric, i) => (
                                        <div key={i} className="coverage-metric mb-3">
                                            <div className="d-flex justify-content-between align-items-center mb-1">
                                                <span className="metric-label">{metric.label}</span>
                                                <span className="metric-value">{metric.value}%</span>
                                            </div>
                                            <div className="progress" style={{ height: '20px' }}>
                                                <div
                                                    className="progress-bar"
                                                    role="progressbar"
                                                    style={{
                                                        width: `${metric.value}%`,
                                                        backgroundColor: metric.color || '#007bff'
                                                    }}
                                                    aria-valuenow={metric.value}
                                                    aria-valuemin="0"
                                                    aria-valuemax="100"
                                                >
                                                    {metric.value}%
                                                </div>
                                            </div>
                                            {metric.target && (
                                                <div className="metric-target small text-muted mt-1">
                                                    Target: {metric.target}%
                                                </div>
                                            )}
                                        </div>
                                    ))}
                                </div>
                            </div>
                            {block.legend && (
                                <div className="chart-legend mt-2 small text-muted">
                                    {block.legend}
                                </div>
                            )}
                        </div>
                    );
case 'tools-grid':
    return (
        <div key={index} className="tools-grid-container my-4">
            <div className="row row-cols-1 row-cols-md-2 row-cols-lg-2 g-4">
                {block.content?.map((item, i) => (
                    <div key={i} className="col">
                        <div className="card h-100 shadow-sm border-0">
                            <div className="card-body d-flex flex-column">
                                <h5 className="card-title mb-2">
                                    {item.tool}
                                </h5>

                                <p className="card-text text-muted mb-0">
                                    {item.description}
                                </p>
                            </div>
                        </div>
                    </div>
                ))}
            </div>
        </div>
    );

                case 'conclusion':
                    return (
                        <div key={index} className="conclusion-section my-5">
                            {/* Optional Hero Icon/Header */}
                            {block.icon && (
                                <div className="text-center mb-4">
                                    <i className={`${block.icon} fa-3x text-primary`}></i>
                                </div>
                            )}

                            {/* Main Title */}
                            {block.title && (
                                <h2 className="text-center mb-4">{block.title}</h2>
                            )}

                            {/* Summary Text */}
                            {block.summary && (
                                <div className="conclusion-summary lead mb-4">
                                    <ReactMarkdown components={markdownComponents}>
                                        {block.summary}
                                    </ReactMarkdown>
                                </div>
                            )}

                            {/* Key Takeaways */}
                            {block.keyTakeaways && (
                                <div className="key-takeaways card border-primary mb-4">
                                    <div className="card-header bg-primary text-white">
                                        <h5 className="mb-0">
                                            <i className="fas fa-key me-2"></i>Key Takeaways
                                        </h5>
                                    </div>
                                    <div className="card-body">
                                        <ul className="mb-0">
                                            {block.keyTakeaways.map((takeaway, i) => (
                                                <li key={i} className="mb-2">
                                                    <ReactMarkdown components={markdownComponents}>
                                                        {takeaway}
                                                    </ReactMarkdown>
                                                </li>
                                            ))}
                                        </ul>
                                    </div>
                                </div>
                            )}

                            {/* Call to Action */}
                            {block.cta && (
                                <div className="call-to-action text-center p-4 bg-light rounded">
                                    <h5>{block.cta.title}</h5>
                                    <p className="mb-3">{block.cta.description}</p>
                                    {block.cta.button && (
                                        <a
                                            href={block.cta.button.link}
                                            className="btn btn-primary btn-lg"
                                            target="_blank"
                                            rel="noopener noreferrer"
                                        >
                                            {block.cta.button.text}
                                        </a>
                                    )}
                                </div>
                            )}
                        </div>
                    );

                    case 'key-takeaways':
                        return (
                            <div key={index} className="key-takeaways-container my-4">
                                <div className="card border-success shadow-sm">
                                    <div className="card-body">

                                        {block.title && (
                                            <h4 className="card-title text-success mb-3">
                                                {block.title}
                                            </h4>
                                        )}

                                        {block.items?.length > 0 && (
                                            <ol className="mb-0 ps-3">
                                                {block.items.map((item, i) => (
                                                    <li key={i} className="mb-2">
                                                        {item}
                                                    </li>
                                                ))}
                                            </ol>
                                        )}

                                    </div>
                                </div>
                            </div>
                        );

                    case 'checklist':
                                                            return (
                                                                <div key={index} className="checklist-section">
                                                                    <h3 className="checklist-title">{block.title}</h3>
                                                                    <div className="checklist-items">
                                                                        {block.items?.map((item, itemIndex) => (
                                                                            <div key={itemIndex} className={`checklist-item ${item.checked ? 'checked' : 'unchecked'}`}>
                                                                                <input
                                                                                    type="checkbox"
                                                                                    checked={item.checked}
                                                                                    readOnly
                                                                                    className="checklist-checkbox"
                                                                                />
                                                                                <span className="checklist-item-text">{item.item}</span>
                                                                                {item.importance && (
                                                                                    <span className={`checklist-importance badge ${item.importance}`}>
                                                                                        {item.importance}
                                                                                    </span>
                                                                                )}
                                                                            </div>
                                                                        ))}
                                                                    </div>
                                                                </div>
                                                            );
                    case 'metrics':
                        return (
                            <div>
                                <h3>{block.title}</h3>
                                <div>
                                    {block.items?.map((item, i) => (
                                        <div key={i} style={{marginBottom: '15px', padding: '10px', border: '1px solid #ddd'}}>
                                            <strong>{item.metric}</strong><br/>
                                            <em>Target:</em> {item.target}<br/>
                                            <em>Measurement:</em> {item.measurement}<br/>
                                            <em>Frequency:</em> {item.frequency}
                                        </div>
                                    ))}
                                </div>
                            </div>
                        );
                        case 'deep-dive-components':
                          return (
                            <div key={index} className="deep-dive-components-section">
                              <h3 className="deep-dive-components-title">{block.title}</h3>

                              <div className="components-container">
                                {Array.isArray(block?.components) &&
                                 block.components.map((component, componentIndex) => (
                                    <div key={componentIndex} className="component-card">
                                      <div className="component-header">
                                        <div className="component-indicator">
                                          <span className="component-number">C{componentIndex + 1}</span>
                                        </div>
                                        <div className="component-title-container">
                                          <h4 className="component-title">{component.component}</h4>
                                          <p className="component-subtitle">{component.description}</p>
                                        </div>
                                      </div>

                                      <div className="component-content">
                                        <div className="details-section">
                                          <h5 className="details-title">Details:</h5>
                                          <p className="details-text">{component.details}</p>
                                        </div>

                                        <div className="pitfall-section">
                                          <div className="pitfall-label">Common Pitfall:</div>
                                          <div className="pitfall-text">{component.pitfall}</div>
                                        </div>
                                      </div>
                                    </div>
                                  ))
                                }
                              </div>
                            </div>
                          );
                          case 'deep-dive-techniques':
                            return (
                              <div key={index} className="techniques-section">
                                <h3 className="techniques-title">{block.title}</h3>

                                <div className="techniques-container">
                                  {Array.isArray(block?.techniques) &&
                                    block.techniques.map((technique, techniqueIndex) => (
                                      <div key={techniqueIndex} className={`technique-card level-${technique.level.toLowerCase()}`}>
                                        <div className="technique-header">
                                          <div className="technique-meta">
                                            <span className="technique-number">T{techniqueIndex + 1}</span>
                                            <span className={`technique-level-badge ${technique.level.toLowerCase()}`}>
                                              {technique.level}
                                            </span>
                                          </div>
                                          <h4 className="technique-name">{technique.technique}</h4>
                                        </div>

                                        <div className="technique-content">
                                          <div className="technique-purpose">
                                            <span className="field-label">Purpose:</span>
                                            <p className="field-value">{technique.purpose}</p>
                                          </div>

                                          <div className="technique-application">
                                            <span className="field-label">Application:</span>
                                            <p className="field-value">{technique.application}</p>
                                          </div>

                                          <div className="technique-example">
                                            <span className="field-label">Example:</span>
                                            <p className="field-value">{technique.example}</p>
                                          </div>

                                          <div className="technique-tip">
                                            <span className="field-label">Expert Tip:</span>
                                            <p className="field-value">{technique['expert-tip']}</p>
                                          </div>
                                        </div>
                                      </div>
                                    ))
                                  }
                                </div>
                              </div>
                            );
                            case 'deep-dive-environment':
                              return (
                                <div key={index} className="environment-section">
                                  <h3 className="environment-title">{block.title}</h3>

                                  <div className="environment-container">
                                    {Array.isArray(block?.components) &&
                                      block.components.map((item, itemIndex) => (
                                        <div key={itemIndex} className="environment-card">
                                          <div className="environment-header">
                                            <div className="environment-indicator">
                                              <span className="environment-number">{itemIndex + 1}</span>
                                            </div>
                                            <h4 className="environment-component">{item.component}</h4>
                                          </div>

                                          <div className="environment-content">
                                            <div className="environment-details">
                                              <span className="field-label">Details:</span>
                                              <p className="field-value">{item.details}</p>
                                            </div>

                                            <div className="environment-verification">
                                              <span className="field-label">Verification:</span>
                                              <p className="field-value">{item.verification}</p>
                                            </div>

                                            <div className="environment-issues">
                                              <span className="field-label">Common Issues:</span>
                                              <p className="field-value">{item['common-issues']}</p>
                                            </div>
                                          </div>
                                        </div>
                                      ))
                                    }
                                  </div>
                                </div>
                              );
                              case 'deep-dive-methodologies':
                                return (
                                  <div key={index} className="methodologies-section">
                                    <h3 className="methodologies-title">{block.title}</h3>

                                    <div className="methodologies-container">
                                      {Array.isArray(block?.methodologies) &&
                                       block.methodologies.map((methodology, methodologyIndex) => (
                                          <div key={methodologyIndex} className="methodology-card">
                                            <div className="methodology-header">
                                              <div className="methodology-indicator">
                                                <span className="methodology-number">M{methodologyIndex + 1}</span>
                                              </div>
                                              <h4 className="methodology-name">{methodology.method}</h4>
                                              <p className="methodology-approach">{methodology.approach}</p>
                                            </div>

                                            <div className="methodology-content">
                                              <div className="methodology-bestfor">
                                                <span className="field-label">Best For:</span>
                                                <p className="field-value">{methodology['best-for']}</p>
                                              </div>

                                              <div className="methodology-proscons">
                                                <div className="advantages-section">
                                                  <span className="field-label">Advantages:</span>
                                                  <p className="field-value">{methodology.advantages}</p>
                                                </div>
                                                <div className="disadvantages-section">
                                                  <span className="field-label">Disadvantages:</span>
                                                  <p className="field-value">{methodology.disadvantages}</p>
                                                </div>
                                              </div>

                                              <div className="methodology-tip">
                                                <span className="field-label">Expert Tip:</span>
                                                <p className="field-value">{methodology['expert-tip']}</p>
                                              </div>
                                            </div>
                                          </div>
                                        ))
                                      }
                                    </div>
                                  </div>
                                );
                                case 'deep-dive-defect-lifecycle':
                                  return (
                                    <div key={index} className="defect-lifecycle-section">
                                      <h3 className="defect-lifecycle-title">{block.title}</h3>

                                      <div className="lifecycle-stages">
                                        {Array.isArray(block?.stages) &&
                                          block.stages.map((stage, stageIndex) => (
                                            <div key={stageIndex} className="stage-container">
                                              <div className="stage-card">
                                                <div className="stage-header">
                                                  <div className="stage-meta">
                                                    <span className="stage-number">{stageIndex + 1}</span>
                                                    <span className={`stage-status stage-${stage.stage.toLowerCase()}`}>
                                                      {stage.stage}
                                                    </span>
                                                  </div>
                                                  <h4 className="stage-description">{stage.description}</h4>
                                                </div>

                                                <div className="stage-details">
                                                  <div className="stage-responsibility">
                                                    <span className="detail-label">Responsibility:</span>
                                                    <span className="detail-value">{stage.responsibility}</span>
                                                  </div>

                                                  <div className="stage-qualitygate">
                                                    <span className="detail-label">Quality Gate:</span>
                                                    <span className="detail-value">{stage['quality-gate']}</span>
                                                  </div>
                                                </div>
                                              </div>

                                              {/* Connector arrow between stages (except last) */}
                                              {stageIndex < block.stages.length - 1 && (
                                                <div className="stage-connector">→</div>
                                              )}
                                            </div>
                                          ))
                                        }
                                      </div>
                                    </div>
                                  );
                    case 'matrix':
                        return (
                            <div>
                                <h3>{block.title}</h3>
                                <table border="1">
                                    <thead>
                                        <tr>
                                            {block.columns.map((col, i) => <th key={i}>{col}</th>)}
                                        </tr>
                                    </thead>
                                    <tbody>
                                        {block.rows.map((row, i) => (
                                            <tr key={i}>
                                                {row.map((cell, j) => <td key={j}>{cell}</td>)}
                                            </tr>
                                        ))}
                                    </tbody>
                                </table>
                                {block.guidance && <p><em>{block.guidance}</em></p>}
                            </div>
                        );
                        case 'deep-dive-closure':
                          return (
                            <div key={index} className="closure-section">
                              <h3 className="closure-title">{block.title}</h3>

                              <div className="closure-container">
                                {Array.isArray(block?.activities) &&
                                  block.activities.map((activity, activityIndex) => (
                                    <div key={activityIndex} className="closure-card">
                                      <div className="closure-header">
                                        <div className="closure-meta">
                                          <span className="closure-number">A{activityIndex + 1}</span>
                                          <h4 className="closure-activity">{activity.activity}</h4>
                                        </div>
                                        <p className="closure-purpose">{activity.purpose}</p>
                                      </div>

                                      <div className="closure-content">
                                        <div className="closure-actions">
                                          <span className="field-label">Actions:</span>
                                          <ul className="actions-list">
                                            {Array.isArray(activity.actions) &&
                                              activity.actions.map((action, actionIndex) => (
                                                <li key={actionIndex} className="action-item">
                                                  <span className="action-icon">•</span>
                                                  {action}
                                                </li>
                                              ))
                                            }
                                          </ul>
                                        </div>

                                        <div className="closure-output">
                                          <span className="field-label">Output:</span>
                                          <p className="field-value">{activity.output}</p>
                                        </div>
                                      </div>
                                    </div>
                                  ))
                                }
                              </div>
                            </div>
                          );
                    case 'warning': {
                        const { content, severity, mitigation } = block;

                        return (
                            <div className="warning-box" data-severity={severity}>
                                <div className="warning-header">
                                    <svg className="warning-icon" width="24" height="24" viewBox="0 0 24 24">
                                        <path fill="currentColor" d="M12 2C6.48 2 2 6.48 2 12s4.48 10 10 10 10-4.48 10-10S17.52 2 12 2zm1 15h-2v-2h2v2zm0-4h-2V7h2v6z"/>
                                    </svg>
                                    <span className="warning-title">
                                        {severity === 'high' ? 'Critical Issue' :
                                         severity === 'medium' ? 'Important Notice' : 'Note'}
                                    </span>
                                </div>
                                <div className="warning-content">{content}</div>
                                {mitigation && mitigation.length > 0 && (
                                    <div className="warning-actions">
                                        <h4>Recommended Actions:</h4>
                                        <ul>
                                            {mitigation.map((action, idx) => (
                                                <li key={idx}>{action}</li>
                                            ))}
                                        </ul>
                                    </div>
                                )}
                            </div>
                        );
                    }
                    case 'comparison-cards':
                        return (
                            <div key={index} className="comparison-cards-container my-4">
                                {block.title && (
                                    <h4 className="mb-4">{block.title}</h4>
                                )}

                                <div className="row row-cols-1 row-cols-md-2 g-4">
                                    {block.cards?.map((card, i) => (
                                        <div key={i} className="col">
                                            <div className="card h-100 shadow-sm border-0">
                                                <div className="card-body d-flex flex-column">

                                                    {card.title && (
                                                        <h5 className="card-title mb-3">
                                                            {card.title}
                                                        </h5>
                                                    )}

                                                    {card.points?.length > 0 && (
                                                        <ul className="mb-0">
                                                            {card.points.map((point, pIndex) => (
                                                                <li key={pIndex} className="mb-2">
                                                                    {point}
                                                                </li>
                                                            ))}
                                                        </ul>
                                                    )}

                                                </div>
                                            </div>
                                        </div>
                                    ))}
                                </div>
                            </div>
                        );
                        case 'pro-tips':
                            return (
                                <div key={index} className="pro-tips-container my-4">
                                    {block.title && (
                                        <h4 className="mb-4">{block.title}</h4>
                                    )}

                                    <div className="row row-cols-1 row-cols-md-2 g-4">
                                        {block.items?.map((item, i) => (
                                            <div key={i} className="col">
                                                <div className="card h-100 shadow-sm border-0">
                                                    <div className="card-body d-flex flex-column">

                                                        {item.tip && (
                                                            <h5 className="card-title mb-2">
                                                                💡 {item.tip}
                                                            </h5>
                                                        )}

                                                        {item.explanation && (
                                                            <p className="card-text text-muted mb-0">
                                                                {item.explanation}
                                                            </p>
                                                        )}

                                                    </div>
                                                </div>
                                            </div>
                                        ))}
                                    </div>
                                </div>
                            );
case 'stats-grid':
    return (
        <div key={index} className="stats-grid-container my-4">
            {block.title && (
                <h4 className="mb-4">{block.title}</h4>
            )}

            <div
                className={`row row-cols-1 row-cols-md-2 row-cols-lg-${block.columns || 4} g-4`}
            >
                {block.items?.map((item, i) => (
                    <div key={i} className="col">
                        <div className="card h-100 text-center shadow-sm border-0">
                            <div className="card-body d-flex flex-column justify-content-center">

                                {item.icon && (
                                    <div className="fs-2 mb-2">
                                        {item.icon}
                                    </div>
                                )}

                                {item.value && (
                                    <h3 className="fw-bold mb-1">
                                        {item.value}
                                    </h3>
                                )}

                                {item.label && (
                                    <h6 className="text-muted mb-2">
                                        {item.label}
                                    </h6>
                                )}

                                {item.description && (
                                    <p className="small text-muted mb-0">
                                        {item.description}
                                    </p>
                                )}

                            </div>
                        </div>
                    </div>
                ))}
            </div>
        </div>
    );


                     case 'comparison-tab':
                         return (
                             <div key={index} className="comparison-table-section">
                                 {block.title && (
                                     <h3 className="comparison-table-title">{block.title}</h3>
                                 )}

                                 <div className="comparison-table-wrapper">
                                     <table className="comparison-table">
                                         <thead>
                                             <tr>
                                                 {(block.columns || []).map((col, colIndex) => (
                                                     <th key={colIndex}>{col}</th>
                                                 ))}
                                             </tr>
                                         </thead>

                                         <tbody>
                                             {(block.rows || []).map((row, rowIndex) => (
                                                 <tr key={rowIndex}>
                                                     {(Array.isArray(row) ? row : []).map((cell, cellIndex) => (
                                                         <td key={cellIndex}>
                                                             <ReactMarkdown components={markdownComponents}>
                                                                 {cell || ""}
                                                             </ReactMarkdown>
                                                         </td>
                                                     ))}
                                                 </tr>
                                             ))}
                                         </tbody>
                                     </table>
                                 </div>
                             </div>
                         );

                     case 'case-study':
                                                            return (
                                                                <div key={index} className="case-study-section">
                                                                    <h3 className="case-study-title">{block.title}</h3>
                                                                    <div className="case-study-content">
                                                                        {block.scenario && (
                                                                            <div className="case-study-scenario">
                                                                                <h4>Scenario</h4>
                                                                                <p>{block.scenario}</p>
                                                                            </div>
                                                                        )}
                                                                        {block.problem && (
                                                                            <div className="case-study-problem">
                                                                                <h4>Problem</h4>
                                                                                <p>{block.problem}</p>
                                                                            </div>
                                                                        )}
                                                                        {block.solution && (
                                                                            <div className="case-study-solution">
                                                                                <h4>Solution</h4>
                                                                                <p>{block.solution}</p>
                                                                            </div>
                                                                        )}
                                                                        {block.code && (
                                                                            <div className="case-study-code">
                                                                                <SyntaxHighlighter
                                                                                    language={block.language || 'javascript'}
                                                                                    style={atomDark}
                                                                                >
                                                                                    {block.code}
                                                                                </SyntaxHighlighter>
                                                                            </div>
                                                                        )}
                                                                        {block.outcome && (
                                                                            <div className="case-study-outcome">
                                                                                <h4>Outcome</h4>
                                                                                <p>{block.outcome}</p>
                                                                            </div>
                                                                        )}
                                                                    </div>
                                                                </div>
                                                            );
                    case 'visual-explainer':
                      return (
                        <div key={index} className="visual-explainer-section">
                          <h3 className="visual-explainer-title">{block.title}</h3>
                          <p className="visual-explainer-description">{block.description}</p>

                          <div className="framework-timeline">
                            {Array.isArray(block?.elements) &&
                             block.elements.map((phase, phaseIndex) => (
                                <div key={phaseIndex} className="phase-container">
                                  <div className="phase-card">
                                    <div className="phase-header">
                                      <span className="phase-number">Phase {phaseIndex + 1}</span>
                                      <h4 className="phase-title">{phase.phase}</h4>
                                    </div>
                                    <div className="phase-content">
                                      <div className="connection-line">
                                        <span className="connection-label">{phase.connection}</span>
                                        <div className="connection-arrow">→</div>
                                      </div>
                                      <div className="output-section">
                                        <span className="output-label">Key Output:</span>
                                        <p className="output-value">{phase['key-output']}</p>
                                      </div>
                                    </div>
                                  </div>

                                  {/* Visual connector between phases (except for last one) */}
                                  {phaseIndex < block.elements.length - 1 && (
                                    <div className="phase-connector">
                                      <div className="connector-line"></div>
                                      <div className="connector-arrow">↓</div>
                                    </div>
                                  )}
                                </div>
                              ))
                            }
                          </div>

                          {block.note && (
                            <div className="framework-note">
                              <p className="note-text">
                                <strong>Note:</strong> {block.note}
                              </p>
                            </div>
                          )}
                        </div>
                      );
                      case 'deep-dive':
                        return (
                          <div key={index} className="deep-dive-section">
                            <h3 className="deep-dive-title">{block.title}</h3>

                            <div className="levels-container">
                              {Array.isArray(block?.levels) &&
                                block.levels.map((level, levelIndex) => (
                                  <div key={levelIndex} className={`level-card level-${levelIndex + 1}`}>
                                    <div className="level-header">
                                      <div className="level-indicator">
                                        <span className="level-number">L{levelIndex + 1}</span>
                                      </div>
                                      <div className="level-title-container">
                                        <h4 className="level-title">{level.level}</h4>
                                        <p className="level-subtitle">{level.description}</p>
                                      </div>
                                    </div>

                                    <div className="level-content">
                                      <div className="activities-section">
                                        <h5 className="activities-title">Key Activities:</h5>
                                        <ul className="activities-list">
                                          {Array.isArray(level.activities) &&
                                            level.activities.map((activity, activityIndex) => (
                                              <li key={activityIndex} className="activity-item">
                                                <span className="activity-icon">✓</span>
                                                {activity}
                                              </li>
                                            ))
                                          }
                                        </ul>
                                      </div>

                                      <div className="risk-section">
                                        <div className="risk-label">Risk/Impact:</div>
                                        <div className="risk-text">{level.risk}</div>
                                      </div>
                                    </div>
                                  </div>
                                ))
                              }
                            </div>
                          </div>
                        );


                case 'module':
                    return (
                        <div key={index} className="advanced-module card border-primary my-5">
                            <div className="card-header bg-primary bg-opacity-10 d-flex justify-content-between align-items-center">
                                <div>
                                    <h3 className="card-title mb-1">
                                        {block.icon && <i className={`${block.icon} me-2`}></i>}
                                        {block.title}
                                    </h3>
                                    {block.duration && (
                                        <span className="badge bg-primary">
                                            <i className="fas fa-clock me-1"></i>
                                            {block.duration} min
                                        </span>
                                    )}
                                </div>
                                {block.status && (
                                    <span className={`module-status badge ${getStatusBadgeClass(block.status)}`}>
                                        {block.status}
                                    </span>
                                )}
                            </div>

                            <div className="card-body">
                                {/* Module Metadata */}
                                {(block.difficulty || block.objectives || block.prerequisites) && (
                                    <div className="module-metadata row g-3 mb-4">
                                        {block.difficulty && (
                                            <div className="col-md-4">
                                                <div className="metadata-item">
                                                    <strong>Difficulty:</strong>
                                                    <span className={`badge bg-${getDifficultyColor(block.difficulty)} ms-2`}>
                                                        {block.difficulty}
                                                    </span>
                                                </div>
                                            </div>
                                        )}
                                        {block.rating && (
                                            <div className="col-md-4">
                                                <div className="metadata-item">
                                                    <strong>Rating:</strong>
                                                    <span className="ms-2">
                                                        <i className="fas fa-star text-warning"></i>
                                                        {block.rating}%
                                                    </span>
                                                </div>
                                            </div>
                                        )}
                                        {block.credits && (
                                            <div className="col-md-4">
                                                <div className="metadata-item">
                                                    <strong>Credits:</strong>
                                                    <span className="ms-2">{block.credits}</span>
                                                </div>
                                            </div>
                                        )}
                                    </div>
                                )}

                                {/* Learning Objectives */}
                                {block.learningObjectives && (
                                    <div className="learning-objectives mb-4">
                                        <h5 className="d-flex align-items-center">
                                            <i className="fas fa-bullseye me-2 text-primary"></i>
                                            Learning Objectives
                                        </h5>
                                        <ul className="list-group list-group-flush">
                                            {block.learningObjectives.map((objective, i) => (
                                                <li key={i} className="list-group-item d-flex align-items-start">
                                                    <i className="fas fa-check-circle text-success me-2 mt-1"></i>
                                                    <span>{objective}</span>
                                                </li>
                                            ))}
                                        </ul>
                                    </div>
                                )}

                                {/* Prerequisites */}
                                {block.prerequisites && (
                                    <div className="prerequisites mb-4">
                                        <h5 className="d-flex align-items-center">
                                            <i className="fas fa-clipboard-check me-2 text-warning"></i>
                                            Prerequisites
                                        </h5>
                                        <div className="prerequisites-content">
                                            {Array.isArray(block.prerequisites) ? (
                                                <ul className="list-unstyled">
                                                    {block.prerequisites.map((prereq, i) => (
                                                        <li key={i} className="d-flex align-items-start mb-2">
                                                            <i className="fas fa-arrow-right text-muted me-2 mt-1"></i>
                                                            <span>{prereq}</span>
                                                        </li>
                                                    ))}
                                                </ul>
                                            ) : (
                                                <ReactMarkdown components={markdownComponents}>
                                                    {block.prerequisites}
                                                </ReactMarkdown>
                                            )}
                                        </div>
                                    </div>
                                )}

                                {/* Module Content */}
                                {block.content && (
                                    <div className="module-content">
                                        <ContentRenderer
                                            content={block.content}
                                            baseUrl={baseUrl}
                                            imageWrapperClass={imageWrapperClass}
                                            imageClass={imageClass}
                                            maxImageHeight={maxImageHeight}
                                            fallbackImage={fallbackImage}
                                            theme={theme}
                                            interactive={interactive}
                                        />
                                    </div>
                                )}

                                {/* Key Takeaways */}
                                {block.keyTakeaways && (
                                    <div className="key-takeaways card border-success mt-4">
                                        <div className="card-header bg-success bg-opacity-10">
                                            <h5 className="mb-0 d-flex align-items-center">
                                                <i className="fas fa-key me-2 text-success"></i>
                                                Key Takeaways
                                            </h5>
                                        </div>
                                        <div className="card-body">
                                            <ul className="mb-0">
                                                {block.keyTakeaways.map((takeaway, i) => (
                                                    <li key={i} className="mb-2">
                                                        <ReactMarkdown components={markdownComponents}>
                                                            {takeaway}
                                                        </ReactMarkdown>
                                                    </li>
                                                ))}
                                            </ul>
                                        </div>
                                    </div>
                                )}

                                {/* Resources */}
                                {block.resources && (
                                    <div className="module-resources mt-4">
                                        <h5 className="d-flex align-items-center">
                                            <i className="fas fa-tools me-2 text-info"></i>
                                            Resources & Tools
                                        </h5>
                                        <div className="row g-3">
                                            {block.resources.map((resource, i) => (
                                                <div key={i} className="col-md-6">
                                                    <div className="resource-card card h-100">
                                                        <div className="card-body">
                                                            <h6 className="card-title">
                                                                {resource.icon && <i className={`${resource.icon} me-2`}></i>}
                                                                {resource.title}
                                                            </h6>
                                                            {resource.description && (
                                                                <p className="card-text small text-muted">{resource.description}</p>
                                                            )}
                                                            {resource.link && (
                                                                <a
                                                                    href={resource.link}
                                                                    target="_blank"
                                                                    rel="noopener noreferrer"
                                                                    className="btn btn-sm btn-outline-primary"
                                                                >
                                                                    Access Resource
                                                                </a>
                                                            )}
                                                        </div>
                                                    </div>
                                                </div>
                                            ))}
                                        </div>
                                    </div>
                                )}

                                {/* Assessment */}
                                {block.assessment && (
                                    <div className="module-assessment card border-warning mt-4">
                                        <div className="card-header bg-warning bg-opacity-10">
                                            <h5 className="mb-0 d-flex align-items-center">
                                                <i className="fas fa-tasks me-2 text-warning"></i>
                                                Assessment Criteria
                                            </h5>
                                        </div>
                                        <div className="card-body">
                                            {block.assessment.criteria && (
                                                <div className="assessment-criteria mb-3">
                                                    <h6>Success Criteria:</h6>
                                                    <ul>
                                                        {block.assessment.criteria.map((criterion, i) => (
                                                            <li key={i}>{criterion}</li>
                                                        ))}
                                                    </ul>
                                                </div>
                                            )}
                                            {block.assessment.grading && (
                                                <div className="assessment-grading">
                                                    <h6>Grading Scale:</h6>
                                                    <div className="table-responsive">
                                                        <table className="table table-sm table-bordered">
                                                            <thead>
                                                            <tr>
                                                                <th>Grade</th>
                                                                <th>Requirements</th>
                                                                <th>Points</th>
                                                            </tr>
                                                            </thead>
                                                            <tbody>
                                                            {block.assessment.grading.map((grade, i) => (
                                                                <tr key={i}>
                                                                    <td>
                                                                        <span className={`badge bg-${getDifficultyColor(grade.level)}`}>
                                                                            {grade.level}
                                                                        </span>
                                                                    </td>
                                                                    <td>{grade.requirements}</td>
                                                                    <td>{grade.points}</td>
                                                                </tr>
                                                            ))}
                                                            </tbody>
                                                        </table>
                                                    </div>
                                                </div>
                                            )}
                                        </div>
                                    </div>
                                )}

                                {/* Progress Tracking */}
                                {interactive && (
                                    <div className="module-progress mt-4 p-3 bg-light rounded">
                                        <div className="d-flex justify-content-between align-items-center">
                                            <div>
                                                <strong>Module Progress</strong>
                                                <div className="progress mt-2" style={{height: '8px', width: '200px'}}>
                                                    <div
                                                        className="progress-bar"
                                                        role="progressbar"
                                                        style={{width: block.progress ? `${block.progress}%` : '0%'}}
                                                        aria-valuenow={block.progress || 0}
                                                        aria-valuemin="0"
                                                        aria-valuemax="100"
                                                    >
                                                    </div>
                                                </div>
                                            </div>
                                            <div className="module-actions">
                                                <button className="btn btn-sm btn-outline-primary me-2">
                                                    <i className="fas fa-bookmark me-1"></i>
                                                    Save
                                                </button>
                                                <button className="btn btn-sm btn-primary">
                                                    <i className="fas fa-forward me-1"></i>
                                                    Continue
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                )}
                            </div>

                            {/* Module Footer */}
                            {(block.tags || block.author || block.lastUpdated) && (
                                <div className="card-footer bg-transparent">
                                    <div className="d-flex justify-content-between align-items-center">
                                        <div>
                                            {block.tags && (
                                                <div className="module-tags">
                                                    {block.tags.map((tag, i) => (
                                                        <span key={i} className="badge bg-secondary me-1">{tag}</span>
                                                    ))}
                                                </div>
                                            )}
                                        </div>
                                        <div className="text-muted small">
                                            {block.author && <span className="me-3">By: {block.author}</span>}
                                            {block.lastUpdated && <span>Updated: {block.lastUpdated}</span>}
                                        </div>
                                    </div>
                                </div>
                            )}
                        </div>
                    );

                 default:
                                    return (
                                        <div key={blockKey} className="unsupported-block my-3">
                                            <div className="alert alert-warning">
                                                Unsupported content type: {block.type}
                                            </div>
                                            {block.fallback && renderBlock(block.fallback, index, depth + 1)}
                                        </div>
                                    );
                            }
                        } catch (error) {
                            return (
                                <ContentErrorBoundary
                                    key={blockKey}
                                    fallback={block.fallback || 'Failed to render this block'}
                                    onRetry={() => handleRetryBlock?.(index)}
                                >
                                    <div className="alert alert-danger">
                                        Rendering error: {error.message}
                                    </div>
                                </ContentErrorBoundary>
                            );
                        }
                    }, [retryKeys, handleRetryBlock]);

                    if (typeof content === 'string') {
                        return (
                            <ContentErrorBoundary fallback={content}>
                                <ReactMarkdown>{content}</ReactMarkdown>
                            </ContentErrorBoundary>
                        );
                    }

                    if (Array.isArray(content)) {
                        return (
                            <div className={`content-renderer theme-${theme}`}>
                                {content.map((block, index) => {
                                    const blockKey = `${index}-${retryKeys[index] || '0'}`;
                                    return (
                                        <ContentErrorBoundary
                                            key={blockKey}
                                            fallback={block?.fallback}
                                            onRetry={() => handleRetryBlock?.(index)}
                                        >
                                            {renderBlock(block, index, 0)}
                                        </ContentErrorBoundary>
                                    );
                                })}
                            </div>
                        );
                    }

                    return (
                        <div className="alert alert-info text-center">
                            No content available or unrecognized content format
                        </div>
                    );
                };

ContentRenderer.propTypes = {
    content: PropTypes.oneOfType([
        PropTypes.string,
        PropTypes.array,
        PropTypes.object
    ]).isRequired,
    contentType: PropTypes.string,
    baseUrl: PropTypes.string,
    imageWrapperClass: PropTypes.string,
    imageClass: PropTypes.string,
    maxImageHeight: PropTypes.string,
    fallbackImage: PropTypes.string,
    theme: PropTypes.oneOf(['light', 'dark']),
    interactive: PropTypes.bool,
    onContentRendered: PropTypes.func

};

ContentRenderer.defaultProps = {
    theme: 'light',
    interactive: true
};

export default React.memo(ContentRenderer);