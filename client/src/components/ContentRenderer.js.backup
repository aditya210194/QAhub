                                        </div>
                                    </div>

                                    <div className="benefits-section mt-3">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-gift me-1 text-success"></i>
                                            Key Benefits
                                        </small>
                                        <div className="benefits-list">
                                            {pattern.benefits.map((benefit, benefitIndex) => (
                                                <div key={benefitIndex} className="benefit-item d-flex align-items-start mb-1">
                                                    <i className="fas fa-check-circle text-success mt-1 me-2 small"></i>
                                                    <span className="small">{benefit}</span>
                                                </div>
                                            ))}
                                        </div>
                                    </div>
                                </div>
                            )}
                        </div>
                    ))}
                </div>
            </div>
        </div>
    );
};

// Integration Checklist Component
const IntegrationChecklistBlock = ({ block, index }) => {
    const [checkedItems, setCheckedItems] = useState({});

    const toggleCheck = (categoryIndex, checkIndex) => {
        const key = `${categoryIndex}-${checkIndex}`;
        setCheckedItems(prev => ({
            ...prev,
            [key]: !prev[key]
        }));
    };

    return (
        <div className="integration-checklist-block card my-4 border-warning border-opacity-25">
            <div className="card-header bg-warning bg-opacity-10 border-warning">
                <div className="d-flex align-items-center">
                    <i className="fas fa-tasks text-warning me-2"></i>
                    <h5 className="card-title mb-0 text-dark">{block.title}</h5>
                </div>
            </div>

            <div className="card-body">
                <div className="checklist-categories">
                    {block.items.map((category, categoryIndex) => (
                        <div key={categoryIndex} className="checklist-category mb-4">
                            <h6 className="text-primary mb-3">
                                <i className="fas fa-folder me-2"></i>
                                {category.category}
                            </h6>

                            <div className="checklist-items">
                                {category.checks.map((check, checkIndex) => {
                                    const key = `${categoryIndex}-${checkIndex}`;
                                    const isChecked = checkedItems[key] || false;

                                    return (
                                        <div key={checkIndex} className="checklist-item card mb-2">
                                            <div className="card-body py-2">
                                                <div className="form-check">
                                                    <input
                                                        className="form-check-input"
                                                        type="checkbox"
                                                        checked={isChecked}
                                                        onChange={() => toggleCheck(categoryIndex, checkIndex)}
                                                        id={`check-${key}`}
                                                    />
                                                    <label
                                                        className={`form-check-label ${isChecked ? 'text-muted text-decoration-line-through' : ''}`}
                                                        htmlFor={`check-${key}`}
                                                    >
                                                        {check}
                                                    </label>
                                                </div>
                                            </div>
                                        </div>
                                    );
                                })}
                            </div>
                        </div>
                    ))}
                </div>

                {/* Progress Summary */}
                <div className="checklist-progress mt-4 p-3 bg-light rounded">
                    <h6 className="text-primary mb-3">
                        <i className="fas fa-chart-bar me-2"></i>
                        Integration Readiness Progress
                    </h6>
                    <div className="progress mb-2" style={{height: '20px'}}>
                        <div
                            className="progress-bar bg-success"
                            style={{
                                width: `${(Object.values(checkedItems).filter(Boolean).length /
                                    block.items.reduce((total, category) => total + category.checks.length, 0)) * 100}%`
                            }}
                        >
                            {Math.round((Object.values(checkedItems).filter(Boolean).length /
                                block.items.reduce((total, category) => total + category.checks.length, 0)) * 100)}%
                        </div>
                    </div>
                    <small className="text-muted">
                        {Object.values(checkedItems).filter(Boolean).length} of {block.items.reduce((total, category) => total + category.checks.length, 0)} items completed
                    </small>
                </div>
            </div>
        </div>
    );
};

// Vendor Roadmap Component
const VendorRoadmapBlock = ({ block, index }) => {
    const [expandedVendor, setExpandedVendor] = useState(null);

    return (
        <div className="vendor-roadmap-block card my-4 border-primary border-opacity-25">
            <div className="card-header bg-primary bg-opacity-10 border-primary">
                <div className="d-flex align-items-center">
                    <i className="fas fa-road text-primary me-2"></i>
                    <h5 className="card-title mb-0 text-dark">{block.title}</h5>
                </div>
            </div>

            <div className="card-body">
                <div className="vendor-roadmaps">
                    {block.vendors.map((vendor, vendorIndex) => (
                        <div key={vendorIndex} className="vendor-roadmap card mb-4">
                            <div
                                className="card-header bg-primary text-white cursor-pointer"
                                onClick={() => setExpandedVendor(expandedVendor === vendorIndex ? null : vendorIndex)}
                            >
                                <div className="d-flex justify-content-between align-items-center">
                                    <h6 className="mb-0">{vendor.vendor}</h6>
                                    <i className={`fas fa-chevron-${expandedVendor === vendorIndex ? 'up' : 'down'}`}></i>
                                </div>
                            </div>

                            {expandedVendor === vendorIndex && (
                                <div className="card-body">
                                    <div className="roadmap-timeline">
                                        <div className="timeline-item mb-4">
                                            <div className="timeline-header d-flex align-items-center mb-2">
                                                <span className="badge bg-success me-3">Near-term</span>
                                                <small className="text-muted">(0-12 months)</small>
                                            </div>
                                            <p className="small mb-0">{vendor['near-term']}</p>
                                        </div>

                                        <div className="timeline-item mb-4">
                                            <div className="timeline-header d-flex align-items-center mb-2">
                                                <span className="badge bg-warning me-3">Mid-term</span>
                                                <small className="text-muted">(12-24 months)</small>
                                            </div>
                                            <p className="small mb-0">{vendor['mid-term']}</p>
                                        </div>

                                        <div className="timeline-item">
                                            <div className="timeline-header d-flex align-items-center mb-2">
                                                <span className="badge bg-info me-3">Long-term</span>
                                                <small className="text-muted">(24+ months)</small>
                                            </div>
                                            <p className="small mb-0">{vendor['long-term']}</p>
                                        </div>
                                    </div>

                                    <div className="vendor-insights mt-3 p-2 bg-light rounded">
                                        <h6 className="text-primary small mb-2">
                                            <i className="fas fa-binoculars me-1"></i>
                                            Strategic Insights
                                        </h6>
                                        <ul className="small mb-0">
                                            <li>Monitor release notes and product updates</li>
                                            <li>Evaluate alignment with organizational roadmap</li>
                                            <li>Consider partnership opportunities</li>
                                            <li>Assess investment in emerging capabilities</li>
                                        </ul>
                                    </div>
                                </div>
                            )}
                        </div>
                    ))}
                </div>
            </div>
        </div>
    );
};
// Project Context Component


// Banking Domain Component
const BankingDomainBlock = ({ block, index }) => {
    const [copied, setCopied] = useState(false);

    const handleCopy = () => {
        let textToCopy = `${block.title}\n\n`;
        block.modules.forEach(module => {
            textToCopy += `${module.module}\n`;
            textToCopy += `Criticality: ${module.criticality}\n`;
            textToCopy += `Testing Focus: ${module['testing-focus'].join(', ')}\n`;
            textToCopy += `Compliance Requirements: ${module['compliance-requirements'].join(', ')}\n\n`;
        });
        navigator.clipboard.writeText(textToCopy);
        setCopied(true);
        setTimeout(() => setCopied(false), 2000);
    };

    return (
        <div className="banking-domain-block card my-4">
            <div className="card-header bg-success bg-opacity-10 border-success">
                <div className="d-flex justify-content-between align-items-center">
                    <div className="d-flex align-items-center">
                        <i className="fas fa-university text-success me-2"></i>
                        <h5 className="card-title mb-0 text-dark">{block.title}</h5>
                    </div>
                    <button className="btn btn-sm btn-outline-secondary" onClick={handleCopy}>
                        <i className={`fas ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                        {copied ? ' Copied!' : ' Copy'}
                    </button>
                </div>
            </div>

            <div className="card-body">
                <div className="banking-modules-grid">
                    {block.modules.map((module, moduleIndex) => (
                        <div key={moduleIndex} className="module-item mb-4 p-3 border rounded">
                            <div className="module-header mb-3">
                                <div className="d-flex justify-content-between align-items-start">
                                    <h6 className="text-success mb-0">
                                        <i className="fas fa-piggy-bank me-2"></i>
                                        {module.module}
                                    </h6>
                                    <span className={`badge ${
                                        module.criticality === 'High' ? 'bg-danger' :
                                            module.criticality === 'Medium' ? 'bg-warning' : 'bg-info'
                                    }`}>
                                        {module.criticality}
                                    </span>
                                </div>
                            </div>

                            <div className="row">
                                <div className="col-md-6">
                                    <div className="testing-focus-section mb-3">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-search me-1"></i>
                                            Testing Focus Areas
                                        </small>
                                        <div className="testing-focus-list">
                                            {module['testing-focus'].map((focus, focusIndex) => (
                                                <div key={focusIndex} className="focus-item small text-success mb-1">
                                                    ✓ {focus}
                                                </div>
                                            ))}
                                        </div>
                                    </div>
                                </div>
                                <div className="col-md-6">
                                    <div className="compliance-section">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-shield-alt me-1"></i>
                                            Compliance Requirements
                                        </small>
                                        <div className="compliance-list">
                                            {module['compliance-requirements'].map((requirement, reqIndex) => (
                                                <div key={reqIndex} className="requirement-item small bg-success bg-opacity-10 p-1 rounded mb-1">
                                                    • {requirement}
                                                </div>
                                            ))}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    );
};

// Stakeholder Map Component
