                                    <h6 className="text-info mb-0">
                                        <i className="fas fa-globe me-2"></i>
                                        {app.application}
                                    </h6>
                                    <span className={`badge ${
                                        app.complexity === 'Low' ? 'bg-success' :
                                            app.complexity === 'Medium' ? 'bg-warning' : 'bg-danger'
