const SelectionCriteriaBlock = ({ block, index }) => {
    const [expanded, setExpanded] = useState(false);
    const [copied, setCopied] = useState(false);

    const handleCopy = async () => {
        let textToCopy = `${block.title}\n\n`;
        block.criteria.forEach(criterion => {
            textToCopy += `${criterion.criterion} (Weight: ${criterion.weight})\n`;
            textToCopy += `Considerations:\n`;
            criterion.considerations.forEach(consideration => {
                textToCopy += `  • ${consideration}\n`;
            });
            textToCopy += "\n";
        });

        try {
            await navigator.clipboard.writeText(textToCopy);
            setCopied(true);
            setTimeout(() => setCopied(false), 2000);
        } catch (err) {
            console.error('Failed to copy text: ', err);
        }
    };

    const getWeightColor = (weight) => {
        const weightMap = {
            'High': 'danger',
            'Medium-High': 'warning',
            'Medium': 'info',
            'Low': 'success'
        };
        return weightMap[weight] || 'secondary';
    };

    return (
        <div className="selection-criteria-block card my-4 border-primary border-opacity-25">
            <div className="card-header bg-primary bg-opacity-10 border-primary">
                <div className="d-flex justify-content-between align-items-center">
                    <div className="d-flex align-items-center">
                        <i className="fas fa-clipboard-check text-primary me-2"></i>
                        <h5 className="card-title mb-0 text-dark">{block.title}</h5>
                    </div>
                    <div className="criteria-actions">
                        <button className="btn btn-sm btn-outline-secondary me-2" onClick={handleCopy}>
                            <i className={`fas ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                            {copied ? ' Copied!' : ' Copy'}
                        </button>
                        <button
                            className="btn btn-sm btn-outline-primary"
                            onClick={() => setExpanded(!expanded)}
                        >
                            <i className={`fas fa-${expanded ? 'minus' : 'plus'}`}></i>
                            {expanded ? ' Less' : ' More'}
                        </button>
                    </div>
                </div>
            </div>

            <div className="card-body">
                <div className="criteria-list">
                    {block.criteria.map((criterion, critIndex) => (
                        <div key={critIndex} className="criterion-item mb-3 p-3 border rounded">
                            <div className="criterion-header d-flex justify-content-between align-items-center mb-2">
                                <h6 className="mb-0 text-dark">
                                    <i className="fas fa-list-alt me-2 text-primary"></i>
                                    {criterion.criterion}
                                </h6>
                                <span className={`badge bg-${getWeightColor(criterion.weight)}`}>
                                    {criterion.weight} Priority
                                </span>
                            </div>

                            <div className="considerations">
                                <small className="text-muted d-block mb-2">
                                    <i className="fas fa-lightbulb me-1"></i>
                                    Key Considerations:
                                </small>
                                <div className="considerations-grid">
                                    {criterion.considerations.map((consideration, consIndex) => (
                                        <div key={consIndex} className="consideration-item d-flex align-items-center mb-1">
                                            <i className="fas fa-check-circle text-success me-2 small"></i>
                                            <span className="small">{consideration}</span>
                                        </div>
                                    ))}
                                </div>
                            </div>
                        </div>
                    ))}
                </div>

                {expanded && (
                    <div className="expanded-content mt-4 p-3 bg-light rounded">
                        <h6 className="text-primary mb-3">
                            <i className="fas fa-chart-line me-2"></i>
                            Selection Strategy
                        </h6>
                        <div className="row">
                            <div className="col-md-6">
                                <div className="priority-breakdown">
                                    <h6 className="text-muted small">Priority Distribution:</h6>
                                    {block.criteria.map((criterion, index) => (
                                        <div key={index} className="d-flex justify-content-between align-items-center mb-1">
                                            <small>{criterion.criterion}</small>
                                            <span className={`badge bg-${getWeightColor(criterion.weight)}`}>
                                                {criterion.weight}
                                            </span>
                                        </div>
                                    ))}
                                </div>
                            </div>
                            <div className="col-md-6">
                                <div className="selection-tips">
                                    <h6 className="text-muted small">Evaluation Tips:</h6>
                                    <ul className="small mb-0">
                                        <li>Focus on High priority criteria first</li>
                                        <li>Consider team capabilities and constraints</li>
                                        <li>Evaluate long-term scalability needs</li>
                                        <li>Balance cost vs. functionality requirements</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                )}
            </div>
        </div>
    );
};

// Technology Comparison Component
const TechnologyComparisonBlock = ({ block, index }) => {
    const [copied, setCopied] = useState(false);

    const handleCopy = async () => {
        let textToCopy = `${block.title}\n\n`;
        textToCopy += `${block.headers.join(' | ')}\n`;
        textToCopy += "―".repeat(50) + "\n";

        block.rows.forEach(row => {
            textToCopy += `${row.join(' | ')}\n`;
        });

        try {
            await navigator.clipboard.writeText(textToCopy);
            setCopied(true);
            setTimeout(() => setCopied(false), 2000);
        } catch (err) {
            console.error('Failed to copy text: ', err);
        }
    };

    return (
        <div className="technology-comparison-block card my-4 border-warning border-opacity-25">
            <div className="card-header bg-warning bg-opacity-10 border-warning">
                <div className="d-flex justify-content-between align-items-center">
                    <div className="d-flex align-items-center">
                        <i className="fas fa-balance-scale text-warning me-2"></i>
                        <h5 className="card-title mb-0 text-dark">{block.title}</h5>
                    </div>
                    <button className="btn btn-sm btn-outline-secondary" onClick={handleCopy}>
                        <i className={`fas ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                        {copied ? ' Copied!' : ' Copy'}
                    </button>
                </div>
            </div>

            <div className="card-body p-0">
                <div className="table-responsive">
                    <table className="table table-bordered table-hover mb-0">
                        <thead className="table-light">
                        <tr>
                            {block.headers.map((header, headerIndex) => (
                                <th key={headerIndex} className={
                                    headerIndex === 0 ? 'bg-light' :
                                        header.includes('Traditional') ? 'bg-danger bg-opacity-10' :
                                            'bg-success bg-opacity-10'
                                }>
                                    {header}
                                </th>
                            ))}
                        </tr>
                        </thead>
                        <tbody>
                        {block.rows.map((row, rowIndex) => (
                            <tr key={rowIndex}>
                                {row.map((cell, cellIndex) => (
                                    <td key={cellIndex} className={
                                        cellIndex === 0 ? 'fw-bold bg-light' :
                                            cellIndex === 1 ? 'text-danger' : 'text-success'
                                    }>
                                        {cellIndex > 0 ? (
                                            <div className="d-flex align-items-center">
                                                <i className={`fas fa-${
                                                    cellIndex === 1 ? 'times text-danger' : 'check text-success'
                                                } me-2`}></i>
                                                {cell}
                                            </div>
                                        ) : (
                                            cell
                                        )}
                                    </td>
                                ))}
                            </tr>
                        ))}
                        </tbody>
                    </table>
                </div>

                <div className="p-3 border-top">
                    <div className="row text-center">
                        <div className="col-md-6">
                            <div className="traditional-side p-2 bg-danger bg-opacity-10 rounded">
                                <h6 className="text-danger mb-1">
                                    <i className="fas fa-times me-2"></i>
                                    Traditional Limitations
                                </h6>
                                <small className="text-muted">Manual, time-consuming, error-prone</small>
                            </div>
                        </div>
                        <div className="col-md-6">
                            <div className="ai-side p-2 bg-success bg-opacity-10 rounded">
                                <h6 className="text-success mb-1">
                                    <i className="fas fa-check me-2"></i>
                                    AI Advantages
                                </h6>
                                <small className="text-muted">Automated, intelligent, scalable</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    );
};
// Healing Mechanisms Component
const HealingMechanismsBlock = ({ block, index }) => {
    const [expanded, setExpanded] = useState(false);
    const [copied, setCopied] = useState(false);

    const handleCopy = async () => {
        let textToCopy = `${block.title}\n\n`;
        block.mechanisms.forEach(mechanism => {
            textToCopy += `${mechanism.mechanism}\n`;
            textToCopy += `Problem: ${mechanism.problem}\n`;
            textToCopy += `AI Solution: ${mechanism['ai-solution']}\n`;
            textToCopy += `Recovery Rate: ${mechanism['recovery-rate']}\n`;
            textToCopy += `Implementation Complexity: ${mechanism['implementation-complexity']}\n\n`;
        });

        try {
            await navigator.clipboard.writeText(textToCopy);
            setCopied(true);
            setTimeout(() => setCopied(false), 2000);
        } catch (err) {
            console.error('Failed to copy text: ', err);
        }
    };

    const getComplexityColor = (complexity) => {
        const complexityMap = {
            'Low': 'success',
            'Low-Medium': 'info',
            'Medium': 'warning',
            'High': 'danger'
        };
        return complexityMap[complexity] || 'secondary';
    };

    const getRecoveryColor = (recovery) => {
        const rate = parseInt(recovery);
        if (rate >= 90) return 'success';
        if (rate >= 80) return 'warning';
        return 'danger';
    };

    return (
        <div className="healing-mechanisms-block card my-4 border-info border-opacity-25">
            <div className="card-header bg-info bg-opacity-10 border-info">
                <div className="d-flex justify-content-between align-items-center">
                    <div className="d-flex align-items-center">
                        <i className="fas fa-stethoscope text-info me-2"></i>
                        <h5 className="card-title mb-0 text-dark">{block.title}</h5>
                    </div>
                    <div className="mechanisms-actions">
                        <button className="btn btn-sm btn-outline-secondary me-2" onClick={handleCopy}>
                            <i className={`fas ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                            {copied ? ' Copied!' : ' Copy'}
                        </button>
                        <button
                            className="btn btn-sm btn-outline-primary"
                            onClick={() => setExpanded(!expanded)}
                        >
                            <i className={`fas fa-${expanded ? 'minus' : 'plus'}`}></i>
                            {expanded ? ' Less' : ' More'}
                        </button>
                    </div>
                </div>
            </div>

            <div className="card-body">
                <div className="mechanisms-grid">
                    {block.mechanisms.map((mechanism, mechIndex) => (
                        <div key={mechIndex} className="mechanism-item card mb-3">
                            <div className="card-body">
                                <div className="mechanism-header d-flex justify-content-between align-items-start mb-3">
                                    <div>
                                        <h6 className="text-info mb-1">
                                            <i className="fas fa-cogs me-2"></i>
                                            {mechanism.mechanism}
                                        </h6>
                                        <div className="mechanism-meta">
                                            <span className={`badge bg-${getRecoveryColor(mechanism['recovery-rate'])} me-2`}>
                                                {mechanism['recovery-rate']} Recovery
                                            </span>
                                            <span className={`badge bg-${getComplexityColor(mechanism['implementation-complexity'])}`}>
                                                {mechanism['implementation-complexity']} Complexity
                                            </span>
                                        </div>
                                    </div>
                                </div>

                                <div className="row">
                                    <div className="col-md-6">
                                        <div className="problem-section mb-3">
                                            <small className="text-muted d-block mb-1">
                                                <i className="fas fa-exclamation-triangle me-1 text-danger"></i>
                                                Problem
                                            </small>
                                            <p className="small mb-0">{mechanism.problem}</p>
                                        </div>
                                    </div>
                                    <div className="col-md-6">
                                        <div className="solution-section mb-3">
                                            <small className="text-muted d-block mb-1">
                                                <i className="fas fa-lightbulb me-1 text-warning"></i>
                                                AI Solution
                                            </small>
                                            <p className="small mb-0">{mechanism['ai-solution']}</p>
                                        </div>
                                    </div>
                                </div>

                                {expanded && (
                                    <div className="expanded-details mt-3 p-3 bg-light rounded">
                                        <h6 className="text-primary small mb-2">
                                            <i className="fas fa-info-circle me-1"></i>
                                            Implementation Insights
                                        </h6>
                                        <div className="row">
                                            <div className="col-md-6">
                                                <small className="text-muted d-block">Best For:</small>
                                                <span className="badge bg-success me-1">Dynamic Applications</span>
                                                <span className="badge bg-info">Frequent UI Changes</span>
                                            </div>
                                            <div className="col-md-6">
                                                <small className="text-muted d-block">Typical ROI:</small>
                                                <span className="badge bg-warning">60-80% Maintenance Reduction</span>
                                            </div>
                                        </div>
                                    </div>
                                )}
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    );
};

// Workflow Diagram Component
const WorkflowDiagramBlock = ({ block, index }) => {
    const [activeStep, setActiveStep] = useState(0);

    return (
        <div className="workflow-diagram-block card my-4 border-primary border-opacity-25">
            <div className="card-header bg-primary bg-opacity-10 border-primary">
                <div className="d-flex align-items-center">
                    <i className="fas fa-project-diagram text-primary me-2"></i>
                    <h5 className="card-title mb-0 text-dark">{block.title}</h5>
                </div>
            </div>

            <div className="card-body">
                {/* Workflow Steps Visualization */}
                <div className="workflow-steps mb-4">
                    {block.steps.map((step, stepIndex) => (
                        <div
                            key={stepIndex}
                            className={`workflow-step card mb-3 ${activeStep === stepIndex ? 'border-primary' : ''}`}
                            onClick={() => setActiveStep(stepIndex)}
                        >
                            <div className={`card-header cursor-pointer ${activeStep === stepIndex ? 'bg-primary text-white' : 'bg-light'}`}>
                                <div className="d-flex justify-content-between align-items-center">
                                    <div className="d-flex align-items-center">
                                        <span className={`badge ${activeStep === stepIndex ? 'bg-light text-primary' : 'bg-primary'} me-3`}>
                                            {step.step}
                                        </span>
                                        <h6 className="mb-0">{step.step.split('. ')[1]}</h6>
                                    </div>
                                    <i className={`fas fa-chevron-${activeStep === stepIndex ? 'up' : 'down'}`}></i>
                                </div>
                            </div>

                            {activeStep === stepIndex && (
                                <div className="card-body">
                                    <div className="row">
                                        <div className="col-md-6">
                                            <h6 className="text-info small mb-2">
                                                <i className="fas fa-tasks me-1"></i>
                                                Activities
                                            </h6>
                                            <ul className="small mb-3">
                                                {step.activities.map((activity, activityIndex) => (
                                                    <li key={activityIndex}>{activity}</li>
                                                ))}
                                            </ul>
                                        </div>
                                        <div className="col-md-6">
                                            <h6 className="text-success small mb-2">
                                                <i className="fas fa-robot me-1"></i>
                                                AI Features
                                            </h6>
                                            <div className="ai-features">
                                                {step['ai-features'].map((feature, featureIndex) => (
                                                    <span key={featureIndex} className="badge bg-success bg-opacity-20 text-success border border-success me-1 mb-1 small">
                                                        {feature}
                                                    </span>
                                                ))}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            )}
                        </div>
                    ))}
                </div>

                {/* Workflow Visualization */}
                <div className="workflow-visualization text-center p-4 bg-light rounded">
                    <div className="steps-flow d-flex justify-content-between align-items-center position-relative">
                        {block.steps.map((step, stepIndex) => (
                            <React.Fragment key={stepIndex}>
                                <div
                                    className={`step-node ${activeStep === stepIndex ? 'active' : ''}`}
                                    onClick={() => setActiveStep(stepIndex)}
                                >
                                    <div className="node-number">{stepIndex + 1}</div>
                                    <div className="node-label small">{step.step.split('. ')[1]}</div>
                                </div>
                                {stepIndex < block.steps.length - 1 && (
                                    <div className="flow-arrow">
                                        <i className="fas fa-arrow-right text-muted"></i>
                                    </div>
                                )}
                            </React.Fragment>
                        ))}
                    </div>
                </div>
            </div>
        </div>
    );
};
