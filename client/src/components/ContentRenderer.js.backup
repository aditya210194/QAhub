// Pattern Selection Component
const PatternSelectionBlock = ({ block, index }) => {
    const [selectedCriterion, setSelectedCriterion] = useState(0);

    return (
        <div className="pattern-selection-block card my-4 border-warning border-opacity-25">
            <div className="card-header bg-warning bg-opacity-10 border-warning">
                <div className="d-flex align-items-center">
                    <i className="fas fa-sitemap text-warning me-2"></i>
                    <h5 className="card-title mb-0 text-dark">{block.title}</h5>
                </div>
            </div>

            <div className="card-body">
                {/* Criteria Selection */}
                <div className="criteria-selection mb-4">
                    <div className="row">
                        {block.criteria.map((criterion, critIndex) => (
                            <div key={critIndex} className="col-md-4 mb-3">
                                <div
                                    className={`criteria-card card text-center cursor-pointer ${selectedCriterion === critIndex ? 'border-warning' : ''}`}
                                    onClick={() => setSelectedCriterion(critIndex)}
                                >
                                    <div className={`card-body ${selectedCriterion === critIndex ? 'bg-warning bg-opacity-10' : ''}`}>
                                        <h6 className="card-title text-dark">{criterion.criterion}</h6>
                                    </div>
                                </div>
                            </div>
                        ))}
                    </div>
                </div>

                {/* Pattern Recommendations */}
                <div className="pattern-recommendations">
                    <h6 className="text-primary mb-3">
                        <i className="fas fa-lightbulb me-2"></i>
                        Recommended Patterns for {block.criteria[selectedCriterion].criterion}
                    </h6>

                    <div className="row">
                        {/* High Priority Patterns */}
                        <div className="col-md-4">
                            <div className="priority-section">
                                <h6 className="text-success small mb-2">
                                    <i className="fas fa-arrow-up me-1"></i>
                                    High Priority
                                </h6>
                                {block.criteria[selectedCriterion]['high-changes']?.map((pattern, patternIndex) => (
                                        <div key={patternIndex} className="pattern-item card border-success mb-2">
                                            <div className="card-body py-2 bg-success bg-opacity-10">
                                                <small className="text-success">{pattern}</small>
                                            </div>
                                        </div>
                                    )) ||
                                    block.criteria[selectedCriterion]['high-criticality']?.map((pattern, patternIndex) => (
                                        <div key={patternIndex} className="pattern-item card border-success mb-2">
                                            <div className="card-body py-2 bg-success bg-opacity-10">
                                                <small className="text-success">{pattern}</small>
                                            </div>
                                        </div>
                                    )) ||
                                    block.criteria[selectedCriterion]['low-complexity']?.map((pattern, patternIndex) => (
                                        <div key={patternIndex} className="pattern-item card border-success mb-2">
                                            <div className="card-body py-2 bg-success bg-opacity-10">
                                                <small className="text-success">{pattern}</small>
                                            </div>
                                        </div>
                                    ))}
                            </div>
                        </div>

                        {/* Medium Priority Patterns */}
                        <div className="col-md-4">
                            <div className="priority-section">
                                <h6 className="text-warning small mb-2">
                                    <i className="fas fa-minus me-1"></i>
                                    Medium Priority
                                </h6>
                                {block.criteria[selectedCriterion]['medium-changes']?.map((pattern, patternIndex) => (
                                        <div key={patternIndex} className="pattern-item card border-warning mb-2">
                                            <div className="card-body py-2 bg-warning bg-opacity-10">
                                                <small className="text-warning">{pattern}</small>
                                            </div>
                                        </div>
                                    )) ||
                                    block.criteria[selectedCriterion]['medium-criticality']?.map((pattern, patternIndex) => (
                                        <div key={patternIndex} className="pattern-item card border-warning mb-2">
                                            <div className="card-body py-2 bg-warning bg-opacity-10">
                                                <small className="text-warning">{pattern}</small>
                                            </div>
                                        </div>
                                    )) ||
                                    block.criteria[selectedCriterion]['medium-complexity']?.map((pattern, patternIndex) => (
                                        <div key={patternIndex} className="pattern-item card border-warning mb-2">
                                            <div className="card-body py-2 bg-warning bg-opacity-10">
                                                <small className="text-warning">{pattern}</small>
                                            </div>
                                        </div>
                                    ))}
                            </div>
                        </div>

                        {/* Low Priority Patterns */}
                        <div className="col-md-4">
                            <div className="priority-section">
                                <h6 className="text-info small mb-2">
                                    <i className="fas fa-arrow-down me-1"></i>
                                    Low Priority
                                </h6>
                                {block.criteria[selectedCriterion]['low-changes']?.map((pattern, patternIndex) => (
                                        <div key={patternIndex} className="pattern-item card border-info mb-2">
                                            <div className="card-body py-2 bg-info bg-opacity-10">
                                                <small className="text-info">{pattern}</small>
                                            </div>
                                        </div>
                                    )) ||
                                    block.criteria[selectedCriterion]['low-criticality']?.map((pattern, patternIndex) => (
                                        <div key={patternIndex} className="pattern-item card border-info mb-2">
                                            <div className="card-body py-2 bg-info bg-opacity-10">
                                                <small className="text-info">{pattern}</small>
                                            </div>
                                        </div>
                                    )) ||
                                    block.criteria[selectedCriterion]['high-complexity']?.map((pattern, patternIndex) => (
                                        <div key={patternIndex} className="pattern-item card border-info mb-2">
                                            <div className="card-body py-2 bg-info bg-opacity-10">
                                                <small className="text-info">{pattern}</small>
                                            </div>
                                        </div>
                                    ))}
                            </div>
                        </div>
                    </div>
                </div>

                {/* Selection Guidance */}
                <div className="selection-guidance mt-4 p-3 bg-light rounded">
                    <h6 className="text-primary small mb-2">
                        <i className="fas fa-graduation-cap me-1"></i>
                        Selection Guidance
                    </h6>
                    <ul className="small mb-0">
                        <li>Start with High Priority patterns for quick wins</li>
                        <li>Consider team expertise and implementation complexity</li>
                        <li>Evaluate patterns based on your specific application characteristics</li>
                        <li>Combine multiple patterns for comprehensive coverage</li>
                    </ul>
                </div>
            </div>
        </div>
    );
};
// Metrics Framework Component
const MetricsFrameworkBlock = ({ block, index }) => {
    const [expandedCategory, setExpandedCategory] = useState(null);
    const [copied, setCopied] = useState(false);

    const handleCopy = async () => {
        let textToCopy = `${block.title}\n\n`;
        block.categories.forEach(category => {
            textToCopy += `${category.category}\n`;
            textToCopy += "―".repeat(40) + "\n";
            category.metrics.forEach(metric => {
                textToCopy += `${metric.metric}\n`;
                textToCopy += `Definition: ${metric.definition}\n`;
                textToCopy += `Calculation: ${metric.calculation}\n`;
                textToCopy += `Target Range: ${metric['target-range']}\n`;
                textToCopy += `Measurement Frequency: ${metric['measurement-frequency']}\n\n`;
            });
        });

        try {
            await navigator.clipboard.writeText(textToCopy);
            setCopied(true);
            setTimeout(() => setCopied(false), 2000);
        } catch (err) {
            console.error('Failed to copy text: ', err);
        }
    };

    const getTargetColor = (target) => {
        if (target.includes('80-95%') || target.includes('90-95%') || target.includes('200-400%')) return 'success';
        if (target.includes('70-80%') || target.includes('75-85%')) return 'warning';
        if (target.includes('60-80%') || target.includes('50-60%')) return 'info';
        return 'secondary';
    };

    return (
        <div className="metrics-framework-block card my-4 border-primary border-opacity-25">
            <div className="card-header bg-primary bg-opacity-10 border-primary">
                <div className="d-flex justify-content-between align-items-center">
                    <div className="d-flex align-items-center">
                        <i className="fas fa-chart-bar text-primary me-2"></i>
                        <h5 className="card-title mb-0 text-dark">{block.title}</h5>
                    </div>
                    <button className="btn btn-sm btn-outline-secondary" onClick={handleCopy}>
                        <i className={`fas ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                        {copied ? ' Copied!' : ' Copy'}
                    </button>
                </div>
            </div>

            <div className="card-body">
                <div className="metrics-categories">
                    {block.categories.map((category, catIndex) => (
                        <div key={catIndex} className="metrics-category mb-4">
                            <div
                                className="category-header card border-0 bg-light cursor-pointer"
                                onClick={() => setExpandedCategory(expandedCategory === catIndex ? null : catIndex)}
                            >
                                <div className="card-body">
                                    <div className="d-flex justify-content-between align-items-center">
                                        <h6 className="mb-0 text-primary">
                                            <i className="fas fa-folder me-2"></i>
                                            {category.category}
                                        </h6>
                                        <div className="metrics-count">
                                            <span className="badge bg-primary">{category.metrics.length} metrics</span>
                                            <i className={`fas fa-chevron-${expandedCategory === catIndex ? 'up' : 'down'} ms-2 text-muted`}></i>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            {expandedCategory === catIndex && (
                                <div className="metrics-list mt-3">
                                    <div className="row">
                                        {category.metrics.map((metric, metricIndex) => (
                                            <div key={metricIndex} className="col-lg-6 mb-3">
                                                <div className="metric-item card h-100 border-primary border-opacity-25">
                                                    <div className="card-header bg-primary bg-opacity-10">
                                                        <div className="d-flex justify-content-between align-items-center">
                                                            <h6 className="mb-0 text-dark small">{metric.metric}</h6>
                                                            <span className={`badge bg-${getTargetColor(metric['target-range'])}`}>
                                                                {metric['target-range']}
                                                            </span>
                                                        </div>
                                                    </div>
                                                    <div className="card-body">
                                                        <div className="metric-details">
                                                            <div className="definition mb-2">
                                                                <small className="text-muted d-block mb-1">
                                                                    <i className="fas fa-info-circle me-1"></i>
                                                                    Definition
                                                                </small>
                                                                <p className="small mb-2">{metric.definition}</p>
                                                            </div>

                                                            <div className="calculation mb-2">
                                                                <small className="text-muted d-block mb-1">
                                                                    <i className="fas fa-calculator me-1"></i>
                                                                    Calculation
                                                                </small>
                                                                <code className="small bg-light p-1 rounded d-block">
                                                                    {metric.calculation}
                                                                </code>
                                                            </div>

                                                            <div className="measurement d-flex justify-content-between">
                                                                <div>
                                                                    <small className="text-muted d-block mb-1">
                                                                        <i className="fas fa-clock me-1"></i>
                                                                        Frequency
                                                                    </small>
                                                                    <span className="badge bg-light text-dark border small">
                                                                        {metric['measurement-frequency']}
                                                                    </span>
                                                                </div>
                                                                <div>
                                                                    <small className="text-muted d-block mb-1">
                                                                        <i className="fas fa-bullseye me-1"></i>
                                                                        Target
                                                                    </small>
                                                                    <span className={`badge bg-${getTargetColor(metric['target-range'])} small`}>
                                                                        {metric['target-range']}
                                                                    </span>
                                                                </div>
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                        ))}
                                    </div>
                                </div>
                            )}
                        </div>
                    ))}
                </div>

                {/* Metrics Summary */}
                <div className="metrics-summary mt-4 p-3 bg-light rounded">
                    <h6 className="text-primary mb-3">
                        <i className="fas fa-chart-line me-2"></i>
                        Metrics Implementation Guidance
                    </h6>
                    <div className="row">
                        <div className="col-md-4">
                            <div className="summary-item text-center">
                                <div className="number-display text-primary h4 mb-1">
                                    {block.categories.reduce((total, category) => total + category.metrics.length, 0)}
                                </div>
                                <small className="text-muted">Total Metrics</small>
                            </div>
                        </div>
                        <div className="col-md-4">
                            <div className="summary-item text-center">
                                <div className="number-display text-success h4 mb-1">
                                    {block.categories.length}
                                </div>
                                <small className="text-muted">Categories</small>
                            </div>
                        </div>
                        <div className="col-md-4">
                            <div className="summary-item text-center">
                                <div className="number-display text-warning h4 mb-1">
                                    {Array.from(new Set(block.categories.flatMap(cat =>
                                        cat.metrics.map(metric => metric['measurement-frequency'])
                                    ))).length}
                                </div>
                                <small className="text-muted">Measurement Frequencies</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    );
};

// ROI Calculation Example Component
const ROICalculationExampleBlock = ({ block, index }) => {
    const [expanded, setExpanded] = useState(false);
    const [copied, setCopied] = useState(false);

    const handleCopy = async () => {
        let textToCopy = `${block.title}\n\n`;
        textToCopy += `Scenario: ${block.scenario}\n\n`;
        textToCopy += "ROI Calculations:\n";
        block.calculations.forEach((calc, calcIndex) => {
            textToCopy += `${calcIndex + 1}. ${calc}\n`;
        });

        try {
            await navigator.clipboard.writeText(textToCopy);
            setCopied(true);
            setTimeout(() => setCopied(false), 2000);
        } catch (err) {
            console.error('Failed to copy text: ', err);
        }
    };

    const extractNumbers = (text) => {
        const numbers = text.match(/\$?[\d,]+(\.\d+)?/g);
        return numbers ? numbers.map(n => n.replace(/[$,]/g, '')) : [];
    };

    const isFinancialLine = (text) => {
        return text.includes('$') || text.includes('cost') || text.includes('savings') || text.includes('ROI');
    };

    return (
        <div className="roi-calculation-example-block card my-4 border-success border-opacity-25">
            <div className="card-header bg-success bg-opacity-10 border-success">
                <div className="d-flex justify-content-between align-items-center">
                    <div className="d-flex align-items-center">
                        <i className="fas fa-calculator text-success me-2"></i>
                        <h5 className="card-title mb-0 text-dark">{block.title}</h5>
                    </div>
                    <div className="roi-actions">
                        <button className="btn btn-sm btn-outline-secondary me-2" onClick={handleCopy}>
                            <i className={`fas ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                            {copied ? ' Copied!' : ' Copy'}
                        </button>
                        <button
                            className="btn btn-sm btn-outline-success"
                            onClick={() => setExpanded(!expanded)}
                        >
                            <i className={`fas fa-${expanded ? 'minus' : 'plus'}`}></i>
                            {expanded ? ' Less' : ' More'}
                        </button>
                    </div>
                </div>
            </div>

            <div className="card-body">
                {/* Scenario Overview */}
                <div className="scenario-overview mb-4 p-3 bg-success bg-opacity-10 rounded">
                    <h6 className="text-success mb-2">
                        <i className="fas fa-building me-2"></i>
                        Scenario Context
                    </h6>
                    <p className="mb-0 small">{block.scenario}</p>
                </div>

                {/* ROI Calculations */}
                <div className="roi-calculations">
                    <h6 className="text-primary mb-3">
                        <i className="fas fa-calculator me-2"></i>
                        ROI Calculation Breakdown
                    </h6>

                    <div className="calculations-list">
                        {block.calculations.map((calculation, calcIndex) => {
                            const numbers = extractNumbers(calculation);
                            const isFinancial = isFinancialLine(calculation);

                            return (
                                <div key={calcIndex} className="calculation-item mb-3">
                                    <div className="d-flex align-items-start">
                                        <span className="calculation-number badge bg-primary me-3 mt-1">
                                            {calcIndex + 1}
                                        </span>
                                        <div className="calculation-content flex-grow-1">
                                            <p className={`mb-1 small ${isFinancial ? 'fw-bold' : ''}`}>
                                                {calculation}
                                            </p>
                                            {numbers.length > 0 && (
                                                <div className="number-highlights mt-1">
                                                    {numbers.map((number, numIndex) => (
                                                        <span key={numIndex} className="badge bg-light text-dark border me-1 small">
                                                            {number}
                                                        </span>
                                                    ))}
                                                </div>
                                            )}
                                        </div>
                                    </div>
                                </div>
                            );
                        })}
                    </div>
                </div>

                {/* ROI Summary */}
                <div className="roi-summary mt-4 p-3 bg-primary bg-opacity-10 rounded">
                    <h6 className="text-primary mb-3">
                        <i className="fas fa-chart-pie me-2"></i>
                        ROI Summary
                    </h6>
                    <div className="row text-center">
                        <div className="col-md-3 mb-3">
                            <div className="summary-card p-2 bg-white rounded border">
                                <div className="summary-value text-success h5 mb-1">107%</div>
                                <small className="text-muted">First-Year ROI</small>
                            </div>
                        </div>
                        <div className="col-md-3 mb-3">
                            <div className="summary-card p-2 bg-white rounded border">
                                <div className="summary-value text-primary h5 mb-1">$210K</div>
                                <small className="text-muted">Annual Labor Savings</small>
                            </div>
                        </div>
                        <div className="col-md-3 mb-3">
                            <div className="summary-card p-2 bg-white rounded border">
                                <div className="summary-value text-warning h5 mb-1">$150K</div>
                                <small className="text-muted">Implementation Cost</small>
                            </div>
                        </div>
                        <div className="col-md-3 mb-3">
                            <div className="summary-card p-2 bg-white rounded border">
                                <div className="summary-value text-info h5 mb-1">9-12</div>
                                <small className="text-muted">Months to Break-even</small>
                            </div>
                        </div>
                    </div>
                </div>

                {expanded && (
                    <div className="expanded-analysis mt-4">
                        <div className="row">
                            <div className="col-md-6">
                                <div className="benefits-analysis p-3 bg-success bg-opacity-10 rounded">
                                    <h6 className="text-success small mb-3">
                                        <i className="fas fa-plus-circle me-2"></i>
                                        Key Benefits Captured
                                    </h6>
                                    <ul className="small mb-0">
                                        <li>Reduced manual maintenance effort</li>
                                        <li>Improved test stability and reliability</li>
                                        <li>Faster feedback cycles for development</li>
                                        <li>Better resource utilization</li>
                                        <li>Reduced time-to-market</li>
                                    </ul>
                                </div>
                            </div>
                            <div className="col-md-6">
                                <div className="implementation-tips p-3 bg-warning bg-opacity-10 rounded">
                                    <h6 className="text-warning small mb-3">
                                        <i className="fas fa-lightbulb me-2"></i>
                                        ROI Optimization Tips
                                    </h6>
                                    <ul className="small mb-0">
                                        <li>Start with high-maintenance test areas</li>
                                        <li>Measure baseline metrics accurately</li>
                                        <li>Include both direct and indirect benefits</li>
                                        <li>Track ROI continuously and adjust strategy</li>
                                        <li>Communicate ROI results to stakeholders</li>
                                    </ul>
                                </div>
                            </div>
                        </div>

                        {/* ROI Formula */}
                        <div className="roi-formula mt-3 p-3 bg-light rounded">
                            <h6 className="text-primary small mb-2">
                                <i className="fas fa-square-root-alt me-2"></i>
                                ROI Calculation Formula
                            </h6>
                            <div className="formula-display text-center p-2 bg-white border rounded">
                                <code className="text-primary">
                                    ROI = (Annual Benefits - Implementation Cost) ÷ Implementation Cost × 100%
                                </code>
                            </div>
                            <div className="formula-breakdown mt-2 small text-muted text-center">
                                Where: Annual Benefits = Labor Savings + Efficiency Gains + Quality Improvements
                            </div>
                        </div>
                    </div>
                )}
            </div>
        </div>
    );
};


// Tool Selection Framework Component
const ToolSelectionFrameworkBlock = ({ block, index }) => {
    const [expanded, setExpanded] = useState(false);
    const [copied, setCopied] = useState(false);

    const handleCopy = async () => {
        let textToCopy = `${block.title}\n\n`;
        block.criteria.forEach(criterion => {
            textToCopy += `${criterion.criterion} (Weight: ${criterion.weight})\n`;
            textToCopy += `Considerations:\n`;
            criterion.considerations.forEach(consideration => {
                textToCopy += `  • ${consideration}\n`;
            });
            textToCopy += "\n";
        });

        try {
            await navigator.clipboard.writeText(textToCopy);
            setCopied(true);
            setTimeout(() => setCopied(false), 2000);
        } catch (err) {
            console.error('Failed to copy text: ', err);
        }
    };

    const getWeightColor = (weight) => {
        const weightMap = {
            'High': 'danger',
            'Medium-High': 'warning',
            'Medium': 'info',
            'Low': 'success'
        };
        return weightMap[weight] || 'secondary';
    };

    return (
        <div className="tool-selection-framework-block card my-4 border-success border-opacity-25">
            <div className="card-header bg-success bg-opacity-10 border-success">
                <div className="d-flex justify-content-between align-items-center">
                    <div className="d-flex align-items-center">
                        <i className="fas fa-tools text-success me-2"></i>
                        <h5 className="card-title mb-0 text-dark">{block.title}</h5>
                    </div>
                    <div className="framework-actions">
                        <button className="btn btn-sm btn-outline-secondary me-2" onClick={handleCopy}>
                            <i className={`fas ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                            {copied ? ' Copied!' : ' Copy'}
                        </button>
                        <button
                            className="btn btn-sm btn-outline-success"
                            onClick={() => setExpanded(!expanded)}
                        >
                            <i className={`fas fa-${expanded ? 'minus' : 'plus'}`}></i>
                            {expanded ? ' Less' : ' More'}
                        </button>
                    </div>
                </div>
            </div>

            <div className="card-body">
                <div className="selection-criteria">
                    {block.criteria.map((criterion, critIndex) => (
                        <div key={critIndex} className="criterion-item mb-4 p-3 border rounded">
                            <div className="criterion-header d-flex justify-content-between align-items-center mb-3">
                                <div className="d-flex align-items-center">
                                    <span className="criterion-number badge bg-primary me-3">
                                        {critIndex + 1}
                                    </span>
                                    <h6 className="mb-0 text-dark">{criterion.criterion}</h6>
                                </div>
                                <span className={`badge bg-${getWeightColor(criterion.weight)}`}>
                                    {criterion.weight} Priority
                                </span>
                            </div>

                            <div className="considerations-section">
                                <h6 className="text-muted small mb-2">
                                    <i className="fas fa-list-ul me-1"></i>
                                    Key Considerations
                                </h6>
                                <div className="row">
                                    {criterion.considerations.map((consideration, consIndex) => (
                                        <div key={consIndex} className="col-md-6 mb-2">
                                            <div className="consideration-item d-flex align-items-start">
                                                <i className="fas fa-check-circle text-success mt-1 me-2 small"></i>
                                                <span className="small">{consideration}</span>
                                            </div>
                                        </div>
                                    ))}
                                </div>
                            </div>

                            {expanded && (
                                <div className="evaluation-tips mt-3 p-2 bg-light rounded">
                                    <h6 className="text-info small mb-2">
                                        <i className="fas fa-tips me-1"></i>
                                        Evaluation Tips
                                    </h6>
                                    <ul className="small mb-0">
                                        <li>Create weighted scoring for each consideration</li>
                                        <li>Involve multiple stakeholders in evaluation</li>
                                        <li>Consider both current and future requirements</li>
                                        <li>Document evaluation decisions and rationale</li>
                                    </ul>
                                </div>
                            )}
                        </div>
                    ))}
                </div>

                {expanded && (
                    <div className="framework-guidance mt-4 p-3 bg-success bg-opacity-10 rounded">
                        <h6 className="text-success mb-3">
                            <i className="fas fa-road me-2"></i>
                            Framework Implementation Guidance
                        </h6>
                        <div className="row">
                            <div className="col-md-6">
                                <div className="scoring-guidance">
                                    <h6 className="text-muted small mb-2">Scoring Approach</h6>
                                    <ul className="small">
                                        <li>Assign scores (1-5) for each consideration</li>
                                        <li>Apply weight multipliers based on priority</li>
                                        <li>Calculate weighted total scores for each tool</li>
                                        <li>Compare scores across evaluation criteria</li>
                                    </ul>
                                </div>
                            </div>
                            <div className="col-md-6">
                                <div className="decision-guidance">
                                    <h6 className="text-muted small mb-2">Decision Framework</h6>
                                    <ul className="small">
                                        <li>Focus on High priority criteria first</li>
                                        <li>Consider trade-offs between criteria</li>
                                        <li>Evaluate implementation complexity</li>
                                        <li>Plan for long-term scalability</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                )}
            </div>
        </div>
    );
};
const SelectionFrameworkBlock = ({ block, index }) => {
