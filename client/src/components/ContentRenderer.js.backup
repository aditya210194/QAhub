                            <div className="stakeholder-header mb-3">
                                <h6 className="text-info mb-2">
                                    <i className="fas fa-user-tie me-2"></i>
                                    {stakeholder.role}
                                </h6>
                                <div className="communication-frequency text-muted small mb-3">
                                    <i className="fas fa-calendar me-1"></i>
                                    Communication: {stakeholder['communication-frequency']}
                                </div>
                            </div>

                            <div className="row">
                                <div className="col-md-6">
                                    <div className="responsibilities-section mb-3">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-tasks me-1"></i>
                                            Responsibilities
                                        </small>
                                        <div className="responsibilities-list">
                                            {stakeholder.responsibilities.map((responsibility, respIndex) => (
                                                <div key={respIndex} className="responsibility-item small bg-info bg-opacity-10 p-2 rounded mb-1">
                                                    • {responsibility}
                                                </div>
                                            ))}
                                        </div>
                                    </div>
                                </div>
                                <div className="col-md-6">
                                    <div className="concerns-section">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-exclamation-circle me-1"></i>
                                            Key Concerns
                                        </small>
                                        <div className="concerns-list">
                                            {stakeholder['key-concerns'].map((concern, concernIndex) => (
                                                <div key={concernIndex} className="concern-item small text-warning mb-1">
                                                    ⚠ {concern}
                                                </div>
                                            ))}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    );
};

// Test Strategy Component
const TestStrategyBlock = ({ block, index }) => {
    const [copied, setCopied] = useState(false);

