                                            <i className="fas fa-bolt me-1"></i>
                                            Impact
                                        </small>
                                        <div className="impact-text small text-danger">
                                            {vuln.impact}
                                        </div>
                                    </div>
                                </div>
                                <div className="col-md-4">
                                    <div className="testing-approach-section mb-3">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-search me-1"></i>
                                            Testing Approach
                                        </small>
                                        <div className="testing-approach-list">
                                            {vuln['testing-approach'].map((approach, approachIndex) => (
                                                <div key={approachIndex} className="approach-item small bg-danger bg-opacity-10 p-1 rounded mb-1">
                                                    • {approach}
                                                </div>
                                            ))}
                                        </div>
                                    </div>
                                </div>
                                <div className="col-md-5">
                                    <div className="mitigation-section">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-shield-alt me-1"></i>
                                            Mitigation
                                        </small>
                                        <div className="mitigation-text small bg-success bg-opacity-10 p-2 rounded text-success">
