    };

    return (
        <div className="key-components-block card my-4">
            <div className="card-header bg-primary bg-opacity-10 border-primary">
                <div className="d-flex justify-content-between align-items-center">
                    <div className="d-flex align-items-center">
                        <i className="fas fa-star text-primary me-2"></i>
                        <h5 className="card-title mb-0 text-dark">{block.title}</h5>
                    </div>
                    <button className="btn btn-sm btn-outline-secondary" onClick={handleCopy}>
                        <i className={`fas ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                        {copied ? ' Copied!' : ' Copy'}
                    </button>
                </div>
            </div>

            <div className="card-body">
                <div className="components-grid">
                    {block.components.map((component, componentIndex) => (
                        <div key={componentIndex} className="component-item mb-4 p-3 border rounded">
                            <div className="component-header mb-3">
                                <h6 className="text-primary mb-2">
                                    <i className="fas fa-cube me-2"></i>
                                    {component.component}
                                </h6>
                                <div className="component-purpose text-muted small mb-3">
                                    <i className="fas fa-bullseye me-1"></i>
                                    {component.purpose}
                                </div>
                            </div>

                            <div className="row">
                                <div className="col-md-6">
                                    <div className="features-section mb-3">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-list me-1"></i>
                                            Features
                                        </small>
                                        <div className="features-list">
                                            {component.features.map((feature, featureIndex) => (
                                                <div key={featureIndex} className="feature-item small text-success mb-1">
                                                    ✓ {feature}
                                                </div>
                                            ))}
                                        </div>
                                    </div>
                                </div>
                                <div className="col-md-6">
                                    <div className="implementation-section">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-code me-1"></i>
                                            Implementation
                                        </small>
                                        <div className="implementation-text small bg-primary bg-opacity-10 p-2 rounded">
                                            {component.implementation}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    );
};

// Data Validation Component
const DataValidationBlock = ({ block, index }) => {
    const [copied, setCopied] = useState(false);

    const handleCopy = () => {
        let textToCopy = `${block.title}\n\n`;
        block.methods.forEach(method => {
            textToCopy += `${method.method}\n`;
            textToCopy += `Purpose: ${method.purpose}\n`;
            textToCopy += `Implementation: ${method.implementation}\n\n`;
        });
        navigator.clipboard.writeText(textToCopy);
        setCopied(true);
        setTimeout(() => setCopied(false), 2000);
    };

    return (
        <div className="data-validation-block card my-4">
            <div className="card-header bg-warning bg-opacity-10 border-warning">
                <div className="d-flex justify-content-between align-items-center">
                    <div className="d-flex align-items-center">
                        <i className="fas fa-check-circle text-warning me-2"></i>
                        <h5 className="card-title mb-0 text-dark">{block.title}</h5>
                    </div>
                    <button className="btn btn-sm btn-outline-secondary" onClick={handleCopy}>
                        <i className={`fas ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                        {copied ? ' Copied!' : ' Copy'}
                    </button>
                </div>
            </div>

            <div className="card-body">
                <div className="validation-methods">
                    {block.methods.map((method, methodIndex) => (
                        <div key={methodIndex} className="method-item mb-4 p-3 border rounded">
                            <div className="method-header mb-3">
                                <h6 className="text-warning mb-2">
                                    <i className="fas fa-shield-alt me-2"></i>
                                    {method.method}
                                </h6>
                                <div className="method-purpose text-muted small mb-3">
                                    <i className="fas fa-bullseye me-1"></i>
                                    {method.purpose}
                                </div>
                            </div>

                            <div className="method-implementation">
                                <small className="text-muted d-block mb-2">
                                    <i className="fas fa-terminal me-1"></i>
                                    Implementation
                                </small>
                                <div className="implementation-code small bg-light p-2 rounded font-monospace">
                                    {method.implementation}
                                </div>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    );
};

