                                    <i className="fas fa-bullseye me-2"></i>
                                    {metric.metric}
                                </h6>
                            </div>

                            <div className="row">
                                <div className="col-md-4">
                                    <div className="measure-section mb-2">
                                        <small className="text-muted d-block mb-1">
                                            <i className="fas fa-ruler me-1"></i>
                                            Measurement
