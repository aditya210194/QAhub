        block.concepts.forEach(concept => {
            textToCopy += `${concept.concept}:\n`;
            textToCopy += `${concept.description}\n\n`;
        });
        navigator.clipboard.writeText(textToCopy);
        setCopied(true);
        setTimeout(() => setCopied(false), 2000);
    };

    return (
        <div className="next-generation-block card my-4">
            <div className="card-header bg-danger bg-opacity-10 border-danger">
                <div className="d-flex justify-content-between align-items-center">
                    <div className="d-flex align-items-center">
                        <i className="fas fa-microchip text-danger me-2"></i>
                        <h5 className="card-title mb-0 text-dark">{block.title}</h5>
                    </div>
                    <button className="btn btn-sm btn-outline-secondary" onClick={handleCopy}>
                        <i className={`fas ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                        {copied ? ' Copied!' : ' Copy'}
                    </button>
                </div>
            </div>

            <div className="card-body">
                <div className="concepts-grid">
                    <div className="row">
                        {block.concepts.map((concept, conceptIndex) => (
                            <div key={conceptIndex} className="col-lg-6 mb-4">
                                <div className="concept-card card h-100 border-danger">
                                    <div className="card-header py-2 bg-danger bg-opacity-10">
                                        <h6 className="mb-0 text-danger">
                                            <i className="fas fa-lightbulb me-2"></i>
                                            {concept.concept}
                                        </h6>
                                    </div>
                                    <div className="card-body">
                                        <p className="mb-0">{concept.description}</p>
                                    </div>
                                </div>
                            </div>
                        ))}
                    </div>
                </div>
            </div>
        </div>
    );
};
