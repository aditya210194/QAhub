                                </div>
                                <div className="col-md-4">
                                    <div className="mindset-section mb-3">
                                        {strategy.mindset && (
                                            <>
                                                <small className="text-muted d-block mb-2">
                                                    <i className="fas fa-brain me-1"></i>
                                                    Mindset
                                                </small>
                                                <div className="mindset-text small bg-success bg-opacity-10 p-2 rounded">
                                                    {strategy.mindset}
