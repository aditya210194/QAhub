// LinkedIn Mastery Component
const LinkedInMasteryBlock = ({ block, index }) => {
    const [copied, setCopied] = useState(false);

    const handleCopy = () => {
        let textToCopy = `${block.title}\n\n`;
        block.sections.forEach(section => {
            textToCopy += `${section.section}\n`;
            textToCopy += `Optimization: ${section.optimization}\n`;
            if (section.example) textToCopy += `Example: ${section.example}\n`;
            if (section.structure) textToCopy += `Structure: ${section.structure.join(', ')}\n`;
            if (section.content) textToCopy += `Content: ${section.content.join(', ')}\n`;
            if (section.approach) textToCopy += `Approach: ${section.approach.join(', ')}\n`;
            textToCopy += `Impact: ${section.impact}\n\n`;
        });
        navigator.clipboard.writeText(textToCopy);
        setCopied(true);
        setTimeout(() => setCopied(false), 2000);
    };

    return (
        <div className="linkedin-mastery-block card my-4">
            <div className="card-header bg-info bg-opacity-10 border-info">
                <div className="d-flex justify-content-between align-items-center">
                    <div className="d-flex align-items-center">
                        <i className="fab fa-linkedin text-info me-2"></i>
                        <h5 className="card-title mb-0 text-dark">{block.title}</h5>
                    </div>
                    <button className="btn btn-sm btn-outline-secondary" onClick={handleCopy}>
                        <i className={`fas ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                        {copied ? ' Copied!' : ' Copy'}
                    </button>
                </div>
            </div>

            <div className="card-body">
                <div className="linkedin-sections">
                    {block.sections.map((section, sectionIndex) => (
                        <div key={sectionIndex} className="section-item mb-4 p-3 border rounded">
                            <div className="section-header mb-3">
                                <h6 className="text-info mb-2">
                                    <i className="fas fa-cog me-2"></i>
                                    {section.section}
                                </h6>
                                <div className="optimization text-muted small">
                                    <i className="fas fa-magic me-1"></i>
                                    {section.optimization}
                                </div>
                            </div>

                            <div className="content-area mb-3">
                                {section.example && (
                                    <div className="example-section mb-3">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-eye me-1"></i>
                                            Example
                                        </small>
                                        <div className="example-text small bg-info bg-opacity-10 p-2 rounded">
                                            {section.example}
                                        </div>
                                    </div>
                                )}

                                {section.structure && (
                                    <div className="structure-section mb-3">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-sitemap me-1"></i>
                                            Structure
                                        </small>
                                        <div className="structure-list">
                                            {section.structure.map((item, itemIndex) => (
                                                <div key={itemIndex} className="structure-item small text-success mb-1">
                                                    {itemIndex + 1}. {item}
                                                </div>
                                            ))}
                                        </div>
                                    </div>
                                )}

                                {section.content && (
                                    <div className="content-section mb-3">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-list me-1"></i>
                                            Content
                                        </small>
                                        <div className="content-list">
                                            {section.content.map((item, itemIndex) => (
                                                <div key={itemIndex} className="content-item small bg-warning bg-opacity-10 p-2 rounded mb-1">
                                                    • {item}
                                                </div>
                                            ))}
                                        </div>
                                    </div>
                                )}

                                {section.approach && (
                                    <div className="approach-section mb-3">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-road me-1"></i>
                                            Approach
                                        </small>
                                        <div className="approach-list">
                                            {section.approach.map((item, itemIndex) => (
                                                <div key={itemIndex} className="approach-item small text-primary mb-1">
                                                    → {item}
                                                </div>
                                            ))}
                                        </div>
                                    </div>
                                )}
                            </div>

                            <div className="impact-section">
                                <small className="text-muted d-block mb-2">
                                    <i className="fas fa-bullseye me-1"></i>
                                    Impact
                                </small>
                                <div className="impact-text small bg-success bg-opacity-10 p-2 rounded text-success">
                                    {section.impact}
                                </div>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    );
};

// GitHub Branding Component
const GitHubBrandingBlock = ({ block, index }) => {
    const [copied, setCopied] = useState(false);

    const handleCopy = () => {
        let textToCopy = `${block.title}\n\n`;
        block.elements.forEach(element => {
            textToCopy += `${element.element}\n`;
            textToCopy += `Content: ${element.content}\n`;
            textToCopy += `Sections: ${element.sections.join(', ')}\n`;
            textToCopy += `Standards: ${element.standards ? element.standards.join(', ') : 'N/A'}\n`;
            textToCopy += `Strategies: ${element.strategies ? element.strategies.join(', ') : 'N/A'}\n`;
            textToCopy += `Branding Tip: ${element['branding-tip']}\n\n`;
        });
        navigator.clipboard.writeText(textToCopy);
        setCopied(true);
        setTimeout(() => setCopied(false), 2000);
    };

    return (
        <div className="github-branding-block card my-4">
            <div className="card-header bg-dark bg-opacity-10 border-dark">
                <div className="d-flex justify-content-between align-items-center">
                    <div className="d-flex align-items-center">
                        <i className="fab fa-github text-dark me-2"></i>
                        <h5 className="card-title mb-0 text-dark">{block.title}</h5>
                    </div>
                    <button className="btn btn-sm btn-outline-secondary" onClick={handleCopy}>
                        <i className={`fas ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                        {copied ? ' Copied!' : ' Copy'}
                    </button>
                </div>
            </div>

            <div className="card-body">
                <div className="github-elements">
                    {block.elements.map((element, elementIndex) => (
                        <div key={elementIndex} className="element-item mb-4 p-3 border rounded">
                            <div className="element-header mb-3">
                                <h6 className="text-dark mb-2">
                                    <i className="fas fa-code me-2"></i>
                                    {element.element}
                                </h6>
                                <div className="content text-muted small">
                                    <i className="fas fa-file-alt me-1"></i>
                                    {element.content}
                                </div>
                            </div>

                            <div className="row">
                                <div className="col-md-4">
                                    <div className="sections-section mb-3">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-layer-group me-1"></i>
                                            Sections
                                        </small>
                                        <div className="sections-list">
                                            {element.sections.map((section, sectionIndex) => (
                                                <div key={sectionIndex} className="section-item small bg-dark bg-opacity-10 p-2 rounded mb-1">
                                                    • {section}
                                                </div>
                                            ))}
                                        </div>
                                    </div>
                                </div>
                                <div className="col-md-4">
                                    {element.standards && (
                                        <div className="standards-section mb-3">
                                            <small className="text-muted d-block mb-2">
                                                <i className="fas fa-check-circle me-1"></i>
                                                Standards
                                            </small>
                                            <div className="standards-list">
                                                {element.standards.map((standard, standardIndex) => (
                                                    <div key={standardIndex} className="standard-item small text-success mb-1">
                                                        ✓ {standard}
                                                    </div>
                                                ))}
                                            </div>
                                        </div>
                                    )}
                                    {element.strategies && (
                                        <div className="strategies-section mb-3">
                                            <small className="text-muted d-block mb-2">
                                                <i className="fas fa-chess me-1"></i>
                                                Strategies
                                            </small>
                                            <div className="strategies-list">
                                                {element.strategies.map((strategy, strategyIndex) => (
                                                    <div key={strategyIndex} className="strategy-item small text-warning mb-1">
                                                        → {strategy}
                                                    </div>
                                                ))}
                                            </div>
                                        </div>
                                    )}
                                </div>
                                <div className="col-md-4">
                                    <div className="branding-tip-section">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-lightbulb me-1"></i>
                                            Branding Tip
                                        </small>
                                        <div className="branding-tip-text small bg-primary bg-opacity-10 p-2 rounded">
                                            {element['branding-tip']}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    );
};

