const StrategyBlock = ({ block, index }) => {
    const [expanded, setExpanded] = useState(false);
    const [copied, setCopied] = useState(false);

    const handleCopy = () => {
        let textToCopy = `${block.title}\n\n`;
        textToCopy += `Approach: ${block.approach}\n\n`;
        textToCopy += `Implementation:\n`;
        block.implementation.forEach((step, idx) => {
            textToCopy += `${idx + 1}. ${step}\n`;
        });
        if (block['expected-reduction']) {
            textToCopy += `\nExpected Reduction: ${block['expected-reduction']}`;
        }
        navigator.clipboard.writeText(textToCopy);
        setCopied(true);
        setTimeout(() => setCopied(false), 2000);
    };

    const toggleExpand = () => {
        setExpanded(!expanded);
    };

    return (
        <div className="strategy-block card my-4">
            <div className="card-header bg-warning bg-opacity-10 border-warning">
                <div className="d-flex justify-content-between align-items-center">
                    <div className="d-flex align-items-center">
                        <i className="fas fa-chess-knight text-warning me-2"></i>
                        <h5 className="card-title mb-0 text-dark">
                            {block.title}
                        </h5>
                    </div>
                    <div className="strategy-actions">
                        <button
                            className="btn btn-sm btn-outline-secondary me-2"
                            onClick={handleCopy}
                            title="Copy strategy"
                        >
                            <i className={`fas ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                            {copied ? ' Copied!' : ' Copy'}
                        </button>
                        <button
                            className="btn btn-sm btn-outline-primary"
                            onClick={toggleExpand}
                        >
                            <i className={`fas fa-${expanded ? 'minus' : 'plus'}`}></i>
                            {expanded ? ' Less' : ' More'}
                        </button>
                    </div>
                </div>
            </div>

            <div className="card-body">
                <div className="strategy-content">
                    {/* Main Strategy Overview */}
                    <div className="strategy-overview mb-4">
                        <div className="approach-section mb-3">
                            <h6 className="d-flex align-items-center text-warning">
                                <i className="fas fa-bullseye me-2"></i>
                                Strategic Approach
                            </h6>
                            <div className="approach-text p-3 bg-warning bg-opacity-10 rounded">
                                {block.approach}
                            </div>
                        </div>

                        {/* Implementation Steps */}
                        <div className="implementation-section">
                            <h6 className="d-flex align-items-center text-primary mb-3">
                                <i className="fas fa-list-ol me-2"></i>
                                Implementation Steps
                            </h6>
                            <div className="implementation-steps">
                                {block.implementation.slice(0, expanded ? block.implementation.length : 2).map((step, stepIndex) => (
                                    <div key={stepIndex} className="step-item d-flex align-items-start mb-3 p-3 bg-light rounded">
                                        <span className="badge bg-primary me-3 mt-1">{stepIndex + 1}</span>
                                        <div className="step-text flex-grow-1">
                                            {step}
                                        </div>
                                    </div>
                                ))}
                            </div>
                        </div>
                    </div>

                    {/* Expected Outcome */}
                    {block['expected-reduction'] && (
                        <div className="expected-outcome mt-4 p-3 bg-success bg-opacity-10 rounded">
                            <h6 className="d-flex align-items-center text-success mb-2">
                                <i className="fas fa-chart-line me-2"></i>
                                Expected Outcome
                            </h6>
                            <div className="outcome-text">
                                <strong>Leakage Reduction:</strong> {block['expected-reduction']}
                            </div>
                        </div>
                    )}

                    {/* Expanded Additional Content */}
                    {expanded && (
                        <div className="expanded-content mt-4">
                            {/* Additional Tips */}
                            <div className="additional-tips mb-4">
                                <h6 className="d-flex align-items-center text-info">
                                    <i className="fas fa-lightbulb me-2"></i>
                                    Pro Tips
                                </h6>
                                <div className="tips-list mt-2">
                                    <div className="tip-item d-flex align-items-start mb-2">
                                        <i className="fas fa-check-circle text-success me-2 mt-1"></i>
                                        <span>Start with a pilot project to validate the approach</span>
                                    </div>
                                    <div className="tip-item d-flex align-items-start mb-2">
                                        <i className="fas fa-check-circle text-success me-2 mt-1"></i>
                                        <span>Involve stakeholders in risk assessment sessions</span>
                                    </div>
                                    <div className="tip-item d-flex align-items-start mb-2">
                                        <i className="fas fa-check-circle text-success me-2 mt-1"></i>
                                        <span>Regularly review and update risk matrices</span>
                                    </div>
                                </div>
                            </div>

                            {/* Success Metrics */}
                            <div className="success-metrics">
                                <h6 className="d-flex align-items-center text-purple">
                                    <i className="fas fa-tachometer-alt me-2"></i>
                                    Success Metrics
                                </h6>
                                <div className="metrics-grid mt-2">
                                    <div className="row">
                                        <div className="col-md-6 mb-2">
                                            <div className="metric-item p-2 bg-light rounded">
                                                <small className="text-muted">Defect Detection Percentage</small>
                                                <div className="metric-value text-primary">↑ Improvement</div>
                                            </div>
                                        </div>
                                        <div className="col-md-6 mb-2">
                                            <div className="metric-item p-2 bg-light rounded">
                                                <small className="text-muted">Testing Efficiency</small>
                                                <div className="metric-value text-success">↑ Better ROI</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    )}
                </div>

                {/* Quick Actions */}
                <div className="strategy-footer mt-3 pt-3 border-top">
                    <div className="d-flex justify-content-between align-items-center">
                        <div className="strategy-stats small text-muted">
                            <i className="fas fa-list me-1"></i>
                            {block.implementation.length} implementation steps
                        </div>
                        <div className="quick-feedback">
                            <small className="text-muted">
                                <i className="fas fa-comment me-1"></i>
                                Viable strategy?
                                <button className="btn btn-sm btn-link p-0 ms-1" title="Yes">
                                    <i className="fas fa-thumbs-up text-success"></i>
                                </button>
                                <button className="btn btn-sm btn-link p-0 ms-1" title="No">
                                    <i className="fas fa-thumbs-down text-danger"></i>
                                </button>
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    );
};
const DashboardBlock = ({ block, index }) => {
    const [expanded, setExpanded] = useState(false);
    const [copied, setCopied] = useState(false);

    const handleCopy = () => {
        let textToCopy = `${block.title}\n\n`;
        block.components.forEach(component => {
            textToCopy += `${component.metric}\n`;
            textToCopy += `Purpose: ${component.purpose}\n`;
            textToCopy += `Visualization: ${component.visualization}\n\n`;
        });
        navigator.clipboard.writeText(textToCopy);
        setCopied(true);
        setTimeout(() => setCopied(false), 2000);
    };

    const toggleExpand = () => {
        setExpanded(!expanded);
    };

    const getVisualizationIcon = (visualizationType) => {
        const iconMap = {
            'line chart': 'fas fa-chart-line',
            'bar chart': 'fas fa-chart-bar',
            'pie chart': 'fas fa-chart-pie',
            'heatmap': 'fas fa-th',
            'scatter plot': 'fas fa-braille',
            'treemap': 'fas fa-sitemap',
            'matrix': 'fas fa-table'
        };

        for (const [key, icon] of Object.entries(iconMap)) {
            if (visualizationType.toLowerCase().includes(key)) {
                return icon;
            }
        }
        return 'fas fa-chart-bar';
    };

    return (
        <div className="dashboard-block card my-4">
            <div className="card-header bg-purple bg-opacity-10 border-purple">
                <div className="d-flex justify-content-between align-items-center">
                    <div className="d-flex align-items-center">
                        <i className="fas fa-tachometer-alt text-purple me-2"></i>
                        <h5 className="card-title mb-0 text-dark">
                            {block.title}
                        </h5>
                    </div>
                    <div className="dashboard-actions">
                        <button
                            className="btn btn-sm btn-outline-secondary me-2"
                            onClick={handleCopy}
                            title="Copy dashboard components"
                        >
                            <i className={`fas ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                            {copied ? ' Copied!' : ' Copy'}
                        </button>
                        <button
                            className="btn btn-sm btn-outline-primary"
                            onClick={toggleExpand}
                        >
                            <i className={`fas fa-${expanded ? 'minus' : 'plus'}`}></i>
                            {expanded ? ' Less' : ' More'}
                        </button>
                    </div>
                </div>
            </div>

            <div className="card-body">
                <div className="dashboard-content">
                    {/* Components Grid */}
                    <div className="components-grid">
                        <div className="row">
                            {block.components.map((component, compIndex) => (
                                <div key={compIndex} className="col-lg-6 mb-3">
                                    <div className="component-card card h-100">
                                        <div className="card-header py-2 bg-purple bg-opacity-10">
                                            <div className="d-flex align-items-center">
                                                <i className={`${getVisualizationIcon(component.visualization)} text-purple me-2`}></i>
                                                <h6 className="mb-0 flex-grow-1">{component.metric}</h6>
                                            </div>
                                        </div>
                                        <div className="card-body">
                                            <div className="component-purpose mb-3">
                                                <small className="text-muted d-block mb-1">
                                                    <i className="fas fa-bullseye me-1"></i>
                                                    Purpose
                                                </small>
                                                <div className="purpose-text">{component.purpose}</div>
                                            </div>
                                            <div className="component-visualization">
                                                <small className="text-muted d-block mb-1">
                                                    <i className="fas fa-chart-area me-1"></i>
                                                    Visualization
                                                </small>
                                                <div className="visualization-text">
                                                    <i className="fas fa-eye me-1 text-info"></i>
                                                    {component.visualization}
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            ))}
                        </div>
                    </div>

                    {/* Expanded Additional Content */}
                    {expanded && (
                        <div className="expanded-content mt-4">
                            <div className="dashboard-best-practices">
                                <h6 className="d-flex align-items-center text-warning mb-3">
                                    <i className="fas fa-lightbulb me-2"></i>
                                    Dashboard Best Practices
                                </h6>
                                <div className="row">
                                    <div className="col-md-6 mb-3">
                                        <div className="practice-item p-3 bg-light rounded">
                                            <i className="fas fa-sync-alt text-primary me-2"></i>
                                            <strong>Real-time Updates:</strong> Automate data refresh
                                        </div>
                                    </div>
                                    <div className="col-md-6 mb-3">
                                        <div className="practice-item p-3 bg-light rounded">
                                            <i className="fas fa-mobile-alt text-info me-2"></i>
                                            <strong>Mobile Responsive:</strong> Ensure accessibility
                                        </div>
                                    </div>
                                    <div className="col-md-6 mb-3">
                                        <div className="practice-item p-3 bg-light rounded">
                                            <i className="fas fa-filter text-success me-2"></i>
                                            <strong>Interactive Filters:</strong> Enable drill-down
                                        </div>
                                    </div>
                                    <div className="col-md-6 mb-3">
                                        <div className="practice-item p-3 bg-light rounded">
                                            <i className="fas fa-bell text-warning me-2"></i>
                                            <strong>Alert System:</strong> Set up threshold alerts
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    )}
                </div>

                {/* Quick Stats */}
                <div className="dashboard-footer mt-3 pt-3 border-top">
                    <div className="d-flex justify-content-between align-items-center">
                        <div className="stats small text-muted">
                            <i className="fas fa-chart-bar me-1"></i>
                            {block.components.length} dashboard components
                        </div>
                        <div className="quick-feedback">
                            <small className="text-muted">
                                <i className="fas fa-comment me-1"></i>
                                Comprehensive dashboard?
                                <button className="btn btn-sm btn-link p-0 ms-1" title="Yes">
                                    <i className="fas fa-thumbs-up text-success"></i>
                                </button>
                                <button className="btn btn-sm btn-link p-0 ms-1" title="No">
                                    <i className="fas fa-thumbs-down text-danger"></i>
                                </button>
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    );
};
const MeasurementGuidelinesBlock = ({ block, index }) => {
    const [expanded, setExpanded] = useState(false);
    const [copied, setCopied] = useState(false);

    const handleCopy = () => {
        let textToCopy = `${block.title}\n\n`;
        block.guidelines.forEach(guideline => {
            textToCopy += `${guideline.category}:\n`;
            guideline.rules.forEach(rule => {
                textToCopy += `• ${rule}\n`;
            });
            textToCopy += '\n';
        });
        navigator.clipboard.writeText(textToCopy);
        setCopied(true);
        setTimeout(() => setCopied(false), 2000);
    };

    const toggleExpand = () => {
        setExpanded(!expanded);
    };

    return (
        <div className="measurement-guidelines-block card my-4">
            <div className="card-header bg-success bg-opacity-10 border-success">
                <div className="d-flex justify-content-between align-items-center">
                    <div className="d-flex align-items-center">
                        <i className="fas fa-ruler-combined text-success me-2"></i>
                        <h5 className="card-title mb-0 text-dark">
                            {block.title}
                        </h5>
                    </div>
                    <div className="guidelines-actions">
                        <button
                            className="btn btn-sm btn-outline-secondary me-2"
                            onClick={handleCopy}
                            title="Copy guidelines"
                        >
                            <i className={`fas ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                            {copied ? ' Copied!' : ' Copy'}
                        </button>
                        <button
                            className="btn btn-sm btn-outline-primary"
                            onClick={toggleExpand}
                        >
                            <i className={`fas fa-${expanded ? 'minus' : 'plus'}`}></i>
                            {expanded ? ' Collapse' : ' Expand'}
                        </button>
                    </div>
                </div>
            </div>

            <div className="card-body">
                <div className="guidelines-content">
                    {/* Summary View (Collapsed) */}
                    {!expanded && (
                        <div className="guidelines-summary">
                            <div className="row">
                                {block.guidelines.map((guideline, guideIndex) => (
                                    <div key={guideIndex} className="col-md-4 mb-3">
                                        <div className="guideline-category card h-100">
                                            <div className="card-header py-2 bg-light">
                                                <h6 className="mb-0 text-center">
                                                    <i className="fas fa-clipboard-list me-2 text-success"></i>
                                                    {guideline.category}
                                                </h6>
                                            </div>
                                            <div className="card-body py-2">
                                                <div className="rules-preview">
                                                    {guideline.rules.slice(0, 2).map((rule, ruleIndex) => (
                                                        <div key={ruleIndex} className="rule-item small text-muted mb-1">
                                                            • {rule}
                                                        </div>
                                                    ))}
                                                    {guideline.rules.length > 2 && (
                                                        <div className="more-items small text-primary">
                                                            +{guideline.rules.length - 2} more rules...
                                                        </div>
                                                    )}
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                ))}
                            </div>
                        </div>
                    )}

                    {/* Expanded View */}
                    {expanded && (
                        <div className="guidelines-expanded">
                            {block.guidelines.map((guideline, guideIndex) => (
                                <div key={guideIndex} className="guideline-section mb-4">
                                    <h6 className="d-flex align-items-center text-success mb-3">
                                        <i className="fas fa-clipboard-check me-2"></i>
                                        {guideline.category}
                                    </h6>
                                    <div className="rules-list">
                                        {guideline.rules.map((rule, ruleIndex) => (
                                            <div key={ruleIndex} className="rule-item d-flex align-items-start mb-2 p-2 bg-light rounded">
                                                <i className="fas fa-check-circle text-success mt-1 me-3"></i>
                                                <div className="rule-text flex-grow-1">
                                                    {rule}
                                                </div>
                                            </div>
                                        ))}
                                    </div>
                                </div>
                            ))}
                        </div>
                    )}
                </div>

                {/* Quick Stats */}
                <div className="guidelines-footer mt-3 pt-3 border-top">
                    <div className="d-flex justify-content-between align-items-center">
                        <div className="stats small text-muted">
                            <i className="fas fa-layer-group me-1"></i>
                            {block.guidelines.length} categories •
                            {block.guidelines.reduce((total, guideline) => total + guideline.rules.length, 0)} total guidelines
                        </div>
                        <div className="quick-feedback">
                            <small className="text-muted">
                                <i className="fas fa-comment me-1"></i>
                                Clear guidelines?
                                <button className="btn btn-sm btn-link p-0 ms-1" title="Yes">
                                    <i className="fas fa-thumbs-up text-success"></i>
                                </button>
                                <button className="btn btn-sm btn-link p-0 ms-1" title="No">
                                    <i className="fas fa-thumbs-down text-danger"></i>
                                </button>
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    );
};
