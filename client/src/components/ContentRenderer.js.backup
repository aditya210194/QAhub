                                            <i className="fas fa-tasks me-1"></i>
                                            Key Activities
                                        </small>
                                        <div className="activities-list">
                                            {phase.activities.map((activity, activityIndex) => (
                                                <div key={activityIndex} className="activity-item small bg-primary bg-opacity-10 p-2 rounded mb-1">
                                                    • {activity}
                                                </div>
                                            ))}
                                        </div>
                                    </div>
                                </div>
                                <div className="col-md-6">
                                    <div className="deliverables-section">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-file-alt me-1"></i>
                                            Deliverables
                                        </small>
                                        <div className="deliverables-list">
                                            {phase.deliverables.map((deliverable, deliverableIndex) => (
                                                <div key={deliverableIndex} className="deliverable-item small text-success mb-1">
                                                    ✓ {deliverable}
                                                </div>
                                            ))}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    );
};

// Test Estimation Component
const TestEstimationBlock = ({ block, index }) => {
    const [copied, setCopied] = useState(false);

    const handleCopy = () => {
        let textToCopy = `${block.title}\n\n`;
        block.techniques.forEach(technique => {
            textToCopy += `${technique.technique}\n`;
            textToCopy += `Description: ${technique.description}\n`;
            textToCopy += `Formula: ${technique.formula}\n`;
            textToCopy += `Best For: ${technique['best-for']}\n\n`;
        });
        navigator.clipboard.writeText(textToCopy);
        setCopied(true);
        setTimeout(() => setCopied(false), 2000);
    };

    return (
        <div className="test-estimation-block card my-4">
            <div className="card-header bg-success bg-opacity-10 border-success">
                <div className="d-flex justify-content-between align-items-center">
                    <div className="d-flex align-items-center">
                        <i className="fas fa-calculator text-success me-2"></i>
                        <h5 className="card-title mb-0 text-dark">{block.title}</h5>
                    </div>
                    <button className="btn btn-sm btn-outline-secondary" onClick={handleCopy}>
                        <i className={`fas ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                        {copied ? ' Copied!' : ' Copy'}
                    </button>
                </div>
            </div>

            <div className="card-body">
                <div className="estimation-techniques">
                    {block.techniques.map((technique, techniqueIndex) => (
                        <div key={techniqueIndex} className="technique-item mb-4 p-3 border rounded">
                            <div className="technique-header mb-3">
                                <h6 className="text-success mb-2">
                                    <i className="fas fa-chart-line me-2"></i>
                                    {technique.technique}
                                </h6>
                                <div className="technique-description text-muted small mb-3">
                                    <i className="fas fa-info-circle me-1"></i>
                                    {technique.description}
                                </div>
                            </div>

                            <div className="row">
                                <div className="col-md-6">
                                    <div className="formula-section mb-3">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-square-root-alt me-1"></i>
                                            Estimation Formula
                                        </small>
                                        <div className="formula-text small bg-success bg-opacity-10 p-2 rounded font-monospace">
                                            {technique.formula}
                                        </div>
                                    </div>
                                </div>
                                <div className="col-md-6">
                                    <div className="best-for-section">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-star me-1"></i>
                                            Best For
                                        </small>
                                        <div className="best-for-text small">
                                            {technique['best-for']}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    ))}
                </div>

                {/* Sample Estimation Table */}
                <div className="sample-estimation mt-4 p-3 bg-light rounded">
                    <h6 className="text-success mb-3">
                        <i className="fas fa-table me-2"></i>
                        Sample Test Effort Estimation
                    </h6>
                    <div className="table-responsive">
                        <table className="table table-sm table-bordered">
                            <thead className="table-light">
                            <tr>
                                <th>Test Type</th>
                                <th>Test Cases</th>
                                <th>Effort/Case (hours)</th>
                                <th>Total Effort (hours)</th>
                            </tr>
                            </thead>
                            <tbody>
                            <tr>
                                <td>Functional Testing</td>
                                <td>500</td>
                                <td>0.5</td>
                                <td>250</td>
                            </tr>
                            <tr>
                                <td>Integration Testing</td>
                                <td>200</td>
                                <td>1.0</td>
                                <td>200</td>
                            </tr>
                            <tr>
                                <td>Security Testing</td>
                                <td>100</td>
                                <td>2.0</td>
                                <td>200</td>
                            </tr>
                            <tr>
                                <td>Performance Testing</td>
                                <td>50</td>
                                <td>3.0</td>
                                <td>150</td>
                            </tr>
                            <tr className="table-primary">
                                <td><strong>Total</strong></td>
                                <td><strong>850</strong></td>
                                <td></td>
                                <td><strong>800 hours</strong></td>
                            </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    );
};

