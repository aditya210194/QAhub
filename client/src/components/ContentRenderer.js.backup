                                    <div className="tools-section">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-tools me-1"></i>
                                            Tools & Techniques
                                        </small>
                                        <div className="tools-list">
                                            {pillar['tools-techniques'].map((tool, toolIndex) => (
                                                <span key={toolIndex} className="badge bg-secondary me-1 mb-1">
                                                    {tool}
                                                </span>
                                            ))}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    ))}
