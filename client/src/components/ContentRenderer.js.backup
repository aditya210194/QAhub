            textToCopy += `${analytic.metric}\n`;
            textToCopy += `Purpose: ${analytic.purpose}\n`;
            textToCopy += `Calculation: ${analytic.calculation}\n`;
            textToCopy += `Implementation: ${analytic.implementation}\n`;
            textToCopy += `Use Case: ${analytic['use-case']}\n\n`;
        });
        navigator.clipboard.writeText(textToCopy);
        setCopied(true);
