// Sprint Closure Component
const SprintClosureBlock = ({ block, index }) => {
    const [copied, setCopied] = useState(false);

    const handleCopy = () => {
        let textToCopy = `${block.title}\n\n`;
        block.activities.forEach(activity => {
            textToCopy += `${activity.activity}\n`;
            textToCopy += `Timing: ${activity.timing}\n`;
            textToCopy += `Scope: ${activity.scope}\n`;
            textToCopy += `Acceptance: ${activity.acceptance}\n`;
            if (activity.content) {
                textToCopy += `Content: ${activity.content.join(', ')}\n`;
            }
            if (activity.distribution) {
                textToCopy += `Distribution: ${activity.distribution}\n`;
            }
            if (activity.artifacts) {
                textToCopy += `Artifacts: ${activity.artifacts.join(', ')}\n`;
            }
            if (activity.storage) {
                textToCopy += `Storage: ${activity.storage}\n`;
            }
            textToCopy += '\n';
        });
        navigator.clipboard.writeText(textToCopy);
        setCopied(true);
        setTimeout(() => setCopied(false), 2000);
    };

    return (
        <div className="sprint-closure-block card my-4">
            <div className="card-header bg-success bg-opacity-10 border-success">
                <div className="d-flex justify-content-between align-items-center">
                    <div className="d-flex align-items-center">
                        <i className="fas fa-flag-checkered text-success me-2"></i>
                        <h5 className="card-title mb-0 text-dark">{block.title}</h5>
                    </div>
                    <button className="btn btn-sm btn-outline-secondary" onClick={handleCopy}>
                        <i className={`fas ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                        {copied ? ' Copied!' : ' Copy'}
                    </button>
                </div>
            </div>

            <div className="card-body">
                <div className="closure-activities">
                    {block.activities.map((activity, activityIndex) => (
                        <div key={activityIndex} className="activity-item mb-4 p-3 border rounded">
                            <div className="activity-header mb-3">
                                <h6 className="text-success mb-2">
                                    <i className="fas fa-tasks me-2"></i>
                                    {activity.activity}
                                </h6>
                                <div className="activity-timing text-muted small mb-3">
                                    <i className="fas fa-clock me-1"></i>
                                    Timing: {activity.timing}
                                </div>
                            </div>

                            <div className="activity-details">
                                <div className="row">
                                    <div className="col-md-6">
                                        <div className="scope-section mb-3">
                                            <small className="text-muted d-block mb-2">
                                                <i className="fas fa-bullseye me-1"></i>
                                                Scope
                                            </small>
                                            <div className="scope-text small bg-success bg-opacity-10 p-2 rounded">
                                                {activity.scope}
                                            </div>
                                        </div>
                                    </div>
                                    <div className="col-md-6">
                                        <div className="acceptance-section mb-3">
                                            <small className="text-muted d-block mb-2">
                                                <i className="fas fa-check-circle me-1"></i>
                                                Acceptance Criteria
                                            </small>
                                            <div className="acceptance-text small text-warning">
                                                {activity.acceptance}
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                {activity.content && (
                                    <div className="content-section mb-3">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-file-alt me-1"></i>
                                            Content
                                        </small>
                                        <div className="content-list">
                                            {activity.content.map((item, itemIndex) => (
                                                <div key={itemIndex} className="content-item small bg-light p-2 rounded mb-1">
                                                    • {item}
                                                </div>
                                            ))}
                                        </div>
                                    </div>
                                )}

                                {activity.distribution && (
                                    <div className="distribution-section mb-3">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-share-alt me-1"></i>
                                            Distribution
                                        </small>
                                        <div className="distribution-text small">
                                            {activity.distribution}
                                        </div>
                                    </div>
                                )}

                                {activity.artifacts && (
                                    <div className="artifacts-section mb-3">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-archive me-1"></i>
                                            Artifacts
                                        </small>
                                        <div className="artifacts-list">
                                            {activity.artifacts.map((artifact, artifactIndex) => (
                                                <div key={artifactIndex} className="artifact-item small text-info mb-1">
                                                    ✓ {artifact}
                                                </div>
                                            ))}
                                        </div>
                                    </div>
                                )}

                                {activity.storage && (
                                    <div className="storage-section">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-database me-1"></i>
                                            Storage
                                        </small>
                                        <div className="storage-text small">
                                            {activity.storage}
                                        </div>
                                    </div>
                                )}
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    );
};
