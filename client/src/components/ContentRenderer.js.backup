                                            <>
                                                <small className="text-muted d-block mb-2 mt-3">
                                                    <i className="fas fa-monument me-1"></i>
                                                    Legacy Building
                                                </small>
                                                <div className="legacy-text small bg-warning bg-opacity-10 p-2 rounded">
                                                    {strategy['legacy-building']}
