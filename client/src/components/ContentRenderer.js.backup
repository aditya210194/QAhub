                                                        <small className="text-muted d-block mb-1">
                                                            <i className="fas fa-bullseye me-1"></i>
                                                            Expected Benefits
                                                        </small>
                                                        <div className="benefits-list">
                                                            {opportunity['expected-benefits'].map((benefit, benefitIndex) => (
                                                                <span key={benefitIndex} className="badge bg-success bg-opacity-20 text-success border border-success me-1 mb-1">
                                                                    {benefit}
                                                                </span>
                                                            ))}
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>

                                            {expanded && (
                                                <div className="implementation-guidance mt-3 p-2 bg-light rounded">
                                                    <small className="text-muted d-block mb-1">Implementation Approach:</small>
                                                    <p className="small mb-0">{opportunity['implementation-approach']}</p>
                                                </div>
                                            )}
                                        </div>
                                    </div>
                                ))}
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    );
};
