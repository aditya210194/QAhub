        block.frameworks.forEach(framework => {
            textToCopy += `${framework.framework}\n`;
            textToCopy += `Focus: ${framework.focus}\n`;
            textToCopy += `Phases: ${framework.phases.join(', ')}\n`;
            textToCopy += `Coverage: ${framework.coverage}\n\n`;
        });
        navigator.clipboard.writeText(textToCopy);
        setCopied(true);
        setTimeout(() => setCopied(false), 2000);
    };

    return (
        <div className="methodology-framework-block card my-4">
            <div className="card-header bg-success bg-opacity-10 border-success">
