};
const CrossValidationBlock = ({ block, index }) => {
    const [copied, setCopied] = useState(false);

    const handleCopy = () => {
        let textToCopy = `${block.title}\n\n`;
        block.methods.forEach(method => {
            textToCopy += `${method.method}\n`;
            textToCopy += `Description: ${method.description}\n`;
            textToCopy += `Applicability: ${method.applicability}\n`;
            textToCopy += "Advantages:\n";
            method.advantages.forEach(advantage => {
                textToCopy += `• ${advantage}\n`;
            });
            textToCopy += "Disadvantages:\n";
            method.disadvantages.forEach(disadvantage => {
                textToCopy += `• ${disadvantage}\n`;
            });
            textToCopy += "\n";
        });
        navigator.clipboard.writeText(textToCopy);
        setCopied(true);
        setTimeout(() => setCopied(false), 2000);
    };

    return (
        <div className="cross-validation-block card my-4">
            <div className="card-header bg-warning bg-opacity-10 border-warning">
                <div className="d-flex justify-content-between align-items-center">
                    <div className="d-flex align-items-center">
                        <i className="fas fa-check-double text-warning me-2"></i>
                        <h5 className="card-title mb-0 text-dark">{block.title}</h5>
                    </div>
                    <button className="btn btn-sm btn-outline-secondary" onClick={handleCopy}>
                        <i className={`fas ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                        {copied ? ' Copied!' : ' Copy'}
                    </button>
                </div>
            </div>

            <div className="card-body">
                <div className="validation-methods">
                    {block.methods.map((method, methodIndex) => (
                        <div key={methodIndex} className="method-item mb-4 p-3 border rounded">
                            <div className="method-header mb-3">
                                <h6 className="text-warning mb-2">
                                    <i className="fas fa-cogs me-2"></i>
