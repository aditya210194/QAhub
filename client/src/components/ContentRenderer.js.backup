            textToCopy += `Communication Frequency: ${stakeholder['communication-frequency']}\n`;
            textToCopy += `Key Concerns: ${stakeholder['key-concerns'].join(', ')}\n\n`;
        });
        navigator.clipboard.writeText(textToCopy);
        setCopied(true);
        setTimeout(() => setCopied(false), 2000);
