                                    <small className="text-muted">
                                        <i className="fas fa-clock me-1"></i>
                                        {phase.duration}
                                    </small>
                                </div>
                                <span className="badge bg-warning">Phase {phaseIndex + 1}</span>
                            </div>

                            <div className="row">
                                <div className="col-md-6">
                                    <div className="activities-section mb-3">
