                            <i className={`fas ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                            {copied ? ' Copied!' : ' Copy'}
                        </button>
                        <button className="btn btn-sm btn-outline-primary" onClick={toggleExpand}>
                            <i className={`fas fa-${expanded ? 'minus' : 'plus'}`}></i>
                            {expanded ? ' Less' : ' More'}
                        </button>
                    </div>
                </div>
            </div>

            <div className="card-body">
                <div className="reports-grid">
                    {block.reports.map((report, reportIndex) => (
                        <div key={reportIndex} className="report-item mb-4 p-3 border rounded">
                            <div className="report-header d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <h6 className="text-success mb-1">
                                        <i className="fas fa-file-alt me-2"></i>
                                        {report.report}
                                    </h6>
                                    <div className="report-audience text-muted small">
                                        <i className="fas fa-users me-1"></i>
                                        Audience: {report.audience}
                                    </div>
                                </div>
                                <span className={`badge bg-${getFrequencyColor(report.frequency)}`}>
                                    {report.frequency}
                                </span>
                            </div>

                            <div className="report-content">
                                <small className="text-muted d-block mb-2">
                                    <i className="fas fa-list-ul me-1"></i>
                                    Report Content
                                </small>
                                <div className="content-list">
                                    {report.content.slice(0, expanded ? report.content.length : 3).map((item, itemIndex) => (
                                        <div key={itemIndex} className="content-item small text-muted mb-1">
                                            • {item}
                                        </div>
                                    ))}
                                    {!expanded && report.content.length > 3 && (
                                        <div className="more-items small text-primary">
                                            +{report.content.length - 3} more items...
                                        </div>
                                    )}
                                </div>
                            </div>
                        </div>
                    ))}
