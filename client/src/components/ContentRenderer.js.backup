                                    <div className="advantages-section mb-3">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-thumbs-up me-1"></i>
                                            Advantages
                                        </small>
                                        <div className="advantages-list">
                                            {method.advantages.map((advantage, advIndex) => (
                                                <div key={advIndex} className="advantage-item small text-success mb-1">
                                                    ✓ {advantage}
                                                </div>
                                            ))}
                                        </div>
                                    </div>
                                </div>
                                <div className="col-md-6">
                                    <div className="disadvantages-section">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-thumbs-down me-1"></i>
                                            Disadvantages
                                        </small>
                                        <div className="disadvantages-list">
                                            {method.disadvantages.map((disadvantage, disIndex) => (
                                                <div key={disIndex} className="disadvantage-item small text-danger mb-1">
                                                    ✗ {disadvantage}
                                                </div>
                                            ))}
