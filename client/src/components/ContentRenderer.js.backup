const AdvancedApplicationsBlock = ({ block, index }) => {
    const [copied, setCopied] = useState(false);

    const handleCopy = () => {
        let textToCopy = `${block.title}\n\n`;
        block.applications.forEach(app => {
            textToCopy += `${app.application}\n`;
            textToCopy += `Description: ${app.description}\n`;
            textToCopy += "Capabilities:\n";
            app.capabilities.forEach(capability => {
                textToCopy += `• ${capability}\n`;
            });
            textToCopy += `Business Impact: ${app['business-impact']}\n\n`;
        });
        navigator.clipboard.writeText(textToCopy);
        setCopied(true);
        setTimeout(() => setCopied(false), 2000);
    };

    const getImpactColor = (impact) => {
        const impactMap = {
            'High': 'danger',
            'Medium-High': 'warning',
            'Medium': 'info',
            'Low': 'success'
        };
        return impactMap[impact] || 'secondary';
    };

    return (
        <div className="advanced-applications-block card my-4">
            <div className="card-header bg-success bg-opacity-10 border-success">
                <div className="d-flex justify-content-between align-items-center">
                    <div className="d-flex align-items-center">
                        <i className="fas fa-rocket text-success me-2"></i>
                        <h5 className="card-title mb-0 text-dark">{block.title}</h5>
                    </div>
                    <button className="btn btn-sm btn-outline-secondary" onClick={handleCopy}>
                        <i className={`fas ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                        {copied ? ' Copied!' : ' Copy'}
                    </button>
                </div>
            </div>

            <div className="card-body">
                <div className="applications-grid">
                    {block.applications.map((app, appIndex) => (
                        <div key={appIndex} className="application-item mb-4 p-3 border rounded">
                            <div className="application-header d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <h6 className="text-success mb-2">
                                        <i className="fas fa-cogs me-2"></i>
                                        {app.application}
                                    </h6>
                                    <div className="application-description text-muted small mb-2">
                                        <i className="fas fa-info-circle me-1"></i>
                                        {app.description}
                                    </div>
                                </div>
                                <span className={`badge bg-${getImpactColor(app['business-impact'])}`}>
                                    {app['business-impact']} Impact
                                </span>
                            </div>

                            <div className="capabilities-section">
                                <small className="text-muted d-block mb-2">
                                    <i className="fas fa-bolt me-1"></i>
                                    AI Capabilities
                                </small>
                                <div className="capabilities-list">
                                    {app.capabilities.map((capability, capIndex) => (
                                        <div key={capIndex} className="capability-item d-flex align-items-start mb-2">
                                            <i className="fas fa-check-circle text-success fa-xs mt-1 me-2"></i>
                                            <span className="small">{capability}</span>
                                        </div>
                                    ))}
                                </div>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    );
};
// Token Types Component
const TokenTypesBlock = ({ block, index }) => {
    const [copied, setCopied] = useState(false);

    const handleCopy = () => {
        let textToCopy = `${block.title}\n\n`;
        block.categories.forEach(category => {
            textToCopy += `${category.type}\n`;
            textToCopy += `Characteristics: ${category.characteristics.join(', ')}\n`;
            textToCopy += `Common Uses: ${category['common-uses'].join(', ')}\n`;
            textToCopy += `Security Considerations: ${category['security-considerations'].join(', ')}\n\n`;
        });
        navigator.clipboard.writeText(textToCopy);
        setCopied(true);
        setTimeout(() => setCopied(false), 2000);
    };

    return (
        <div className="token-types-block card my-4">
            <div className="card-header bg-primary bg-opacity-10 border-primary">
                <div className="d-flex justify-content-between align-items-center">
                    <div className="d-flex align-items-center">
                        <i className="fas fa-key text-primary me-2"></i>
                        <h5 className="card-title mb-0 text-dark">{block.title}</h5>
                    </div>
                    <button className="btn btn-sm btn-outline-secondary" onClick={handleCopy}>
                        <i className={`fas ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                        {copied ? ' Copied!' : ' Copy'}
                    </button>
                </div>
            </div>

            <div className="card-body">
                <div className="token-types-grid">
                    {block.categories.map((category, categoryIndex) => (
                        <div key={categoryIndex} className="token-type-item mb-4 p-3 border rounded">
                            <div className="type-header mb-3">
                                <h6 className="text-primary mb-2">
                                    <i className="fas fa-lock me-2"></i>
                                    {category.type}
                                </h6>
                            </div>

                            <div className="row">
                                <div className="col-md-4">
                                    <div className="characteristics-section mb-3">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-list me-1"></i>
                                            Characteristics
                                        </small>
                                        <div className="characteristics-list">
                                            {category.characteristics.map((characteristic, charIndex) => (
                                                <div key={charIndex} className="characteristic-item small bg-primary bg-opacity-10 p-2 rounded mb-1">
                                                    • {characteristic}
                                                </div>
                                            ))}
                                        </div>
                                    </div>
                                </div>
                                <div className="col-md-4">
                                    <div className="uses-section mb-3">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-rocket me-1"></i>
                                            Common Uses
                                        </small>
                                        <div className="uses-list">
                                            {category['common-uses'].map((use, useIndex) => (
                                                <div key={useIndex} className="use-item small text-success mb-1">
                                                    ✓ {use}
                                                </div>
                                            ))}
                                        </div>
                                    </div>
                                </div>
                                <div className="col-md-4">
                                    <div className="security-section">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-shield-alt me-1"></i>
                                            Security Considerations
                                        </small>
                                        <div className="security-list">
                                            {category['security-considerations'].map((consideration, considerationIndex) => (
                                                <div key={considerationIndex} className="consideration-item small text-warning mb-1">
                                                    ⚠ {consideration}
                                                </div>
                                            ))}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    ))}
                </div>

                {/* Token Type Comparison */}
                <div className="comparison-section mt-4">
                    <h6 className="text-primary mb-3">
                        <i className="fas fa-balance-scale me-2"></i>
                        Token Type Security Comparison
                    </h6>
                    <div className="table-responsive">
                        <table className="table table-sm table-bordered">
                            <thead className="table-light">
                            <tr>
                                <th>Token Type</th>
                                <th>Security Level</th>
                                <th>Common Attacks</th>
                                <th>Best For</th>
                            </tr>
                            </thead>
                            <tbody>
                            <tr>
                                <td><strong>JWT</strong></td>
                                <td>High</td>
                                <td>Algorithm Confusion, None Attack</td>
                                <td>Stateless APIs, Microservices</td>
                            </tr>
                            <tr>
                                <td><strong>Opaque Tokens</strong></td>
                                <td>Medium</td>
                                <td>Token Theft, Replay</td>
                                <td>Traditional Web Apps</td>
                            </tr>
                            <tr>
                                <td><strong>Reference Tokens</strong></td>
                                <td>High</td>
                                <td>Database Attacks, DoS</td>
                                <td>High Security Systems</td>
                            </tr>
                            <tr>
                                <td><strong>Self-Contained Tokens</strong></td>
                                <td>Medium-High</td>
                                <td>Information Leakage, Tampering</td>
                                <td>Distributed Systems</td>
                            </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    );
};

// JWT Structure Component
