                                    {category.category}
                                </h6>
                            </div>

                            <div className="use-case-details">
                                <div className="problem-section mb-3">
                                    <small className="text-muted d-block mb-1">
                                        <i className="fas fa-exclamation-triangle me-1"></i>
                                        Problem
                                    </small>
                                    <div className="problem-text small bg-light p-2 rounded">
                                        {category.problem}
                                    </div>
