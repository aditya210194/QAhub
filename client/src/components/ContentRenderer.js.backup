                                    <div className="examples-section mb-3">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-eye me-1"></i>
                                            Examples
                                        </small>
                                        <div className="examples-list">
                                            {app.examples.map((example, exampleIndex) => (
                                                <div key={exampleIndex} className="example-item small bg-info bg-opacity-10 p-2 rounded mb-1">
                                                    • {example}
                                                </div>
                                            ))}
                                        </div>
                                    </div>
                                </div>
                                <div className="col-md-5">
                                    <div className="testing-focus-section mb-3">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-bullseye me-1"></i>
                                            Testing Focus Areas
                                        </small>
                                        <div className="focus-list">
                                            {app['testing-focus'].map((focus, focusIndex) => (
                                                <div key={focusIndex} className="focus-item small text-success mb-1">
                                                    ✓ {focus}
                                                </div>
                                            ))}
                                        </div>
                                    </div>
                                </div>
                                <div className="col-md-3">
                                    <div className="complexity-section">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-chart-bar me-1"></i>
                                            Complexity Level
                                        </small>
                                        <div className="complexity-text small text-warning">
                                            {app.complexity}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    );
};

