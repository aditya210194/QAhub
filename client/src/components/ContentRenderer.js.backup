            textToCopy += `${criterion.criterion}:\n`;
            criterion.considerations.forEach(consideration => {
                textToCopy += `• ${consideration}\n`;
            });
            textToCopy += "\n";
        });
        navigator.clipboard.writeText(textToCopy);
        setCopied(true);
        setTimeout(() => setCopied(false), 2000);
    };

    const toggleExpand = () => {
        setExpanded(!expanded);
    };

    return (
