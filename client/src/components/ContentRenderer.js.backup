            'Medium-High': 'warning',
            'Medium': 'info',
            'Low': 'success'
        };
        return impactMap[impact] || 'secondary';
    };

    return (
        <div className="factor-analysis-block card my-4">
            <div className="card-header bg-primary bg-opacity-10 border-primary">
                <div className="d-flex justify-content-between align-items-center">
                    <div className="d-flex align-items-center">
                        <i className="fas fa-chart-pie text-primary me-2"></i>
                        <h5 className="card-title mb-0 text-dark">Factor Analysis</h5>
                    </div>
                    <div className="factor-actions">
                        <button className="btn btn-sm btn-outline-secondary me-2" onClick={handleCopy}>
                            <i className={`fas ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                            {copied ? ' Copied!' : ' Copy'}
                        </button>
                        <button className="btn btn-sm btn-outline-primary" onClick={toggleExpand}>
                            <i className={`fas fa-${expanded ? 'minus' : 'plus'}`}></i>
                            {expanded ? ' Less' : ' More'}
                        </button>
                    </div>
                </div>
            </div>

            <div className="card-body">
                <div className="factors-grid">
                    {block.categories.map((category, catIndex) => (
                        <div key={catIndex} className="factor-category mb-4 p-3 border rounded">
                            <div className="category-header d-flex justify-content-between align-items-center mb-3">
                                <h6 className="text-primary mb-0">
                                    <i className="fas fa-folder me-2"></i>
                                    {category.category}
                                </h6>
                                <span className={`badge bg-${getImpactColor(category.impact)}`}>
                                    Impact: {category.impact}
                                </span>
                            </div>

                            <div className="factors-list">
                                <small className="text-muted d-block mb-2">
                                    <i className="fas fa-list-ul me-1"></i>
                                    Key Factors
                                </small>
                                {category.factors.slice(0, expanded ? category.factors.length : 3).map((factor, factorIndex) => (
                                    <div key={factorIndex} className="factor-item d-flex align-items-start mb-2">
                                        <i className="fas fa-circle text-primary fa-xs mt-2 me-2"></i>
                                        <span className="small">{factor}</span>
                                    </div>
                                ))}
                                {!expanded && category.factors.length > 3 && (
                                    <div className="more-items small text-primary">
                                        +{category.factors.length - 3} more factors...
                                    </div>
                                )}
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    );
};
const RootCauseAnalysisBlock = ({ block, index }) => {
    const [copied, setCopied] = useState(false);

    const handleCopy = () => {
        let textToCopy = `${block.title}\n\n`;
        block.causes.forEach((cause, index) => {
            textToCopy += `${index + 1}. ${cause}\n`;
        });
        navigator.clipboard.writeText(textToCopy);
        setCopied(true);
        setTimeout(() => setCopied(false), 2000);
    };

    return (
        <div className="root-cause-analysis-block card my-4">
            <div className="card-header bg-danger bg-opacity-10 border-danger">
                <div className="d-flex justify-content-between align-items-center">
                    <div className="d-flex align-items-center">
                        <i className="fas fa-search text-danger me-2"></i>
                        <h5 className="card-title mb-0 text-dark">{block.title}</h5>
                    </div>
                    <button className="btn btn-sm btn-outline-secondary" onClick={handleCopy}>
                        <i className={`fas ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                        {copied ? ' Copied!' : ' Copy'}
                    </button>
                </div>
            </div>

            <div className="card-body">
                <div className="causes-list">
                    {block.causes.map((cause, causeIndex) => (
                        <div key={causeIndex} className="cause-item d-flex align-items-start mb-3 p-3 bg-danger bg-opacity-10 rounded">
                            <span className="badge bg-danger me-3 mt-1">{causeIndex + 1}</span>
                            <div className="cause-text flex-grow-1">
                                {cause}
                            </div>
                        </div>
                    ))}
                </div>

                {/* Impact Assessment */}
                <div className="impact-assessment mt-4 p-3 bg-light rounded">
                    <h6 className="d-flex align-items-center text-warning mb-3">
                        <i className="fas fa-exclamation-triangle me-2"></i>
                        Typical Impact
                    </h6>
                    <div className="row text-center">
                        <div className="col-md-4 mb-2">
                            <div className="impact-item p-2">
                                <i className="fas fa-bug text-danger fa-2x mb-2"></i>
                                <div className="impact-value text-danger">30-50%</div>
                                <small className="text-muted">Reduction in Defect Detection</small>
                            </div>
                        </div>
                        <div className="col-md-4 mb-2">
                            <div className="impact-item p-2">
                                <i className="fas fa-clock text-warning fa-2x mb-2"></i>
                                <div className="impact-value text-warning">40-60%</div>
                                <small className="text-muted">Increase in Production Defects</small>
                            </div>
                        </div>
                        <div className="col-md-4 mb-2">
                            <div className="impact-item p-2">
                                <i className="fas fa-dollar-sign text-info fa-2x mb-2"></i>
                                <div className="impact-value text-info">25-45%</div>
                                <small className="text-muted">Higher Support Costs</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    );
};
// Market Overview Component
const MarketOverviewBlock = ({ block, index }) => {
    const [expanded, setExpanded] = useState(false);
    const [copied, setCopied] = useState(false);

    const handleCopy = async () => {
        let textToCopy = `${block.title}\n\n`;
        block.segments.forEach(segment => {
            textToCopy += `${segment.segment}\n`;
            textToCopy += `Market Size: ${segment['market-size']}\n`;
            textToCopy += `Growth Rate: ${segment['growth-rate']}\n`;
            textToCopy += `Key Drivers: ${segment['key-drivers'].join(', ')}\n`;
            textToCopy += `Major Players: ${segment['major-players'].join(', ')}\n\n`;
        });

        try {
            await navigator.clipboard.writeText(textToCopy);
            setCopied(true);
            setTimeout(() => setCopied(false), 2000);
        } catch (err) {
            console.error('Failed to copy text: ', err);
        }
    };

    const getGrowthColor = (growth) => {
        const rate = parseInt(growth);
        if (rate >= 25) return 'success';
        if (rate >= 15) return 'warning';
        return 'danger';
    };

    return (
        <div className="market-overview-block card my-4 border-primary border-opacity-25">
            <div className="card-header bg-primary bg-opacity-10 border-primary">
                <div className="d-flex justify-content-between align-items-center">
                    <div className="d-flex align-items-center">
                        <i className="fas fa-chart-line text-primary me-2"></i>
                        <h5 className="card-title mb-0 text-dark">{block.title}</h5>
                    </div>
                    <div className="market-actions">
                        <button className="btn btn-sm btn-outline-secondary me-2" onClick={handleCopy}>
                            <i className={`fas ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                            {copied ? ' Copied!' : ' Copy'}
                        </button>
                        <button
                            className="btn btn-sm btn-outline-primary"
                            onClick={() => setExpanded(!expanded)}
                        >
                            <i className={`fas fa-${expanded ? 'minus' : 'plus'}`}></i>
                            {expanded ? ' Less' : ' More'}
                        </button>
                    </div>
                </div>
            </div>

            <div className="card-body">
                <div className="market-segments">
                    {block.segments.map((segment, segmentIndex) => (
                        <div key={segmentIndex} className="market-segment card mb-3">
                            <div className="card-header bg-light">
                                <div className="d-flex justify-content-between align-items-center">
                                    <h6 className="mb-0 text-dark">{segment.segment}</h6>
                                    <div className="market-meta">
                                        <span className="badge bg-primary me-2">{segment['market-size']}</span>
                                        <span className={`badge bg-${getGrowthColor(segment['growth-rate'])}`}>
                                            {segment['growth-rate']} Growth
                                        </span>
                                    </div>
                                </div>
                            </div>
                            <div className="card-body">
                                <div className="row">
                                    <div className="col-md-6">
                                        <div className="key-drivers mb-3">
                                            <small className="text-muted d-block mb-2">
                                                <i className="fas fa-rocket me-1 text-success"></i>
                                                Key Drivers
                                            </small>
                                            <div className="drivers-list">
                                                {segment['key-drivers'].map((driver, driverIndex) => (
                                                    <span key={driverIndex} className="badge bg-success bg-opacity-20 text-success border border-success me-1 mb-1">
                                                        {driver}
                                                    </span>
                                                ))}
                                            </div>
                                        </div>
                                    </div>
                                    <div className="col-md-6">
                                        <div className="major-players">
                                            <small className="text-muted d-block mb-2">
                                                <i className="fas fa-building me-1 text-primary"></i>
                                                Major Players
                                            </small>
                                            <div className="players-list">
                                                {segment['major-players'].map((player, playerIndex) => (
                                                    <span key={playerIndex} className="badge bg-primary bg-opacity-20 text-primary border border-primary me-1 mb-1">
                                                        {player}
                                                    </span>
                                                ))}
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                {expanded && (
                                    <div className="expanded-details mt-3 p-3 bg-light rounded">
                                        <h6 className="text-info small mb-2">
                                            <i className="fas fa-trending-up me-1"></i>
                                            Market Insights
                                        </h6>
                                        <div className="row">
                                            <div className="col-md-6">
                                                <small className="text-muted d-block">Adoption Stage:</small>
                                                <span className="badge bg-warning">Early Majority</span>
                                            </div>
                                            <div className="col-md-6">
                                                <small className="text-muted d-block">Investment Activity:</small>
                                                <span className="badge bg-success">High</span>
                                            </div>
                                        </div>
                                    </div>
                                )}
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    );
};

// Implementation Scenario Component
const ImplementationScenarioBlock = ({ block, index }) => {
    const [activeTab, setActiveTab] = useState('scenario');

    return (
        <div className="implementation-scenario-block card my-4 border-warning border-opacity-25">
            <div className="card-header bg-warning bg-opacity-10 border-warning">
                <div className="d-flex align-items-center">
                    <i className="fas fa-laptop-code text-warning me-2"></i>
                    <h5 className="card-title mb-0 text-dark">{block.title}</h5>
                </div>
            </div>

            <div className="card-body">
                {/* Tab Navigation */}
                <ul className="nav nav-tabs mb-4">
                    <li className="nav-item">
                        <button
                            className={`nav-link ${activeTab === 'scenario' ? 'active' : ''}`}
                            onClick={() => setActiveTab('scenario')}
                        >
                            <i className="fas fa-info-circle me-1"></i>
                            Scenario
                        </button>
                    </li>
                    <li className="nav-item">
                        <button
                            className={`nav-link ${activeTab === 'challenges' ? 'active' : ''}`}
                            onClick={() => setActiveTab('challenges')}
                        >
                            <i className="fas fa-exclamation-triangle me-1"></i>
                            Challenges
                        </button>
                    </li>
                    <li className="nav-item">
                        <button
                            className={`nav-link ${activeTab === 'solution' ? 'active' : ''}`}
                            onClick={() => setActiveTab('solution')}
                        >
                            <i className="fas fa-lightbulb me-1"></i>
                            Solution
                        </button>
                    </li>
                    <li className="nav-item">
                        <button
                            className={`nav-link ${activeTab === 'results' ? 'active' : ''}`}
                            onClick={() => setActiveTab('results')}
                        >
                            <i className="fas fa-chart-bar me-1"></i>
                            Results
                        </button>
                    </li>
                </ul>

                {/* Tab Content */}
                <div className="tab-content">
                    {activeTab === 'scenario' && (
                        <div className="scenario-tab">
                            <h6 className="text-primary mb-3">
                                <i className="fas fa-building me-2"></i>
                                Organization Context
                            </h6>
                            <p className="mb-4">{block.scenario}</p>

                            <div className="scenario-details row">
                                <div className="col-md-6">
                                    <div className="detail-card p-3 bg-light rounded mb-3">
                                        <small className="text-muted d-block mb-1">Team Size</small>
                                        <strong>{block['team-size']}</strong>
                                    </div>
                                </div>
                                <div className="col-md-6">
                                    <div className="detail-card p-3 bg-light rounded mb-3">
                                        <small className="text-muted d-block mb-1">Application Complexity</small>
                                        <strong>{block['application-complexity']}</strong>
                                    </div>
                                </div>
                            </div>
                        </div>
                    )}

                    {activeTab === 'challenges' && (
                        <div className="challenges-tab">
                            <h6 className="text-danger mb-3">
                                <i className="fas fa-exclamation-circle me-2"></i>
                                Key Challenges
                            </h6>
                            <div className="challenges-list">
                                {block.challenges.map((challenge, challengeIndex) => (
                                    <div key={challengeIndex} className="challenge-item mb-3 p-3 border border-danger border-opacity-25 rounded">
                                        <div className="d-flex align-items-start">
                                            <i className="fas fa-times-circle text-danger mt-1 me-3"></i>
                                            <div>
                                                <strong className="text-danger">{challenge.challenge}</strong>
                                                <p className="mb-0 small mt-1">{challenge.impact}</p>
                                            </div>
                                        </div>
                                    </div>
                                ))}
                            </div>
                        </div>
                    )}

                    {activeTab === 'solution' && (
                        <div className="solution-tab">
                            <h6 className="text-success mb-3">
                                <i className="fas fa-check-circle me-2"></i>
                                AI Testing Solution
                            </h6>
                            <div className="solution-approach mb-4">
                                <p className="mb-3">{block['solution-approach']}</p>

                                <div className="tools-used">
                                    <small className="text-muted d-block mb-2">Tools Implemented:</small>
                                    <div className="tools-list">
                                        {block['tools-used'].map((tool, toolIndex) => (
                                            <span key={toolIndex} className="badge bg-success me-2 mb-2">
                                                {tool}
                                            </span>
                                        ))}
                                    </div>
                                </div>
                            </div>

                            <div className="implementation-steps">
                                <h6 className="text-info small mb-3">Implementation Steps:</h6>
                                {block['implementation-steps'].map((step, stepIndex) => (
                                    <div key={stepIndex} className="step-item d-flex align-items-start mb-2">
                                        <span className="badge bg-primary me-3 mt-1">{stepIndex + 1}</span>
                                        <span className="small">{step}</span>
                                    </div>
                                ))}
                            </div>
                        </div>
                    )}

                    {activeTab === 'results' && (
                        <div className="results-tab">
                            <h6 className="text-success mb-3">
                                <i className="fas fa-trophy me-2"></i>
                                Achieved Results
                            </h6>
                            <div className="results-grid">
                                {block.results.map((result, resultIndex) => (
                                    <div key={resultIndex} className="result-item card border-success mb-3">
                                        <div className="card-body">
                                            <div className="d-flex justify-content-between align-items-center">
                                                <div>
                                                    <strong className="text-success">{result.metric}</strong>
                                                    <p className="mb-0 small text-muted">{result.description}</p>
                                                </div>
                                                <div className="result-value text-end">
                                                    <div className="h5 mb-0 text-success">{result.improvement}</div>
                                                    <small className="text-muted">Improvement</small>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                ))}
                            </div>
                        </div>
                    )}
                </div>
            </div>
        </div>
    );
};

// Comparison Table Component
const ComparisonTableBlock = ({ block, index }) => {
    const [copied, setCopied] = useState(false);

    const handleCopy = async () => {
        let textToCopy = `${block.title}\n\n`;
        textToCopy += `${block.headers.join(' | ')}\n`;
        textToCopy += "―".repeat(60) + "\n";

        block.rows.forEach(row => {
            textToCopy += `${row.join(' | ')}\n`;
        });

        try {
            await navigator.clipboard.writeText(textToCopy);
            setCopied(true);
            setTimeout(() => setCopied(false), 2000);
        } catch (err) {
            console.error('Failed to copy text: ', err);
        }
    };

    return (
        <div className="comparison-table-block card my-4 border-info border-opacity-25">
            <div className="card-header bg-info bg-opacity-10 border-info">
                <div className="d-flex justify-content-between align-items-center">
                    <div className="d-flex align-items-center">
                        <i className="fas fa-balance-scale text-info me-2"></i>
                        <h5 className="card-title mb-0 text-dark">{block.title}</h5>
                    </div>
                    <button className="btn btn-sm btn-outline-secondary" onClick={handleCopy}>
                        <i className={`fas ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                        {copied ? ' Copied!' : ' Copy'}
                    </button>
                </div>
            </div>

            <div className="card-body p-0">
                <div className="table-responsive">
                    <table className="table table-bordered table-hover mb-0">
                        <thead className="table-light">
                        <tr>
                            {block.headers.map((header, headerIndex) => (
                                <th key={headerIndex} className="text-center">
                                    {header}
                                </th>
                            ))}
                        </tr>
                        </thead>
                        <tbody>
                        {block.rows.map((row, rowIndex) => (
                            <tr key={rowIndex}>
                                {row.map((cell, cellIndex) => (
                                    <td key={cellIndex} className={
                                        cellIndex === 0 ? 'fw-bold bg-light' : ''
                                    }>
                                        {cell}
                                    </td>
                                ))}
                            </tr>
                        ))}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    );
};

// Selection Guidance Component
const SelectionGuidanceBlock = ({ block, index }) => {
    const [activeCriteria, setActiveCriteria] = useState(0);

    return (
        <div className="selection-guidance-block card my-4 border-success border-opacity-25">
            <div className="card-header bg-success bg-opacity-10 border-success">
                <div className="d-flex align-items-center">
                    <i className="fas fa-hand-pointer text-success me-2"></i>
                    <h5 className="card-title mb-0 text-dark">{block.title}</h5>
                </div>
            </div>

            <div className="card-body">
                {/* Criteria Selection */}
                <div className="criteria-tabs mb-4">
                    <div className="row">
                        {block.criteria.map((criterion, critIndex) => (
                            <div key={critIndex} className="col-md-4 mb-3">
                                <div
                                    className={`criteria-tab card text-center cursor-pointer ${activeCriteria === critIndex ? 'border-success' : ''}`}
                                    onClick={() => setActiveCriteria(critIndex)}
                                >
                                    <div className={`card-body ${activeCriteria === critIndex ? 'bg-success bg-opacity-10' : ''}`}>
                                        <h6 className="card-title text-dark small">{criterion.criterion}</h6>
                                        <span className={`badge bg-${criterion.priority === 'High' ? 'danger' : criterion.priority === 'Medium' ? 'warning' : 'success'}`}>
                                            {criterion.priority} Priority
                                        </span>
                                    </div>
                                </div>
                            </div>
                        ))}
                    </div>
                </div>

                {/* Guidance Details */}
                <div className="guidance-details">
                    <div className="row">
                        <div className="col-md-6">
                            <div className="recommendations">
                                <h6 className="text-primary small mb-3">
                                    <i className="fas fa-thumbs-up me-2"></i>
                                    Recommended For
                                </h6>
                                <div className="recommendation-list">
                                    {block.criteria[activeCriteria]['recommended-for'].map((item, itemIndex) => (
                                        <div key={itemIndex} className="recommendation-item d-flex align-items-start mb-2">
                                            <i className="fas fa-check-circle text-success mt-1 me-2"></i>
                                            <span className="small">{item}</span>
                                        </div>
                                    ))}
                                </div>
                            </div>
                        </div>
                        <div className="col-md-6">
                            <div className="considerations">
                                <h6 className="text-warning small mb-3">
                                    <i className="fas fa-exclamation-triangle me-2"></i>
                                    Key Considerations
                                </h6>
                                <div className="consideration-list">
                                    {block.criteria[activeCriteria].considerations.map((consideration, consIndex) => (
                                        <div key={consIndex} className="consideration-item d-flex align-items-start mb-2">
                                            <i className="fas fa-info-circle text-warning mt-1 me-2"></i>
                                            <span className="small">{consideration}</span>
                                        </div>
                                    ))}
                                </div>
                            </div>
                        </div>
                    </div>

                    {/* Decision Framework */}
                    <div className="decision-framework mt-4 p-3 bg-light rounded">
                        <h6 className="text-info small mb-3">
                            <i className="fas fa-sitemap me-2"></i>
                            Decision Framework
                        </h6>
                        <div className="framework-steps">
                            {block.criteria[activeCriteria]['decision-framework'].map((step, stepIndex) => (
                                <div key={stepIndex} className="framework-step d-flex align-items-start mb-2">
                                    <span className="badge bg-info me-3 mt-1">{stepIndex + 1}</span>
                                    <span className="small">{step}</span>
                                </div>
                            ))}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    );
};

// Integration Opportunities Component
