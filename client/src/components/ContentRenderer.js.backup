            <div className="card-header bg-success bg-opacity-10 border-success">
                <div className="d-flex justify-content-between align-items-center">
                    <div className="d-flex align-items-center">
                        <i className="fas fa-handshake text-success me-2"></i>
                        <h5 className="card-title mb-0 text-dark">BDD Principles</h5>
                    </div>
                    <button className="btn btn-sm btn-outline-secondary" onClick={handleCopy}>
                        <i className={`fas ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                        {copied ? ' Copied!' : ' Copy'}
                    </button>
                </div>
            </div>

            <div className="card-body">
                <div className="principles-grid">
                    {block.principles.map((principle, principleIndex) => (
                        <div key={principleIndex} className="principle-item mb-4 p-3 border rounded">
                            <div className="principle-header mb-3">
                                <h6 className="text-success mb-2">
                                    <i className="fas fa-star me-2"></i>
                                    {principle.principle}
                                </h6>
                            </div>

                            <div className="principle-details">
                                <div className="description-section mb-3">
                                    <small className="text-muted d-block mb-1">
                                        <i className="fas fa-info-circle me-1"></i>
                                        Description
                                    </small>
                                    <div className="description-text small bg-light p-2 rounded">
                                        {principle.description}
                                    </div>
                                </div>

                                <div className="benefit-section">
                                    <small className="text-muted d-block mb-1">
                                        <i className="fas fa-chart-line me-1"></i>
                                        Benefit
                                    </small>
                                    <div className="benefit-text small bg-success bg-opacity-10 p-2 rounded text-success">
                                        {principle.benefit}
                                    </div>
                                </div>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    );
};

// Gherkin Syntax Component
const GherkinSyntaxBlock = ({ block, index }) => {
    const [copied, setCopied] = useState(false);

    const handleCopy = () => {
        let textToCopy = `${block.title}\n\n`;
        block.keywords.forEach(keyword => {
            textToCopy += `${keyword.keyword}\n`;
            textToCopy += `Purpose: ${keyword.purpose}\n`;
            textToCopy += `Syntax: ${keyword.syntax}\n`;
            textToCopy += `Example: ${keyword.example}\n\n`;
        });
        navigator.clipboard.writeText(textToCopy);
        setCopied(true);
        setTimeout(() => setCopied(false), 2000);
    };

    return (
        <div className="gherkin-syntax-block card my-4">
            <div className="card-header bg-info bg-opacity-10 border-info">
                <div className="d-flex justify-content-between align-items-center">
                    <div className="d-flex align-items-center">
                        <i className="fas fa-code text-info me-2"></i>
                        <h5 className="card-title mb-0 text-dark">{block.title}</h5>
                    </div>
                    <button className="btn btn-sm btn-outline-secondary" onClick={handleCopy}>
                        <i className={`fas ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                        {copied ? ' Copied!' : ' Copy'}
                    </button>
                </div>
            </div>

            <div className="card-body">
                <div className="keywords-grid">
                    {block.keywords.map((keyword, keywordIndex) => (
                        <div key={keywordIndex} className="keyword-item mb-4 p-3 border rounded">
                            <div className="keyword-header mb-3">
                                <h6 className="text-info mb-2">
                                    <i className="fas fa-key me-2"></i>
                                    {keyword.keyword}
                                </h6>
                                <div className="keyword-purpose text-muted small mb-3">
                                    <i className="fas fa-bullseye me-1"></i>
                                    {keyword.purpose}
                                </div>
                            </div>

                            <div className="row">
                                <div className="col-md-6">
                                    <div className="syntax-section mb-3">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-terminal me-1"></i>
                                            Syntax
                                        </small>
                                        <div className="syntax-text small bg-light p-2 rounded font-monospace">
                                            {keyword.syntax}
                                        </div>
                                    </div>
                                </div>
                                <div className="col-md-6">
                                    <div className="example-section">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-play-circle me-1"></i>
                                            Example
                                        </small>
                                        <div className="example-text small bg-info bg-opacity-10 p-2 rounded font-monospace">
                                            {keyword.example}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    );
};

// Integration Architecture Component
const IntegrationArchitectureBlock = ({ block, index }) => {
    const [copied, setCopied] = useState(false);

    const handleCopy = () => {
        let textToCopy = "Integration Architecture\n\n";
        block.layers.forEach(layer => {
            textToCopy += `${layer.layer}\n`;
            textToCopy += `Technology: ${layer.technology}\n`;
            textToCopy += `Purpose: ${layer.purpose}\n`;
            textToCopy += "Components: " + layer.components.join(", ") + "\n\n";
        });
        navigator.clipboard.writeText(textToCopy);
        setCopied(true);
        setTimeout(() => setCopied(false), 2000);
    };

    return (
        <div className="integration-architecture-block card my-4">
            <div className="card-header bg-primary bg-opacity-10 border-primary">
                <div className="d-flex justify-content-between align-items-center">
                    <div className="d-flex align-items-center">
                        <i className="fas fa-sitemap text-primary me-2"></i>
                        <h5 className="card-title mb-0 text-dark">Integration Architecture</h5>
                    </div>
                    <button className="btn btn-sm btn-outline-secondary" onClick={handleCopy}>
                        <i className={`fas ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                        {copied ? ' Copied!' : ' Copy'}
                    </button>
                </div>
            </div>

            <div className="card-body">
                <div className="architecture-layers">
                    {block.layers.map((layer, layerIndex) => (
                        <div key={layerIndex} className="layer-item mb-4 p-3 border rounded">
                            <div className="layer-header d-flex justify-content-between align-items-center mb-3">
                                <h6 className="text-primary mb-0">
                                    <i className="fas fa-layer-group me-2"></i>
                                    {layer.layer}
                                </h6>
                                <span className="badge bg-primary">{layer.technology}</span>
                            </div>

                            <div className="layer-details">
                                <div className="purpose-section mb-3">
                                    <small className="text-muted d-block mb-1">
                                        <i className="fas fa-bullseye me-1"></i>
                                        Purpose
                                    </small>
                                    <div className="purpose-text small">
                                        {layer.purpose}
                                    </div>
                                </div>

                                <div className="components-section">
                                    <small className="text-muted d-block mb-1">
                                        <i className="fas fa-cubes me-1"></i>
                                        Components
                                    </small>
                                    <div className="components-list">
                                        {layer.components.map((component, compIndex) => (
                                            <span key={compIndex} className="badge bg-light text-dark border me-1 mb-1">
                                                {component}
                                            </span>
                                        ))}
                                    </div>
                                </div>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    );
};

// Dependency Configuration Component
const DependencyConfigurationBlock = ({ block, index }) => {
    const [copied, setCopied] = useState(false);

    const handleCopy = () => {
        let textToCopy = `${block.title}\n\n`;
        block.dependencies.forEach(dep => {
            textToCopy += `${dep.group}:${dep.artifact}:${dep.version}\n`;
            textToCopy += `Purpose: ${dep.purpose}\n\n`;
        });
        navigator.clipboard.writeText(textToCopy);
        setCopied(true);
        setTimeout(() => setCopied(false), 2000);
    };

    return (
        <div className="dependency-configuration-block card my-4">
            <div className="card-header bg-warning bg-opacity-10 border-warning">
                <div className="d-flex justify-content-between align-items-center">
                    <div className="d-flex align-items-center">
                        <i className="fas fa-boxes text-warning me-2"></i>
                        <h5 className="card-title mb-0 text-dark">{block.title}</h5>
                    </div>
                    <button className="btn btn-sm btn-outline-secondary" onClick={handleCopy}>
                        <i className={`fas ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                        {copied ? ' Copied!' : ' Copy'}
                    </button>
                </div>
            </div>

            <div className="card-body">
                <div className="dependencies-list">
                    {block.dependencies.map((dep, depIndex) => (
                        <div key={depIndex} className="dependency-item mb-3 p-3 border rounded">
                            <div className="dependency-header d-flex justify-content-between align-items-center mb-2">
                                <code className="text-dark">{dep.group}:{dep.artifact}:{dep.version}</code>
                                <span className="badge bg-warning text-dark">v{dep.version}</span>
                            </div>
                            <div className="dependency-purpose text-muted small">
                                <i className="fas fa-info-circle me-1"></i>
                                {dep.purpose}
                            </div>
                        </div>
                    ))}
                </div>

                {block.configuration && (
                    <div className="configuration-section mt-4 p-3 bg-light rounded">
                        <h6 className="text-warning mb-3">
                            <i className="fas fa-cog me-2"></i>
                            Configuration Details
                        </h6>
                        <div className="row">
                            <div className="col-md-6">
                                <small className="text-muted d-block mb-1">Build Tool</small>
                                <span className="badge bg-secondary">{block.configuration['build-tool']}</span>
                            </div>
                            <div className="col-md-6">
                                <small className="text-muted d-block mb-1">Test Framework</small>
                                <span className="badge bg-secondary">{block.configuration['test-framework']}</span>
                            </div>
                        </div>
                    </div>
                )}
            </div>
        </div>
    );
};

