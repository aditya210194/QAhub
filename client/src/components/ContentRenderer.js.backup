                        {copied ? ' Copied!' : ' Copy'}
                    </button>
                </div>
            </div>

            <div className="card-body">
                <div className="vulnerabilities-grid">
                    {block.vulnerabilities.map((vuln, vulnIndex) => (
                        <div key={vulnIndex} className="vulnerability-item mb-4 p-3 border rounded">
                            <div className="vuln-header mb-3">
                                <div className="d-flex justify-content-between align-items-start">
