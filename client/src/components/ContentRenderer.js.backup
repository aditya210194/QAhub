                                    </div>
                                </div>
                                <div className="col-md-4">
                                    <div className="implementation-section mb-3">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-code me-1"></i>
                                            Implementation
                                        </small>
