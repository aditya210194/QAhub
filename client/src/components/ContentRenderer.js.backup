            textToCopy += `Completeness Requirements: ${section['completeness-requirements'].join(', ')}\n`;
            textToCopy += `Impact Score: ${section['impact-score']}\n\n`;
        });
        navigator.clipboard.writeText(textToCopy);
        setCopied(true);
        setTimeout(() => setCopied(false), 2000);
    };

    return (
        <div className="profile-completeness-block card my-4">
            <div className="card-header bg-info bg-opacity-10 border-info">
