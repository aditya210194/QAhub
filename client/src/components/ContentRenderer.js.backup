// Testing Checklist Component
const TestingChecklistBlock = ({ block, index }) => {
    const [copied, setCopied] = useState(false);

    const handleCopy = () => {
        let textToCopy = `${block.title}\n\n`;
        block.categories.forEach(category => {
            textToCopy += `${category.category}\n\n`;
            category.tests.forEach((test, testIndex) => {
                textToCopy += `  ${testIndex + 1}. ${test}\n`;
            });
            textToCopy += `\nTools: ${category.tools.join(', ')}\n\n`;
        });
        navigator.clipboard.writeText(textToCopy);
        setCopied(true);
        setTimeout(() => setCopied(false), 2000);
    };

    return (
        <div className="testing-checklist-block card my-4">
            <div className="card-header bg-primary bg-opacity-10 border-primary">
                <div className="d-flex justify-content-between align-items-center">
                    <div className="d-flex align-items-center">
                        <i className="fas fa-tasks text-primary me-2"></i>
                        <h5 className="card-title mb-0 text-dark">{block.title}</h5>
                    </div>
                    <button className="btn btn-sm btn-outline-secondary" onClick={handleCopy}>
                        <i className={`fas ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                        {copied ? ' Copied!' : ' Copy'}
                    </button>
                </div>
            </div>

            <div className="card-body">
                <div className="checklist-categories">
                    {block.categories.map((category, categoryIndex) => (
                        <div key={categoryIndex} className="category-item mb-4 p-3 border rounded">
                            <div className="category-header mb-3">
                                <h6 className="text-primary mb-2">
                                    <i className="fas fa-folder me-2"></i>
                                    {category.category}
                                </h6>
                            </div>

                            <div className="row">
                                <div className="col-md-8">
                                    <div className="tests-section mb-3">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-list-check me-1"></i>
                                            Test Items
                                        </small>
                                        <div className="tests-list">
                                            {category.tests.map((test, testIndex) => (
                                                <div key={testIndex} className="test-item small bg-primary bg-opacity-10 p-2 rounded mb-1">
                                                    <input type="checkbox" className="form-check-input me-2" />
                                                    {testIndex + 1}. {test}
                                                </div>
                                            ))}
                                        </div>
                                    </div>
                                </div>
                                <div className="col-md-4">
                                    <div className="tools-section">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-tools me-1"></i>
                                            Recommended Tools
                                        </small>
                                        <div className="tools-list">
                                            {category.tools.map((tool, toolIndex) => (
                                                <span key={toolIndex} className="badge bg-secondary me-1 mb-1">
                                                    {tool}
                                                </span>
                                            ))}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    );
};

// Automated Testing Component
const AutomatedTestingBlock = ({ block, index }) => {
    const [copied, setCopied] = useState(false);

    const handleCopy = () => {
        let textToCopy = `${block.title}\n\nLanguage: ${block.implementation.language}\nFile: ${block.implementation.file}\n\n${block.implementation.content}`;
        navigator.clipboard.writeText(textToCopy);
        setCopied(true);
        setTimeout(() => setCopied(false), 2000);
    };

    return (
        <div className="automated-testing-block card my-4">
            <div className="card-header bg-success bg-opacity-10 border-success">
                <div className="d-flex justify-content-between align-items-center">
                    <div className="d-flex align-items-center">
                        <i className="fas fa-robot text-success me-2"></i>
                        <h5 className="card-title mb-0 text-dark">{block.title}</h5>
                    </div>
                    <button className="btn btn-sm btn-outline-secondary" onClick={handleCopy}>
                        <i className={`fas ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                        {copied ? ' Copied!' : ' Copy'}
                    </button>
                </div>
            </div>

            <div className="card-body">
                <div className="implementation-info mb-3">
                    <div className="row">
                        <div className="col-md-6">
                            <small className="text-muted d-block mb-1">
                                <i className="fas fa-code me-1"></i>
                                Language
                            </small>
                            <span className="badge bg-success">{block.implementation.language}</span>
                        </div>
                        <div className="col-md-6">
                            <small className="text-muted d-block mb-1">
                                <i className="fas fa-file me-1"></i>
                                File
                            </small>
                            <code className="small">{block.implementation.file}</code>
                        </div>
                    </div>
                </div>

                <div className="implementation-code">
                    <small className="text-muted d-block mb-2">
                        <i className="fas fa-terminal me-1"></i>
                        Implementation Code
                    </small>
                    <div className="code-content small bg-dark text-light p-3 rounded font-monospace">
                        <pre className="mb-0">{block.implementation.content}</pre>
                    </div>
                </div>

                {/* Usage Instructions */}
                <div className="usage-instructions mt-3 p-3 bg-light rounded">
                    <h6 className="text-success mb-3">
                        <i className="fas fa-play-circle me-2"></i>
                        Usage Instructions
                    </h6>
                    <div className="steps">
                        <div className="step-item small mb-2">
                            <strong>1. Setup:</strong> Install required dependencies (PyJWT, requests, cryptography)
                        </div>
                        <div className="step-item small mb-2">
                            <strong>2. Configure:</strong> Update target URL and provide test JWT token
                        </div>
                        <div className="step-item small mb-2">
                            <strong>3. Run:</strong> Execute script and review security report
                        </div>
                        <div className="step-item small">
                            <strong>4. Analyze:</strong> Address any identified vulnerabilities
                        </div>
                    </div>
                </div>
            </div>
        </div>
    );
};
const ToolsComparisonBlock = ({ block, index }) => {
    const [expanded, setExpanded] = useState(false);
    const [copied, setCopied] = useState(false);

    const handleCopy = () => {
        let textToCopy = "AI Visual Testing Tools Comparison\n\n";
        block.categories.forEach(category => {
            textToCopy += `${category.category}\n`;
            textToCopy += `Description: ${category.description}\n`;
            textToCopy += "Tools:\n";
            category.tools.forEach(tool => {
                textToCopy += `${tool.name}\n`;
                textToCopy += `  AI Capabilities: ${tool['ai-capabilities'].join(', ')}\n`;
                textToCopy += `  Key Features: ${tool['key-features'].join(', ')}\n`;
                textToCopy += `  Pricing: ${tool['pricing-tier']}\n`;
                textToCopy += `  Accuracy: ${tool.accuracy}\n`;
            });
            textToCopy += "\n";
        });
        navigator.clipboard.writeText(textToCopy);
        setCopied(true);
        setTimeout(() => setCopied(false), 2000);
    };

    const toggleExpand = () => {
        setExpanded(!expanded);
    };

    const getPricingColor = (pricing) => {
        const pricingMap = {
            'Enterprise': 'danger',
            'Business/Enterprise': 'warning',
            'Team/Enterprise': 'info',
            'Free + Paid': 'success',
            'Free': 'success'
        };
        return pricingMap[pricing] || 'secondary';
    };

    return (
        <div className="tools-comparison-block card my-4">
            <div className="card-header bg-warning bg-opacity-10 border-warning">
                <div className="d-flex justify-content-between align-items-center">
                    <div className="d-flex align-items-center">
                        <i className="fas fa-balance-scale text-warning me-2"></i>
                        <h5 className="card-title mb-0 text-dark">AI Visual Testing Tools Comparison</h5>
                    </div>
                    <div className="tools-actions">
                        <button className="btn btn-sm btn-outline-secondary me-2" onClick={handleCopy}>
                            <i className={`fas ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                            {copied ? ' Copied!' : ' Copy'}
                        </button>
                        <button className="btn btn-sm btn-outline-primary" onClick={toggleExpand}>
                            <i className={`fas fa-${expanded ? 'minus' : 'plus'}`}></i>
                            {expanded ? ' Less' : ' More'}
                        </button>
                    </div>
                </div>
            </div>

            <div className="card-body">
                <div className="tools-categories">
                    {block.categories.map((category, catIndex) => (
                        <div key={catIndex} className="tools-category mb-4">
                            <div className="category-header mb-3">
                                <h6 className="text-warning mb-1">
                                    <i className="fas fa-folder me-2"></i>
                                    {category.category}
                                </h6>
                                <div className="category-description text-muted small mb-3">
                                    <i className="fas fa-info-circle me-1"></i>
                                    {category.description}
                                </div>
                            </div>

                            <div className="tools-list">
                                {category.tools.map((tool, toolIndex) => (
                                    <div key={toolIndex} className="tool-item mb-3 p-3 border rounded">
                                        <div className="tool-header d-flex justify-content-between align-items-start mb-2">
                                            <div>
                                                <strong className="text-dark">{tool.name}</strong>
                                                <span className={`badge bg-${getPricingColor(tool['pricing-tier'])} ms-2`}>
                                                    {tool['pricing-tier']}
                                                </span>
                                            </div>
                                            <div className="tool-accuracy">
                                                <span className="badge bg-success">{tool.accuracy}</span>
                                            </div>
                                        </div>

                                        <div className="row">
                                            <div className="col-md-6">
                                                <div className="ai-capabilities mb-2">
                                                    <small className="text-muted d-block mb-1">
                                                        <i className="fas fa-brain me-1"></i>
                                                        AI Capabilities
                                                    </small>
                                                    <div className="capabilities-list">
                                                        {tool['ai-capabilities'].slice(0, expanded ? tool['ai-capabilities'].length : 2).map((capability, capIndex) => (
                                                            <span key={capIndex} className="badge bg-info text-dark me-1 mb-1">
                                                                {capability}
                                                            </span>
                                                        ))}
                                                        {!expanded && tool['ai-capabilities'].length > 2 && (
                                                            <span className="badge bg-light text-dark border">
                                                                +{tool['ai-capabilities'].length - 2} more
                                                            </span>
                                                        )}
                                                    </div>
                                                </div>
                                            </div>
                                            <div className="col-md-6">
                                                <div className="key-features">
                                                    <small className="text-muted d-block mb-1">
                                                        <i className="fas fa-star me-1"></i>
                                                        Key Features
                                                    </small>
                                                    <div className="features-list">
                                                        {tool['key-features'].slice(0, expanded ? tool['key-features'].length : 2).map((feature, featureIndex) => (
                                                            <span key={featureIndex} className="badge bg-light text-dark border me-1 mb-1">
                                                                {feature}
                                                            </span>
                                                        ))}
                                                        {!expanded && tool['key-features'].length > 2 && (
                                                            <span className="badge bg-light text-dark border">
                                                                +{tool['key-features'].length - 2} more
                                                            </span>
                                                        )}
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                ))}
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    );
};
const ChallengesSolutionsBlock = ({ block, index }) => {
    const [copied, setCopied] = useState(false);

    const handleCopy = () => {
        let textToCopy = "Challenges and Solutions in AI Visual Testing\n\n";
        block.challenges.forEach(challenge => {
            textToCopy += `${challenge.challenge}\n`;
            textToCopy += `Description: ${challenge.description}\n`;
            textToCopy += `Impact: ${challenge.impact}\n`;
            textToCopy += "Solutions:\n";
            challenge.solutions.forEach(solution => {
                textToCopy += `• ${solution}\n`;
            });
            textToCopy += `Success Rate: ${challenge['success-rate']}\n\n`;
        });
        navigator.clipboard.writeText(textToCopy);
        setCopied(true);
        setTimeout(() => setCopied(false), 2000);
    };

    const getImpactColor = (impact) => {
        const impactMap = {
            'High': 'danger',
            'Medium-High': 'warning',
            'Medium': 'info',
            'Low': 'success'
        };
        return impactMap[impact] || 'secondary';
    };

    return (
        <div className="challenges-solutions-block card my-4">
            <div className="card-header bg-danger bg-opacity-10 border-danger">
                <div className="d-flex justify-content-between align-items-center">
                    <div className="d-flex align-items-center">
                        <i className="fas fa-exclamation-triangle text-danger me-2"></i>
                        <h5 className="card-title mb-0 text-dark">Challenges and Solutions in AI Visual Testing</h5>
                    </div>
                    <button className="btn btn-sm btn-outline-secondary" onClick={handleCopy}>
                        <i className={`fas ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                        {copied ? ' Copied!' : ' Copy'}
                    </button>
                </div>
            </div>

            <div className="card-body">
                <div className="challenges-grid">
                    {block.challenges.map((challenge, challengeIndex) => (
                        <div key={challengeIndex} className="challenge-item mb-4 p-3 border rounded">
                            <div className="challenge-header d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <h6 className="text-danger mb-2">
                                        <i className="fas fa-times-circle me-2"></i>
                                        {challenge.challenge}
                                    </h6>
                                    <div className="challenge-description text-muted small mb-2">
                                        <i className="fas fa-info-circle me-1"></i>
                                        {challenge.description}
                                    </div>
                                </div>
                                <span className={`badge bg-${getImpactColor(challenge.impact)}`}>
                                    {challenge.impact} Impact
                                </span>
                            </div>

                            <div className="solutions-section">
                                <small className="text-muted d-block mb-2">
                                    <i className="fas fa-lightbulb me-1"></i>
                                    Solutions
                                </small>
                                <div className="solutions-list">
                                    {challenge.solutions.map((solution, solutionIndex) => (
                                        <div key={solutionIndex} className="solution-item d-flex align-items-start mb-2">
                                            <span className="badge bg-success me-3 mt-1">{solutionIndex + 1}</span>
                                            <div className="solution-text flex-grow-1 small">
                                                {solution}
                                            </div>
                                        </div>
                                    ))}
                                </div>
                            </div>

                            <div className="success-rate mt-2">
                                <small className="text-muted d-block mb-1">
                                    <i className="fas fa-chart-line me-1"></i>
                                    Success Rate
                                </small>
                                <div className="success-text small bg-success bg-opacity-10 p-2 rounded text-success">
                                    {challenge['success-rate']}
                                </div>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    );
};

