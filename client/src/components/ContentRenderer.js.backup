const ContinuousImprovementFrameworkBlock = ({ block, index }) => {
    const [expanded, setExpanded] = useState(false);
    const [copied, setCopied] = useState(false);

    const handleCopy = () => {
        let textToCopy = `${block.title}\n\n`;
        block.framework.forEach(phase => {
            textToCopy += `${phase.phase}:\n`;
            phase.activities.forEach((activity, index) => {
                textToCopy += `${index + 1}. ${activity}\n`;
            });
            textToCopy += "\n";
        });
        navigator.clipboard.writeText(textToCopy);
        setCopied(true);
        setTimeout(() => setCopied(false), 2000);
    };

    const toggleExpand = () => {
        setExpanded(!expanded);
    };

    const getPhaseColor = (phaseIndex) => {
        const colors = ['primary', 'success', 'info', 'warning'];
        return colors[phaseIndex % colors.length];
    };

    return (
        <div className="continuous-improvement-framework-block card my-4">
            <div className="card-header bg-warning bg-opacity-10 border-warning">
                <div className="d-flex justify-content-between align-items-center">
                    <div className="d-flex align-items-center">
                        <i className="fas fa-sync-alt text-warning me-2"></i>
                        <h5 className="card-title mb-0 text-dark">{block.title}</h5>
                    </div>
                    <div className="framework-actions">
                        <button className="btn btn-sm btn-outline-secondary me-2" onClick={handleCopy}>
                            <i className={`fas ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                            {copied ? ' Copied!' : ' Copy'}
                        </button>
                        <button className="btn btn-sm btn-outline-primary" onClick={toggleExpand}>
                            <i className={`fas fa-${expanded ? 'minus' : 'plus'}`}></i>
                            {expanded ? ' Less' : ' More'}
                        </button>
                    </div>
                </div>
            </div>

            <div className="card-body">
                <div className="improvement-framework">
                    {block.framework.map((phase, phaseIndex) => (
                        <div key={phaseIndex} className="phase-item mb-4">
                            <div className="phase-header d-flex align-items-center mb-3">
                                <div className={`phase-icon bg-${getPhaseColor(phaseIndex)} text-white rounded-circle d-flex align-items-center justify-content-center me-3`} style={{width: '40px', height: '40px'}}>
                                    <i className="fas fa-flag"></i>
                                </div>
                                <div>
                                    <h6 className={`text-${getPhaseColor(phaseIndex)} mb-1`}>
                                        {phase.phase}
                                    </h6>
                                    <small className="text-muted">Phase {phaseIndex + 1}</small>
                                </div>
                            </div>

                            <div className="activities-list">
                                {phase.activities.slice(0, expanded ? phase.activities.length : 3).map((activity, activityIndex) => (
                                    <div key={activityIndex} className="activity-item d-flex align-items-start mb-2 p-2 bg-light rounded">
                                        <span className={`badge bg-${getPhaseColor(phaseIndex)} me-3 mt-1`}>{activityIndex + 1}</span>
                                        <div className="activity-text flex-grow-1 small">
                                            {activity}
                                        </div>
                                    </div>
                                ))}
                                {!expanded && phase.activities.length > 3 && (
                                    <div className="more-items small text-primary text-center">
                                        +{phase.activities.length - 3} more activities...
                                    </div>
                                )}
                            </div>
                        </div>
                    ))}
                </div>

                {/* Improvement Cycle Visualization */}
                <div className="improvement-cycle mt-4 p-3 bg-warning bg-opacity-10 rounded">
                    <h6 className="d-flex align-items-center text-warning mb-3">
                        <i className="fas fa-redo me-2"></i>
                        Continuous Improvement Cycle
                    </h6>
                    <div className="cycle-visualization text-center">
                        <div className="row">
                            {block.framework.map((phase, phaseIndex) => (
                                <div key={phaseIndex} className="col-md-3 mb-3">
                                    <div className="cycle-phase">
                                        <div className={`phase-circle bg-${getPhaseColor(phaseIndex)} text-white rounded-circle mx-auto mb-2 d-flex align-items-center justify-content-center`} style={{width: '60px', height: '60px'}}>
                                            <i className="fas fa-flag"></i>
                                        </div>
                                        <div className="phase-title small fw-bold">{phase.phase}</div>
                                        <div className="phase-number small text-muted">Phase {phaseIndex + 1}</div>
                                    </div>
                                    {phaseIndex < block.framework.length - 1 && (
                                        <div className="phase-arrow d-none d-md-block">
                                            <i className="fas fa-arrow-right text-muted fa-lg"></i>
                                        </div>
                                    )}
                                </div>
                            ))}
                        </div>
                    </div>
                </div>
            </div>
        </div>
    );
};
