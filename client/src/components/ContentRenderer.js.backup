                        <h5 className="card-title mb-0 text-dark">{block.title}</h5>
                    </div>
                    <button className="btn btn-sm btn-outline-secondary" onClick={handleCopy}>
                        <i className={`fas ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                        {copied ? ' Copied!' : ' Copy'}
                    </button>
                </div>
            </div>

            <div className="card-body">
                <div className="evolution-phases">
                    {block.phases.map((phase, phaseIndex) => (
                        <div key={phaseIndex} className="phase-item mb-4 p-3 border rounded">
                            <div className="phase-header mb-3">
                                <div className="d-flex align-items-center mb-2">
                                    <span className="phase-number bg-primary text-white rounded-circle d-inline-flex align-items-center justify-content-center me-3" style={{width: '30px', height: '30px'}}>
                                        {phaseIndex + 1}
                                    </span>
                                    <div>
                                        <h6 className="text-primary mb-0">{phase.phase}</h6>
                                        <small className="text-muted">Focus: {phase.focus}</small>
                                    </div>
                                </div>
                            </div>

                            <div className="row">
                                <div className="col-md-5">
                                    <div className="activities-section mb-3">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-tasks me-1"></i>
                                            Activities
                                        </small>
                                        <div className="activities-list">
                                            {phase.activities.map((activity, activityIndex) => (
                                                <div key={activityIndex} className="activity-item small bg-primary bg-opacity-10 p-2 rounded mb-1">
                                                    • {activity}
                                                </div>
                                            ))}
                                        </div>
                                    </div>
                                </div>
                                <div className="col-md-7">
                                    <div className="success-section">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-check-circle me-1"></i>
                                            Success Indicators
                                        </small>
                                        <div className="success-list">
                                            {phase['success-indicators'].map((indicator, indicatorIndex) => (
                                                <div key={indicatorIndex} className="indicator-item small text-success mb-1">
                                                    ✓ {indicator}
                                                </div>
                                            ))}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    );
};

