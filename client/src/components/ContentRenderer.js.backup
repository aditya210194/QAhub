                                                </span>
                                            ))}
                                        </div>
                                    </div>
                                </div>
                                <div className="col-md-4">
                                    <div className="training-section">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-road me-1"></i>
                                            Training Path
                                        </small>
                                        <div className="training-list">
                                            {role['training-path'].map((path, pathIndex) => (
                                                <div key={pathIndex} className="path-item small text-success mb-1">
                                                    ✓ {path}
                                                </div>
                                            ))}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    );
};
const TrainingRoadmapBlock = ({ block, index }) => {
    const [copied, setCopied] = useState(false);

    const handleCopy = () => {
        let textToCopy = `${block.title}\n\n`;
        block.levels.forEach(level => {
            textToCopy += `${level.level}\n`;
            textToCopy += "Focus Areas:\n";
            level['focus-areas'].forEach(area => {
                textToCopy += `• ${area}\n`;
            });
            textToCopy += "Activities:\n";
            level.activities.forEach(activity => {
                textToCopy += `• ${activity}\n`;
            });
            textToCopy += "\n";
        });
        navigator.clipboard.writeText(textToCopy);
        setCopied(true);
        setTimeout(() => setCopied(false), 2000);
    };

    const getLevelColor = (levelIndex) => {
        const colors = ['primary', 'success', 'warning'];
        return colors[levelIndex % colors.length];
    };

    return (
        <div className="training-roadmap-block card my-4">
            <div className="card-header bg-info bg-opacity-10 border-info">
                <div className="d-flex justify-content-between align-items-center">
                    <div className="d-flex align-items-center">
                        <i className="fas fa-map-marked-alt text-info me-2"></i>
                        <h5 className="card-title mb-0 text-dark">{block.title}</h5>
                    </div>
                    <button className="btn btn-sm btn-outline-secondary" onClick={handleCopy}>
                        <i className={`fas ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                        {copied ? ' Copied!' : ' Copy'}
                    </button>
                </div>
            </div>

            <div className="card-body">
                <div className="roadmap-timeline">
                    {block.levels.map((level, levelIndex) => (
                        <div key={levelIndex} className="level-item mb-4">
                            <div className="level-header d-flex align-items-center mb-3">
                                <div className={`level-icon bg-${getLevelColor(levelIndex)} text-white rounded-circle d-flex align-items-center justify-content-center me-3`} style={{width: '50px', height: '50px'}}>
                                    <i className="fas fa-flag"></i>
                                </div>
                                <div>
                                    <h6 className={`text-${getLevelColor(levelIndex)} mb-1`}>
                                        {level.level}
                                    </h6>
                                    <small className="text-muted">Level {levelIndex + 1}</small>
                                </div>
                            </div>

                            <div className="row">
                                <div className="col-md-6">
                                    <div className="focus-areas-section mb-3">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-bullseye me-1"></i>
                                            Focus Areas
                                        </small>
                                        <div className="focus-areas-list">
                                            {level['focus-areas'].map((area, areaIndex) => (
                                                <div key={areaIndex} className="area-item small text-muted mb-1">
                                                    • {area}
                                                </div>
                                            ))}
                                        </div>
                                    </div>
                                </div>
                                <div className="col-md-6">
                                    <div className="activities-section">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-tasks me-1"></i>
                                            Activities
                                        </small>
                                        <div className="activities-list">
                                            {level.activities.map((activity, activityIndex) => (
                                                <div key={activityIndex} className="activity-item small text-success mb-1">
                                                    ✓ {activity}
                                                </div>
                                            ))}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    );
};

const ChallengesFrameworkBlock = ({ block, index }) => {
    const [expanded, setExpanded] = useState(false);
    const [copied, setCopied] = useState(false);

    const handleCopy = () => {
        let textToCopy = "Challenges Framework\n\n";
        block.challenges.forEach(challenge => {
            textToCopy += `${challenge.challenge}\n`;
            textToCopy += `Description: ${challenge.description}\n`;
            textToCopy += `Impact: ${challenge.impact}\n`;
            textToCopy += "Mitigation Strategies:\n";
            challenge['mitigation-strategies'].forEach(strategy => {
                textToCopy += `• ${strategy}\n`;
            });
            textToCopy += "\n";
        });
        navigator.clipboard.writeText(textToCopy);
        setCopied(true);
        setTimeout(() => setCopied(false), 2000);
    };

    const toggleExpand = () => {
        setExpanded(!expanded);
    };

    const getImpactColor = (impact) => {
        const impactMap = {
            'High': 'danger',
            'Medium-High': 'warning',
            'Medium': 'info',
            'Low': 'success'
        };
        return impactMap[impact] || 'secondary';
    };

    return (
        <div className="challenges-framework-block card my-4">
            <div className="card-header bg-danger bg-opacity-10 border-danger">
                <div className="d-flex justify-content-between align-items-center">
                    <div className="d-flex align-items-center">
                        <i className="fas fa-exclamation-triangle text-danger me-2"></i>
                        <h5 className="card-title mb-0 text-dark">Challenges Framework</h5>
                    </div>
                    <div className="challenges-actions">
                        <button className="btn btn-sm btn-outline-secondary me-2" onClick={handleCopy}>
                            <i className={`fas ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                            {copied ? ' Copied!' : ' Copy'}
                        </button>
                        <button className="btn btn-sm btn-outline-primary" onClick={toggleExpand}>
                            <i className={`fas fa-${expanded ? 'minus' : 'plus'}`}></i>
                            {expanded ? ' Less' : ' More'}
                        </button>
                    </div>
                </div>
            </div>

            <div className="card-body">
                <div className="challenges-grid">
                    {block.challenges.map((challenge, challengeIndex) => (
                        <div key={challengeIndex} className="challenge-item mb-4 p-3 border rounded">
                            <div className="challenge-header d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <h6 className="text-danger mb-2">
                                        <i className="fas fa-times-circle me-2"></i>
                                        {challenge.challenge}
                                    </h6>
                                    <div className="challenge-description text-muted small mb-2">
                                        <i className="fas fa-info-circle me-1"></i>
                                        {challenge.description}
                                    </div>
                                </div>
                                <span className={`badge bg-${getImpactColor(challenge.impact)}`}>
                                    Impact: {challenge.impact}
                                </span>
                            </div>

                            <div className="mitigation-section">
                                <small className="text-muted d-block mb-2">
                                    <i className="fas fa-shield-alt me-1"></i>
                                    Mitigation Strategies
                                </small>
                                <div className="strategies-list">
                                    {challenge['mitigation-strategies'].map((strategy, strategyIndex) => (
                                        <div key={strategyIndex} className="strategy-item d-flex align-items-start mb-2">
                                            <i className="fas fa-check-circle text-success fa-xs mt-1 me-2"></i>
                                            <span className="small">{strategy}</span>
                                        </div>
                                    ))}
                                </div>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    );
};
