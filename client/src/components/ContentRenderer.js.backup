        <div className="benefits-analysis-block card my-4">
            <div className="card-header bg-success bg-opacity-10 border-success">
                <div className="d-flex justify-content-between align-items-center">
                    <div className="d-flex align-items-center">
                        <i className="fas fa-chart-line text-success me-2"></i>
                        <h5 className="card-title mb-0 text-dark">Benefits Analysis</h5>
                    </div>
                    <div className="benefits-actions">
                        <button className="btn btn-sm btn-outline-secondary me-2" onClick={handleCopy}>
                            <i className={`fas ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                            {copied ? ' Copied!' : ' Copy'}
                        </button>
                        <button className="btn btn-sm btn-outline-primary" onClick={toggleExpand}>
                            <i className={`fas fa-${expanded ? 'minus' : 'plus'}`}></i>
                            {expanded ? ' Less' : ' More'}
                        </button>
                    </div>
                </div>
            </div>

            <div className="card-body">
                <div className="benefits-categories">
                    {block.categories.map((category, catIndex) => (
                        <div key={catIndex} className="benefit-category mb-4">
                            <h6 className="text-success mb-3">
                                <i className="fas fa-folder me-2"></i>
                                {category.category}
                            </h6>
                            <div className="benefits-list">
                                {category.benefits.map((benefit, benefitIndex) => (
                                    <div key={benefitIndex} className="benefit-item mb-3 p-3 bg-success bg-opacity-10 rounded">
                                        <div className="benefit-header d-flex align-items-center mb-2">
