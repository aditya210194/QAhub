                                                <div key={phaseIndex} className="phase-item small bg-light p-2 rounded mb-1">
                                                    {phaseIndex + 1}. {phase}
                                                </div>
                                            ))}
                                        </div>
                                    </div>
                                </div>
                                <div className="col-md-4">
                                    <div className="coverage-section">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-chart-pie me-1"></i>
                                            Coverage
                                        </small>
                                        <div className="coverage-text small bg-success bg-opacity-10 p-2 rounded text-success">
                                            {framework.coverage}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    );
};

