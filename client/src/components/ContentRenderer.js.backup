                            <div className="row">
                                {block.categories.map((category, catIndex) => (
                                    <div key={catIndex} className="col-md-6 mb-4">
                                        <div className="category-card card h-100">
                                            <div className="card-header py-2 bg-info bg-opacity-10">
                                                <h6 className="mb-0">
                                                    <i className="fas fa-folder me-2 text-info"></i>
                                                    {category.category}
                                                </h6>
                                            </div>
