        block.roles.forEach(role => {
            textToCopy += `${role.role}\n`;
            textToCopy += "Core Responsibilities:\n";
            role['core-responsibilities'].forEach(resp => {
                textToCopy += `• ${resp}\n`;
            });
            textToCopy += "Required Skills:\n";
            role['required-skills'].forEach(skill => {
                textToCopy += `• ${skill}\n`;
            });
            textToCopy += "Training Path:\n";
            role['training-path'].forEach(path => {
                textToCopy += `• ${path}\n`;
            });
