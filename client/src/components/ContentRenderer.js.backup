                                        <span className="small">{consideration}</span>
                                    </div>
                                ))}
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    );
};
const SuccessFactorsBlock = ({ block, index }) => {
    const [expanded, setExpanded] = useState(false);
    const [copied, setCopied] = useState(false);

    const handleCopy = () => {
        let textToCopy = `${block.title}\n\n`;
        block.factors.forEach(factor => {
            textToCopy += `${factor.factor} (Importance: ${factor.importance})\n`;
            textToCopy += "Actions:\n";
            factor.actions.forEach(action => {
                textToCopy += `• ${action}\n`;
            });
            textToCopy += "\n";
        });
        navigator.clipboard.writeText(textToCopy);
        setCopied(true);
        setTimeout(() => setCopied(false), 2000);
    };

    const toggleExpand = () => {
        setExpanded(!expanded);
    };

    const getImportanceColor = (importance) => {
        const importanceMap = {
            'High': 'danger',
            'Medium-High': 'warning',
            'Medium': 'info',
            'Low': 'success'
        };
        return importanceMap[importance] || 'secondary';
    };

    return (
        <div className="success-factors-block card my-4">
            <div className="card-header bg-success bg-opacity-10 border-success">
                <div className="d-flex justify-content-between align-items-center">
