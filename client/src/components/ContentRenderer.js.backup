                            <div className="actions-list">
                                <small className="text-muted d-block mb-2">
                                    <i className="fas fa-play-circle me-1"></i>
                                    Recommended Actions
                                </small>
                                {factor.actions.map((action, actionIndex) => (
                                    <div key={actionIndex} className="action-item d-flex align-items-start mb-2">
                                        <span className="badge bg-success me-3 mt-1">{actionIndex + 1}</span>
                                        <div className="action-text flex-grow-1 small">
                                            {action}
                                        </div>
                                    </div>
                                ))}
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    );
};
const SkillDevelopmentBlock = ({ block, index }) => {
