// Defect Analysis Template Component
const DefectAnalysisTemplateBlock = ({ block, index }) => {
    const [copied, setCopied] = useState(false);

    const handleCopy = () => {
        let textToCopy = `${block.title}\n\n`;
        block.sections.forEach(section => {
            textToCopy += `${section.section}\n`;
            if (section.content) {
                textToCopy += `Content: ${section.content}\n`;
            }
            if (section.metrics) {
                textToCopy += `Metrics: ${section.metrics.join(', ')}\n`;
            }
            if (section.analysis) {
                textToCopy += `Analysis: ${section.analysis.join(', ')}\n`;
            }
            if (section.comparison) {
                textToCopy += `Comparison: ${section.comparison}\n`;
            }
            if (section.insights) {
                textToCopy += `Insights: ${section.insights}\n`;
            }
            if (section.improvements) {
                textToCopy += `Improvements: ${section.improvements.join(', ')}\n`;
            }
            textToCopy += '\n';
        });
        navigator.clipboard.writeText(textToCopy);
        setCopied(true);
        setTimeout(() => setCopied(false), 2000);
    };

    return (
        <div className="defect-analysis-template-block card my-4">
            <div className="card-header bg-success bg-opacity-10 border-success">
                <div className="d-flex justify-content-between align-items-center">
                    <div className="d-flex align-items-center">
                        <i className="fas fa-file-chart-line text-success me-2"></i>
                        <h5 className="card-title mb-0 text-dark">{block.title}</h5>
                    </div>
                    <button className="btn btn-sm btn-outline-secondary" onClick={handleCopy}>
                        <i className={`fas ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                        {copied ? ' Copied!' : ' Copy'}
                    </button>
                </div>
            </div>

            <div className="card-body">
                <div className="analysis-sections">
                    {block.sections.map((section, sectionIndex) => (
                        <div key={sectionIndex} className="section-item mb-4 p-3 border rounded">
                            <div className="section-header mb-3">
                                <h6 className="text-success mb-2">
                                    <i className="fas fa-file me-2"></i>
                                    {section.section}
                                </h6>
                            </div>

                            <div className="section-content">
                                {section.content && (
                                    <div className="content-text small bg-success bg-opacity-10 p-3 rounded mb-3">
                                        {section.content}
                                    </div>
                                )}

                                {section.metrics && (
                                    <div className="metrics-section mb-3">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-chart-bar me-1"></i>
                                            Metrics
                                        </small>
                                        <div className="metrics-list">
                                            {section.metrics.map((metric, metricIndex) => (
                                                <div key={metricIndex} className="metric-item small bg-light p-2 rounded mb-1">
                                                    • {metric}
                                                </div>
                                            ))}
                                        </div>
                                    </div>
                                )}

                                {section.analysis && (
                                    <div className="analysis-section mb-3">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-chart-pie me-1"></i>
                                            Analysis
                                        </small>
                                        <div className="analysis-list">
                                            {section.analysis.map((item, itemIndex) => (
                                                <div key={itemIndex} className="analysis-item small text-info mb-1">
                                                    • {item}
                                                </div>
                                            ))}
                                        </div>
                                    </div>
                                )}

                                {section.comparison && (
                                    <div className="comparison-section mb-3">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-balance-scale me-1"></i>
                                            Comparison
                                        </small>
                                        <div className="comparison-text small">
                                            {section.comparison}
                                        </div>
                                    </div>
                                )}

                                {section.insights && (
                                    <div className="insights-section mb-3">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-lightbulb me-1"></i>
                                            Insights
                                        </small>
                                        <div className="insights-text small text-warning">
                                            {section.insights}
                                        </div>
                                    </div>
                                )}

                                {section.improvements && (
                                    <div className="improvements-section">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-rocket me-1"></i>
                                            Action Items
                                        </small>
                                        <div className="improvements-list">
                                            {section.improvements.map((improvement, improvementIndex) => (
                                                <div key={improvementIndex} className="improvement-item small text-success mb-1">
                                                    ✓ {improvement}
                                                </div>
                                            ))}
                                        </div>
                                    </div>
                                )}
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    );
};
