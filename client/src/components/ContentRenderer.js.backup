// Defect Management Component
const DefectManagementBlock = ({ block, index }) => {
    const [copied, setCopied] = useState(false);

    const handleCopy = () => {
        let textToCopy = `${block.title}\n\n`;
        block.process.forEach(step => {
            textToCopy += `${step.step}\n`;
            textToCopy += `Description: ${step.description}\n`;
            textToCopy += `Tools: ${step.tools.join(', ')}\n`;
            textToCopy += `Output: ${step.output}\n\n`;
        });
        navigator.clipboard.writeText(textToCopy);
        setCopied(true);
        setTimeout(() => setCopied(false), 2000);
    };

    return (
        <div className="defect-management-block card my-4">
            <div className="card-header bg-warning bg-opacity-10 border-warning">
                <div className="d-flex justify-content-between align-items-center">
                    <div className="d-flex align-items-center">
                        <i className="fas fa-bug text-warning me-2"></i>
                        <h5 className="card-title mb-0 text-dark">{block.title}</h5>
                    </div>
                    <button className="btn btn-sm btn-outline-secondary" onClick={handleCopy}>
                        <i className={`fas ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                        {copied ? ' Copied!' : ' Copy'}
                    </button>
                </div>
            </div>

            <div className="card-body">
                <div className="defect-process">
                    {block.process.map((step, stepIndex) => (
                        <div key={stepIndex} className="process-step mb-4 p-3 border rounded">
                            <div className="step-header mb-3">
                                <div className="d-flex align-items-center mb-2">
                                    <span className="step-number bg-warning text-white rounded-circle d-inline-flex align-items-center justify-content-center me-3" style={{width: '30px', height: '30px'}}>
                                        {stepIndex + 1}
                                    </span>
                                    <h6 className="text-warning mb-0">{step.step}</h6>
                                </div>
                                <div className="step-description text-muted small">
                                    <i className="fas fa-info-circle me-1"></i>
                                    {step.description}
                                </div>
                            </div>

                            <div className="row">
                                <div className="col-md-6">
                                    <div className="tools-section mb-3">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-tools me-1"></i>
                                            Tools Used
                                        </small>
                                        <div className="tools-list">
                                            {step.tools.map((tool, toolIndex) => (
                                                <span key={toolIndex} className="badge bg-secondary me-1 mb-1">
                                                    {tool}
                                                </span>
                                            ))}
                                        </div>
                                    </div>
                                </div>
                                <div className="col-md-6">
                                    <div className="output-section">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-file-export me-1"></i>
                                            Output/Deliverable
                                        </small>
                                        <div className="output-text small bg-warning bg-opacity-10 p-2 rounded">
                                            {step.output}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    ))}
                </div>

                {/* Defect Severity Matrix */}
                <div className="severity-matrix mt-4 p-3 bg-light rounded">
                    <h6 className="text-warning mb-3">
                        <i className="fas fa-table me-2"></i>
                        Defect Severity & Priority Matrix
                    </h6>
                    <div className="table-responsive">
                        <table className="table table-sm table-bordered">
                            <thead className="table-light">
                            <tr>
                                <th>Severity/Priority</th>
                                <th>High</th>
                                <th>Medium</th>
                                <th>Low</th>
                            </tr>
                            </thead>
                            <tbody>
                            <tr>
                                <td><strong>Critical</strong></td>
                                <td className="bg-danger text-white">Fix Immediately</td>
                                <td className="bg-warning">Fix in Current Sprint</td>
                                <td className="bg-warning">Fix in Current Sprint</td>
                            </tr>
                            <tr>
                                <td><strong>Major</strong></td>
                                <td className="bg-warning">Fix in Current Sprint</td>
                                <td className="bg-info">Fix in Next Sprint</td>
                                <td className="bg-info">Fix in Next Sprint</td>
                            </tr>
                            <tr>
                                <td><strong>Minor</strong></td>
                                <td className="bg-info">Fix in Next Sprint</td>
                                <td className="bg-light">Fix When Possible</td>
                                <td className="bg-light">Fix When Possible</td>
                            </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    );
};

