        block.applications.forEach(app => {
            textToCopy += `${app.application}\n`;
            textToCopy += `Examples: ${app.examples.join(', ')}\n`;
            textToCopy += `Testing Focus: ${app['testing-focus'].join(', ')}\n`;
            textToCopy += `Complexity: ${app.complexity}\n\n`;
        });
        navigator.clipboard.writeText(textToCopy);
        setCopied(true);
        setTimeout(() => setCopied(false), 2000);
    };

    return (
        <div className="practice-applications-block card my-4">
            <div className="card-header bg-info bg-opacity-10 border-info">
