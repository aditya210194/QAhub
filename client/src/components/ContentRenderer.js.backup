                                            <li>Evaluate integration capabilities with existing tools</li>
                                            <li>Assess vendor stability and funding status</li>
                                            <li>Consider pilot implementation for evaluation</li>
                                        </ul>
                                    </div>
                                )}
                            </div>
                        </div>
                    ))}
                </div>

                <div className="emerging-tools-summary mt-4 p-3 bg-warning bg-opacity-10 rounded">
                    <h6 className="text-warning mb-3">
                        <i className="fas fa-binoculars me-2"></i>
                        Emerging Tools Watchlist Strategy
                    </h6>
                    <div className="row text-center">
                        <div className="col-md-4 mb-3">
                            <div className="summary-item">
                                <div className="number text-warning h4 mb-1">
                                    {block.tools.filter(t => t['potential-impact'] === 'High').length}
                                </div>
                                <small className="text-muted">High Impact Tools</small>
                            </div>
                        </div>
                        <div className="col-md-4 mb-3">
                            <div className="summary-item">
                                <div className="number text-warning h4 mb-1">
                                    {block.tools.filter(t => t.status.includes('Early')).length}
                                </div>
                                <small className="text-muted">Early Stage</small>
                            </div>
                        </div>
                        <div className="col-md-4 mb-3">
                            <div className="summary-item">
                                <div className="number text-warning h4 mb-1">
                                    12-24
                                </div>
                                <small className="text-muted">Months to Watch</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    );
};

// ROI Framework Component
const ROIFrameworkBlock = ({ block, index }) => {
