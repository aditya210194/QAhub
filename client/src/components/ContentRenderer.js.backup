};


// Test Summary Template Component
const TestSummaryTemplateBlock = ({ block, index }) => {
    const [copied, setCopied] = useState(false);

    const handleCopy = () => {
        let textToCopy = `${block.title}\n\n`;
        block.sections.forEach(section => {
            textToCopy += `${section.section}\n`;
            if (section.content) {
                textToCopy += `Content: ${section.content}\n`;
            }
            if (section.metrics) {
                textToCopy += `Metrics: ${section.metrics.join(', ')}\n`;
            }
            textToCopy += '\n';
        });
        navigator.clipboard.writeText(textToCopy);
        setCopied(true);
        setTimeout(() => setCopied(false), 2000);
    };

    return (
        <div className="test-summary-template-block card my-4">
            <div className="card-header bg-warning bg-opacity-10 border-warning">
                <div className="d-flex justify-content-between align-items-center">
                    <div className="d-flex align-items-center">
                        <i className="fas fa-file-contract text-warning me-2"></i>
                        <h5 className="card-title mb-0 text-dark">{block.title}</h5>
                    </div>
                    <button className="btn btn-sm btn-outline-secondary" onClick={handleCopy}>
                        <i className={`fas ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                        {copied ? ' Copied!' : ' Copy'}
                    </button>
                </div>
            </div>

            <div className="card-body">
                <div className="summary-sections">
                    {block.sections.map((section, sectionIndex) => (
                        <div key={sectionIndex} className="section-item mb-4 p-3 border rounded">
                            <div className="section-header mb-3">
                                <h6 className="text-warning mb-2">
                                    <i className="fas fa-file me-2"></i>
                                    {section.section}
                                </h6>
                            </div>

                            <div className="section-content">
                                {section.content && (
                                    <div className="content-text small bg-warning bg-opacity-10 p-3 rounded mb-3">
                                        {section.content}
                                    </div>
                                )}

                                {section.metrics && (
                                    <div className="metrics-section">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-chart-bar me-1"></i>
                                            Metrics
                                        </small>
                                        <div className="metrics-list">
                                            {section.metrics.map((metric, metricIndex) => (
                                                <div key={metricIndex} className="metric-item small bg-light p-2 rounded mb-1">
                                                    • {metric}
                                                </div>
                                            ))}
                                        </div>
                                    </div>
                                )}
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    );
};

