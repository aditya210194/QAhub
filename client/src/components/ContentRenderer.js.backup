        let textToCopy = "Common JWT Vulnerabilities\n\n";
        block.vulnerabilities.forEach(vuln => {
            textToCopy += `${vuln.vulnerability}\n`;
            textToCopy += `Description: ${vuln.description}\n`;
            textToCopy += `Impact: ${vuln.impact}\n`;
            textToCopy += `Testing Approach: ${vuln['testing-approach'].join(', ')}\n`;
            textToCopy += `Mitigation: ${vuln.mitigation}\n\n`;
        });
        navigator.clipboard.writeText(textToCopy);
        setCopied(true);
        setTimeout(() => setCopied(false), 2000);
    };

    return (
        <div className="common-vulnerabilities-block card my-4">
            <div className="card-header bg-danger bg-opacity-10 border-danger">
