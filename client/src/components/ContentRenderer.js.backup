// Security Headers Component
const SecurityHeadersBlock = ({ block, index }) => {
    const [copied, setCopied] = useState(false);

    const handleCopy = () => {
        let textToCopy = `${block.title}\n\n`;
        block.headers.forEach(header => {
            textToCopy += `${header.header}\n`;
            textToCopy += `Purpose: ${header.purpose}\n`;
            textToCopy += `Value: ${header.value}\n`;
            textToCopy += `Protection: ${header.protection}\n\n`;
        });
        navigator.clipboard.writeText(textToCopy);
        setCopied(true);
        setTimeout(() => setCopied(false), 2000);
    };

    return (
        <div className="security-headers-block card my-4">
            <div className="card-header bg-primary bg-opacity-10 border-primary">
                <div className="d-flex justify-content-between align-items-center">
                    <div className="d-flex align-items-center">
                        <i className="fas fa-heading text-primary me-2"></i>
                        <h5 className="card-title mb-0 text-dark">{block.title}</h5>
                    </div>
                    <button className="btn btn-sm btn-outline-secondary" onClick={handleCopy}>
                        <i className={`fas ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                        {copied ? ' Copied!' : ' Copy'}
                    </button>
                </div>
            </div>

            <div className="card-body">
                <div className="security-headers-grid">
                    {block.headers.map((header, headerIndex) => (
                        <div key={headerIndex} className="header-item mb-4 p-3 border rounded">
                            <div className="header-name mb-3">
                                <h6 className="text-primary mb-2">
                                    <i className="fas fa-server me-2"></i>
                                    {header.header}
                                </h6>
                                <div className="header-purpose text-muted small mb-3">
                                    <i className="fas fa-bullseye me-1"></i>
                                    Purpose: {header.purpose}
                                </div>
                            </div>

                            <div className="row">
                                <div className="col-md-6">
                                    <div className="value-section mb-3">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-code me-1"></i>
                                            Header Value
                                        </small>
                                        <div className="header-value small bg-primary bg-opacity-10 p-2 rounded font-monospace">
                                            {header.value}
                                        </div>
                                    </div>
                                </div>
                                <div className="col-md-6">
                                    <div className="protection-section">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-shield-alt me-1"></i>
                                            Protection Provided
                                        </small>
                                        <div className="protection-text small text-success">
                                            {header.protection}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    ))}
                </div>

                {/* Security Headers Implementation Guide */}
                <div className="implementation-guide mt-4 p-3 bg-light rounded">
                    <h6 className="text-primary mb-3">
                        <i className="fas fa-cogs me-2"></i>
                        Implementation Example
                    </h6>
                    <div className="code-example small bg-dark text-light p-3 rounded font-monospace">
                        <pre className="mb-0">
{`// Example HTTP Security Headers Configuration
Strict-Transport-Security: max-age=31536000; includeSubDomains
Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'
X-Frame-Options: DENY
X-Content-Type-Options: nosniff
Referrer-Policy: strict-origin-when-cross-origin
Permissions-Policy: geolocation=(), microphone=(), camera=()`}
                        </pre>
                    </div>
                </div>
            </div>
        </div>
    );
};

// Emerging Tools Component
const EmergingToolsBlock = ({ block, index }) => {
