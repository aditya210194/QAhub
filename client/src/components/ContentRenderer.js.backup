                                        <div className="vuln-header mb-2">
                                            <div className="d-flex justify-content-between align-items-start">
                                                <h6 className="text-dark mb-1">
                                                    <i className="fas fa-exclamation-triangle me-2"></i>
                                                    {vuln.vulnerability}
                                                </h6>
                                                <span className={`badge ${
                                                    vuln.severity === 'Critical' ? 'bg-danger' :
                                                        vuln.severity === 'High' ? 'bg-warning' : 'bg-info'
                                                }`}>
                                                    {vuln.severity}
                                                </span>
                                            </div>
                                            <div className="vuln-description text-muted small mb-2">
                                                {vuln.description}
                                            </div>
                                        </div>

                                        <div className="row">
                                            <div className="col-md-5">
                                                <div className="testing-technique-section mb-2">
                                                    <small className="text-muted d-block mb-1">
                                                        <i className="fas fa-search me-1"></i>
                                                        Testing Techniques
                                                    </small>
                                                    <div className="techniques-list">
                                                        {vuln['testing-technique'].map((technique, techIndex) => (
                                                            <div key={techIndex} className="technique-item small text-success mb-1">
                                                                • {technique}
                                                            </div>
                                                        ))}
                                                    </div>
                                                </div>
                                            </div>
                                            <div className="col-md-4">
                                                <div className="tools-section mb-2">
                                                    <small className="text-muted d-block mb-1">
                                                        <i className="fas fa-tools me-1"></i>
                                                        Tools
                                                    </small>
                                                    <div className="tools-list">
                                                        {vuln.tools.map((tool, toolIndex) => (
                                                            <span key={toolIndex} className="badge bg-secondary me-1 mb-1">
                                                                {tool}
                                                            </span>
                                                        ))}
                                                    </div>
                                                </div>
                                            </div>
                                            <div className="col-md-3">
                                                <div className="severity-section">
                                                    <small className="text-muted d-block mb-1">
                                                        <i className="fas fa-chart-line me-1"></i>
                                                        Risk Level
                                                    </small>
                                                    <div className="severity-badge">
                                                        <span className={`badge ${
                                                            vuln.severity === 'Critical' ? 'bg-danger' :
                                                                vuln.severity === 'High' ? 'bg-warning' : 'bg-info'
                                                        }`}>
                                                            {vuln.severity}
                                                        </span>
                                                    </div>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                ))}
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    );
};

