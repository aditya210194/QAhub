                                                </div>
                                            ))}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    ))}
                </div>

                {/* API Type Comparison */}
                <div className="comparison-section mt-4">
                    <h6 className="text-primary mb-3">
                        <i className="fas fa-balance-scale me-2"></i>
                        API Type Security Comparison
                    </h6>
                    <div className="table-responsive">
                        <table className="table table-sm table-bordered">
                            <thead className="table-light">
                            <tr>
                                <th>API Type</th>
                                <th>Common Vulnerabilities</th>
                                <th>Testing Complexity</th>
                                <th>Security Maturity</th>
                            </tr>
                            </thead>
                            <tbody>
                            <tr>
                                <td><strong>RESTful APIs</strong></td>
                                <td>IDOR, Broken Authentication, Injection</td>
                                <td>Medium</td>
                                <td>High</td>
                            </tr>
                            <tr>
                                <td><strong>GraphQL</strong></td>
                                <td>Query Complexity, Field Injection, Introspection</td>
                                <td>High</td>
                                <td>Medium</td>
                            </tr>
                            <tr>
                                <td><strong>SOAP</strong></td>
                                <td>XXE, SOAP Injection, WS-Security</td>
                                <td>Medium</td>
                                <td>High</td>
                            </tr>
                            <tr>
                                <td><strong>gRPC</strong></td>
                                <td>Protobuf Manipulation, Stream Abuse</td>
                                <td>High</td>
                                <td>Medium</td>
                            </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    );
};

