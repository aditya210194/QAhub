// Legal Framework Component
const LegalFrameworkBlock = ({ block, index }) => {
    const [copied, setCopied] = useState(false);

    const handleCopy = () => {
        let textToCopy = "Legal Framework for Penetration Testing\n\n";
        block.elements.forEach(element => {
            textToCopy += `${element.element}\n`;
            textToCopy += `Requirements: ${element.requirements.join(', ')}\n`;
            textToCopy += `Importance: ${element.importance}\n\n`;
        });
        navigator.clipboard.writeText(textToCopy);
        setCopied(true);
        setTimeout(() => setCopied(false), 2000);
    };

    return (
        <div className="legal-framework-block card my-4">
            <div className="card-header bg-warning bg-opacity-10 border-warning">
                <div className="d-flex justify-content-between align-items-center">
                    <div className="d-flex align-items-center">
                        <i className="fas fa-gavel text-warning me-2"></i>
                        <h5 className="card-title mb-0 text-dark">Legal Framework</h5>
                    </div>
                    <button className="btn btn-sm btn-outline-secondary" onClick={handleCopy}>
                        <i className={`fas ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                        {copied ? ' Copied!' : ' Copy'}
                    </button>
                </div>
            </div>

            <div className="card-body">
                <div className="legal-elements">
                    {block.elements.map((element, elementIndex) => (
                        <div key={elementIndex} className="legal-element-item mb-4 p-3 border rounded">
                            <div className="element-header mb-3">
                                <div className="d-flex justify-content-between align-items-start">
                                    <h6 className="text-warning mb-0">
                                        <i className="fas fa-balance-scale me-2"></i>
                                        {element.element}
                                    </h6>
                                    <span className={`badge ${
                                        element.importance === 'Critical' ? 'bg-danger' :
                                            element.importance === 'High' ? 'bg-warning' : 'bg-info'
                                    }`}>
                                        {element.importance} Priority
                                    </span>
                                </div>
                            </div>

                            <div className="row">
                                <div className="col-md-8">
                                    <div className="requirements-section mb-3">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-requirements me-1"></i>
                                            Legal Requirements
                                        </small>
                                        <div className="requirements-list">
                                            {element.requirements.map((requirement, reqIndex) => (
                                                <div key={reqIndex} className="requirement-item small bg-warning bg-opacity-10 p-2 rounded mb-1">
                                                    • {requirement}
                                                </div>
                                            ))}
                                        </div>
                                    </div>
                                </div>
                                <div className="col-md-4">
                                    <div className="importance-section">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-exclamation-circle me-1"></i>
                                            Importance Level
                                        </small>
                                        <div className="importance-text small">
                                            {element.importance}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    );
};

