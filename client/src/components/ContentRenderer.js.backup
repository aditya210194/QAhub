import React, { useState, useEffect, useCallback, useMemo } from 'react';
import ReactMarkdown from 'react-markdown';
import { Prism as SyntaxHighlighter } from 'react-syntax-highlighter';
import { atomDark } from 'react-syntax-highlighter/dist/esm/styles/prism';
import Mermaid from 'react-mermaid2';
import ChartRenderer from './ChartRenderer';
import PropTypes from 'prop-types';
import { InlineMath, BlockMath } from 'react-katex';
import 'katex/dist/katex.min.css';
import { CopyToClipboard } from 'react-copy-to-clipboard';
import { v4 as uuidv4 } from 'uuid';

// Enhanced error boundary with recovery option
class ContentErrorBoundary extends React.Component {
    state = { hasError: false, error: null, errorInfo: null };

    static getDerivedStateFromError(error) {
        return { hasError: true, error };
    }

    componentDidCatch(error, errorInfo) {
        console.error('Content rendering error:', error, errorInfo);
        this.setState({ errorInfo });
    }

    handleRetry = () => {
        this.setState({ hasError: false, error: null, errorInfo: null });
        this.props.onRetry?.();
    };

    render() {
        if (this.state.hasError) {
            return (
                <div className="alert alert-danger my-3">
                    <div className="d-flex justify-content-between align-items-center">
                        <div>
                            <strong>Error rendering content:</strong> {this.state.error?.message}
                            {this.props.fallback && (
                                <div className="mt-2">
                                    {this.props.fallback}
                                </div>
                            )}
                        </div>
                        <button
                            className="btn btn-sm btn-outline-secondary"
                            onClick={this.handleRetry}
                        >
                            Retry
                        </button>
                    </div>
                    {process.env.NODE_ENV === 'development' && this.state.errorInfo && (
                        <details className="mt-2 small">
                            <summary>Error details</summary>
                            <pre>{this.state.errorInfo.componentStack}</pre>
                        </details>
                    )}
                </div>
            );
        }
        return this.props.children;
    }
}
const DefinitionBlock = ({ block, index }) => {
    const [expanded, setExpanded] = useState(false);
    const [copied, setCopied] = useState(false);

    const handleCopy = () => {
        navigator.clipboard.writeText(block.content);
        setCopied(true);
        setTimeout(() => setCopied(false), 2000);
    };

    const toggleExpand = () => {
        setExpanded(!expanded);
    };

    const getDefinitionType = () => {
        const typeMap = {
            'formal': { icon: 'fas fa-gavel', color: 'primary', label: 'Formal Definition' },
            'technical': { icon: 'fas fa-cogs', color: 'info', label: 'Technical Definition' },
            'conceptual': { icon: 'fas fa-lightbulb', color: 'warning', label: 'Conceptual Definition' },
            'operational': { icon: 'fas fa-play-circle', color: 'success', label: 'Operational Definition' },
            'standard': { icon: 'fas fa-certificate', color: 'secondary', label: 'Standard Definition' }
        };

        return typeMap[block.definitionType] || {
            icon: 'fas fa-book',
            color: 'dark',
            label: 'Definition'
        };
    };

    const definitionType = getDefinitionType();

    return (
        <div key={index} className="definition-block card my-4">
            <div className={`card-header bg-${definitionType.color} bg-opacity-10 border-${definitionType.color}`}>
                <div className="d-flex justify-content-between align-items-center">
                    <div className="d-flex align-items-center">
                        <i className={`${definitionType.icon} text-${definitionType.color} me-2`}></i>
                        <h5 className="card-title mb-0 text-dark">
                            {block.title || definitionType.label}
                        </h5>
                    </div>
                    <div className="definition-actions">
                        <button
                            className="btn btn-sm btn-outline-secondary me-2"
                            onClick={handleCopy}
                            title="Copy definition"
                        >
                            <i className={`fas ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                            {copied ? ' Copied!' : ' Copy'}
                        </button>
                        {(block.details || block.examples || block.relatedTerms) && (
                            <button
                                className="btn btn-sm btn-outline-primary"
                                onClick={toggleExpand}
                            >
                                <i className={`fas fa-${expanded ? 'minus' : 'plus'}`}></i>
                                {expanded ? ' Less' : ' More'}
                            </button>
                        )}
                    </div>
                </div>

                {/* Definition Metadata */}
                {(block.source || block.domain || block.lastUpdated) && (
                    <div className="definition-meta mt-2 small">
                        {block.source && (
                            <span className="me-3">
                                <i className="fas fa-source me-1"></i>
                                Source: {block.source}
                            </span>
                        )}
                        {block.domain && (
                            <span className="me-3">
                                <i className="fas fa-tag me-1"></i>
                                Domain: {block.domain}
                            </span>
                        )}
                        {block.lastUpdated && (
                            <span>
                                <i className="fas fa-calendar me-1"></i>
                                Updated: {block.lastUpdated}
                            </span>
                        )}
                    </div>
                )}
            </div>

            <div className="card-body">
                {/* Main Definition Content */}
                <div className="definition-content">
                    <div className="definition-text lead">
                        <i className="fas fa-quote-left text-muted me-2"></i>
                        {block.content}
                        <i className="fas fa-quote-right text-muted ms-2"></i>
                    </div>

                    {/* Key Points */}
                    {block.keyPoints && (
                        <div className="key-points mt-3">
                            <h6 className="text-muted mb-2">
                                <i className="fas fa-key me-2"></i>
                                Key Points:
                            </h6>
                            <ul className="list-unstyled">
                                {block.keyPoints.map((point, pointIndex) => (
                                    <li key={pointIndex} className="mb-1">
                                        <i className="fas fa-circle text-primary me-2 small"></i>
                                        {point}
                                    </li>
                                ))}
                            </ul>
                        </div>
                    )}
                </div>

                {/* Expanded Content */}
                {expanded && (
                    <div className="expanded-content mt-4">
                        {/* Details */}
                        {block.details && (
                            <div className="definition-details mb-4">
                                <h6 className="border-bottom pb-2">
                                    <i className="fas fa-info-circle me-2 text-info"></i>
                                    Detailed Explanation
                                </h6>
                                <div className="details-content mt-2">
                                    {typeof block.details === 'string' ? (
                                        <p>{block.details}</p>
                                    ) : (
                                        block.details.map((detail, detailIndex) => (
                                            <p key={detailIndex}>{detail}</p>
                                        ))
                                    )}
                                </div>
                            </div>
                        )}

                        {/* Examples */}
                        {block.examples && (
                            <div className="definition-examples mb-4">
                                <h6 className="border-bottom pb-2">
                                    <i className="fas fa-list-alt me-2 text-success"></i>
                                    Examples
                                </h6>
                                <div className="examples-content mt-2">
                                    {block.examples.map((example, exampleIndex) => (
                                        <div key={exampleIndex} className="example-item mb-3 p-3 bg-light rounded">
                                            {example.title && (
                                                <strong className="d-block mb-1">{example.title}:</strong>
                                            )}
                                            <div>{example.content}</div>
                                            {example.context && (
                                                <small className="text-muted mt-1 d-block">
                                                    Context: {example.context}
                                                </small>
                                            )}
                                        </div>
                                    ))}
                                </div>
                            </div>
                        )}

                        {/* Related Terms */}
                        {block.relatedTerms && (
                            <div className="related-terms mb-4">
                                <h6 className="border-bottom pb-2">
                                    <i className="fas fa-link me-2 text-warning"></i>
                                    Related Terms
                                </h6>
                                <div className="terms-list mt-2">
                                    {block.relatedTerms.map((term, termIndex) => (
                                        <span key={termIndex} className="badge bg-light text-dark border me-2 mb-2">
                                            {term}
                                        </span>
                                    ))}
                                </div>
                            </div>
                        )}

                        {/* Formula/Calculation */}
                        {block.formula && (
                            <div className="definition-formula mb-4">
                                <h6 className="border-bottom pb-2">
                                    <i className="fas fa-calculator me-2 text-danger"></i>
                                    Formula
                                </h6>
                                <div className="formula-content mt-2 p-3 bg-dark text-light rounded">
                                    <code>{block.formula}</code>
                                </div>
                                {block.formulaExplanation && (
                                    <small className="text-muted mt-1 d-block">
                                        {block.formulaExplanation}
                                    </small>
                                )}
                            </div>
                        )}

                        {/* Best Practices */}
                        {block.bestPractices && (
                            <div className="best-practices">
                                <h6 className="border-bottom pb-2">
                                    <i className="fas fa-check-circle me-2 text-success"></i>
                                    Best Practices
                                </h6>
                                <ul className="list-group list-group-flush mt-2">
                                    {block.bestPractices.map((practice, practiceIndex) => (
                                        <li key={practiceIndex} className="list-group-item d-flex align-items-start">
                                            <i className="fas fa-check text-success me-2 mt-1"></i>
                                            <span>{practice}</span>
                                        </li>
                                    ))}
                                </ul>
                            </div>
                        )}
                    </div>
                )}

                {/* Quick Actions */}
                <div className="definition-footer mt-3 pt-3 border-top">
                    <div className="d-flex justify-content-between align-items-center">
                        <div className="definition-tags">
                            {block.tags && block.tags.map((tag, tagIndex) => (
                                <span key={tagIndex} className="badge bg-secondary me-1">
                                    {tag}
                                </span>
                            ))}
                        </div>
                        <div className="quick-actions">
                            {block.referenceLink && (
                                <a
                                    href={block.referenceLink}
                                    target="_blank"
                                    rel="noopener noreferrer"
                                    className="btn btn-sm btn-outline-info me-2"
                                >
                                    <i className="fas fa-external-link-alt me-1"></i>
                                    Reference
                                </a>
                            )}
                            <small className="text-muted">
                                <i className="fas fa-eye me-1"></i>
                                Definition
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    );
};
const EmergingTrendsBlock = ({ block, index }) => {
    const [copied, setCopied] = useState(false);

    const handleCopy = () => {
        let textToCopy = "Emerging Trends\n\n";
        block.trends.forEach(trend => {
            textToCopy += `${trend.trend}\n`;
            textToCopy += `Description: ${trend.description}\n`;
            textToCopy += `Impact: ${trend.impact}\n\n`;
        });
        navigator.clipboard.writeText(textToCopy);
        setCopied(true);
        setTimeout(() => setCopied(false), 2000);
    };

    return (
        <div className="emerging-trends-block card my-4">
            <div className="card-header bg-purple bg-opacity-10 border-purple">
                <div className="d-flex justify-content-between align-items-center">
                    <div className="d-flex align-items-center">
                        <i className="fas fa-crystal-ball text-purple me-2"></i>
                        <h5 className="card-title mb-0 text-dark">Emerging Trends</h5>
                    </div>
                    <button className="btn btn-sm btn-outline-secondary" onClick={handleCopy}>
                        <i className={`fas ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                        {copied ? ' Copied!' : ' Copy'}
                    </button>
                </div>
            </div>

            <div className="card-body">
                <div className="trends-grid">
                    {block.trends.map((trend, trendIndex) => (
                        <div key={trendIndex} className="trend-item mb-4 p-3 border rounded">
                            <div className="trend-header mb-3">
                                <h6 className="text-purple mb-2">
                                    <i className="fas fa-rocket me-2"></i>
                                    {trend.trend}
                                </h6>
                                <div className="trend-description text-muted small mb-2">
                                    <i className="fas fa-info-circle me-1"></i>
                                    {trend.description}
                                </div>
                            </div>

                            <div className="trend-impact">
                                <small className="text-muted d-block mb-1">
                                    <i className="fas fa-bolt me-1"></i>
                                    Impact
                                </small>
                                <div className="impact-text small bg-light p-2 rounded">
                                    {trend.impact}
                                </div>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    );
};
const ExecutionScenariosBlock = ({ block, index }) => {
    const [copied, setCopied] = useState(false);

    const handleCopy = () => {
        let textToCopy = `${block.title}\n\n`;
        block.scenarios.forEach(scenario => {
            textToCopy += `${scenario.scenario}\n`;
            textToCopy += `Approach: ${scenario.approach}\n`;
            textToCopy += `Coverage Target: ${scenario['coverage-target']}\n`;
            textToCopy += `Risk Acceptance: ${scenario['risk-acceptance']}\n\n`;
        });
        navigator.clipboard.writeText(textToCopy);
        setCopied(true);
        setTimeout(() => setCopied(false), 2000);
    };

    const getRiskColor = (risk) => {
        const riskMap = {
            'High': 'danger',
            'Medium': 'warning',
            'Low': 'success'
        };
        return riskMap[risk] || 'secondary';
    };

    return (
        <div className="execution-scenarios-block card my-4">
            <div className="card-header bg-info bg-opacity-10 border-info">
                <div className="d-flex justify-content-between align-items-center">
                    <div className="d-flex align-items-center">
                        <i className="fas fa-play-circle text-info me-2"></i>
                        <h5 className="card-title mb-0 text-dark">{block.title}</h5>
                    </div>
                    <button className="btn btn-sm btn-outline-secondary" onClick={handleCopy}>
                        <i className={`fas ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                        {copied ? ' Copied!' : ' Copy'}
                    </button>
                </div>
            </div>

            <div className="card-body">
                <div className="scenarios-grid">
                    {block.scenarios.map((scenario, scenarioIndex) => (
                        <div key={scenarioIndex} className="scenario-item mb-4 p-3 border rounded">
                            <div className="scenario-header mb-3">
                                <h6 className="text-info mb-2">
                                    <i className="fas fa-desktop me-2"></i>
                                    {scenario.scenario}
                                </h6>
                                <div className="scenario-approach text-muted small mb-2">
                                    <i className="fas fa-cogs me-1"></i>
                                    {scenario.approach}
                                </div>
                            </div>

                            <div className="row">
                                <div className="col-md-6">
                                    <div className="coverage-section mb-2">
                                        <small className="text-muted d-block mb-1">
                                            <i className="fas fa-bullseye me-1"></i>
                                            Coverage Target
                                        </small>
                                        <div className="coverage-text small bg-light p-2 rounded">
                                            {scenario['coverage-target']}
                                        </div>
                                    </div>
                                </div>
                                <div className="col-md-6">
                                    <div className="risk-section">
                                        <small className="text-muted d-block mb-1">
                                            <i className="fas fa-exclamation-triangle me-1"></i>
                                            Risk Acceptance
                                        </small>
                                        <span className={`badge bg-${getRiskColor(scenario['risk-acceptance'])}`}>
                                            {scenario['risk-acceptance']}
                                        </span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    );
};
const RiskPrioritizationFrameworkBlock = ({ block, index }) => {
    const [expanded, setExpanded] = useState(false);
    const [copied, setCopied] = useState(false);

    const handleCopy = () => {
        let textToCopy = "Risk Prioritization Framework\n\n";
        block.framework.forEach(level => {
            textToCopy += `${level.level}\n`;
            textToCopy += `Execution Priority: ${level['execution-priority']}\n`;
            textToCopy += `Acceptance Criteria: ${level['acceptance-criteria']}\n`;
            textToCopy += "Criteria:\n";
            level.criteria.forEach(criterion => {
                textToCopy += `• ${criterion}\n`;
            });
            textToCopy += "\n";
        });
        navigator.clipboard.writeText(textToCopy);
        setCopied(true);
        setTimeout(() => setCopied(false), 2000);
    };

    const toggleExpand = () => {
        setExpanded(!expanded);
    };

    const getLevelColor = (level) => {
        const levelMap = {
            'Critical Tests': 'danger',
            'High Priority Tests': 'warning',
            'Medium Priority Tests': 'info',
            'Low Priority Tests': 'secondary'
        };
        return levelMap[level] || 'secondary';
    };

    return (
        <div className="risk-prioritization-framework-block card my-4">
            <div className="card-header bg-danger bg-opacity-10 border-danger">
                <div className="d-flex justify-content-between align-items-center">
                    <div className="d-flex align-items-center">
                        <i className="fas fa-exclamation-triangle text-danger me-2"></i>
                        <h5 className="card-title mb-0 text-dark">Risk Prioritization Framework</h5>
                    </div>
                    <div className="framework-actions">
                        <button className="btn btn-sm btn-outline-secondary me-2" onClick={handleCopy}>
                            <i className={`fas ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                            {copied ? ' Copied!' : ' Copy'}
                        </button>
                        <button className="btn btn-sm btn-outline-primary" onClick={toggleExpand}>
                            <i className={`fas fa-${expanded ? 'minus' : 'plus'}`}></i>
                            {expanded ? ' Less' : ' More'}
                        </button>
                    </div>
                </div>
            </div>

            <div className="card-body">
                <div className="framework-levels">
                    {block.framework.map((level, levelIndex) => (
                        <div key={levelIndex} className="level-item mb-4 p-3 border rounded">
                            <div className="level-header d-flex justify-content-between align-items-center mb-3">
                                <h6 className={`text-${getLevelColor(level.level)} mb-0`}>
                                    <i className="fas fa-flag me-2"></i>
                                    {level.level}
                                </h6>
                                <div className="level-priority">
                                    <span className="badge bg-dark me-2">{level['execution-priority']}</span>
                                </div>
                            </div>

                            <div className="row">
                                <div className="col-md-6">
                                    <div className="criteria-section mb-3">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-list-ul me-1"></i>
                                            Criteria
                                        </small>
                                        <div className="criteria-list">
                                            {level.criteria.map((criterion, critIndex) => (
                                                <div key={critIndex} className="criterion-item small mb-1">
                                                    • {criterion}
                                                </div>
                                            ))}
                                        </div>
                                    </div>
                                </div>
                                <div className="col-md-6">
                                    <div className="acceptance-section">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-check-circle me-1"></i>
                                            Acceptance Criteria
                                        </small>
                                        <div className="acceptance-text small text-success bg-light p-2 rounded">
                                            {level['acceptance-criteria']}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    );
};
const ImplementationWorkflowBlock = ({ block, index }) => {
    const [copied, setCopied] = useState(false);

    const handleCopy = () => {
        let textToCopy = `${block.title}\n\n`;
        block.steps.forEach((step, index) => {
            textToCopy += `${index + 1}. ${step}\n`;
        });
        navigator.clipboard.writeText(textToCopy);
        setCopied(true);
        setTimeout(() => setCopied(false), 2000);
    };

    return (
        <div className="implementation-workflow-block card my-4">
            <div className="card-header bg-success bg-opacity-10 border-success">
                <div className="d-flex justify-content-between align-items-center">
                    <div className="d-flex align-items-center">
                        <i className="fas fa-project-diagram text-success me-2"></i>
                        <h5 className="card-title mb-0 text-dark">{block.title}</h5>
                    </div>
                    <button className="btn btn-sm btn-outline-secondary" onClick={handleCopy}>
                        <i className={`fas ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                        {copied ? ' Copied!' : ' Copy'}
                    </button>
                </div>
            </div>

            <div className="card-body">
                <div className="workflow-steps">
                    {block.steps.map((step, stepIndex) => (
                        <div key={stepIndex} className="step-item d-flex align-items-start mb-3 p-3 bg-light rounded">
                            <span className="badge bg-success me-3 mt-1">{stepIndex + 1}</span>
                            <div className="step-text flex-grow-1">{step}</div>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    );
};
const ToolCapabilitiesBlock = ({ block, index }) => {
    const [expanded, setExpanded] = useState(false);
    const [copied, setCopied] = useState(false);

    const handleCopy = () => {
        let textToCopy = "Tool Capabilities\n\n";
        block.categories.forEach(category => {
            textToCopy += `${category.category}:\n`;
            textToCopy += "Tools: " + category.tools.join(", ") + "\n";
            textToCopy += "Capabilities:\n";
            category.capabilities.forEach(capability => {
                textToCopy += `• ${capability}\n`;
            });
            textToCopy += "\n";
        });
        navigator.clipboard.writeText(textToCopy);
        setCopied(true);
        setTimeout(() => setCopied(false), 2000);
    };

    const toggleExpand = () => {
        setExpanded(!expanded);
    };

    return (
        <div className="tool-capabilities-block card my-4">
            <div className="card-header bg-primary bg-opacity-10 border-primary">
                <div className="d-flex justify-content-between align-items-center">
                    <div className="d-flex align-items-center">
                        <i className="fas fa-tools text-primary me-2"></i>
                        <h5 className="card-title mb-0 text-dark">Tool Capabilities</h5>
                    </div>
                    <div className="tool-actions">
                        <button className="btn btn-sm btn-outline-secondary me-2" onClick={handleCopy}>
                            <i className={`fas ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                            {copied ? ' Copied!' : ' Copy'}
                        </button>
                        <button className="btn btn-sm btn-outline-primary" onClick={toggleExpand}>
                            <i className={`fas fa-${expanded ? 'minus' : 'plus'}`}></i>
                            {expanded ? ' Collapse' : ' Expand'}
                        </button>
                    </div>
                </div>
            </div>

            <div className="card-body">
                <div className="capabilities-grid">
                    {block.categories.map((category, catIndex) => (
                        <div key={catIndex} className="capability-category mb-4">
                            <h6 className="d-flex align-items-center text-primary mb-3">
                                <i className="fas fa-folder me-2"></i>
                                {category.category}
                            </h6>
                            <div className="row">
                                <div className="col-md-5">
                                    <div className="tools-section mb-3">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-wrench me-1"></i>Tools
                                        </small>
                                        <div className="tools-list">
                                            {category.tools.map((tool, toolIndex) => (
                                                <span key={toolIndex} className="badge bg-light text-dark border me-1 mb-1">
                                                    {tool}
                                                </span>
                                            ))}
                                        </div>
                                    </div>
                                </div>
                                <div className="col-md-7">
                                    <div className="capabilities-section">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-bolt me-1"></i>Capabilities
                                        </small>
                                        <div className="capabilities-list">
                                            {category.capabilities.slice(0, expanded ? category.capabilities.length : 3).map((capability, capIndex) => (
                                                <div key={capIndex} className="capability-item small text-muted mb-1">
                                                    • {capability}
                                                </div>
                                            ))}
                                            {!expanded && category.capabilities.length > 3 && (
                                                <div className="more-items small text-primary">
                                                    +{category.capabilities.length - 3} more...
                                                </div>
                                            )}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    );
};
