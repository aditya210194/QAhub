// Session Structure Component
const SessionStructureBlock = ({ block, index }) => {
    const [copied, setCopied] = useState(false);

    const handleCopy = () => {
        let textToCopy = `${block.title}\n\n`;
        block.components.forEach(component => {
            textToCopy += `${component.component}\n`;
            textToCopy += `Activities: ${component.activities.join(', ')}\n`;
            textToCopy += `Time Allocation: ${component['time-allocation']}\n`;
            textToCopy += `Success Indicators: ${component['success-indicators']}\n\n`;
        });
        navigator.clipboard.writeText(textToCopy);
        setCopied(true);
        setTimeout(() => setCopied(false), 2000);
    };

    return (
        <div className="session-structure-block card my-4">
            <div className="card-header bg-success bg-opacity-10 border-success">
                <div className="d-flex justify-content-between align-items-center">
                    <div className="d-flex align-items-center">
                        <i className="fas fa-clock text-success me-2"></i>
                        <h5 className="card-title mb-0 text-dark">{block.title}</h5>
                    </div>
                    <button className="btn btn-sm btn-outline-secondary" onClick={handleCopy}>
                        <i className={`fas ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                        {copied ? ' Copied!' : ' Copy'}
                    </button>
                </div>
            </div>

            <div className="card-body">
                <div className="session-components">
                    {block.components.map((component, componentIndex) => (
                        <div key={componentIndex} className="component-item mb-4 p-3 border rounded">
                            <div className="component-header mb-3">
                                <div className="d-flex justify-content-between align-items-start">
                                    <h6 className="text-success mb-0">
                                        <i className="fas fa-cube me-2"></i>
                                        {component.component}
                                    </h6>
                                    <span className="badge bg-info">{component['time-allocation']}</span>
                                </div>
                            </div>

                            <div className="row">
                                <div className="col-md-5">
                                    <div className="activities-section mb-3">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-list me-1"></i>
                                            Activities
                                        </small>
                                        <div className="activities-list">
                                            {component.activities.map((activity, activityIndex) => (
                                                <div key={activityIndex} className="activity-item small bg-success bg-opacity-10 p-2 rounded mb-1">
                                                    • {activity}
                                                </div>
                                            ))}
                                        </div>
                                    </div>
                                </div>
                                <div className="col-md-7">
                                    <div className="structure-section mb-3">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-sitemap me-1"></i>
                                            Structure
                                        </small>
                                        {component.structure && (
                                            <div className="structure-list">
                                                {component.structure.map((item, itemIndex) => (
                                                    <div key={itemIndex} className="structure-item small text-primary mb-1">
                                                        {itemIndex + 1}. {item}
                                                    </div>
                                                ))}
                                            </div>
                                        )}
                                    </div>
                                </div>
                            </div>

                            <div className="success-section">
                                <small className="text-muted d-block mb-2">
                                    <i className="fas fa-bullseye me-1"></i>
                                    Success Indicators
                                </small>
                                <div className="success-text small bg-warning bg-opacity-10 p-2 rounded">
                                    {component['success-indicators']}
                                </div>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    );
};

