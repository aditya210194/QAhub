                        <i className={`fas ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                        {copied ? ' Copied!' : ' Copy'}
                    </button>
                </div>
            </div>

            <div className="card-body">
                <div className="profile-sections">
                    {block.sections.map((section, sectionIndex) => (
                        <div key={sectionIndex} className="section-item mb-4 p-3 border rounded">
                            <div className="section-header mb-3">
                                <div className="d-flex justify-content-between align-items-start">
                                    <h6 className="text-info mb-0">
                                        <i className="fas fa-file-alt me-2"></i>
                                        {section.section}
                                    </h6>
                                    <span className={`badge ${
                                        section['impact-score'] === 'Critical' ? 'bg-danger' :
                                            section['impact-score'] === 'High' ? 'bg-warning' : 'bg-info'
                                    }`}>
                                        {section['impact-score']}
                                    </span>
                                </div>
                            </div>

                            <div className="requirements-section">
                                <small className="text-muted d-block mb-2">
                                    <i className="fas fa-list-check me-1"></i>
                                    Completeness Requirements
                                </small>
                                <div className="requirements-list">
                                    {section['completeness-requirements'].map((requirement, requirementIndex) => (
                                        <div key={requirementIndex} className="requirement-item small bg-info bg-opacity-10 p-2 rounded mb-1">
                                            • {requirement}
                                        </div>
                                    ))}
                                </div>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    );
};

