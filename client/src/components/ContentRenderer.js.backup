                    </div>
                </div>
            </div>
        </div>
    );
};
const AnalogyBlock = ({ block, index }) => {
    const [expanded, setExpanded] = useState(false);
    const [copied, setCopied] = useState(false);

    const handleCopy = () => {
        const textToCopy = `${block.title}\n\n${block.content}${block.explanation ? `\n\n${block.explanation}` : ''}`;
        navigator.clipboard.writeText(textToCopy);
        setCopied(true);
        setTimeout(() => setCopied(false), 2000);
    };

    const toggleExpand = () => {
        setExpanded(!expanded);
    };

    const getAnalogyType = () => {
        const typeMap = {
            'real-world': { icon: 'fas fa-globe-americas', color: 'success', label: 'Real-world Analogy' },
            'technical': { icon: 'fas fa-cogs', color: 'info', label: 'Technical Analogy' },
            'metaphor': { icon: 'fas fa-theater-masks', color: 'warning', label: 'Metaphor' },
            'story': { icon: 'fas fa-book-open', color: 'primary', label: 'Story Analogy' },
            'comparison': { icon: 'fas fa-balance-scale', color: 'secondary', label: 'Comparison' },
            'visual': { icon: 'fas fa-eye', color: 'danger', label: 'Visual Analogy' }
        };

        return typeMap[block.analogyType] || {
            icon: 'fas fa-lightbulb',
            color: 'primary',
            label: 'Analogy'
        };
    };

    const analogyType = getAnalogyType();

    return (
        <div key={index} className="analogy-block card my-4">
            <div className={`card-header bg-${analogyType.color} bg-opacity-10 border-${analogyType.color}`}>
                <div className="d-flex justify-content-between align-items-center">
                    <div className="d-flex align-items-center">
                        <i className={`${analogyType.icon} text-${analogyType.color} me-2`}></i>
                        <h5 className="card-title mb-0 text-dark">
                            {block.title || analogyType.label}
                        </h5>
                    </div>
                    <div className="analogy-actions">
                        <button
                            className="btn btn-sm btn-outline-secondary me-2"
                            onClick={handleCopy}
                            title="Copy analogy"
                        >
                            <i className={`fas ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                            {copied ? ' Copied!' : ' Copy'}
                        </button>
                        {(block.explanation || block.components || block.learningTips) && (
                            <button
                                className="btn btn-sm btn-outline-primary"
                                onClick={toggleExpand}
                            >
                                <i className={`fas fa-${expanded ? 'minus' : 'plus'}`}></i>
                                {expanded ? ' Less' : ' More'}
                            </button>
                        )}
                    </div>
                </div>

                {/* Analogy Metadata */}
                {(block.difficulty || block.domain || block.effectiveness) && (
                    <div className="analogy-meta mt-2 small">
                        {block.difficulty && (
                            <span className="me-3">
                                <i className="fas fa-brain me-1"></i>
                                Level:
                                <span className={`badge ms-1 ${
                                    block.difficulty === 'easy' ? 'bg-success' :
                                        block.difficulty === 'medium' ? 'bg-warning' : 'bg-danger'
                                }`}>
                                    {block.difficulty}
                                </span>
                            </span>
                        )}
                        {block.domain && (
                            <span className="me-3">
                                <i className="fas fa-tag me-1"></i>
                                Domain: {block.domain}
                            </span>
                        )}
                        {block.effectiveness && (
                            <span>
                                <i className="fas fa-chart-line me-1"></i>
                                Effectiveness: {block.effectiveness}%
                            </span>
                        )}
                    </div>
                )}
            </div>

            <div className="card-body">
                {/* Main Analogy Content */}
                <div className="analogy-content">
                    <div className="analogy-main d-flex align-items-start">
                        <div className="analogy-icon me-3">
                            <i className="fas fa-arrow-right text-muted fa-lg mt-1"></i>
                        </div>
                        <div className="analogy-text flex-grow-1">
                            <div className="analogy-statement lead">
                                {block.content}
                            </div>

                            {/* Visual Representation */}
                            {block.visual && (
                                <div className="analogy-visual mt-3 text-center">
                                    <div className="visual-container p-3 bg-light rounded">
                                        <i className={`${block.visual.icon} fa-2x text-${analogyType.color} mb-2`}></i>
                                        <div className="visual-text small">
                                            {block.visual.text}
                                        </div>
                                    </div>
                                </div>
                            )}
                        </div>
                    </div>

                    {/* Quick Mapping */}
                    {block.mapping && (
                        <div className="analogy-mapping mt-3 p-3 bg-light rounded">
                            <h6 className="mb-3 text-center">
                                <i className="fas fa-project-diagram me-2"></i>
                                How This Maps to Your Context
                            </h6>
                            <div className="row text-center">
                                {block.mapping.map((map, mapIndex) => (
                                    <div key={mapIndex} className="col-md-6 mb-2">
                                        <div className="mapping-item">
                                            <strong className="d-block text-primary">{map.from}</strong>
                                            <i className="fas fa-arrow-down text-muted my-1"></i>
                                            <div className="text-success">{map.to}</div>
                                        </div>
                                    </div>
                                ))}
                            </div>
                        </div>
                    )}
                </div>

                {/* Expanded Content */}
                {expanded && (
                    <div className="expanded-content mt-4">
                        {/* Detailed Explanation */}
                        {block.explanation && (
                            <div className="analogy-explanation mb-4">
                                <h6 className="border-bottom pb-2">
                                    <i className="fas fa-info-circle me-2 text-info"></i>
                                    Why This Analogy Works
                                </h6>
                                <div className="explanation-content mt-2">
                                    {block.explanation}
                                </div>
                            </div>
                        )}

                        {/* Component Breakdown */}
                        {block.components && (
                            <div className="analogy-components mb-4">
                                <h6 className="border-bottom pb-2">
                                    <i className="fas fa-puzzle-piece me-2 text-warning"></i>
                                    Analogy Components
                                </h6>
                                <div className="components-grid mt-2">
                                    {block.components.map((component, compIndex) => (
                                        <div key={compIndex} className="component-item card mb-2">
                                            <div className="card-body py-2">
                                                <div className="d-flex justify-content-between align-items-center">
                                                    <div>
                                                        <strong>{component.concept}:</strong>
                                                        <span className="text-muted ms-2">→</span>
                                                        <span className="ms-2">{component.analog}</span>
                                                    </div>
                                                    <small className="text-muted">{component.role}</small>
                                                </div>
                                            </div>
                                        </div>
                                    ))}
                                </div>
                            </div>
                        )}

                        {/* Learning Tips */}
                        {block.learningTips && (
                            <div className="learning-tips mb-4">
                                <h6 className="border-bottom pb-2">
                                    <i className="fas fa-graduation-cap me-2 text-success"></i>
                                    Learning Tips
                                </h6>
                                <div className="tips-list mt-2">
                                    {block.learningTips.map((tip, tipIndex) => (
                                        <div key={tipIndex} className="tip-item d-flex align-items-start mb-2">
                                            <i className="fas fa-check-circle text-success me-2 mt-1"></i>
                                            <span>{tip}</span>
                                        </div>
                                    ))}
                                </div>
                            </div>
                        )}

                        {/* Common Misconceptions */}
                        {block.misconceptions && (
                            <div className="misconceptions mb-4">
                                <h6 className="border-bottom pb-2">
                                    <i className="fas fa-exclamation-triangle me-2 text-danger"></i>
                                    Common Misconceptions
                                </h6>
                                <div className="misconceptions-list mt-2">
                                    {block.misconceptions.map((misconception, misIndex) => (
                                        <div key={misIndex} className="misconception-item d-flex align-items-start mb-2">
                                            <i className="fas fa-times-circle text-danger me-2 mt-1"></i>
                                            <div>
                                                <strong>Myth:</strong> {misconception.myth}
                                                <br />
                                                <strong>Reality:</strong> {misconception.reality}
                                            </div>
                                        </div>
                                    ))}
                                </div>
                            </div>
                        )}

                        {/* Related Analogies */}
                        {block.relatedAnalogies && (
                            <div className="related-analogies">
                                <h6 className="border-bottom pb-2">
                                    <i className="fas fa-link me-2 text-primary"></i>
                                    Related Analogies
                                </h6>
                                <div className="analogies-list mt-2">
                                    {block.relatedAnalogies.map((related, relIndex) => (
                                        <div key={relIndex} className="related-item d-flex align-items-center mb-2 p-2 bg-light rounded">
                                            <i className="fas fa-lightbulb text-warning me-2"></i>
                                            <div>
                                                <strong>{related.title}:</strong>
                                                <span className="text-muted ms-2">{related.description}</span>
                                            </div>
                                        </div>
                                    ))}
                                </div>
                            </div>
                        )}
                    </div>
                )}

                {/* Quick Actions */}
                <div className="analogy-footer mt-3 pt-3 border-top">
                    <div className="d-flex justify-content-between align-items-center">
                        <div className="analogy-tags">
                            {block.tags && block.tags.map((tag, tagIndex) => (
                                <span key={tagIndex} className="badge bg-light text-dark border me-1">
                                    {tag}
                                </span>
                            ))}
                        </div>
                        <div className="quick-feedback">
                            <small className="text-muted">
                                <i className="fas fa-comment me-1"></i>
                                Did this analogy help?
                                <button className="btn btn-sm btn-link p-0 ms-1" title="Helpful">
                                    <i className="fas fa-thumbs-up text-success"></i>
                                </button>
                                <button className="btn btn-sm btn-link p-0 ms-1" title="Not helpful">
                                    <i className="fas fa-thumbs-down text-danger"></i>
                                </button>
                            </small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    );
};

const InteractiveQuiz = ({ block, index }) => {
    const [selectedAnswer, setSelectedAnswer] = useState(null);
    const [showExplanation, setShowExplanation] = useState(false);
    const [isCorrect, setIsCorrect] = useState(false);
    const [attempted, setAttempted] = useState(false);

    const handleAnswerSelect = (answerIndex) => {
        if (showExplanation) return; // Prevent changing answer after submission

        setSelectedAnswer(answerIndex);
        setAttempted(true);
    };

    const checkAnswer = () => {
        if (selectedAnswer === null) return;

        const correct = selectedAnswer === block.correctAnswer;
        setIsCorrect(correct);
        setShowExplanation(true);
    };

    const resetQuiz = () => {
        setSelectedAnswer(null);
        setShowExplanation(false);
        setIsCorrect(false);
        setAttempted(false);
    };

    const getOptionIcon = (optionIndex) => {
        if (!showExplanation) {
            return selectedAnswer === optionIndex ? '🔵' : '⚪';
        }

        if (optionIndex === block.correctAnswer) {
            return '✅';
        } else if (optionIndex === selectedAnswer && !isCorrect) {
            return '❌';
        }
        return '⚪';
    };

    const getOptionClass = (optionIndex) => {
        if (!showExplanation) {
            return selectedAnswer === optionIndex ? 'option-selected' : '';
        }

        if (optionIndex === block.correctAnswer) {
            return 'option-correct';
        } else if (optionIndex === selectedAnswer && !isCorrect) {
            return 'option-incorrect';
        }
        return '';
    };

    return (
        <div key={index} className="interactive-quiz card my-4">
            <div className="card-header bg-primary bg-opacity-10">
                <div className="d-flex justify-content-between align-items-center">
                    <h3 className="card-title mb-0">
                        <i className="fas fa-brain me-2"></i>
                        {block.title || "Knowledge Check"}
                    </h3>
                    <span className="badge bg-primary">
                        <i className="fas fa-star me-1"></i>
                        Quiz
                    </span>
                </div>
            </div>

            <div className="card-body">
                {/* Question */}
                <div className="quiz-question mb-4">
                    <h5 className="question-text">
                        <i className="fas fa-question-circle text-primary me-2"></i>
                        {block.question}
                    </h5>
                </div>

                {/* Options */}
                <div className="quiz-options mb-4">
                    {block.options?.map((option, optionIndex) => (
                        <div
                            key={optionIndex}
                            className={`quiz-option ${getOptionClass(optionIndex)} ${
                                !showExplanation ? 'clickable' : ''
                            }`}
                            onClick={() => !showExplanation && handleAnswerSelect(optionIndex)}
                        >
                            <div className="option-content">
                                <span className="option-icon me-3">
                                    {getOptionIcon(optionIndex)}
                                </span>
                                <span className="option-text">{option}</span>
                            </div>
                        </div>
                    ))}
                </div>

                {/* Action Buttons */}
                <div className="quiz-actions">
                    {!showExplanation ? (
                        <button
                            className="btn btn-primary"
                            onClick={checkAnswer}
                            disabled={selectedAnswer === null}
                        >
                            <i className="fas fa-check-circle me-2"></i>
                            Check Answer
                        </button>
                    ) : (
                        <div className="d-flex gap-2">
                            <button
                                className="btn btn-outline-secondary"
                                onClick={resetQuiz}
                            >
                                <i className="fas fa-redo me-2"></i>
                                Try Again
                            </button>
                            {block.explanation && (
                                <button
                                    className="btn btn-outline-info"
                                    onClick={() => {/* Could expand for more details */}}
                                >
                                    <i className="fas fa-info-circle me-2"></i>
                                    Learn More
                                </button>
                            )}
                        </div>
                    )}
                </div>

                {/* Explanation */}
                {showExplanation && block.explanation && (
                    <div className={`quiz-explanation mt-4 p-3 rounded ${
                        isCorrect ? 'alert-success' : 'alert-danger'
                    }`}>
                        <div className="explanation-header d-flex align-items-center mb-2">
                            <i className={`fas ${isCorrect ? 'fa-check-circle text-success' : 'fa-times-circle text-danger'} me-2`}></i>
                            <strong>
                                {isCorrect ? 'Correct! ' : 'Not quite. '}
                                {block.explanationTitle || 'Explanation:'}
                            </strong>
                        </div>
                        <div className="explanation-content">
                            {block.explanation}
                        </div>
                    </div>
                )}

                {/* Progress Indicator */}
                <div className="quiz-progress mt-3">
                    <div className="progress" style={{ height: '6px' }}>
                        <div
                            className={`progress-bar ${attempted ? 'bg-primary' : 'bg-light'}`}
                            style={{ width: attempted ? '100%' : '0%' }}
                        ></div>
                    </div>
                    <small className="text-muted">
                        {attempted ? 'Answer submitted' : 'Select an answer to continue'}
                    </small>
                </div>
            </div>
        </div>
    );
};
const InteractiveQuiz1 = ({ block, index }) => {
    const [currentQuestionIndex, setCurrentQuestionIndex] = useState(0);
    const [userAnswers, setUserAnswers] = useState([]);
    const [showResults, setShowResults] = useState(false);
    const [quizCompleted, setQuizCompleted] = useState(false);

    const currentQuestion = block.questions?.[currentQuestionIndex];
    const totalQuestions = block.questions?.length || 0;
    const currentAnswer = userAnswers[currentQuestionIndex];
    const isLastQuestion = currentQuestionIndex === totalQuestions - 1;

    const handleAnswerSelect = (answerIndex) => {
        if (quizCompleted) return;

        const newAnswers = [...userAnswers];
        newAnswers[currentQuestionIndex] = answerIndex;
        setUserAnswers(newAnswers);
    };

    const handleNextQuestion = () => {
        if (currentQuestionIndex < totalQuestions - 1) {
            setCurrentQuestionIndex(prev => prev + 1);
        } else {
            // All questions answered
            setShowResults(true);
            setQuizCompleted(true);
        }
    };

    const handlePreviousQuestion = () => {
        if (currentQuestionIndex > 0) {
            setCurrentQuestionIndex(prev => prev - 1);
        }
    };

    const handleSubmitQuiz = () => {
        setShowResults(true);
        setQuizCompleted(true);
    };

    const handleResetQuiz = () => {
        setCurrentQuestionIndex(0);
        setUserAnswers([]);
        setShowResults(false);
        setQuizCompleted(false);
    };

    const calculateScore = () => {
        if (!block.questions) return 0;

        let correct = 0;
        block.questions.forEach((question, index) => {
            if (userAnswers[index] === question.correctAnswer) {
                correct++;
            }
        });
        return correct;
    };

    const getOptionIcon = (optionIndex) => {
        if (showResults) {
            if (optionIndex === currentQuestion.correctAnswer) {
                return '✅';
            } else if (optionIndex === currentAnswer && optionIndex !== currentQuestion.correctAnswer) {
                return '❌';
            }
            return '⚪';
        }

        return currentAnswer === optionIndex ? '🔵' : '⚪';
    };

    const getOptionClass = (optionIndex) => {
        let baseClass = "quiz-option p-3 mb-2 rounded border ";

        if (showResults) {
            if (optionIndex === currentQuestion.correctAnswer) {
                baseClass += "border-success bg-success bg-opacity-10 ";
            } else if (optionIndex === currentAnswer && optionIndex !== currentQuestion.correctAnswer) {
                baseClass += "border-danger bg-danger bg-opacity-10 ";
            }
        } else {
            baseClass += currentAnswer === optionIndex
                ? "border-primary bg-primary bg-opacity-10 "
                : "border-light ";
        }

        return baseClass + (!quizCompleted ? "cursor-pointer hover:bg-light" : "");
    };

    if (!block.questions || block.questions.length === 0) {
        return (
            <div className="alert alert-warning my-4">
                <i className="fas fa-exclamation-triangle me-2"></i>
                No questions available for this quiz.
            </div>
        );
    }

    return (
        <div key={index} className="interactive-quiz card my-4 shadow-sm">
            <div className="card-header bg-primary text-white">
                <div className="d-flex justify-content-between align-items-center">
                    <div>
                        <h3 className="card-title mb-0">
                            <i className="fas fa-brain me-2"></i>
                            {block.title || "Knowledge Check"}
                        </h3>
                        <small className="opacity-75">
                            Question {currentQuestionIndex + 1} of {totalQuestions}
                        </small>
                    </div>
                    {quizCompleted && (
                        <span className="badge bg-light text-primary fs-6">
                            Score: {calculateScore()}/{totalQuestions}
                        </span>
                    )}
                </div>
            </div>

            <div className="card-body">
                {/* Question Progress */}
                <div className="quiz-progress mb-4">
                    <div className="d-flex justify-content-between mb-2">
                        <small>Progress</small>
                        <small>{Math.round(((currentQuestionIndex + 1) / totalQuestions) * 100)}%</small>
                    </div>
                    <div className="progress" style={{ height: '8px' }}>
                        <div
                            className="progress-bar bg-primary"
                            style={{
                                width: `${((currentQuestionIndex + 1) / totalQuestions) * 100}%`
                            }}
                        ></div>
                    </div>
                </div>

                {/* Current Question */}
                <div className="quiz-question mb-4">
                    <h5 className="question-text fw-bold mb-4">
                        <span className="badge bg-secondary me-2">{currentQuestionIndex + 1}</span>
                        {currentQuestion.question}
                    </h5>

                    {/* Options */}
                    <div className="quiz-options mb-4">
                        {currentQuestion.options?.map((option, optionIndex) => (
                            <div
                                key={optionIndex}
                                className={getOptionClass(optionIndex)}
                                onClick={() => !quizCompleted && handleAnswerSelect(optionIndex)}
                            >
                                <div className="option-content d-flex align-items-center">
                                    <span className="option-icon me-3 fs-5">
                                        {getOptionIcon(optionIndex)}
                                    </span>
                                    <span className="option-text flex-grow-1">{option}</span>
                                    {showResults && optionIndex === currentQuestion.correctAnswer && (
                                        <span className="badge bg-success ms-2">
                                            <i className="fas fa-check me-1"></i>Correct
                                        </span>
                                    )}
                                </div>
                            </div>
                        ))}
                    </div>
                </div>

                {/* Explanation (if showing results) */}
                {showResults && currentQuestion.explanation && (
                    <div className="quiz-explanation alert alert-info mt-3">
                        <div className="d-flex align-items-start">
                            <i className="fas fa-info-circle mt-1 me-2"></i>
                            <div>
                                <strong className="d-block mb-1">Explanation:</strong>
                                <p className="mb-0">{currentQuestion.explanation}</p>
                            </div>
                        </div>
                    </div>
                )}

                {/* Navigation Buttons */}
                <div className="quiz-navigation d-flex justify-content-between mt-4 pt-3 border-top">
                    <div>
                        <button
                            className="btn btn-outline-secondary"
                            onClick={handlePreviousQuestion}
                            disabled={currentQuestionIndex === 0}
                        >
                            <i className="fas fa-arrow-left me-2"></i>
                            Previous
                        </button>
                    </div>

                    <div className="d-flex gap-2">
                        {!quizCompleted ? (
                            <>
                                <button
                                    className="btn btn-primary"
                                    onClick={handleNextQuestion}
                                    disabled={currentAnswer === undefined}
                                >
                                    {isLastQuestion ? (
                                        <>
                                            <i className="fas fa-paper-plane me-2"></i>
                                            Submit Quiz
                                        </>
                                    ) : (
                                        <>
                                            Next Question
                                            <i className="fas fa-arrow-right ms-2"></i>
                                        </>
                                    )}
                                </button>

                                {isLastQuestion && currentAnswer !== undefined && (
                                    <button
                                        className="btn btn-success"
                                        onClick={handleSubmitQuiz}
                                    >
                                        <i className="fas fa-check-circle me-2"></i>
                                        Submit Now
                                    </button>
                                )}
                            </>
                        ) : (
                            <button
                                className="btn btn-outline-primary"
                                onClick={handleResetQuiz}
                            >
                                <i className="fas fa-redo me-2"></i>
                                Retry Quiz
                            </button>
                        )}
                    </div>
                </div>

                {/* Results Summary (when completed) */}
                {showResults && (
                    <div className="quiz-results alert alert-light mt-4">
                        <h5 className="mb-3">
                            <i className="fas fa-chart-bar me-2 text-primary"></i>
                            Quiz Results
                        </h5>
                        <div className="row">
                            <div className="col-md-6">
                                <div className="score-card text-center p-3 bg-primary bg-opacity-10 rounded">
                                    <h2 className="text-primary">{calculateScore()}/{totalQuestions}</h2>
                                    <p className="mb-0">Your Score</p>
                                </div>
                            </div>
                            <div className="col-md-6">
                                <div className="score-details">
                                    <p className="mb-2">
                                        <strong>Percentage:</strong>{' '}
                                        <span className="badge bg-primary">
                                            {Math.round((calculateScore() / totalQuestions) * 100)}%
                                        </span>
                                    </p>
                                    <p className="mb-2">
                                        <strong>Correct Answers:</strong>{' '}
                                        <span className="text-success">{calculateScore()}</span>
                                    </p>
                                    <p className="mb-0">
                                        <strong>Incorrect Answers:</strong>{' '}
                                        <span className="text-danger">{totalQuestions - calculateScore()}</span>
                                    </p>
                                </div>
                            </div>
                        </div>
                    </div>
                )}
            </div>
        </div>
    );
};



const InteractiveCalculator = ({ block, index }) => {
    const [values, setValues] = useState(() =>
        block.fields.reduce((acc, field, fieldIndex) => {
            acc[fieldIndex] = field.default || 0;
            return acc;
        }, {})
    );

    const [result, setResult] = useState(null);
    const [breakdown, setBreakdown] = useState({});

    const calculateResult = useCallback(() => {
        try {
            // Extract values for calculation
            const timeSavings = parseFloat(values[0]) || 0;
            const teamSize = parseFloat(values[1]) || 0;
            const hourlyRate = parseFloat(values[2]) || 0;
            const defectsPrevented = parseFloat(values[3]) || 0;
            const costPerDefect = parseFloat(values[4]) || 0;

            // Calculate breakdown values
            const timeValue = timeSavings * teamSize * hourlyRate * 48; // 48 weeks per year
            const defectValue = defectsPrevented * costPerDefect * 12; // 12 months per year
            const totalValue = timeValue + defectValue;

            setResult(totalValue);
            setBreakdown({
                timeValue,
                defectValue,
                totalValue
            });

        } catch (error) {
            console.error('Calculation error:', error);
            setResult('Error in calculation');
        }
    }, [values]);

    const handleInputChange = (fieldIndex, value) => {
        setValues(prev => ({
            ...prev,
            [fieldIndex]: parseFloat(value) || 0
        }));
    };

    const formatCurrency = (amount) => {
        return new Intl.NumberFormat('en-US', {
            style: 'currency',
            currency: 'USD',
            minimumFractionDigits: 0,
            maximumFractionDigits: 0
        }).format(amount);
    };

    const resetCalculator = () => {
        const resetValues = block.fields.reduce((acc, field, fieldIndex) => {
            acc[fieldIndex] = field.default || 0;
            return acc;
        }, {});
        setValues(resetValues);
        setResult(null);
        setBreakdown({});
    };

    return (
        <div key={index} className="interactive-calculator card my-4">
            <div className="card-header bg-primary bg-opacity-10">
                <h3 className="card-title mb-0">
                    <i className="fas fa-calculator me-2"></i>
                    {block.title || "Interactive Calculator"}
                </h3>
            </div>

            <div className="card-body">
                {/* Calculator Form */}
                <div className="calculator-form">
                    <div className="row g-3">
                        {block.fields.map((field, fieldIndex) => (
                            <div key={fieldIndex} className="col-md-6">
                                <div className="calculator-field">
                                    <label htmlFor={`calc-${index}-${fieldIndex}`} className="form-label">
                                        {field.label}
                                        {field.tooltip && (
                                            <i
                                                className="fas fa-info-circle ms-1 text-muted"
                                                data-bs-toggle="tooltip"
                                                title={field.tooltip}
                                            ></i>
                                        )}
                                    </label>
                                    <input
                                        id={`calc-${index}-${fieldIndex}`}
                                        type={field.type || "number"}
                                        className="form-control"
                                        value={values[fieldIndex]}
                                        onChange={(e) => handleInputChange(fieldIndex, e.target.value)}
                                        min={field.min}
                                        max={field.max}
                                        step={field.step || "1"}
                                        placeholder={field.placeholder || `Enter ${field.label.toLowerCase()}`}
                                    />
                                    {field.description && (
                                        <div className="form-text text-muted small">
                                            {field.description}
                                        </div>
                                    )}
                                </div>
                            </div>
                        ))}
                    </div>

                    {/* Action Buttons */}
                    <div className="calculator-actions mt-4">
                        <button
                            className="btn btn-primary me-2"
                            onClick={calculateResult}
                        >
                            <i className="fas fa-calculator me-1"></i>
                            Calculate
                        </button>
                        <button
                            className="btn btn-outline-secondary"
                            onClick={resetCalculator}
                        >
                            <i className="fas fa-redo me-1"></i>
                            Reset
                        </button>
                    </div>
                </div>

                {/* Results Section */}
                {result !== null && (
                    <div className="calculator-results mt-4">
                        <div className="results-card card border-success">
                            <div className="card-header bg-success bg-opacity-10">
                                <h5 className="mb-0 text-success">
                                    <i className="fas fa-chart-line me-2"></i>
                                    {block.outputLabel || "Calculation Results"}
                                </h5>
                            </div>
                            <div className="card-body">
                                {/* Main Result */}
                                <div className="main-result text-center mb-4">
                                    <div className="result-value display-6 text-success fw-bold">
                                        {formatCurrency(result)}
                                    </div>
                                    <div className="result-label text-muted">
                                        {block.outputLabel || "Total Value"}
                                    </div>
                                </div>

                                {/* Breakdown */}
                                {breakdown.timeValue !== undefined && (
                                    <div className="breakdown-section">
                                        <h6 className="mb-3">Value Breakdown</h6>
                                        <div className="breakdown-items">
                                            <div className="breakdown-item d-flex justify-content-between align-items-center py-2 border-bottom">
                                                <div>
                                                    <i className="fas fa-clock text-primary me-2"></i>
                                                    <span>Time Savings Value</span>
                                                </div>
                                                <div className="fw-bold text-primary">
                                                    {formatCurrency(breakdown.timeValue)}
                                                </div>
                                            </div>
                                            <div className="breakdown-item d-flex justify-content-between align-items-center py-2 border-bottom">
                                                <div>
                                                    <i className="fas fa-bug text-warning me-2"></i>
                                                    <span>Defect Prevention Value</span>
                                                </div>
                                                <div className="fw-bold text-warning">
                                                    {formatCurrency(breakdown.defectValue)}
                                                </div>
                                            </div>
                                            <div className="breakdown-item d-flex justify-content-between align-items-center py-2">
                                                <div>
                                                    <i className="fas fa-chart-bar text-success me-2"></i>
                                                    <strong>Total Annual Value</strong>
                                                </div>
                                                <div className="fw-bold text-success">
                                                    {formatCurrency(breakdown.totalValue)}
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                )}

                                {/* Formula Info */}
                                {block.formula && (
                                    <div className="formula-info mt-3 p-3 bg-light rounded">
                                        <small className="text-muted">
                                            <strong>Formula:</strong> {block.formula}
                                        </small>
                                    </div>
                                )}
                            </div>
                        </div>
                    </div>
                )}

                {/* Help Text */}
                {block.helpText && (
                    <div className="calculator-help mt-3">
                        <div className="alert alert-info">
                            <i className="fas fa-info-circle me-2"></i>
                            {block.helpText}
                        </div>
                    </div>
                )}
            </div>
        </div>
    );
};

const ContentRenderer = ({
                             content,
                             contentType = 'markdown',
                             baseUrl = '',
                             imageWrapperClass = 'text-center my-4',
                             imageClass = 'img-fluid rounded',
                             maxImageHeight = '400px',
                             fallbackImage = `${process.env.PUBLIC_URL}/fallback-image.png`,
                             theme = 'light',
                             interactive = true,
                             onContentRendered

                         }) => {
    const [collapsedSubsections, setCollapsedSubsections] = useState([]);
    const [collapsedSections, setCollapsedSections] = useState([]);
    const [copiedItems, setCopiedItems] = useState({});
    const [activeTabs, setActiveTabs] = useState({});
    const [flashcardStates, setFlashcardStates] = useState({});
    const [calculatorValues, setCalculatorValues] = useState({});
    const [retryKeys, setRetryKeys] = useState({});

    // Generate unique content key for error boundary recovery
    const contentKey = useMemo(() => {
        if (typeof content === 'string') return content;
        if (Array.isArray(content)) return JSON.stringify(content);
        return uuidv4();
    }, [content]);

    // Notify parent when content is rendered
    useEffect(() => {
        if (onContentRendered) {
            onContentRendered();
        }
    }, [contentKey, onContentRendered]);

    const handleRetryBlock = useCallback((blockId) => {
        setRetryKeys(prev => ({ ...prev, [blockId]: uuidv4() }));
    }, []);

    const isCollapsed = useCallback(
        (index) => collapsedSubsections.includes(index),
        [collapsedSubsections]
    );

    const getDifficultyColor = (difficulty) => {
        const difficultyMap = {
            'beginner': 'success',
            'intermediate': 'warning',
            'advanced': 'danger',
            'expert': 'dark',
            'easy': 'success',
            'medium': 'warning',
            'hard': 'danger'
        };
        return difficultyMap[difficulty.toLowerCase()] || 'primary';
    };

    const toggleCollapse = useCallback(
        (index) => {
            setCollapsedSubsections((prev) =>
                prev.includes(index)
                    ? prev.filter((i) => i !== index)
                    : [...prev, index]
            );
        },
        []
    );

    const handleCopy = useCallback((id) => {
        setCopiedItems((prev) => ({ ...prev, [id]: true }));
        setTimeout(() => {
            setCopiedItems((prev) => ({ ...prev, [id]: false }));
        }, 2000);
    }, []);

    const handleTabChange = useCallback((blockIndex, tabIndex) => {
        setActiveTabs((prev) => ({
            ...prev,
            [blockIndex]: tabIndex
        }));
    }, []);

    const toggleFlashcard = useCallback((blockIndex) => {
        setFlashcardStates((prev) => ({
            ...prev,
            [blockIndex]: !prev[blockIndex]
        }));
    }, []);

    const getStatusBadgeClass = useCallback((status) => {
        const statusMap = {
            new: 'badge-status-new',
            updated: 'badge-status-updated',
            deprecated: 'badge-status-deprecated',
            experimental: 'badge-status-experimental'
        };
        return statusMap[status] || 'bg-secondary';
    }, []);

    const ImageRenderer = React.memo(({ src, alt, title }) => {
        const [imageSrc, setImageSrc] = useState(
            src.startsWith('http') ? src : `${baseUrl}${src}`
        );
        const [loading, setLoading] = useState(true);
        const [error, setError] = useState(false);

        const handleError = useCallback(() => {
            if (!error) {
                setError(true);
                if (imageSrc !== fallbackImage) {
                    setImageSrc(fallbackImage);
                }
            }
        }, [error, imageSrc, fallbackImage]);

        const handleLoad = useCallback(() => {
            setLoading(false);
        }, []);

        return (
            <figure className={`${imageWrapperClass} ${loading ? 'loading' : ''}`}>
                <div className="image-container position-relative">
                    {loading && (
                        <div className="image-loader">
                            <div className="spinner-border text-primary" role="status">
                                <span className="visually-hidden">Loading...</span>
                            </div>
                        </div>
                    )}
                    <img
                        src={imageSrc}
                        alt={alt || ''}
                        className={`${imageClass} ${error ? 'image-error' : ''}`}
                        style={{ maxHeight: maxImageHeight }}
                        loading="lazy"
                        onError={handleError}
                        onLoad={handleLoad}
                    />
                    {interactive && (
                        <div className="image-overlay">
                            <button
                                className="btn btn-sm btn-light"
                                onClick={() => window.open(imageSrc, '_blank')}
                            >
                                <i className="fas fa-expand"></i>
                            </button>
                        </div>
                    )}
                </div>
                {title && <figcaption className="mt-2 text-muted">{title}</figcaption>}
            </figure>
        );
    });

    const markdownComponents = useMemo(() => ({
        code({ node, inline, className, children, ...props }) {
            const match = /language-(\w+)/.exec(className || '');
            const id = uuidv4();

            return !inline && match ? (
                <div className="code-block-wrapper">
                    <div className="code-header d-flex justify-content-between align-items-center">
                        <div className="language-tag">{match[1]}</div>
                        <CopyToClipboard text={String(children).replace(/\n$/, '')} onCopy={() => handleCopy(id)}>
                            <button className="copy-button btn btn-sm btn-outline-secondary">
                                {copiedItems[id] ? (
                                    <><i className="fas fa-check me-1"></i> Copied!</>
                                ) : (
                                    <><i className="fas fa-copy me-1"></i> Copy</>
                                )}
                            </button>
                        </CopyToClipboard>
                    </div>
                    <SyntaxHighlighter
                        style={atomDark}
                        language={match[1]}
                        PreTag="div"
                        showLineNumbers
                        {...props}
                    >
                        {String(children).replace(/\n$/, '')}
                    </SyntaxHighlighter>
                </div>
            ) : (
                <code className={className} {...props}>
                    {children}
                </code>
            );
        },
        table({ children }) {
            return (
                <div className="table-responsive my-3">
                    <table className="table table-striped table-bordered">{children}</table>
                </div>
            );
        },
        img: ImageRenderer,
        math: ({ inline, children }) =>
            inline ? (
                <InlineMath math={children[0]} />
            ) : (
                <div className="math-block">
                    <BlockMath math={children[0]} />
                </div>
            ),
    }), [handleCopy, copiedItems, baseUrl, interactive, ImageRenderer]);

    const renderContent = (content) => (
        <ContentRenderer
            content={content}
            baseUrl={baseUrl}
            imageWrapperClass={imageWrapperClass}
            imageClass={imageClass}
            maxImageHeight={maxImageHeight}
            fallbackImage={fallbackImage}
            theme={theme}
            interactive={interactive}
        />
    );
    // Header Categories Component
    const HeaderCategoriesBlock = ({ block, index }) => {
        const [copied, setCopied] = useState(false);

        const handleCopy = () => {
            let textToCopy = `${block.title}\n\n`;
            block.categories.forEach(category => {
                textToCopy += `${category.category}\n`;
                textToCopy += `Purpose: ${category.purpose}\n`;
                textToCopy += `Headers: ${category.headers.join(', ')}\n\n`;
            });
            navigator.clipboard.writeText(textToCopy);
            setCopied(true);
            setTimeout(() => setCopied(false), 2000);
        };

        return (
            <div className="header-categories-block card my-4">
                <div className="card-header bg-primary bg-opacity-10 border-primary">
                    <div className="d-flex justify-content-between align-items-center">
                        <div className="d-flex align-items-center">
                            <i className="fas fa-heading text-primary me-2"></i>
                            <h5 className="card-title mb-0 text-dark">{block.title}</h5>
                        </div>
                        <button className="btn btn-sm btn-outline-secondary" onClick={handleCopy}>
                            <i className={`fas ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                            {copied ? ' Copied!' : ' Copy'}
                        </button>
                    </div>
                </div>

                <div className="card-body">
                    <div className="header-categories-grid">
                        {block.categories.map((category, categoryIndex) => (
                            <div key={categoryIndex} className="category-item mb-4 p-3 border rounded">
                                <div className="category-header mb-3">
                                    <h6 className="text-primary mb-2">
                                        <i className="fas fa-folder me-2"></i>
                                        {category.category}
                                    </h6>
                                    <div className="category-purpose text-muted small mb-3">
                                        <i className="fas fa-bullseye me-1"></i>
                                        {category.purpose}
                                    </div>
                                </div>

                                <div className="headers-list">
                                    <small className="text-muted d-block mb-2">
                                        <i className="fas fa-list me-1"></i>
                                        Security Headers
                                    </small>
                                    <div className="headers-grid">
                                        {category.headers.map((header, headerIndex) => (
                                            <span key={headerIndex} className="badge bg-primary me-1 mb-1">
                                            {header}
                                        </span>
                                        ))}
                                    </div>
                                </div>
                            </div>
                        ))}
                    </div>

                    {/* Header Importance Comparison */}
                    <div className="importance-section mt-4">
                        <h6 className="text-primary mb-3">
                            <i className="fas fa-chart-bar me-2"></i>
                            Header Importance by Category
                        </h6>
                        <div className="table-responsive">
                            <table className="table table-sm table-bordered">
                                <thead className="table-light">
                                <tr>
                                    <th>Category</th>
                                    <th>Criticality</th>
                                    <th>Implementation Complexity</th>
                                    <th>Browser Support</th>
                                </tr>
                                </thead>
                                <tbody>
                                <tr>
                                    <td><strong>Transport Security</strong></td>
                                    <td>High</td>
                                    <td>Low</td>
                                    <td>Excellent</td>
                                </tr>
                                <tr>
                                    <td><strong>Content Protection</strong></td>
                                    <td>High</td>
                                    <td>Medium</td>
                                    <td>Good</td>
                                </tr>
                                <tr>
                                    <td><strong>Information Control</strong></td>
                                    <td>Medium</td>
                                    <td>Low</td>
                                    <td>Excellent</td>
                                </tr>
                                <tr>
                                    <td><strong>Feature Security</strong></td>
                                    <td>Medium</td>
                                    <td>Medium</td>
                                    <td>Good</td>
                                </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        );
    };

// Header Structure Component
    const HeaderStructureBlock = ({ block, index }) => {
        const [copied, setCopied] = useState(false);

        const handleCopy = () => {
            let textToCopy = `${block.title}\n\n`;
            block.headers.forEach(header => {
                textToCopy += `${header.header}\n`;
                textToCopy += `Purpose: ${header.purpose}\n`;
                textToCopy += `Syntax: ${header.syntax}\n`;
                textToCopy += `Example: ${header.example}\n\n`;
            });
            navigator.clipboard.writeText(textToCopy);
            setCopied(true);
            setTimeout(() => setCopied(false), 2000);
        };

        return (
            <div className="header-structure-block card my-4">
                <div className="card-header bg-success bg-opacity-10 border-success">
                    <div className="d-flex justify-content-between align-items-center">
                        <div className="d-flex align-items-center">
                            <i className="fas fa-code text-success me-2"></i>
                            <h5 className="card-title mb-0 text-dark">{block.title}</h5>
                        </div>
                        <button className="btn btn-sm btn-outline-secondary" onClick={handleCopy}>
                            <i className={`fas ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                            {copied ? ' Copied!' : ' Copy'}
                        </button>
                    </div>
                </div>

                <div className="card-body">
                    <div className="headers-structure-grid">
                        {block.headers.map((header, headerIndex) => (
                            <div key={headerIndex} className="header-item mb-4 p-3 border rounded">
                                <div className="header-name mb-3">
                                    <h6 className="text-success mb-2">
                                        <i className="fas fa-server me-2"></i>
                                        {header.header}
                                    </h6>
                                    <div className="header-purpose text-muted small mb-3">
                                        <i className="fas fa-bullseye me-1"></i>
                                        {header.purpose}
                                    </div>
                                </div>

                                <div className="row">
                                    <div className="col-md-6">
                                        <div className="syntax-section mb-3">
                                            <small className="text-muted d-block mb-2">
                                                <i className="fas fa-terminal me-1"></i>
                                                Syntax
                                            </small>
                                            <div className="syntax-code small bg-success bg-opacity-10 p-2 rounded font-monospace">
                                                {header.syntax}
                                            </div>
                                        </div>
                                    </div>
                                    <div className="col-md-6">
                                        <div className="example-section">
                                            <small className="text-muted d-block mb-2">
                                                <i className="fas fa-play-circle me-1"></i>
                                                Example
                                            </small>
                                            <div className="example-code small bg-light p-2 rounded font-monospace">
                                                {header.example}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        ))}
                    </div>

                    {/* Complete Header Configuration Example */}
                    <div className="complete-configuration mt-4 p-3 bg-light rounded">
                        <h6 className="text-success mb-3">
                            <i className="fas fa-cogs me-2"></i>
                            Complete Security Headers Configuration
                        </h6>
                        <div className="config-example small bg-dark text-light p-3 rounded font-monospace">
                        <pre className="mb-0">
{`# Nginx Configuration Example
server {
    listen 443 ssl http2;
    server_name example.com;
    
    # Security Headers
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Frame-Options "DENY" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
    
    # Content Security Policy
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:;" always;
    
    # Remove sensitive headers
    server_tokens off;
    proxy_hide_header X-Powered-By;
}`}
                        </pre>
                        </div>
                    </div>
                </div>
            </div>
        );
    };

// HTTPS Components Component
    const HttpsComponentsBlock = ({ block, index }) => {
        const [copied, setCopied] = useState(false);

        const handleCopy = () => {
            let textToCopy = `${block.title}\n\n`;
            block.components.forEach(component => {
                textToCopy += `${component.component}\n`;
                textToCopy += `Purpose: ${component.purpose}\n`;
                textToCopy += `Key Points: ${component['key-points'].join(', ')}\n\n`;
            });
            navigator.clipboard.writeText(textToCopy);
            setCopied(true);
            setTimeout(() => setCopied(false), 2000);
        };

        return (
            <div className="https-components-block card my-4">
                <div className="card-header bg-info bg-opacity-10 border-info">
                    <div className="d-flex justify-content-between align-items-center">
                        <div className="d-flex align-items-center">
                            <i className="fas fa-lock text-info me-2"></i>
                            <h5 className="card-title mb-0 text-dark">{block.title}</h5>
                        </div>
                        <button className="btn btn-sm btn-outline-secondary" onClick={handleCopy}>
                            <i className={`fas ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                            {copied ? ' Copied!' : ' Copy'}
                        </button>
                    </div>
                </div>

                <div className="card-body">
                    <div className="https-components-grid">
                        {block.components.map((component, componentIndex) => (
                            <div key={componentIndex} className="component-item mb-4 p-3 border rounded">
                                <div className="component-header mb-3">
                                    <h6 className="text-info mb-2">
                                        <i className="fas fa-puzzle-piece me-2"></i>
                                        {component.component}
                                    </h6>
                                    <div className="component-purpose text-muted small mb-3">
                                        <i className="fas fa-bullseye me-1"></i>
                                        {component.purpose}
                                    </div>
                                </div>

                                <div className="key-points-section">
                                    <small className="text-muted d-block mb-2">
                                        <i className="fas fa-key me-1"></i>
                                        Key Points
                                    </small>
                                    <div className="key-points-list">
                                        {component['key-points'].map((point, pointIndex) => (
                                            <div key={pointIndex} className="point-item small bg-info bg-opacity-10 p-2 rounded mb-1">
                                                • {point}
                                            </div>
                                        ))}
                                    </div>
                                </div>
                            </div>
                        ))}
                    </div>

                    {/* TLS Handshake Visualization */}
                    <div className="handshake-visualization mt-4 p-3 bg-light rounded">
                        <h6 className="text-info mb-3">
                            <i className="fas fa-handshake me-2"></i>
                            TLS Handshake Process
                        </h6>
                        <div className="handshake-steps">
                            <div className="step-item text-center mb-3">
                                <div className="step-number bg-info text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style={{width: '30px', height: '30px'}}>1</div>
                                <small className="text-muted d-block">Client Hello</small>
                                <small>Supported ciphers, TLS version</small>
                            </div>
                            <div className="step-item text-center mb-3">
                                <div className="step-number bg-info text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style={{width: '30px', height: '30px'}}>2</div>
                                <small className="text-muted d-block">Server Hello</small>
                                <small>Selected cipher, certificate</small>
                            </div>
                            <div className="step-item text-center mb-3">
                                <div className="step-number bg-info text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style={{width: '30px', height: '30px'}}>3</div>
                                <small className="text-muted d-block">Key Exchange</small>
                                <small>Pre-master secret exchange</small>
                            </div>
                            <div className="step-item text-center">
                                <div className="step-number bg-info text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-2" style={{width: '30px', height: '30px'}}>4</div>
                                <small className="text-muted d-block">Secure Communication</small>
                                <small>Encrypted data transfer</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        );
    };

// Common HTTPS Issues Component
    const CommonHttpsIssuesBlock = ({ block, index }) => {
        const [copied, setCopied] = useState(false);

        const handleCopy = () => {
            let textToCopy = `${block.title}\n\n`;
            block.issues.forEach(issue => {
                textToCopy += `${issue.issue}\n`;
                textToCopy += `Description: ${issue.description}\n`;
                textToCopy += `Impact: ${issue.impact}\n`;
                textToCopy += `Testing Approach: ${issue['testing-approach']}\n\n`;
            });
            navigator.clipboard.writeText(textToCopy);
            setCopied(true);
            setTimeout(() => setCopied(false), 2000);
        };

        return (
            <div className="common-https-issues-block card my-4">
                <div className="card-header bg-warning bg-opacity-10 border-warning">
                    <div className="d-flex justify-content-between align-items-center">
                        <div className="d-flex align-items-center">
                            <i className="fas fa-exclamation-triangle text-warning me-2"></i>
                            <h5 className="card-title mb-0 text-dark">{block.title}</h5>
                        </div>
                        <button className="btn btn-sm btn-outline-secondary" onClick={handleCopy}>
                            <i className={`fas ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                            {copied ? ' Copied!' : ' Copy'}
                        </button>
                    </div>
                </div>

                <div className="card-body">
                    <div className="https-issues-grid">
                        {block.issues.map((issue, issueIndex) => (
                            <div key={issueIndex} className="issue-item mb-4 p-3 border rounded">
                                <div className="issue-header mb-3">
                                    <div className="d-flex justify-content-between align-items-start">
                                        <h6 className="text-warning mb-0">
                                            <i className="fas fa-bug me-2"></i>
                                            {issue.issue}
                                        </h6>
                                        <span className={`badge ${
                                            issue.impact.includes('High') ? 'bg-danger' :
                                                issue.impact.includes('Medium') ? 'bg-warning' : 'bg-info'
                                        }`}>
                                        {issue.impact}
                                    </span>
                                    </div>
                                    <div className="issue-description text-muted small mt-2">
                                        <i className="fas fa-info-circle me-1"></i>
                                        {issue.description}
                                    </div>
                                </div>

                                <div className="testing-approach-section">
                                    <small className="text-muted d-block mb-2">
                                        <i className="fas fa-search me-1"></i>
                                        Testing Approach
                                    </small>
                                    <div className="testing-approach-text small bg-warning bg-opacity-10 p-2 rounded">
                                        {issue['testing-approach']}
                                    </div>
                                </div>
                            </div>
                        ))}
                    </div>

                    {/* Detection Script Example */}
                    <div className="detection-script mt-4 p-3 bg-light rounded">
                        <h6 className="text-warning mb-3">
                            <i className="fas fa-code me-2"></i>
                            Automated HTTPS Issue Detection Script
                        </h6>
                        <div className="script-code small bg-dark text-light p-3 rounded font-monospace">
                        <pre className="mb-0">
{`#!/bin/bash
# HTTPS Security Check Script

DOMAIN=$1

echo "🔍 Testing HTTPS configuration for: $DOMAIN"
echo "==========================================="

# Check for mixed content
echo "1. Checking for mixed content..."
curl -s "https://$DOMAIN" | grep -E "src=\"http://" && echo "❌ Mixed content detected" || echo "✅ No mixed content"

# Check HSTS header
echo "2. Checking HSTS header..."
curl -s -I "https://$DOMAIN" | grep -i Strict-Transport-Security && echo "✅ HSTS header present" || echo "❌ HSTS header missing"

# Check certificate validity
echo "3. Checking certificate validity..."
openssl s_client -connect "$DOMAIN:443" -servername "$DOMAIN" < /dev/null 2>/dev/null | openssl x509 -noout -dates

# Check for weak ciphers
echo "4. Checking for weak ciphers..."
nmap --script ssl-enum-ciphers -p 443 "$DOMAIN" | grep -E "(\
|TLSv1.0|TLSv1.1|RC4|DES|3DES)" && echo "❌ Weak ciphers detected" || echo "✅ No weak ciphers"

echo "==========================================="
echo "📊 HTTPS Security Check Complete"`}
                        </pre>
                        </div>
                    </div>
                </div>
            </div>
        );
    };

// Practical Commands Component
    const PracticalCommandsBlock = ({ block, index }) => {
        const [copied, setCopied] = useState(false);

        const handleCopy = () => {
            let textToCopy = `${block.title}\n\n`;
            block.examples.forEach(example => {
                textToCopy += `${example.purpose}\n`;
                textToCopy += `Command: ${example.command}\n`;
                textToCopy += `Explanation: ${example.explanation}\n\n`;
            });
            navigator.clipboard.writeText(textToCopy);
            setCopied(true);
            setTimeout(() => setCopied(false), 2000);
        };

        return (
            <div className="practical-commands-block card my-4">
                <div className="card-header bg-success bg-opacity-10 border-success">
                    <div className="d-flex justify-content-between align-items-center">
                        <div className="d-flex align-items-center">
                            <i className="fas fa-terminal text-success me-2"></i>
                            <h5 className="card-title mb-0 text-dark">{block.title}</h5>
                        </div>
                        <button className="btn btn-sm btn-outline-secondary" onClick={handleCopy}>
                            <i className={`fas ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                            {copied ? ' Copied!' : ' Copy'}
                        </button>
                    </div>
                </div>

                <div className="card-body">
                    <div className="command-examples">
                        {block.examples.map((example, exampleIndex) => (
                            <div key={exampleIndex} className="command-item mb-4 p-3 border rounded">
                                <div className="command-purpose mb-3">
                                    <h6 className="text-success mb-2">
                                        <i className="fas fa-bullseye me-2"></i>
                                        {example.purpose}
                                    </h6>
                                </div>

                                <div className="row">
                                    <div className="col-md-6">
                                        <div className="command-section mb-3">
                                            <small className="text-muted d-block mb-2">
                                                <i className="fas fa-code me-1"></i>
                                                Command
                                            </small>
                                            <div className="command-code small bg-dark text-light p-2 rounded font-monospace">
                                                <pre className="mb-0">{example.command}</pre>
                                            </div>
                                        </div>
                                    </div>
                                    <div className="col-md-6">
                                        <div className="explanation-section">
                                            <small className="text-muted d-block mb-2">
                                                <i className="fas fa-info-circle me-1"></i>
                                                Explanation
                                            </small>
                                            <div className="explanation-text small bg-success bg-opacity-10 p-2 rounded">
                                                {example.explanation}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        ))}
                    </div>

                    {/* Quick Reference Table */}
                    <div className="quick-reference mt-4">
                        <h6 className="text-success mb-3">
                            <i className="fas fa-bookmark me-2"></i>
                            Command Quick Reference
                        </h6>
                        <div className="table-responsive">
                            <table className="table table-sm table-bordered">
                                <thead className="table-light">
                                <tr>
                                    <th>Purpose</th>
                                    <th>Tool</th>
                                    <th>Key Command</th>
                                </tr>
                                </thead>
                                <tbody>
                                <tr>
                                    <td>Check Headers</td>
                                    <td>curl</td>
                                    <td><code>curl -I https://example.com</code></td>
                                </tr>
                                <tr>
                                    <td>Certificate Info</td>
                                    <td>openssl</td>
                                    <td><code>openssl s_client -connect example.com:443</code></td>
                                </tr>
                                <tr>
                                    <td>TLS Ciphers</td>
                                    <td>nmap</td>
                                    <td><code>nmap --script ssl-enum-ciphers -p 443</code></td>
                                </tr>
                                <tr>
                                    <td>Full Analysis</td>
                                    <td>TestSSL.sh</td>
                                    <td><code>./testssl.sh example.com</code></td>
                                </tr>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        );
    };

// Reporting Template Component
    const ReportingTemplateBlock = ({ block, index }) => {
        const [copied, setCopied] = useState(false);

        const handleCopy = () => {
            let textToCopy = `${block.title}\n\n`;
            block.sections.forEach(section => {
                textToCopy += `${section.section}\n`;
                if (Array.isArray(section.content)) {
                    section.content.forEach(finding => {
                        textToCopy += `  ${finding.finding}\n`;
                        textToCopy += `  Risk: ${finding.risk}\n`;
                        textToCopy += `  Description: ${finding.description}\n`;
                        textToCopy += `  Proof: ${finding.proof}\n`;
                        textToCopy += `  Remediation: ${finding.remediation}\n\n`;
                    });
                } else {
                    textToCopy += `${section.content}\n\n`;
                }
            });
            navigator.clipboard.writeText(textToCopy);
            setCopied(true);
            setTimeout(() => setCopied(false), 2000);
        };

        return (
            <div className="reporting-template-block card my-4">
                <div className="card-header bg-primary bg-opacity-10 border-primary">
                    <div className="d-flex justify-content-between align-items-center">
                        <div className="d-flex align-items-center">
                            <i className="fas fa-file-alt text-primary me-2"></i>
                            <h5 className="card-title mb-0 text-dark">{block.title}</h5>
                        </div>
                        <button className="btn btn-sm btn-outline-secondary" onClick={handleCopy}>
                            <i className={`fas ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                            {copied ? ' Copied!' : ' Copy'}
                        </button>
                    </div>
                </div>

                <div className="card-body">
                    <div className="report-sections">
                        {block.sections.map((section, sectionIndex) => (
                            <div key={sectionIndex} className="section-item mb-4 p-3 border rounded">
                                <div className="section-header mb-3">
                                    <h6 className="text-primary mb-2">
                                        <i className="fas fa-file me-2"></i>
                                        {section.section}
                                    </h6>
                                </div>

                                {Array.isArray(section.content) ? (
                                    <div className="findings-list">
                                        {section.content.map((finding, findingIndex) => (
                                            <div key={findingIndex} className="finding-item mb-3 p-3 bg-light rounded">
                                                <div className="finding-header mb-2">
                                                    <div className="d-flex justify-content-between align-items-start">
                                                        <h6 className="text-dark mb-1">{finding.finding}</h6>
                                                        <span className={`badge ${
                                                            finding.risk === 'High' ? 'bg-danger' :
                                                                finding.risk === 'Medium' ? 'bg-warning' : 'bg-info'
                                                        }`}>
                                                        {finding.risk}
                                                    </span>
                                                    </div>
                                                </div>

                                                <div className="row">
                                                    <div className="col-md-6">
                                                        <div className="description-section mb-2">
                                                            <small className="text-muted d-block mb-1">
                                                                <i className="fas fa-info-circle me-1"></i>
                                                                Description
                                                            </small>
                                                            <div className="description-text small">
                                                                {finding.description}
                                                            </div>
                                                        </div>
                                                    </div>
                                                    <div className="col-md-6">
                                                        <div className="proof-section mb-2">
                                                            <small className="text-muted d-block mb-1">
                                                                <i className="fas fa-camera me-1"></i>
                                                                Proof
                                                            </small>
                                                            <div className="proof-text small bg-warning bg-opacity-10 p-1 rounded">
                                                                {finding.proof}
                                                            </div>
                                                        </div>
                                                    </div>
                                                </div>

                                                <div className="remediation-section mt-2">
                                                    <small className="text-muted d-block mb-1">
                                                        <i className="fas fa-wrench me-1"></i>
                                                        Remediation
                                                    </small>
                                                    <div className="remediation-text small bg-success bg-opacity-10 p-2 rounded text-success">
                                                        {finding.remediation}
                                                    </div>
                                                </div>
                                            </div>
                                        ))}
                                    </div>
                                ) : (
                                    <div className="section-content">
                                        <div className="content-text small bg-primary bg-opacity-10 p-3 rounded">
                                            {section.content}
                                        </div>
                                    </div>
                                )}
                            </div>
                        ))}
                    </div>
                </div>
            </div>
        );
    };
    // Recruiter Perspective Component
    const RecruiterPerspectiveBlock = ({ block, index }) => {
        const [copied, setCopied] = useState(false);

        const handleCopy = () => {
            let textToCopy = `${block.title}\n\n`;
            block['search-patterns'].forEach(pattern => {
                textToCopy += `${pattern['search-type']}\n`;
                textToCopy += `Common Terms/Queries: ${pattern['common-terms'] ? pattern['common-terms'].join(', ') : pattern['common-queries'].join(', ')}\n`;
                textToCopy += `Optimization Strategy: ${pattern['optimization-strategy']}\n`;
                textToCopy += `Example: ${pattern.example}\n\n`;
            });
            navigator.clipboard.writeText(textToCopy);
            setCopied(true);
            setTimeout(() => setCopied(false), 2000);
        };

        return (
            <div className="recruiter-perspective-block card my-4">
                <div className="card-header bg-primary bg-opacity-10 border-primary">
                    <div className="d-flex justify-content-between align-items-center">
                        <div className="d-flex align-items-center">
                            <i className="fas fa-search text-primary me-2"></i>
                            <h5 className="card-title mb-0 text-dark">{block.title}</h5>
                        </div>
                        <button className="btn btn-sm btn-outline-secondary" onClick={handleCopy}>
                            <i className={`fas ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                            {copied ? ' Copied!' : ' Copy'}
                        </button>
                    </div>
                </div>

                <div className="card-body">
                    <div className="search-patterns">
                        {block['search-patterns'].map((pattern, patternIndex) => (
                            <div key={patternIndex} className="pattern-item mb-4 p-3 border rounded">
                                <div className="pattern-header mb-3">
                                    <h6 className="text-primary mb-2">
                                        <i className="fas fa-binoculars me-2"></i>
                                        {pattern['search-type']}
                                    </h6>
                                </div>

                                <div className="row">
                                    <div className="col-md-4">
                                        <div className="terms-section mb-3">
                                            <small className="text-muted d-block mb-2">
                                                <i className="fas fa-key me-1"></i>
                                                {pattern['common-terms'] ? 'Common Terms' : 'Common Queries'}
                                            </small>
                                            <div className="terms-list">
                                                {(pattern['common-terms'] || pattern['common-queries']).map((term, termIndex) => (
                                                    <div key={termIndex} className="term-item small bg-primary bg-opacity-10 p-2 rounded mb-1">
                                                        • {term}
                                                    </div>
                                                ))}
                                            </div>
                                        </div>
                                    </div>
                                    <div className="col-md-4">
                                        <div className="strategy-section mb-3">
                                            <small className="text-muted d-block mb-2">
                                                <i className="fas fa-chess me-1"></i>
                                                Optimization Strategy
                                            </small>
                                            <div className="strategy-text small bg-success bg-opacity-10 p-2 rounded text-success">
                                                {pattern['optimization-strategy']}
                                            </div>
                                        </div>
                                    </div>
                                    <div className="col-md-4">
                                        <div className="example-section">
                                            <small className="text-muted d-block mb-2">
                                                <i className="fas fa-eye me-1"></i>
                                                Example
                                            </small>
                                            <div className="example-text small bg-warning bg-opacity-10 p-2 rounded">
                                                {pattern.example}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        ))}
                    </div>
                </div>
            </div>
        );
    };

// Headline Optimization Component
