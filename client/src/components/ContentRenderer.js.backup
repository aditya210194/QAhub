                                    {step.activities.map((activity, activityIndex) => (
                                        <div key={activityIndex} className="activity-item small bg-info bg-opacity-10 p-2 rounded mb-1">
                                            • {activity}
                                        </div>
                                    ))}
                                </div>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    );
};

