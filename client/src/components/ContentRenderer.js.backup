                                            <i className="fas fa-users me-1"></i>
                                            Responsibilities
                                        </small>
                                        <div className="responsibilities-list">
                                            {state.responsibilities.map((responsibility, respIndex) => (
                                                <div key={respIndex} className="responsibility-item small bg-primary bg-opacity-10 p-2 rounded mb-1">
                                                    • {responsibility}
                                                </div>
                                            ))}
                                        </div>
                                    </div>
                                </div>
                                <div className="col-md-3">
                                    <div className="sla-section mb-3">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-clock me-1"></i>
                                            SLA
                                        </small>
