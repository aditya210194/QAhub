                                <th>Feature</th>
                                <th className="bg-info text-white">Zephyr</th>
                                <th className="bg-warning text-dark">Xray</th>
                                <th className="bg-success text-white">Recommendation</th>
                            </tr>
                            </thead>
                            <tbody>
                            {block.comparison.map((comparison, comparisonIndex) => (
                                <tr key={comparisonIndex}>
                                    <td><strong>{comparison.feature}</strong></td>
                                    <td className="bg-info bg-opacity-10">{comparison.zephyr}</td>
                                    <td className="bg-warning bg-opacity-10">{comparison.xray}</td>
                                    <td className="bg-success bg-opacity-10">{comparison.recommendation}</td>
                                </tr>
                            ))}
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    );
};

