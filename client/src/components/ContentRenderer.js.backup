                                            <i className="fas fa-tasks me-1"></i>
                                            Key Activities
                                        </h6>
                                        <div className="activities-list">
                                            {phase.activities.slice(0, expanded ? phase.activities.length : 3).map((activity, actIndex) => (
                                                <div key={actIndex} className="activity-item small mb-1">
                                                    • {activity}
                                                </div>
                                            ))}
                                            {!expanded && phase.activities.length > 3 && (
                                                <div className="more-items small text-primary">
                                                    +{phase.activities.length - 3} more...
                                                </div>
                                            )}
                                        </div>
                                    </div>
                                </div>
                                <div className="col-md-6">
                                    <div className="criteria-section">
                                        <h6 className="small text-muted mb-2">
                                            <i className="fas fa-check-circle me-1"></i>
                                            Success Criteria
                                        </h6>
                                        <div className="criteria-list">
