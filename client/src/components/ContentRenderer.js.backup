                {/* Metrics Dashboard Example */}
                <div className="metrics-dashboard mt-4 p-3 bg-light rounded">
                    <h6 className="text-primary mb-3">
                        <i className="fas fa-tachometer-alt me-2"></i>
                        Sample Quality Dashboard
                    </h6>
                    <div className="dashboard-metrics row text-center">
                        <div className="col-md-3">
                            <div className="metric-card p-2">
                                <div className="metric-value text-success mb-1">95%</div>
                                <small className="text-muted">Test Coverage</small>
                            </div>
                        </div>
                        <div className="col-md-3">
                            <div className="metric-card p-2">
                                <div className="metric-value text-warning mb-1">0.4</div>
                                <small className="text-muted">Defect Density</small>
                            </div>
                        </div>
                        <div className="col-md-3">
                            <div className="metric-card p-2">
                                <div className="metric-value text-info mb-1">87%</div>
                                <small className="text-muted">Automation Rate</small>
                            </div>
                        </div>
                        <div className="col-md-3">
                            <div className="metric-card p-2">
                                <div className="metric-value text-danger mb-1">1.2%</div>
                                <small className="text-muted">Defect Leakage</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    );
};

// Stakeholder Reports Component
const StakeholderReportsBlock = ({ block, index }) => {
    const [copied, setCopied] = useState(false);

    const handleCopy = () => {
        let textToCopy = `${block.title}\n\n`;
        block.reports.forEach(report => {
            textToCopy += `${report.audience}\n`;
            textToCopy += `Frequency: ${report.frequency}\n`;
            textToCopy += `Content: ${report.content.join(', ')}\n`;
            textToCopy += `Format: ${report.format}\n\n`;
        });
        navigator.clipboard.writeText(textToCopy);
        setCopied(true);
        setTimeout(() => setCopied(false), 2000);
    };

    return (
        <div className="stakeholder-reports-block card my-4">
            <div className="card-header bg-success bg-opacity-10 border-success">
                <div className="d-flex justify-content-between align-items-center">
                    <div className="d-flex align-items-center">
                        <i className="fas fa-chart-pie text-success me-2"></i>
                        <h5 className="card-title mb-0 text-dark">{block.title}</h5>
                    </div>
                    <button className="btn btn-sm btn-outline-secondary" onClick={handleCopy}>
                        <i className={`fas ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                        {copied ? ' Copied!' : ' Copy'}
                    </button>
                </div>
            </div>

            <div className="card-body">
                <div className="stakeholder-reports">
                    {block.reports.map((report, reportIndex) => (
                        <div key={reportIndex} className="report-item mb-4 p-3 border rounded">
                            <div className="report-header mb-3">
                                <h6 className="text-success mb-2">
                                    <i className="fas fa-user-tie me-2"></i>
                                    {report.audience}
                                </h6>
                                <div className="report-frequency text-muted small mb-3">
                                    <i className="fas fa-calendar me-1"></i>
                                    Frequency: {report.frequency}
                                </div>
                            </div>

                            <div className="row">
                                <div className="col-md-6">
                                    <div className="content-section mb-3">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-file-alt me-1"></i>
                                            Report Content
                                        </small>
                                        <div className="content-list">
                                            {report.content.map((item, itemIndex) => (
                                                <div key={itemIndex} className="content-item small bg-success bg-opacity-10 p-2 rounded mb-1">
                                                    • {item}
                                                </div>
                                            ))}
                                        </div>
                                    </div>
                                </div>
                                <div className="col-md-6">
                                    <div className="format-section">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-palette me-1"></i>
                                            Report Format
                                        </small>
                                        <div className="format-text small">
                                            {report.format}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    );
};

// Test Summary Component
const TestSummaryBlock = ({ block, index }) => {
    const [copied, setCopied] = useState(false);

    const handleCopy = () => {
        let textToCopy = `${block.title}\n\n`;
        block.sections.forEach(section => {
            textToCopy += `${section.section}\n`;
            textToCopy += `Content: ${section.content}\n\n`;
        });
        navigator.clipboard.writeText(textToCopy);
        setCopied(true);
        setTimeout(() => setCopied(false), 2000);
    };

    return (
        <div className="test-summary-block card my-4">
            <div className="card-header bg-warning bg-opacity-10 border-warning">
                <div className="d-flex justify-content-between align-items-center">
                    <div className="d-flex align-items-center">
                        <i className="fas fa-file-contract text-warning me-2"></i>
                        <h5 className="card-title mb-0 text-dark">{block.title}</h5>
                    </div>
                    <button className="btn btn-sm btn-outline-secondary" onClick={handleCopy}>
                        <i className={`fas ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                        {copied ? ' Copied!' : ' Copy'}
                    </button>
                </div>
            </div>

            <div className="card-body">
                <div className="summary-sections">
                    {block.sections.map((section, sectionIndex) => (
                        <div key={sectionIndex} className="section-item mb-4 p-3 border rounded">
                            <div className="section-header mb-3">
                                <h6 className="text-warning mb-2">
                                    <i className="fas fa-file me-2"></i>
                                    {section.section}
                                </h6>
                            </div>

                            <div className="section-content">
                                <div className="content-text small bg-warning bg-opacity-10 p-3 rounded">
                                    {section.content}
                                </div>
                            </div>
                        </div>
                    ))}
                </div>

                {/* Release Recommendation Matrix */}
                <div className="recommendation-matrix mt-4 p-3 bg-light rounded">
                    <h6 className="text-warning mb-3">
                        <i className="fas fa-check-circle me-2"></i>
                        Release Recommendation Criteria
                    </h6>
                    <div className="table-responsive">
                        <table className="table table-sm table-bordered">
                            <thead className="table-light">
                            <tr>
                                <th>Criteria</th>
                                <th>Go</th>
                                <th>Conditional Go</th>
                                <th>No Go</th>
                            </tr>
                            </thead>
                            <tbody>
                            <tr>
                                <td><strong>Critical Defects</strong></td>
                                <td className="bg-success text-white">0 Open</td>
                                <td className="bg-warning">0-2 Open (with workarounds)</td>
                                <td className="bg-danger text-white">>2 Open</td>
                            </tr>
                            <tr>
                                <td><strong>Test Coverage</strong></td>
                                <td className="bg-success text-white">≥ 95%</td>
                                <td className="bg-warning">90-94%</td>
                                <td className="bg-danger text-white">&lt; 90%</td>
                            </tr>
                            <tr>
                                <td><strong>Automation Pass Rate</strong></td>
                                <td className="bg-success text-white">≥ 98%</td>
                                <td className="bg-warning">95-97%</td>
                                <td className="bg-danger text-white">&lt; 95%</td>
                            </tr>
                            <tr>
                                <td><strong>Performance SLAs</strong></td>
                                <td className="bg-success text-white">All Met</td>
                                <td className="bg-warning">Minor Deviations</td>
                                <td className="bg-danger text-white">Major Failures</td>
                            </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    );
};

// Action Plan Component
const ActionPlanBlock = ({ block, index }) => {
    const [completedSteps, setCompletedSteps] = useState({});

    const toggleStep = (stepIndex) => {
        setCompletedSteps(prev => ({
            ...prev,
            [stepIndex]: !prev[stepIndex]
        }));
    };

    return (
        <div className="action-plan-block card my-4 border-success border-opacity-25">
            <div className="card-header bg-success bg-opacity-10 border-success">
                <div className="d-flex align-items-center">
                    <i className="fas fa-list-check text-success me-2"></i>
                    <h5 className="card-title mb-0 text-dark">Action Plan</h5>
                </div>
            </div>

            <div className="card-body">
                <div className="action-steps">
                    {block.steps.map((step, stepIndex) => {
                        const isCompleted = completedSteps[stepIndex] || false;

                        return (
                            <div key={stepIndex} className="action-step card mb-3">
                                <div className="card-body">
                                    <div className="d-flex justify-content-between align-items-start mb-3">
                                        <div className="flex-grow-1">
                                            <div className="d-flex align-items-center mb-2">
                                                <span className="step-number badge bg-primary me-3">
                                                    {stepIndex + 1}
                                                </span>
                                                <h6 className={`mb-0 ${isCompleted ? 'text-muted text-decoration-line-through' : 'text-dark'}`}>
                                                    {step.step}
                                                </h6>
                                            </div>

                                            <div className="step-duration mb-2">
                                                <small className="text-muted">
                                                    <i className="fas fa-clock me-1"></i>
                                                    Duration: {step.duration}
                                                </small>
                                            </div>
                                        </div>

                                        <div className="step-actions">
                                            <button
                                                className={`btn btn-sm ${isCompleted ? 'btn-outline-success' : 'btn-outline-secondary'}`}
                                                onClick={() => toggleStep(stepIndex)}
                                            >
                                                <i className={`fas ${isCompleted ? 'fa-check' : 'fa-square'}`}></i>
                                                {isCompleted ? ' Completed' : ' Mark Complete'}
                                            </button>
                                        </div>
                                    </div>

                                    <div className="step-details">
                                        <div className="activities mb-3">
                                            <small className="text-muted d-block mb-2">
                                                <i className="fas fa-tasks me-1"></i>
                                                Key Activities
                                            </small>
                                            <ul className="small mb-0">
                                                {step.activities.map((activity, activityIndex) => (
                                                    <li key={activityIndex}>{activity}</li>
                                                ))}
                                            </ul>
                                        </div>

                                        <div className="resources">
                                            <small className="text-muted d-block mb-2">
                                                <i className="fas fa-toolbox me-1"></i>
                                                Resources Needed
                                            </small>
                                            <div className="resources-list">
                                                {step.resources.map((resource, resourceIndex) => (
                                                    <span key={resourceIndex} className="badge bg-light text-dark border me-1 mb-1">
                                                        {resource}
                                                    </span>
                                                ))}
                                            </div>
                                        </div>
                                    </div>

                                    <div className="step-outcome mt-3 p-2 bg-light rounded">
                                        <small className="text-muted d-block mb-1">
                                            <i className="fas fa-bullseye me-1"></i>
                                            Expected Outcome
                                        </small>
                                        <p className="small mb-0">{step.outcome}</p>
                                    </div>
                                </div>
                            </div>
                        );
                    })}
                </div>

                {/* Progress Summary */}
                <div className="action-plan-progress mt-4 p-3 bg-success bg-opacity-10 rounded">
                    <h6 className="text-success mb-3">
                        <i className="fas fa-chart-line me-2"></i>
                        Implementation Progress
                    </h6>
                    <div className="progress mb-2" style={{height: '20px'}}>
                        <div
                            className="progress-bar bg-success"
                            style={{
                                width: `${(Object.values(completedSteps).filter(Boolean).length / block.steps.length) * 100}%`
                            }}
                        >
                            {Math.round((Object.values(completedSteps).filter(Boolean).length / block.steps.length) * 100)}%
                        </div>
                    </div>
                    <small className="text-muted">
                        {Object.values(completedSteps).filter(Boolean).length} of {block.steps.length} steps completed
                    </small>
                </div>
            </div>
        </div>
    );
};

// Quick Wins Component
const QuickWinsBlock = ({ block, index }) => {
    return (
        <div className="quick-wins-block card my-4 border-warning border-opacity-25">
            <div className="card-header bg-warning bg-opacity-10 border-warning">
                <div className="d-flex align-items-center">
                    <i className="fas fa-bolt text-warning me-2"></i>
                    <h5 className="card-title mb-0 text-dark">{block.title}</h5>
                </div>
            </div>

            <div className="card-body">
                <div className="quick-wins-grid">
                    {block.opportunities.map((opportunity, oppIndex) => (
                        <div key={oppIndex} className="quick-win-item card mb-3">
                            <div className="card-body">
                                <div className="d-flex justify-content-between align-items-start mb-3">
                                    <h6 className="text-success mb-0">{opportunity.opportunity}</h6>
                                    <span className={`badge bg-${opportunity['effort-level'] === 'Low' ? 'success' : 'warning'}`}>
                                        {opportunity['effort-level']} Effort
                                    </span>
                                </div>

                                <div className="quick-win-details">
                                    <div className="approach mb-3">
                                        <small className="text-muted d-block mb-1">
                                            <i className="fas fa-play-circle me-1 text-primary"></i>
                                            Approach
                                        </small>
                                        <p className="small mb-0">{opportunity.approach}</p>
                                    </div>

                                    <div className="expected-benefit">
                                        <small className="text-muted d-block mb-1">
                                            <i className="fas fa-gift me-1 text-success"></i>
                                            Expected Benefit
                                        </small>
                                        <p className="small mb-0 text-success">{opportunity['expected-benefit']}</p>
                                    </div>
                                </div>

                                <div className="implementation-tips mt-3 p-2 bg-light rounded">
                                    <small className="text-muted d-block mb-1">
                                        <i className="fas fa-lightbulb me-1 text-warning"></i>
                                        Quick Start Tips
                                    </small>
                                    <ul className="small mb-0">
                                        <li>Start with a small, well-defined scope</li>
                                        <li>Involve key stakeholders early</li>
                                        <li>Measure before and after results</li>
                                        <li>Document lessons learned for scaling</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    ))}
                </div>

                <div className="quick-wins-summary mt-4 p-3 bg-warning bg-opacity-10 rounded">
                    <h6 className="text-warning mb-3">
                        <i className="fas fa-rocket me-2"></i>
                        Quick Wins Strategy
                    </h6>
                    <div className="row text-center">
                        <div className="col-md-4 mb-3">
                            <div className="summary-item">
                                <div className="number text-warning h4 mb-1">
                                    {block.opportunities.filter(o => o['effort-level'] === 'Low').length}
                                </div>
                                <small className="text-muted">Low Effort Opportunities</small>
                            </div>
                        </div>
                        <div className="col-md-4 mb-3">
                            <div className="summary-item">
                                <div className="number text-warning h4 mb-1">2-4</div>
                                <small className="text-muted">Weeks to Implement</small>
                            </div>
                        </div>
                        <div className="col-md-4 mb-3">
                            <div className="summary-item">
                                <div className="number text-warning h4 mb-1">Immediate</div>
                                <small className="text-muted">Value Delivery</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    );
};
const DesignPrinciplesBlock = ({ block, index }) => {
    const [expanded, setExpanded] = useState(false);
    const [copied, setCopied] = useState(false);

    const handleCopy = () => {
        let textToCopy = "Design Principles\n\n";
        block.principles.forEach(principle => {
            textToCopy += `${principle.principle}\n`;
            textToCopy += `Description: ${principle.description}\n`;
            textToCopy += `Implementation: ${principle.implementation}\n\n`;
        });
        navigator.clipboard.writeText(textToCopy);
        setCopied(true);
        setTimeout(() => setCopied(false), 2000);
    };

    const toggleExpand = () => {
        setExpanded(!expanded);
    };

    return (
        <div className="design-principles-block card my-4">
            <div className="card-header bg-success bg-opacity-10 border-success">
                <div className="d-flex justify-content-between align-items-center">
                    <div className="d-flex align-items-center">
                        <i className="fas fa-pencil-ruler text-success me-2"></i>
                        <h5 className="card-title mb-0 text-dark">Design Principles</h5>
                    </div>
                    <div className="principles-actions">
                        <button className="btn btn-sm btn-outline-secondary me-2" onClick={handleCopy}>
                            <i className={`fas ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                            {copied ? ' Copied!' : ' Copy'}
                        </button>
                        <button className="btn btn-sm btn-outline-primary" onClick={toggleExpand}>
                            <i className={`fas fa-${expanded ? 'minus' : 'plus'}`}></i>
                            {expanded ? ' Less' : ' More'}
                        </button>
                    </div>
                </div>
            </div>

            <div className="card-body">
                <div className="principles-grid">
                    {block.principles.map((principle, principleIndex) => (
                        <div key={principleIndex} className="principle-item mb-4 p-3 border rounded">
                            <div className="principle-header mb-3">
                                <h6 className="text-success mb-2">
                                    <i className="fas fa-star me-2"></i>
                                    {principle.principle}
                                </h6>
                                <div className="principle-description text-muted mb-2">
                                    <small>
                                        <i className="fas fa-info-circle me-1"></i>
                                        {principle.description}
                                    </small>
                                </div>
                            </div>

                            <div className="implementation-section">
                                <small className="text-muted d-block mb-2">
                                    <i className="fas fa-cogs me-1"></i>
                                    Implementation
                                </small>
                                <div className="implementation-text small bg-light p-2 rounded">
                                    {principle.implementation}
                                </div>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    );
};
const TestDesignTechniquesBlock = ({ block, index }) => {
    const [expanded, setExpanded] = useState(false);
    const [copied, setCopied] = useState(false);

    const handleCopy = () => {
        let textToCopy = `${block.title}\n\n`;
        block.techniques.forEach(technique => {
            textToCopy += `${technique.technique}\n`;
            textToCopy += `Purpose: ${technique.purpose}\n`;
            textToCopy += `Effectiveness: ${technique.effectiveness}\n\n`;
        });
        navigator.clipboard.writeText(textToCopy);
        setCopied(true);
        setTimeout(() => setCopied(false), 2000);
    };

    const toggleExpand = () => {
        setExpanded(!expanded);
    };

    const getEffectivenessColor = (effectiveness) => {
        const effectivenessMap = {
            'Very high': 'success',
            'High': 'info',
            'Medium': 'warning',
            'Low': 'secondary'
        };
        return effectivenessMap[effectiveness] || 'secondary';
    };

    return (
        <div className="test-design-techniques-block card my-4">
            <div className="card-header bg-info bg-opacity-10 border-info">
                <div className="d-flex justify-content-between align-items-center">
                    <div className="d-flex align-items-center">
                        <i className="fas fa-vial text-info me-2"></i>
                        <h5 className="card-title mb-0 text-dark">{block.title}</h5>
                    </div>
                    <div className="techniques-actions">
                        <button className="btn btn-sm btn-outline-secondary me-2" onClick={handleCopy}>
                            <i className={`fas ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                            {copied ? ' Copied!' : ' Copy'}
                        </button>
                        <button className="btn btn-sm btn-outline-primary" onClick={toggleExpand}>
                            <i className={`fas fa-${expanded ? 'minus' : 'plus'}`}></i>
                            {expanded ? ' Less' : ' More'}
                        </button>
                    </div>
                </div>
            </div>

            <div className="card-body">
                <div className="techniques-grid">
                    {block.techniques.map((technique, techIndex) => (
                        <div key={techIndex} className="technique-item mb-4 p-3 border rounded">
                            <div className="technique-header d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <h6 className="text-info mb-1">
                                        <i className="fas fa-flask me-2"></i>
                                        {technique.technique}
                                    </h6>
                                    <div className="technique-purpose text-muted small">
                                        <i className="fas fa-bullseye me-1"></i>
                                        {technique.purpose}
                                    </div>
                                </div>
                                <span className={`badge bg-${getEffectivenessColor(technique.effectiveness)}`}>
                                    {technique.effectiveness}
                                </span>
                            </div>

                            {/* Additional details when expanded */}
                            {expanded && (
                                <div className="technique-details mt-3 p-2 bg-light rounded">
                                    <small className="text-muted">
                                        <i className="fas fa-lightbulb me-1"></i>
                                        Best suited for: Functional testing, Input validation
                                    </small>
                                </div>
                            )}
                        </div>
                    ))}
                </div>
            </div>
        </div>
    );
};
// POI Architecture Component
const PoiArchitectureBlock = ({ block, index }) => {
    const [copied, setCopied] = useState(false);

    const handleCopy = () => {
        let textToCopy = "Apache POI Architecture\n\n";
        block.components.forEach(component => {
            textToCopy += `${component.component}\n`;
            textToCopy += `Description: ${component.description}\n`;
            textToCopy += `Classes: ${component.classes.join(', ')}\n`;
            if (component.limitations) {
                textToCopy += `Limitations: ${component.limitations}\n`;
            }
            if (component.advantages) {
                textToCopy += `Advantages: ${component.advantages}\n`;
            }
            textToCopy += '\n';
        });
        navigator.clipboard.writeText(textToCopy);
        setCopied(true);
        setTimeout(() => setCopied(false), 2000);
    };

    return (
        <div className="poi-architecture-block card my-4">
            <div className="card-header bg-primary bg-opacity-10 border-primary">
                <div className="d-flex justify-content-between align-items-center">
                    <div className="d-flex align-items-center">
                        <i className="fas fa-archway text-primary me-2"></i>
                        <h5 className="card-title mb-0 text-dark">Apache POI Architecture</h5>
                    </div>
                    <button className="btn btn-sm btn-outline-secondary" onClick={handleCopy}>
                        <i className={`fas ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                        {copied ? ' Copied!' : ' Copy'}
                    </button>
                </div>
            </div>

            <div className="card-body">
                <div className="poi-components-grid">
                    {block.components.map((component, componentIndex) => (
                        <div key={componentIndex} className="poi-component-item mb-4 p-3 border rounded">
                            <div className="component-header mb-3">
                                <div className="d-flex justify-content-between align-items-start mb-2">
                                    <h6 className="text-primary mb-0">
                                        <i className="fas fa-cube me-2"></i>
                                        {component.component}
                                    </h6>
                                    <div className="component-badges">
                                        {component.component === 'HSSF' && (
                                            <span className="badge bg-secondary">Legacy</span>
                                        )}
                                        {component.component === 'XSSF' && (
                                            <span className="badge bg-success">Modern</span>
                                        )}
                                        {component.component === 'SXSSF' && (
                                            <span className="badge bg-info">Streaming</span>
                                        )}
                                    </div>
                                </div>
                                <div className="component-description text-muted small">
                                    <i className="fas fa-info-circle me-1"></i>
                                    {component.description}
                                </div>
                            </div>

                            <div className="row">
                                <div className="col-md-6">
                                    <div className="classes-section mb-3">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-code me-1"></i>
                                            Key Classes
                                        </small>
                                        <div className="classes-list">
                                            {component.classes.map((className, classIndex) => (
                                                <div key={classIndex} className="class-item small bg-light p-2 rounded mb-1 font-monospace">
                                                    {className}
                                                </div>
                                            ))}
                                        </div>
                                    </div>
                                </div>

                                <div className="col-md-6">
                                    {component.limitations && (
                                        <div className="limitations-section mb-3">
                                            <small className="text-muted d-block mb-2">
                                                <i className="fas fa-exclamation-triangle text-warning me-1"></i>
                                                Limitations
                                            </small>
                                            <div className="limitations-text small bg-warning bg-opacity-10 p-2 rounded text-warning">
                                                {component.limitations}
                                            </div>
                                        </div>
                                    )}

                                    {component.advantages && (
                                        <div className="advantages-section">
                                            <small className="text-muted d-block mb-2">
                                                <i className="fas fa-check-circle text-success me-1"></i>
                                                Advantages
                                            </small>
                                            <div className="advantages-text small bg-success bg-opacity-10 p-2 rounded text-success">
                                                {component.advantages}
                                            </div>
                                        </div>
                                    )}
                                </div>
                            </div>

                            {/* Format-specific information */}
                            {component.component === 'HSSF' && (
                                <div className="format-info mt-3 p-2 bg-secondary bg-opacity-10 rounded">
                                    <small className="text-muted">
                                        <i className="fas fa-file-excel me-1"></i>
                                        Format: .xls (Excel 97-2003)
                                    </small>
                                </div>
                            )}

                            {component.component === 'XSSF' && (
                                <div className="format-info mt-3 p-2 bg-success bg-opacity-10 rounded">
                                    <small className="text-muted">
                                        <i className="fas fa-file-excel me-1"></i>
                                        Format: .xlsx (Excel 2007+)
                                    </small>
                                </div>
                            )}

                            {component.component === 'SXSSF' && (
                                <div className="format-info mt-3 p-2 bg-info bg-opacity-10 rounded">
                                    <small className="text-muted">
                                        <i className="fas fa-file-excel me-1"></i>
                                        Format: .xlsx (Streaming for large files)
                                    </small>
                                </div>
                            )}
                        </div>
                    ))}
                </div>

                {/* Comparison Table */}
                <div className="comparison-section mt-4">
                    <h6 className="text-primary mb-3">
                        <i className="fas fa-balance-scale me-2"></i>
                        POI Component Comparison
                    </h6>
                    <div className="table-responsive">
                        <table className="table table-sm table-bordered">
                            <thead className="table-light">
                            <tr>
                                <th>Component</th>
                                <th>Format</th>
                                <th>Max Rows</th>
                                <th>Memory Usage</th>
                                <th>Use Case</th>
                            </tr>
                            </thead>
                            <tbody>
                            <tr>
                                <td><strong>HSSF</strong></td>
                                <td>.xls</td>
                                <td>65,536</td>
                                <td>High</td>
                                <td>Legacy Excel files</td>
                            </tr>
                            <tr>
                                <td><strong>XSSF</strong></td>
                                <td>.xlsx</td>
                                <td>1,048,576</td>
                                <td>Medium-High</td>
                                <td>Modern Excel files</td>
                            </tr>
                            <tr>
                                <td><strong>SXSSF</strong></td>
                                <td>.xlsx</td>
                                <td>Unlimited*</td>
                                <td>Low</td>
                                <td>Very large files</td>
                            </tr>
                            </tbody>
                        </table>
                    </div>
                    <small className="text-muted">*Limited by disk space, not memory</small>
                </div>

                {/* Usage Recommendations */}
                <div className="recommendations-section mt-4 p-3 bg-light rounded">
                    <h6 className="text-primary mb-3">
                        <i className="fas fa-lightbulb me-2"></i>
                        Usage Recommendations
                    </h6>
                    <div className="row">
                        <div className="col-md-4">
                            <div className="recommendation-item text-center p-2">
                                <div className="icon-wrapper mb-2">
                                    <i className="fas fa-history text-secondary fa-2x"></i>
                                </div>
                                <small className="text-muted d-block">Use <strong>HSSF</strong> for</small>
                                <small className="text-dark">Legacy .xls files only</small>
                            </div>
                        </div>
                        <div className="col-md-4">
                            <div className="recommendation-item text-center p-2">
                                <div className="icon-wrapper mb-2">
                                    <i className="fas fa-file-excel text-success fa-2x"></i>
                                </div>
                                <small className="text-muted d-block">Use <strong>XSSF</strong> for</small>
                                <small className="text-dark">Standard .xlsx files</small>
                            </div>
                        </div>
                        <div className="col-md-4">
                            <div className="recommendation-item text-center p-2">
                                <div className="icon-wrapper mb-2">
                                    <i className="fas fa-database text-info fa-2x"></i>
                                </div>
                                <small className="text-muted d-block">Use <strong>SXSSF</strong> for</small>
                                <small className="text-dark">Large datasets &gt; 100k rows</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    );
};
// Testing Types Component
const TestingTypesBlock = ({ block, index }) => {
    const [copied, setCopied] = useState(false);

    const handleCopy = () => {
        let textToCopy = `${block.title}\n\n`;
        block.categories.forEach(category => {
            textToCopy += `${category.category}\n`;
            textToCopy += `Description: ${category.description}\n`;
            textToCopy += `Simulation: ${category.simulation}\n`;
            textToCopy += `Coverage: ${category.coverage}\n`;
            textToCopy += `Time Required: ${category['time-required']}\n\n`;
        });
        navigator.clipboard.writeText(textToCopy);
        setCopied(true);
        setTimeout(() => setCopied(false), 2000);
    };

    return (
        <div className="testing-types-block card my-4">
            <div className="card-header bg-primary bg-opacity-10 border-primary">
                <div className="d-flex justify-content-between align-items-center">
                    <div className="d-flex align-items-center">
                        <i className="fas fa-vial text-primary me-2"></i>
                        <h5 className="card-title mb-0 text-dark">{block.title}</h5>
                    </div>
                    <button className="btn btn-sm btn-outline-secondary" onClick={handleCopy}>
                        <i className={`fas ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                        {copied ? ' Copied!' : ' Copy'}
                    </button>
                </div>
            </div>

            <div className="card-body">
                <div className="testing-types-grid">
                    {block.categories.map((category, categoryIndex) => (
                        <div key={categoryIndex} className="testing-type-item mb-4 p-3 border rounded">
                            <div className="type-header mb-3">
                                <div className="d-flex justify-content-between align-items-start mb-2">
                                    <h6 className="text-primary mb-0">
                                        <i className="fas fa-box me-2"></i>
                                        {category.category}
                                    </h6>
                                    <div className="time-badge">
                                        <span className={`badge ${
                                            category['time-required'] === 'High' ? 'bg-danger' :
                                                category['time-required'] === 'Medium' ? 'bg-warning' : 'bg-info'
                                        }`}>
                                            {category['time-required']} Time
                                        </span>
                                    </div>
                                </div>
                                <div className="type-description text-muted small mb-3">
                                    <i className="fas fa-info-circle me-1"></i>
                                    {category.description}
                                </div>
                            </div>

                            <div className="row">
                                <div className="col-md-6">
                                    <div className="simulation-section mb-3">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-user-secret me-1"></i>
                                            Simulation
                                        </small>
                                        <div className="simulation-text small bg-primary bg-opacity-10 p-2 rounded">
                                            {category.simulation}
                                        </div>
                                    </div>
                                </div>
                                <div className="col-md-6">
                                    <div className="coverage-section">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-bullseye me-1"></i>
                                            Coverage
                                        </small>
                                        <div className="coverage-text small">
                                            {category.coverage}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    ))}
                </div>

                {/* Comparison Table */}
                <div className="comparison-section mt-4">
                    <h6 className="text-primary mb-3">
                        <i className="fas fa-balance-scale me-2"></i>
                        Testing Type Comparison
                    </h6>
                    <div className="table-responsive">
                        <table className="table table-sm table-bordered">
                            <thead className="table-light">
                            <tr>
                                <th>Type</th>
                                <th>Knowledge Level</th>
                                <th>Time Required</th>
                                <th>Cost</th>
                                <th>Best For</th>
                            </tr>
                            </thead>
                            <tbody>
                            <tr>
                                <td><strong>Black Box</strong></td>
                                <td>No internal knowledge</td>
                                <td>High</td>
                                <td>High</td>
                                <td>External threat simulation</td>
                            </tr>
                            <tr>
                                <td><strong>White Box</strong></td>
                                <td>Full internal knowledge</td>
                                <td>Medium</td>
                                <td>Medium</td>
                                <td>Comprehensive security audit</td>
                            </tr>
                            <tr>
                                <td><strong>Gray Box</strong></td>
                                <td>Partial knowledge</td>
                                <td>Medium-High</td>
                                <td>Medium-High</td>
                                <td>Balanced approach</td>
                            </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    );
};

// Methodology Framework Component
const MethodologyFrameworkBlock = ({ block, index }) => {
