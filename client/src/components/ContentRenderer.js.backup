        block.phases.forEach(phase => {
            textToCopy += `${phase.phase}\n`;
            textToCopy += `Duration: ${phase.duration}\n`;
            textToCopy += `Activities: ${phase.activities.join(', ')}\n`;
            textToCopy += `Deliverables: ${phase.deliverables.join(', ')}\n\n`;
        });
        navigator.clipboard.writeText(textToCopy);
        setCopied(true);
        setTimeout(() => setCopied(false), 2000);
