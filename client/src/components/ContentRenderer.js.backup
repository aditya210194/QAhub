                                    <span className={`badge ${
                                        format.effort === 'Low' ? 'bg-success' :
                                            format.effort === 'Medium' ? 'bg-warning' : 'bg-danger'
                                    }`}>
                                        Effort: {format.effort}
                                    </span>
                                </div>
                            </div>

                            <div className="row">
                                <div className="col-md-4">
                                    <div className="tools-section mb-3">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-tools me-1"></i>
                                            Tools
                                        </small>
                                        <div className="tools-list">
                                            {Array.isArray(format.tools) ? (
                                                format.tools.map((tool, toolIndex) => (
                                                    <span key={toolIndex} className="badge bg-secondary me-1 mb-1">
                                                        {tool}
                                                    </span>
                                                ))
                                            ) : (
                                                <div className="tools-text small">{format.tools}</div>
                                            )}
                                        </div>
                                    </div>
                                </div>
                                <div className="col-md-4">
                                    <div className="best-for-section mb-3">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-user-tag me-1"></i>
                                            Best For
                                        </small>
                                        <div className="best-for-text small">
                                            {format['best-for']}
                                        </div>
                                    </div>
                                </div>
                                <div className="col-md-4">
                                    <div className="impact-section">
                                        <small className="text-muted d-block mb-2">
                                            <i className="fas fa-chart-bar me-1"></i>
                                            Impact
                                        </small>
                                        <div className="impact-text small text-warning">
                                            {format.impact}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    );
};

