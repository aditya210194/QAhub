                            {widget.metrics && (
                                <div className="metrics-section mt-3">
                                    <small className="text-muted d-block mb-2">
                                        <i className="fas fa-tachometer-alt me-1"></i>
                                        Metrics Tracked
                                    </small>
                                    <div className="metrics-list">
                                        {widget.metrics.map((metric, metricIndex) => (
                                            <span key={metricIndex} className="badge bg-secondary me-1 mb-1">
                                                {metric}
                                            </span>
                                        ))}
                                    </div>
                                </div>
                            )}
                        </div>
                    ))}
                </div>
            </div>
        </div>
    );
};

// Predictive Analytics Component
const PredictiveAnalyticsBlock = ({ block, index }) => {
