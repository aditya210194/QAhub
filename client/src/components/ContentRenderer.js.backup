const RootCauseFrameworkBlock = ({ block, index }) => {
    const [expanded, setExpanded] = useState(false);
    const [copied, setCopied] = useState(false);

    const handleCopy = () => {
        let textToCopy = `${block.title}\n\n`;
        block.categories.forEach(category => {
            textToCopy += `${category.category} (Impact: ${category['detection-impact']})\n`;
            textToCopy += "Root Causes:\n";
            category['root-causes'].forEach(cause => {
                textToCopy += `• ${cause}\n`;
            });
            textToCopy += "\n";
        });
        navigator.clipboard.writeText(textToCopy);
        setCopied(true);
        setTimeout(() => setCopied(false), 2000);
    };

    const toggleExpand = () => {
        setExpanded(!expanded);
    };

    const getImpactColor = (impact) => {
        const impactMap = {
            'High': 'danger',
            'Medium-High': 'warning',
            'Medium': 'info',
            'Medium-Long term': 'secondary'
        };
        return impactMap[impact] || 'secondary';
    };

    return (
        <div className="root-cause-framework-block card my-4">
            <div className="card-header bg-danger bg-opacity-10 border-danger">
                <div className="d-flex justify-content-between align-items-center">
                    <div className="d-flex align-items-center">
                        <i className="fas fa-search text-danger me-2"></i>
                        <h5 className="card-title mb-0 text-dark">{block.title}</h5>
                    </div>
                    <div className="framework-actions">
                        <button className="btn btn-sm btn-outline-secondary me-2" onClick={handleCopy}>
                            <i className={`fas ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                            {copied ? ' Copied!' : ' Copy'}
                        </button>
                        <button className="btn btn-sm btn-outline-primary" onClick={toggleExpand}>
                            <i className={`fas fa-${expanded ? 'minus' : 'plus'}`}></i>
                            {expanded ? ' Less' : ' More'}
                        </button>
                    </div>
                </div>
            </div>

            <div className="card-body">
                <div className="categories-grid">
                    {block.categories.map((category, catIndex) => (
                        <div key={catIndex} className="category-item mb-4 p-3 border rounded">
                            <div className="category-header d-flex justify-content-between align-items-center mb-3">
                                <h6 className="text-danger mb-0">
                                    <i className="fas fa-folder me-2"></i>
                                    {category.category}
                                </h6>
                                <span className={`badge bg-${getImpactColor(category['detection-impact'])}`}>
                                    Impact: {category['detection-impact']}
                                </span>
                            </div>

                            <div className="root-causes-list">
                                <small className="text-muted d-block mb-2">
                                    <i className="fas fa-exclamation-circle me-1"></i>
                                    Root Causes
                                </small>
                                {category['root-causes'].slice(0, expanded ? category['root-causes'].length : 3).map((cause, causeIndex) => (
                                    <div key={causeIndex} className="cause-item d-flex align-items-start mb-2">
                                        <i className="fas fa-times-circle text-danger fa-xs mt-1 me-2"></i>
                                        <span className="small">{cause}</span>
                                    </div>
                                ))}
                                {!expanded && category['root-causes'].length > 3 && (
                                    <div className="more-items small text-primary">
                                        +{category['root-causes'].length - 3} more causes...
                                    </div>
                                )}
                            </div>
                        </div>
                    ))}
                </div>

                {/* Impact Summary */}
                <div className="impact-summary mt-4 p-3 bg-light rounded">
                    <h6 className="d-flex align-items-center text-danger mb-3">
                        <i className="fas fa-chart-line me-2"></i>
                        Detection Impact Summary
                    </h6>
                    <div className="row text-center">
                        <div className="col-md-3 mb-2">
                            <div className="impact-item p-2">
                                <i className="fas fa-clock text-danger fa-2x mb-2"></i>
                                <div className="impact-value text-danger">High Impact</div>
                                <small className="text-muted">Direct timeline extension</small>
                            </div>
                        </div>
                        <div className="col-md-3 mb-2">
                            <div className="impact-item p-2">
                                <i className="fas fa-tachometer-alt text-warning fa-2x mb-2"></i>
                                <div className="impact-value text-warning">Medium-High</div>
                                <small className="text-muted">Execution bottlenecks</small>
                            </div>
                        </div>
                        <div className="col-md-3 mb-2">
                            <div className="impact-item p-2">
                                <i className="fas fa-users text-info fa-2x mb-2"></i>
                                <div className="impact-value text-info">Medium</div>
                                <small className="text-muted">Effectiveness reduction</small>
                            </div>
                        </div>
                        <div className="col-md-3 mb-2">
                            <div className="impact-item p-2">
                                <i className="fas fa-history text-secondary fa-2x mb-2"></i>
                                <div className="impact-value text-secondary">Long-term</div>
                                <small className="text-muted">Sustained improvement</small>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    );
};

