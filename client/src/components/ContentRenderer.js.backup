                        <button className="btn btn-sm btn-outline-primary" onClick={toggleExpand}>
                            <i className={`fas fa-${expanded ? 'minus' : 'plus'}`}></i>
                            {expanded ? ' Less' : ' More'}
                        </button>
                    </div>
                </div>
            </div>

            <div className="card-body">
                <div className="phases-timeline">
                    {block.phases.map((phase, phaseIndex) => (
                        <div key={phaseIndex} className="phase-item mb-4 p-3 border rounded">
                            <div className="phase-header d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    <h6 className="text-warning mb-1">
                                        <i className="fas fa-flag me-2"></i>
                                        {phase.phase}
