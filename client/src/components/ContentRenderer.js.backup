// Testing Scripts Component
const TestingScriptsBlock = ({ block, index }) => {
    const [copied, setCopied] = useState(false);

    const handleCopy = () => {
        let textToCopy = `${block.title}\n\n`;
        block.scripts.forEach(script => {
            textToCopy += `${script.language} - ${script.purpose}\n\n`;
            textToCopy += `${script.code}\n\n`;
        });
        navigator.clipboard.writeText(textToCopy);
        setCopied(true);
        setTimeout(() => setCopied(false), 2000);
    };

    return (
        <div className="testing-scripts-block card my-4">
            <div className="card-header bg-success bg-opacity-10 border-success">
                <div className="d-flex justify-content-between align-items-center">
                    <div className="d-flex align-items-center">
                        <i className="fas fa-code text-success me-2"></i>
                        <h5 className="card-title mb-0 text-dark">{block.title}</h5>
                    </div>
                    <button className="btn btn-sm btn-outline-secondary" onClick={handleCopy}>
                        <i className={`fas ${copied ? 'fa-check' : 'fa-copy'}`}></i>
                        {copied ? ' Copied!' : ' Copy'}
                    </button>
                </div>
            </div>

            <div className="card-body">
                <div className="testing-scripts">
                    {block.scripts.map((script, scriptIndex) => (
                        <div key={scriptIndex} className="script-item mb-4 p-3 border rounded">
                            <div className="script-header mb-3">
                                <div className="d-flex justify-content-between align-items-center">
                                    <h6 className="text-success mb-0">
                                        <i className="fas fa-file-code me-2"></i>
                                        {script.language} Script
                                    </h6>
                                    <span className="badge bg-success">{script.language}</span>
                                </div>
                                <div className="script-purpose text-muted small mt-1">
                                    <i className="fas fa-bullseye me-1"></i>
                                    Purpose: {script.purpose}
                                </div>
                            </div>

                            <div className="script-code">
                                <small className="text-muted d-block mb-2">
                                    <i className="fas fa-terminal me-1"></i>
                                    Code Implementation
                                </small>
                                <div className="code-content small bg-dark text-light p-3 rounded font-monospace">
                                    <pre className="mb-0">{script.code}</pre>
                                </div>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </div>
    );
};
