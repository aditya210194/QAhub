const KeyComponentsBlock = ({ block, index }) => {
    const [copied, setCopied] = useState(false);

    const handleCopy = () => {
        let textToCopy = `${block.title}\n\n`;
        block.components.forEach(component => {
            textToCopy += `${component.component}\n`;
            textToCopy += `Purpose: ${component.purpose}\n`;
            textToCopy += `Features: ${component.features.join(', ')}\n`;
